# T86 (rows I183, I184): `library also-by`, `library similar` and `library duplicates` through the real selecta-cli, on the
# devilbox fixture songs (composers from the songdb step, genres by tag edit, ratings written to the ratings table;
# duplicates: modland and hvsc rows planted with the md5 of the local files, OPEN through `selecta-cli script`).
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DSONGS=<tests/m3/genre> -DGOLDEN=<tests/m3/similar.golden>
# -DSQLITE3=<sqlite3 shell>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "devilbox.uprough.net=${fx},fixture.test=${fx}")
set(ENV{SELECTA_DEVILBOX_URL} "http://devilbox.uprough.net")

set(good 0)
set(db "${WORK}/t86-similar.db")
file(REMOVE "${db}" "${db}-wal" "${db}-shm")
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)

function(run_cli out)
  execute_process(COMMAND "${CLI}" ${ARGN} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T86 similar: selecta-cli ${ARGN} failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}${e}" PARENT_SCOPE)
endfunction()

function(sql out stmt)
  execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=1" "${db}" "${stmt}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T86 similar: sqlite3 '${stmt}' failed rc=${rc}\n${o}${e}")
  endif()
  string(STRIP "${o}" o)
  set(${out} "${o}" PARENT_SCOPE)
endfunction()

function(key_of var file)
  sql(k "SELECT key FROM songs WHERE path LIKE '%/${file}'")
  if(k STREQUAL "")
    message(FATAL_ERROR "T86 similar: no song row for ${file}")
  endif()
  set(${var} "${k}" PARENT_SCOPE)
endfunction()

function(expect_counter text name want)
  if(NOT text MATCHES "${name}=([0-9]+)")
    message(FATAL_ERROR "T86 similar: counter ${name}= missing\n${text}")
  endif()
  if(NOT CMAKE_MATCH_1 EQUAL want)
    message(FATAL_ERROR "T86 similar: ${name}=${CMAKE_MATCH_1}, want ${want}\n${text}")
  endif()
endfunction()

# The rows of a CLI answer without their keys (keys depend on the checkout path): "name|genre|rating|match".
function(rows_without_keys var text)
  set(out "")
  string(REPLACE "\n" ";" lines "${text}")
  foreach(l IN LISTS lines)
    if(l MATCHES "^row=[^|]*\\|(.*)$")
      string(APPEND out "${CMAKE_MATCH_1}\n")
    endif()
  endforeach()
  set(${var} "${out}" PARENT_SCOPE)
endfunction()

run_cli(scan library scan --db "${db}" "${SONGS}")
run_cli(sync library genre --db "${db}")
key_of(k_amb ambient.mod)
key_of(k_tec techno.mod)
key_of(k_nog nogenre.mod)
key_of(k_dwn down.mod)

# ---- also-by: composer songs of the seed, never the seed itself
run_cli(a1 library also-by --db "${db}" ${k_amb})
expect_counter("${a1}" also_by_rows 2)
if(NOT a1 MATCHES "${k_tec}" OR NOT a1 MATCHES "${k_nog}" OR a1 MATCHES "${k_amb}" OR a1 MATCHES "${k_dwn}")
  message(FATAL_ERROR "T86 also-by: wrong rows for ambient.mod\n${a1}")
endif()
run_cli(a2 library also-by --db "${db}" ${k_nog})
expect_counter("${a2}" also_by_rows 2)
run_cli(a3 library also-by --db "${db}" ${k_dwn})
expect_counter("${a3}" also_by_rows 0)

# ---- similar: genre match first, then rating. ambient.mod is "Electronic - Ambient" (fixture); nogenre.mod gets
# the same genre in another case by tag edit, down.mod keeps none. Ratings: techno 5, nogenre 2, down 4.
run_cli(t1 userdata --db "${db}" --tag ${k_nog} genre "electronic - ambient")
sql(x "INSERT INTO ratings(key, rating) VALUES('${k_tec}', 5), ('${k_nog}', 2), ('${k_dwn}', 4)")
run_cli(s1 library similar --db "${db}" ${k_amb})
expect_counter("${s1}" similar_rows 3)
rows_without_keys(got "${s1}")
file(READ "${GOLDEN}" want)
if(NOT got STREQUAL want)
  message(FATAL_ERROR "T86 similar: order differs from tests/m3/similar.golden\n--- got\n${got}--- want\n${want}")
endif()

# ---- duplicates (I184): a second database so the similar counts above stay as they are. Planted groups, md5 taken
# from the files by cmake (not by the code under test): ambient.mod = local + modland + hvsc, techno.mod = local +
# modland, and one modland + hvsc pair with no local copy. Three groups; nogenre.mod and down.mod are unique.
set(db "${WORK}/t86-dupes.db")
file(REMOVE "${db}" "${db}-wal" "${db}-shm")
run_cli(scan2 library scan --db "${db}" "${SONGS}")
file(MD5 "${SONGS}/ambient.mod" m_amb)
file(MD5 "${SONGS}/techno.mod" m_tec)
set(m_pair 0123456789abcdef0123456789abcdef)
foreach(row "modland:Planted/amb.mod|${m_amb}" "hvsc:Planted/amb.sid|${m_amb}" "modland:Planted/tec.mod|${m_tec}"
    "modland:Planted/pair.mod|${m_pair}" "hvsc:Planted/pair.sid|${m_pair}")
  string(REPLACE "|" ";" f "${row}")
  list(GET f 0 k)
  list(GET f 1 m)
  string(REGEX REPLACE "^([a-z]+):(.*)$" "\\1" src "${k}")
  string(REGEX REPLACE "^([a-z]+):(.*)$" "\\2" pth "${k}")
  sql(x "INSERT INTO songs(key, source, path, name, md5) VALUES('${k}', '${src}', '${pth}', '${pth}', '${m}')")
endforeach()
key_of(k_amb ambient.mod)
key_of(k_tec techno.mod)
run_cli(d1 library duplicates --db "${db}")
expect_counter("${d1}" dupes 3)
string(REGEX MATCHALL "group=[^\n]*" groups "${d1}")
foreach(g IN LISTS groups)
  if(g MATCHES "group=${m_amb}\\|3\\|${k_amb}$" OR g MATCHES "group=${m_tec}\\|2\\|${k_tec}$"
      OR g MATCHES "group=${m_pair}\\|2\\|modland:Planted/pair.mod$")
    math(EXPR good "${good} + 1" OUTPUT_FORMAT DECIMAL)
  endif()
endforeach()
if(NOT good EQUAL 3)
  message(FATAL_ERROR "T86 duplicates: best source per D-M3-14 wrong in ${good} of 3 groups\n${d1}")
endif()
# the md5 of the local files was stored by the duplicates step
sql(hashed "SELECT md5 FROM songs WHERE key = '${k_amb}'")
if(NOT hashed STREQUAL m_amb)
  message(FATAL_ERROR "T86 duplicates: local md5 ${hashed}, want ${m_amb}")
endif()

# ---- OPEN plays the best source: opening the modland copy of ambient.mod reads the local file, opening the local
# key is no redirect. dup_stats is the sentinel (DUP redirects=N played=<path or remote key read instead; a local best source is its plain path>).
string(REGEX REPLACE "^local:" "" p_amb "${k_amb}")
file(WRITE "${WORK}/t86-open.sel" "OPEN modland:Planted/amb.mod\n@dup_stats\nOPEN ${p_amb}\n@dup_stats\n@library_stats\n")
execute_process(COMMAND "${CLI}" script "${WORK}/t86-open.sel" --db "${db}" OUTPUT_VARIABLE o2 ERROR_VARIABLE e2 RESULT_VARIABLE rc2)
set(o2 "${o2}${e2}")
if(NOT rc2 EQUAL 0 OR o2 MATCHES "ERROR")
  message(FATAL_ERROR "T86 open: script failed rc=${rc2}\n${o2}")
endif()
string(REGEX MATCHALL "DUP redirects=[^\n]*" dups "${o2}")
list(GET dups 0 dup_first)
list(GET dups 1 dup_second)
# the second OPEN is the local file itself: no twin ranks above it, so the count stays at 1
string(REGEX REPLACE "^local:" "" p_amb "${k_amb}")
if(NOT dup_first STREQUAL "DUP redirects=1 played=${p_amb}" OR NOT dup_second STREQUAL "DUP redirects=1 played=${p_amb}")
  message(FATAL_ERROR "T86 open: OPEN did not play the best source\n${o2}")
endif()
expect_counter("${o2}" songs_opened 2)
# ---- I184a: OPEN of a remote copy finds its local twin on a fresh database that never ran `library duplicates`: the scan
# leaves the local md5 empty, the idle pass or OPEN hashes the local files that share the remote row's size before it ranks the sources.
set(db "${WORK}/t86-open-nohash.db")
file(REMOVE "${db}" "${db}-wal" "${db}-shm")
run_cli(scan3 library scan --db "${db}" "${SONGS}")
file(SIZE "${SONGS}/ambient.mod" sz_amb)
key_of(k_amb3 ambient.mod)
# the engine's idle pass may already have hashed the scanned files; clear them so the state is a scan's: md5 empty
sql(x "UPDATE songs SET md5 = NULL WHERE source = 'local'; UPDATE files SET md5 = NULL WHERE source = 'local'")
sql(x "INSERT INTO songs(key, source, path, name, md5, size) VALUES('modland:Planted/amb.mod', 'modland', 'Planted/amb.mod', 'amb', '${m_amb}', ${sz_amb})")
string(REGEX REPLACE "^local:" "" p_amb3 "${k_amb3}")
file(WRITE "${WORK}/t86-open3.sel" "OPEN modland:Planted/amb.mod\n@dup_stats\n")
execute_process(COMMAND "${CLI}" script "${WORK}/t86-open3.sel" --db "${db}" OUTPUT_VARIABLE o3 ERROR_VARIABLE e3 RESULT_VARIABLE rc3)
set(o3 "${o3}${e3}")
if(NOT rc3 EQUAL 0 OR o3 MATCHES "ERROR")
  message(FATAL_ERROR "T86 open-nohash: script failed rc=${rc3}\n${o3}")
endif()
string(REGEX MATCH "DUP redirects=[^\n]*" dup3 "${o3}")
if(NOT dup3 STREQUAL "DUP redirects=1 played=${p_amb3}")
  message(FATAL_ERROR "T86 open-nohash: OPEN of the remote copy did not play the local twin without a duplicates run\n${o3}")
endif()
sql(post "SELECT md5 FROM songs WHERE key = '${k_amb3}'")
if(NOT post STREQUAL m_amb)
  message(FATAL_ERROR "T86 open-nohash: local md5 '${post}' not stored by OPEN, want ${m_amb}")
endif()
message(STATUS "similar_ok similar_rows=3 also_by_rows=2 dupes=3 open_best_source=1")
