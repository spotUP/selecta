# Row I695d: a sndh tune the site has no loose file for (the year zip lists it) is fetched from the zip member.
# Reachability: `library sync sndh <url>` through the engine, then `selecta-cli script` LIBRARY_FETCH sndh:<path> (the
# song fetch the player uses). sndhzip.test serves download.php and a 2-member zip; sndh.atari.org (the built-in mirror)
# has no /sndh/sndh_lf/ file, so the loose URL answers 404. Sentinel: the cache counts zip_members.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures> -DM3=<tests/m3>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "sndh.atari.org=${fx},sndhzip.test=${fx},fixture.test=${fx}")
unset(ENV{SELECTA_MIRROR})
unset(ENV{SELECTA_MIRRORS_SNDH})
set(cache "${WORK}/i695d-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/i695d.db")
file(REMOVE "${db}")
set(dir "${FIXDIR}/sndhzip.test")

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "I695d ${what}: got '${got}', want '${want}'\n${raw}")
  endif()
endfunction()

function(counter var key)
  if(raw MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now 1792756800 --dump sndh http://sndhzip.test
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("sync exit code" "${rc}" 0)
counter(v listing_rows)
expect("listing_rows" "${v}" 2)

execute_process(COMMAND "${CLI}" script "${M3}/fetch_sndh_zip.sel" --catalogue "${M3}/catalogue.tsv"
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("fetch exit code" "${rc}" 0)
counter(v zip_members)
expect("zip_members (sentinel: the zip member path ran)" "${v}" 2)
counter(v fetches)
expect("fetches" "${v}" 2)
counter(v cache_hits)
expect("cache_hits (the repeat)" "${v}" 1)
counter(v zip_requests)
expect("zip_requests (local header + data, per member)" "${v}" 4)

foreach(pair "Too_Drunk_To_Fuck.sndh" "Stored_Tune.sndh")
  set(got "${cache}/files/sndh/Dubmood/DMA/${pair}")
  if(NOT EXISTS "${got}")
    message(FATAL_ERROR "I695d: ${got} missing\n${raw}")
  endif()
  file(MD5 "${got}" got_md5)
  file(MD5 "${dir}/${pair}.expected" want_md5)
  expect("md5 of ${pair} equals the original member" "${got_md5}" "${want_md5}")
  file(SIZE "${got}" got_size)
  file(SIZE "${dir}/${pair}.expected" want_size)
  expect("size of ${pair}" "${got_size}" "${want_size}")
endforeach()
if(EXISTS "${cache}/files/sndh/Dubmood/DMA/Too_Drunk_To_Fuck.sndh.part")
  message(FATAL_ERROR "I695d: .part file left behind")
endif()
message(STATUS "sndh_zip_member_ok")
