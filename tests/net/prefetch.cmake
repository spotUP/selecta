# T77 prefetch (row I168): `selecta-cli script tests/m3/prefetch.sel` over fixture mirrors.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DM3=<tests/m3> -DCAT=<catalogue tsv>
# fast.mirror.test serves two playable songs (play1.mod, play2.mod). Playing the first prefetches the second;
# playing the second afterwards is a cache hit and makes no request.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "fixture.test=${fx},fast.mirror.test=${fx}")
unset(ENV{SELECTA_MIRROR})
set(ENV{SELECTA_MIRRORS_MODLAND} "http://fast.mirror.test/mods/")

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "T77 ${what}: got '${got}', want '${want}'\n${last_raw}")
  endif()
endfunction()

function(counter var key)
  if(last_raw MATCHES "(^|\n)${key}=([^\n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

function(hits var host path)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t77-log.json"
    OUTPUT_VARIABLE o RESULT_VARIABLE rc)
  file(READ "${WORK}/t77-log.json" logjson)
  string(JSON n LENGTH "${logjson}")
  set(count 0)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON h GET "${logjson}" ${i} host)
      string(JSON p GET "${logjson}" ${i} path)
      if(h STREQUAL "${host}" AND p STREQUAL "${path}")
        math(EXPR count "${count} + 1")
      endif()
    endforeach()
  endif()
  set(${var} "${count}" PARENT_SCOPE)
endfunction()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST
  OUTPUT_VARIABLE o RESULT_VARIABLE rc)
set(cache "${WORK}/t77-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
execute_process(COMMAND "${CLI}" script "${M3}/prefetch.sel" --catalogue "${CAT}"
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(last_raw "${o}${e}")

# The sentinel: the prefetch ran, and fetched the second song exactly once.
counter(prefetch_fetches prefetch_fetches)
expect("prefetch_fetches" "${prefetch_fetches}" 1)
counter(prefetches prefetches)
if(prefetches STREQUAL "" OR prefetches LESS 1)
  message(FATAL_ERROR "T77 no prefetch request counted: ${last_raw}")
endif()
foreach(n 1 2)
  if(NOT EXISTS "${cache}/files/modland/Protracker/test/play${n}.mod")
    message(FATAL_ERROR "T77 play${n}.mod missing from the cache\n${last_raw}")
  endif()
endforeach()
# Song 1 came from the play, song 2 from the prefetch: two downloads, and playing song 2 was a cache hit.
counter(fetches fetches)
expect("fetches (play1 + prefetched play2)" "${fetches}" 2)
counter(cache_hits cache_hits)
if(cache_hits STREQUAL "" OR cache_hits LESS 1)
  message(FATAL_ERROR "T77 playing the prefetched song was not a cache hit: ${last_raw}")
endif()
hits(h1 fast.mirror.test "/mods/Protracker/test/play1.mod")
expect("play1 requests" "${h1}" 1)
hits(h2 fast.mirror.test "/mods/Protracker/test/play2.mod")
expect("play2 requests (prefetch only, none at play)" "${h2}" 1)
if(NOT last_raw MATCHES "SONG_OPENED[^\n]*\n[^\n]*SONG_OPENED" AND NOT last_raw MATCHES "playing=2")
  message(FATAL_ERROR "T77 second song never played: ${last_raw}")
endif()
message(STATUS "prefetch_ok")
