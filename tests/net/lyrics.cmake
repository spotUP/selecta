# T93 lyrics (row I193): `selecta-cli script tests/m3/lyrics.sel` over the devilbox fixture.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DM3=<tests/m3>
# Songs and lyrics: tests/m3/lyrics/ (message.it is an Impulse Tracker module with no samples and one empty pattern,
# carrying a three line song message). Precedence: .lrc next to the song, song message, DEViLBOX endpoint.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "devilbox.uprough.net=${fx},fixture.test=${fx}")
set(ENV{SELECTA_DEVILBOX_URL} "http://devilbox.uprough.net")

function(reset_log)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
endfunction()

# Number of requests on /api/lyrics/ in the fixture log.
function(lyrics_requests var)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t93-log.json" OUTPUT_VARIABLE o)
  file(READ "${WORK}/t93-log.json" logjson)
  string(JSON n LENGTH "${logjson}")
  set(c 0)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON path GET "${logjson}" ${i} path)
      if(path MATCHES "^/api/lyrics/")
        math(EXPR c "${c} + 1")
      endif()
    endforeach()
  endif()
  set(${var} ${c} PARENT_SCOPE)
endfunction()

function(expect_match text pattern what)
  if(NOT text MATCHES "${pattern}")
    message(FATAL_ERROR "T93 lyrics: ${what}: want /${pattern}/\n${text}")
  endif()
endfunction()

function(run_script out script db)
  file(REMOVE "${db}" "${db}-wal" "${db}-shm")
  file(REMOVE_RECURSE "${WORK}/t93-config")
  file(MAKE_DIRECTORY "${WORK}/t93-config")
  execute_process(COMMAND "${CLI}" script "${M3}/${script}" --db "${db}" --config-dir "${WORK}/t93-config"
    WORKING_DIRECTORY "${M3}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T93 lyrics: ${script} failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}${e}" PARENT_SCOPE)
endfunction()

# I193b: like run_script, but with a DEViLBOX token in the config dir when TOKEN is set, and the script text given inline.
function(run_inline out text db with_token)
  file(REMOVE "${db}" "${db}-wal" "${db}-shm")
  file(REMOVE_RECURSE "${WORK}/t93-config")
  file(MAKE_DIRECTORY "${WORK}/t93-config")
  if(with_token)
    file(WRITE "${WORK}/t93-config/devilbox.token" "fixture-jwt-token\n")
  endif()
  file(WRITE "${WORK}/t93-up.sel" "${text}")
  execute_process(COMMAND "${CLI}" script "${WORK}/t93-up.sel" --db "${db}" --config-dir "${WORK}/t93-config"
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T93 lyrics upload: script failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}${e}" PARENT_SCOPE)
endfunction()

# POSTs on /api/lyrics/ in the fixture log: count in <var>, the first one's JSON in <var>_first.
function(lyrics_posts var)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t93-log.json" OUTPUT_VARIABLE o)
  file(READ "${WORK}/t93-log.json" logjson)
  string(JSON n LENGTH "${logjson}")
  set(c 0)
  set(first "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON path GET "${logjson}" ${i} path)
      string(JSON method GET "${logjson}" ${i} method)
      if(path MATCHES "^/api/lyrics/" AND method STREQUAL "POST")
        if(c EQUAL 0)
          string(JSON first GET "${logjson}" ${i})
        endif()
        math(EXPR c "${c} + 1")
      endif()
    endforeach()
  endif()
  set(${var} ${c} PARENT_SCOPE)
  set(${var}_first "${first}" PARENT_SCOPE)
endfunction()

file(REMOVE_RECURSE "${WORK}/t93-config")
file(MAKE_DIRECTORY "${WORK}/t93-config")

# ---- 1. all four songs in one script
reset_log()
run_script(r "lyrics.sel" "${WORK}/t93-1.db")
string(REGEX MATCHALL "LYRICS [^\n]*" lines "${r}")
list(LENGTH lines nlines)
if(NOT nlines EQUAL 5)
  message(FATAL_ERROR "T93 lyrics: ${nlines} LYRICS lines, want 5\n${r}")
endif()
list(GET lines 0 l_lrc)
list(GET lines 1 l_msg)
list(GET lines 2 l_dvb)
list(GET lines 3 l_dvb_seek)
list(GET lines 4 l_missing)
# local file: at 12.5 s the current line is the 00:12.00 one, index 3 of 6 (the golden); the endpoint is asked once (I193b: for the upload decision), its answer is not used
expect_match("${l_lrc}" "lyric_source=lrc lyric_line=3 lyric_lines=6 lyric_fetches=1 text=Line three, sung at twelve seconds" "lrc at 12.5 s")
# song message: plain lyrics, no synced lines, still no request
expect_match("${l_msg}" "lyric_source=message lyric_line=-1 lyric_lines=0 lyric_fetches=1 text=First line of the song message\\|Second line sings along\\|Third line fades out"  "song message")
expect_match("${l_msg}" "Third line fades out" "whole song message kept")
# endpoint: used because there is no local file; no line has started at 0 s
expect_match("${l_dvb}" "lyric_source=devilbox lyric_line=-1 lyric_lines=3 lyric_fetches=2" "endpoint lyrics before the first line")
expect_match("${l_dvb_seek}" "lyric_source=devilbox lyric_line=1 lyric_lines=3 lyric_fetches=2 text=Endpoint line two" "endpoint lyrics at 2.6 s")
# missing route: the song plays without lyrics and the sentinel names the endpoint
expect_match("${r}" "devilbox_missing=lyrics\nLYRICS lyric_source=none lyric_line=-1 lyric_lines=0 lyric_fetches=3" "missing endpoint")
lyrics_requests(n1)
if(NOT n1 EQUAL 3)
  message(FATAL_ERROR "T93 lyrics: ${n1} /api/lyrics requests, want 3 (ambient GET for the upload decision, techno, nogenre; none for message)")
endif()

# ---- 2. the pref off: no request at all, no lyrics
reset_log()
run_script(r2 "lyrics_off.sel" "${WORK}/t93-2.db")
expect_match("${r2}" "LYRICS lyric_source=none lyric_line=-1 lyric_lines=0 lyric_fetches=0" "pref off")
lyrics_requests(n2)
if(NOT n2 EQUAL 0)
  message(FATAL_ERROR "T93 lyrics: ${n2} /api/lyrics requests with library.lyrics_online off, want 0")
endif()

# ---- 3. I193b upload: a local .lrc whose GET answered 404 is POSTed once (copies in WORK, so the committed songs keep
# their lyrics tests above).
file(MAKE_DIRECTORY "${WORK}/t93-up")
file(COPY "${M3}/lyrics/ambient.mod" "${M3}/lyrics/ambient.lrc" "${M3}/lyrics/techno.mod" DESTINATION "${WORK}/t93-up")
file(RENAME "${WORK}/t93-up/techno.mod" "${WORK}/t93-up/known.mod")
file(COPY "${M3}/lyrics/ambient.lrc" DESTINATION "${WORK}/t93-up")
file(COPY_FILE "${WORK}/t93-up/ambient.lrc" "${WORK}/t93-up/known.lrc")
file(READ "${M3}/lyrics/ambient.lrc" lrc_text)
string(LENGTH "${lrc_text}" lrc_len)
set(open_ambient "OPEN ${WORK}/t93-up/ambient.mod\n@render 441\n@lyrics\n")
set(open_known "OPEN ${WORK}/t93-up/known.mod\n@render 441\n@lyrics\n")

# 3a. token, GET 404: exactly one POST, right path, content type, auth header and body; reopening the same
# song later in the session sends the GET again but not the POST
reset_log()
run_inline(u1 "${open_ambient}${open_known}${open_ambient}" "${WORK}/t93-3a.db" 1)
lyrics_posts(p1)
if(NOT p1 EQUAL 1)
  message(FATAL_ERROR "T93 lyrics upload: ${p1} POSTs with a token and GET 404, want exactly 1\n${u1}")
endif()
string(JSON ppath GET "${p1_first}" path)
string(JSON pctype GET "${p1_first}" headers content-type)
string(JSON pauth GET "${p1_first}" headers authorization)
string(JSON pbody GET "${p1_first}" body)
string(JSON pbody_len GET "${p1_first}" body_len)
if(NOT ppath STREQUAL "/api/lyrics/1074d265f7f122c4c6d3d4df65f86ed9")
  message(FATAL_ERROR "T93 lyrics upload: POST path ${ppath}")
endif()
if(NOT pctype STREQUAL "text/plain; charset=utf-8")
  message(FATAL_ERROR "T93 lyrics upload: POST content type '${pctype}'")
endif()
if(NOT pauth STREQUAL "Bearer fixture-jwt-token")
  message(FATAL_ERROR "T93 lyrics upload: POST authorization '${pauth}'")
endif()
if(NOT pbody STREQUAL lrc_text OR NOT pbody_len EQUAL lrc_len)
  message(FATAL_ERROR "T93 lyrics upload: POST body differs from ambient.lrc (${pbody_len} vs ${lrc_len} bytes)")
endif()
lyrics_requests(g1)
if(NOT g1 EQUAL 4)
  message(FATAL_ERROR "T93 lyrics upload: ${g1} /api/lyrics requests, want 4 (GET and POST for ambient, GET known, GET ambient again without a second POST)")
endif()
expect_match("${u1}" "lyric_source=lrc" "uploaded song still plays its local lyrics")

# 3b. no token: the GET is sent, no POST
reset_log()
run_inline(u2 "${open_ambient}" "${WORK}/t93-3b.db" 0)
lyrics_posts(p2)
lyrics_requests(g2)
if(NOT p2 EQUAL 0 OR NOT g2 EQUAL 1)
  message(FATAL_ERROR "T93 lyrics upload: no token gave ${p2} POSTs and ${g2} requests, want 0 and 1")
endif()

# 3c. GET 200 (the endpoint holds the lyrics): no POST although a token and a local .lrc exist
reset_log()
run_inline(u3 "${open_known}" "${WORK}/t93-3c.db" 1)
lyrics_posts(p3)
lyrics_requests(g3)
if(NOT p3 EQUAL 0 OR NOT g3 EQUAL 1)
  message(FATAL_ERROR "T93 lyrics upload: GET 200 gave ${p3} POSTs and ${g3} requests, want 0 and 1")
endif()

# 3d. library.lyrics_online off: no network at all, even with a token
reset_log()
run_inline(u4 "PREF_SET library.lyrics_online off\n${open_ambient}" "${WORK}/t93-3d.db" 1)
lyrics_requests(g4)
if(NOT g4 EQUAL 0)
  message(FATAL_ERROR "T93 lyrics upload: ${g4} requests with lyrics_online off, want 0")
endif()

message(STATUS "lyrics_ok")
