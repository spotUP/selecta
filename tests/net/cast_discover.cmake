# I892e1: Chromecast mDNS discovery. -DTEST=<cast_discover_test> -DWORK=<scratch dir> -DSRV=<mdns_server.py>
# The test binary first runs the pure parser check (name compression, TXT fn/id/md, SRV port, A address; prints
# mdns_parse_ok), then browses the loopback responder (unicast to 127.0.0.1, real multicast is unreliable on macOS
# loopback). The responder answers the PTR query with the PTR record only, twice, so the device can only appear when the
# client sends the follow-up SRV/TXT query and the A query by name. Asserts the device fields and the fixture's query log.
set(PORT "${WORK}/mdns-port")
file(REMOVE "${PORT}" "${PORT}.requests")
execute_process(COMMAND sh -c "python3 -I '${SRV}' '${PORT}' 30 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${PORT}")
    file(READ "${PORT}" sp)
    if(NOT sp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${sp}" sp)
if(NOT sp MATCHES "^[0-9]+$")
  message(FATAL_ERROR "I892e1: mdns fixture did not start (${sp})")
endif()
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
execute_process(COMMAND "${TEST}" 127.0.0.1 ${sp} OUTPUT_VARIABLE so ERROR_VARIABLE se RESULT_VARIABLE rc TIMEOUT 30)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "I892e1: cast_discover_test failed rc=${rc}\n${so}${se}")
endif()
foreach(want "mdns_parse_ok" "cast_found=1" "cast_name=Living Room" "cast_id=0123456789abcdef"
             "cast_model=Chromecast Audio" "cast_host=127.0.0.1" "cast_port=8009")
  if(NOT so MATCHES "${want}\n")
    message(FATAL_ERROR "I892e1: missing '${want}'\n${so}")
  endif()
endforeach()
file(READ "${PORT}.requests" rq)
foreach(want "mdns_q=12:_googlecast._tcp.local" "mdns_q=255:Chromecast-abc123._googlecast._tcp.local" "mdns_q=1:abc123.local")
  if(NOT rq MATCHES "${want}")
    message(FATAL_ERROR "I892e1: fixture never saw '${want}' (code did not run)\n${rq}")
  endif()
endforeach()
message(STATUS "cast_discover_ok")
