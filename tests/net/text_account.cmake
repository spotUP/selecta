# I1469t text-ui-account (design doc 9.2, D-M3-12): the text UI account prompts against the fixture server. A opens them;
# a wrong password shows the server's own error text, Create Account logs in and stores the name (never the password),
# A again offers Log Out and y removes the name.
# -DSELECTA=<selecta> -DWORK=<fixture work dir>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_DEVILBOX_URL} "http://devilbox.uprough.net")
set(ENV{SELECTA_NET_MAP} "devilbox.uprough.net=http://127.0.0.1:${port}")
set(cfg "${WORK}/i1469t-cfg")
file(REMOVE_RECURSE "${cfg}")
file(MAKE_DIRECTORY "${cfg}")

# keys: one key per line; a word is typed one character per line
function(ui name keys)
  set(body "")
  foreach(k ${keys})
    if(k MATCHES "^type:(.*)$")
      string(LENGTH "${CMAKE_MATCH_1}" n)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        string(SUBSTRING "${CMAKE_MATCH_1}" ${i} 1 c)
        string(APPEND body "${c}\n")
      endforeach()
    else()
      string(APPEND body "${k}\n")
    endif()
  endforeach()
  file(WRITE "${WORK}/i1469t-${name}.keys" "${body}wait 1500\n")
  execute_process(COMMAND "${SELECTA}" --output null --size 120x30 --config-dir "${cfg}"
    --keys "${WORK}/i1469t-${name}.keys" --screen-dump "${WORK}/i1469t-${name}.txt"
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc TIMEOUT 30)
  if(NOT rc EQUAL 0 OR NOT EXISTS "${WORK}/i1469t-${name}.txt")
    message(FATAL_ERROR "I1469t ${name}: selecta exited ${rc}\n${o}${e}")
  endif()
  file(READ "${WORK}/i1469t-${name}.txt" screen)
  set(screen "${screen}" PARENT_SCOPE)
endfunction()

function(expect pattern what)
  if(NOT screen MATCHES "${pattern}")
    message(FATAL_ERROR "I1469t ${what}: want ${pattern}\n${screen}")
  endif()
endfunction()

ui(wrong "A;l;type:newuser;Enter;type:wrong-password;Enter")
expect("Log In failed: Invalid username or password" "server error text")
if(EXISTS "${cfg}/devilbox.token")
  message(FATAL_ERROR "I1469t a failed login left a token")
endif()

ui(prompt "A;c;type:bob;Enter;type:abc")
expect("Create Account  Username: bob  Password: \\*\\*\\*" "masked password prompt")
if(screen MATCHES "abc")
  message(FATAL_ERROR "I1469t the password shows in clear\n${screen}")
endif()

ui(signup "A;c;type:bob;Enter;type:fixture-password;Enter")
expect("Account created, logged in as bob" "signup")
file(READ "${cfg}/devilbox.user" who)
if(NOT who MATCHES "^bob$")
  message(FATAL_ERROR "I1469t user file holds '${who}'")
endif()
file(GLOB files "${cfg}/*")
foreach(f ${files})
  file(READ "${f}" body)
  if(body MATCHES "fixture-password|wrong-password")
    message(FATAL_ERROR "I1469t password written to ${f}")
  endif()
endforeach()

ui(ask "A")
expect("Logged in as bob\\. Log Out\\?" "log out prompt")
ui(logout "A;y")
expect("Logged out" "logout")
if(EXISTS "${cfg}/devilbox.token" OR EXISTS "${cfg}/devilbox.user")
  message(FATAL_ERROR "I1469t logout left the token or the name")
endif()
message(STATUS "text_account_ok")
