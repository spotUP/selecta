# T85 genre part (row I181): `library genre` asks the DEViLBOX genre endpoint once per song, caches the answer in
# genre_cache, and `library search genre:ambient` finds songs through songs.genre.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DSONGS=<tests/m3/genre>
# Run 1: 4 lookups (ambient, techno, nogenre answer 200; down answers 503 and stays unknown, uncached).
# Run 2: the 3 answered keys come from the cache (no request), only the 503 song asks again.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "devilbox.uprough.net=${fx},fixture.test=${fx}")
set(ENV{SELECTA_DEVILBOX_URL} "http://devilbox.uprough.net")

set(db "${WORK}/t85-genre.db")
file(REMOVE "${db}" "${db}-wal" "${db}-shm")
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)

function(run_cli out)
  execute_process(COMMAND "${CLI}" ${ARGN} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T85 genre: selecta-cli ${ARGN} failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}${e}" PARENT_SCOPE)
endfunction()

function(genre_requests var)
  set(prefix "^/api/genre/")
  if(ARGC GREATER 1)
    set(prefix "${ARGV1}")
  endif()
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t85-log.json" OUTPUT_VARIABLE o)
  file(READ "${WORK}/t85-log.json" logjson)
  string(JSON n LENGTH "${logjson}")
  set(c 0)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON p GET "${logjson}" ${i} path)
      if(p MATCHES "${prefix}")
        math(EXPR c "${c} + 1")
      endif()
    endforeach()
  endif()
  set(${var} ${c} PARENT_SCOPE)
endfunction()

function(expect_counter text name want)
  if(NOT text MATCHES "${name}=([0-9]+)")
    message(FATAL_ERROR "T85 genre: counter ${name}= missing\n${text}")
  endif()
  if(NOT CMAKE_MATCH_1 EQUAL want)
    message(FATAL_ERROR "T85 genre: ${name}=${CMAKE_MATCH_1}, want ${want}\n${text}")
  endif()
endfunction()

run_cli(scan library scan --db "${db}" "${SONGS}")

# ---- run 1: every song asks the endpoint
run_cli(r1 library genre --db "${db}")
expect_counter("${r1}" songs 4)
expect_counter("${r1}" genre_lookups 4)
expect_counter("${r1}" genre_cache_hits 0)
expect_counter("${r1}" genre_set 2)
expect_counter("${r1}" songdb_lookups 4)
expect_counter("${r1}" songdb_cache_hits 0)
expect_counter("${r1}" composers_set 3)
expect_counter("${r1}" unknown 2)
genre_requests(n1)
if(NOT n1 EQUAL 4)
  message(FATAL_ERROR "T85 genre: run 1 sent ${n1} /api/genre requests, want 4")
endif()

genre_requests(s1 "^/api/songdb/")
if(NOT s1 EQUAL 4)
  message(FATAL_ERROR "T85 genre: run 1 sent ${s1} /api/songdb requests, want 4")
endif()

# ---- composer page: every spelling and alias lists the same 3 songs; the other author lists 1
set(page "")
foreach(nm "Jogeir Liljedahl" "virgill" "liljedahl, jogeir" "JOGEIR LILJEDAHL (Virgill)")
  run_cli(cp library composer --db "${db}" "${nm}")
  expect_counter("${cp}" composer_rows 3)
  string(REGEX REPLACE "composer=[^\n]*\n" "" rows "${cp}")
  if(page STREQUAL "")
    set(page "${rows}")
  elseif(NOT page STREQUAL rows)
    message(FATAL_ERROR "T85 composer: spelling '${nm}' lists different songs\n${cp}\nvs\n${page}")
  endif()
endforeach()
if(NOT cp MATCHES "composer=Jogeir Liljedahl")
  message(FATAL_ERROR "T85 composer: header\n${cp}")
endif()
run_cli(cp2 library composer --db "${db}" "Dr Awesome")
expect_counter("${cp2}" composer_rows 1)

# ---- genre: search finds the right songs
run_cli(amb library search --db "${db}" genre:ambient)
if(NOT amb MATCHES "ambient\\.mod" AND NOT amb MATCHES "key=")
  message(FATAL_ERROR "T85 genre: genre:ambient found nothing\n${amb}")
endif()
string(REGEX MATCHALL "key=" ambn "${amb}")
list(LENGTH ambn ambc)
if(NOT ambc EQUAL 1)
  message(FATAL_ERROR "T85 genre: genre:ambient found ${ambc} songs, want 1\n${amb}")
endif()
run_cli(tec library search --db "${db}" genre:techno)
string(REGEX MATCHALL "key=" tecn "${tec}")
list(LENGTH tecn tecc)
if(NOT tecc EQUAL 1 OR amb STREQUAL tec)
  message(FATAL_ERROR "T85 genre: genre:techno found ${tecc} songs or the same as ambient\n${tec}")
endif()
run_cli(ele library search --db "${db}" genre:electronic)
string(REGEX MATCHALL "key=" elen "${ele}")
list(LENGTH elen elec)
if(NOT elec EQUAL 2)
  message(FATAL_ERROR "T85 genre: genre:electronic found ${elec} songs, want 2\n${ele}")
endif()

# ---- run 2: the cache answers, only the 503 song asks again
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
run_cli(r2 library genre --db "${db}")
expect_counter("${r2}" genre_cache_hits 3)
expect_counter("${r2}" genre_lookups 1)
expect_counter("${r2}" songdb_cache_hits 3)
expect_counter("${r2}" songdb_lookups 1)
genre_requests(n2)
if(NOT n2 EQUAL 1)
  message(FATAL_ERROR "T85 genre: run 2 sent ${n2} /api/genre requests, want 1 (the 503 song)")
endif()
genre_requests(s2 "^/api/songdb/")
if(NOT s2 EQUAL 1)
  message(FATAL_ERROR "T85 genre: run 2 sent ${s2} /api/songdb requests, want 1 (the 503 song)")
endif()
run_cli(amb2 library search --db "${db}" genre:ambient)
if(NOT amb2 STREQUAL amb)
  message(FATAL_ERROR "T85 genre: search after run 2 differs\n${amb2}")
endif()
message(STATUS "devilbox_genre_ok run1_lookups=4 run2_lookups=1 run2_cache_hits=3 songdb_lookups=4/1 composer_rows=3")
