# T75 cache-fetch (rows I165, I166): `selecta-cli script tests/m3/fetch.sel` over fixture mirrors.
# -DCAT=<catalogue tsv; LIBRARY_FETCH runs on cfg.library, I166a> -DCLI=<selecta-cli>-DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures> -DM3=<tests/m3>
# bad.mirror.test serves a song.mod whose md5 differs from the catalogue's; fast.mirror.test serves
# the right one and a TFMX song with its smpl.* companion.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "fixture.test=${fx},fast.mirror.test=${fx},bad.mirror.test=${fx}")
unset(ENV{SELECTA_MIRROR})
set(mods "/mods/")
set(rel "Protracker/test/song.mod")
file(MD5 "${FIXDIR}/fast.mirror.test/mods/${rel}" want_md5)
file(SIZE "${FIXDIR}/fast.mirror.test/mods/${rel}" want_size)

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "T75 ${what}: got '${got}', want '${want}'\n${last_raw}")
  endif()
endfunction()

function(counter var key)
  if(last_raw MATCHES "(^|\n)${key}=([^\n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

function(hits var host path)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t75-log.json"
    OUTPUT_VARIABLE o RESULT_VARIABLE rc)
  file(READ "${WORK}/t75-log.json" logjson)
  string(JSON n LENGTH "${logjson}")
  set(count 0)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON h GET "${logjson}" ${i} host)
      string(JSON p GET "${logjson}" ${i} path)
      if(h STREQUAL "${host}" AND p STREQUAL "${path}")
        math(EXPR count "${count} + 1")
      endif()
    endforeach()
  endif()
  set(${var} "${count}" PARENT_SCOPE)
endfunction()

function(reset_log)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST
    OUTPUT_VARIABLE o RESULT_VARIABLE rc)
endfunction()

# run_script(<script>): fresh cache dir, output in last_raw.
function(run_script script cache)
  file(REMOVE_RECURSE "${cache}")
  set(ENV{SELECTA_CACHE_DIR} "${cache}")
  execute_process(COMMAND "${CLI}" script "${script}" --catalogue "${CAT}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  set(last_raw "${o}${e}" PARENT_SCOPE)
endfunction()

# 1. Bad mirror first, fast second: the md5 mismatch is rejected, the next mirror serves.
set(ENV{SELECTA_MIRRORS_MODLAND} "http://bad.mirror.test${mods},http://fast.mirror.test${mods}")
set(cache "${WORK}/t75-cache")
reset_log()
run_script("${M3}/fetch.sel" "${cache}")
expect("file in cache" "${cache}/files/modland/${rel}" "${cache}/files/modland/${rel}")
if(NOT EXISTS "${cache}/files/modland/${rel}")
  message(FATAL_ERROR "T75 cache file missing: ${cache}/files/modland/${rel}\n${last_raw}")
endif()
file(MD5 "${cache}/files/modland/${rel}" got_md5)
expect("cached md5" "${got_md5}" "${want_md5}")
file(SIZE "${cache}/files/modland/${rel}" got_size)
expect("cached size" "${got_size}" "${want_size}")
if(EXISTS "${cache}/files/modland/${rel}.part")
  message(FATAL_ERROR "T75 .part file left behind\n${last_raw}")
endif()
counter(md5_mismatches md5_mismatches)
if(md5_mismatches STREQUAL "" OR md5_mismatches LESS 1)
  message(FATAL_ERROR "T75 no md5 mismatch counted: ${last_raw}")
endif()
hits(bad_hits bad.mirror.test "/mods/${rel}")
expect("bad mirror was tried" "${bad_hits}" 1)
hits(fast_hits fast.mirror.test "/mods/${rel}")
expect("fast mirror served the song once" "${fast_hits}" 1)
counter(cache_hits cache_hits)
expect("second fetch is a cache hit" "${cache_hits}" 1)
counter(fetches fetches)
expect("fetches (song, mdat, smpl)" "${fetches}" 3)
counter(companions companions)
expect("companions" "${companions}" 1)
if(NOT EXISTS "${cache}/files/modland/TFMX/test/mdat.song" OR NOT EXISTS "${cache}/files/modland/TFMX/test/smpl.song")
  message(FATAL_ERROR "T75 TFMX song or companion missing in the cache\n${last_raw}")
endif()
hits(smpl_hits fast.mirror.test "/mods/TFMX/test/smpl.song")
expect("companion requested once" "${smpl_hits}" 1)

# 2. The second fetch of the song made no request: still exactly one on the fast mirror (above),
# and a fresh process over the filled cache makes none at all.
reset_log()
set(ENV{SELECTA_CACHE_DIR} "${cache}")
execute_process(COMMAND "${CLI}" script "${M3}/fetch.sel" --catalogue "${CAT}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(last_raw "${o}${e}")
counter(hits3 cache_hits)
expect("warm cache hits (3 fetches + 2 repeats)" "${hits3}" 4)
counter(fetches3 fetches)
expect("warm cache fetches" "${fetches3}" 0)
counter(tries3 mirror_tries)
expect("warm cache transport tries" "${tries3}" 0)
hits(warm_fast fast.mirror.test "/mods/${rel}")
hits(warm_bad bad.mirror.test "/mods/${rel}")
expect("warm cache requests" "${warm_fast}${warm_bad}" "00")

# 3. Every mirror wrong: ERROR md5_mismatch, nothing cached.
set(ENV{SELECTA_MIRRORS_MODLAND} "http://bad.mirror.test${mods}")
set(cache2 "${WORK}/t75-cache2")
run_script("${M3}/fetch_md5.sel" "${cache2}")
if(NOT last_raw MATCHES "md5_mismatch")
  message(FATAL_ERROR "T75 no md5_mismatch error: ${last_raw}")
endif()
if(EXISTS "${cache2}/files/modland/${rel}" OR EXISTS "${cache2}/files/modland/${rel}.part")
  message(FATAL_ERROR "T75 rejected body was cached\n${last_raw}")
endif()

# 4. I695a: a song in a subfolder the mirror does not serve fails and leaves no empty folder (sndh Dubmood/DMA shape).
set(ENV{SELECTA_MIRRORS_MODLAND} "http://fast.mirror.test${mods}")
set(cache4 "${WORK}/t75-cache4")
run_script("${M3}/fetch_missing_nested.sel" "${cache4}")
if(NOT last_raw MATCHES "ERROR")
  message(FATAL_ERROR "T75 missing nested song did not fail: ${last_raw}")
endif()
if(EXISTS "${cache4}/files/modland/Protracker/nodir")
  message(FATAL_ERROR "T75 failed fetch left an empty folder: ${cache4}/files/modland/Protracker/nodir\n${last_raw}")
endif()
