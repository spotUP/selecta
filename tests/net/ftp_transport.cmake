# T70 ftp-transport (row I155, D-M3-5): passive FTP through `selecta-cli fetch ftp://`.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures>
# ftp.modland.com is mapped to the fixture FTP listener; the data connection goes to the
# address of the PASV reply (127.0.0.1), which the net guard allows.
file(READ "${WORK}/ftp_port" ftp_port)
string(STRIP "${ftp_port}" ftp_port)
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "ftp.modland.com=http://127.0.0.1:${ftp_port},fixture.test=http://127.0.0.1:${port}")
set(file_name "changelog_2026-10-22.txt")
set(src "${FIXDIR}/ftp.modland.com/${file_name}")
file(SHA256 "${src}" want_sha)
file(SIZE "${src}" want_size)
set(out "${WORK}/t70.bin")
file(REMOVE "${out}")

function(run prefix)
  execute_process(COMMAND "${CLI}" fetch ${ARGN} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  set(${prefix}_rc "${rc}" PARENT_SCOPE)
  set(${prefix}_raw "${o}${e}" PARENT_SCOPE)
  foreach(k ftp_error ftp_retr ftp_size ftp_passive body_bytes net_blocked)
    if(o MATCHES "(^|\n)${k}=([^\n]*)")
      set(${prefix}_${k} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    else()
      set(${prefix}_${k} "" PARENT_SCOPE)
    endif()
  endforeach()
endfunction()

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "T70 ${what}: got '${got}', want '${want}'")
  endif()
endfunction()

run(ok ftp://ftp.modland.com/${file_name} --out "${out}")
expect("exit code" "${ok_rc}" 0)
expect("error" "${ok_ftp_error}" ok)
expect("ftp_retr" "${ok_ftp_retr}" 1)
expect("passive" "${ok_ftp_passive}" 1)
expect("SIZE matches the file" "${ok_ftp_size}" "${want_size}")
expect("body bytes" "${ok_body_bytes}" "${want_size}")
file(SHA256 "${out}" got_sha)
expect("body sha256" "${got_sha}" "${want_sha}")

# A missing file is a clean failure with no RETR counted as success.
run(miss ftp://ftp.modland.com/pub/modules/none.xm)
expect("missing file error" "${miss_ftp_error}" no_such_file)
expect("missing file retr" "${miss_ftp_retr}" 0)

# The server saw the command sequence of D-M3-5: USER anonymous, TYPE I, SIZE, PASV, RETR.
run(log http://fixture.test/__fixture/log --out "${WORK}/t70_log.json")
file(READ "${WORK}/t70_log.json" logjson)
string(JSON n LENGTH "${logjson}")
set(seen "")
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  string(JSON m GET "${logjson}" ${i} method)
  if(m MATCHES "^FTP ")
    string(JSON p GET "${logjson}" ${i} path)
    string(APPEND seen "${m} ${p};")
  endif()
endforeach()
foreach(want "FTP USER anonymous" "FTP TYPE I" "FTP SIZE /${file_name}" "FTP PASV " "FTP RETR /${file_name}")
  if(NOT seen MATCHES "${want};")
    message(FATAL_ERROR "T70 server log lacks '${want}': ${seen}")
  endif()
endforeach()
