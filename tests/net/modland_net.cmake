# T72 network part (row I161a): `selecta-cli library sync modland <url>` over the sync.modland.test fixture.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures> -DM3=<tests/m3>
# The server holds allmods.zip (allmods.txt, 100 rows, "<size><TAB><path>") and two changelogs inside the 14 day
# window; the other 12 days answer 404. Expected numbers are counted from the fixture sources here.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "sync.modland.test=${fx},fixture.test=${fx}")
set(cache "${WORK}/t72n-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/t72n.db")
file(REMOVE "${db}")
set(now 1792756800) # 2026-10-23 12:00:00 UTC
set(days 14)

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "T72 net ${what}: got '${got}', want '${want}'\n${raw}")
  endif()
endfunction()

function(counter var key)
  if(raw MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Expected values from the fixture sources.
file(STRINGS "${M3}/modland_listing/allmods_md5.txt" listing_lines)
list(LENGTH listing_lines want_rows)
set(want_added 0)
set(want_deleted 0)
set(want_fetched 0)
file(GLOB changelogs "${FIXDIR}/sync.modland.test/pub/changelogs/changelog_*.txt")
foreach(f IN LISTS changelogs)
  file(READ "${f}" body)
  string(REGEX MATCHALL "(^|\n)[ \t]*added:" hits "${body}")
  list(LENGTH hits n)
  math(EXPR want_added "${want_added} + ${n}")
  string(REGEX MATCHALL "(^|\n)[ \t]*deleted:" dels "${body}")
  list(LENGTH dels nd)
  math(EXPR want_deleted "${want_deleted} + ${nd}")
  math(EXPR want_fetched "${want_fetched} + 1")
endforeach()
math(EXPR want_missing "${days} - ${want_fetched}")
if(want_rows LESS 1 OR want_added LESS 1 OR want_fetched LESS 1)
  message(FATAL_ERROR "T72 net: fixture is empty (rows=${want_rows} added=${want_added} changelogs=${want_fetched})")
endif()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now ${now} modland http://sync.modland.test
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("exit code" "${rc}" 0)
counter(v listing_rows)
expect("listing_rows" "${v}" "${want_rows}")
counter(v new_this_week)
expect("new_this_week" "${v}" "${want_added}")
counter(v changelogs)
expect("changelogs applied" "${v}" "${want_fetched}")
counter(v cl_added)
expect("cl_added" "${v}" "${want_added}")
counter(v net_changelogs_fetched)
expect("net_changelogs_fetched (sentinel: network path ran)" "${v}" "${want_fetched}")
counter(v net_changelogs_missing)
expect("net_changelogs_missing" "${v}" "${want_missing}")
counter(v net_zip_bytes)
if(v STREQUAL "" OR v LESS 1)
  message(FATAL_ERROR "T72 net: no zip downloaded\n${raw}")
endif()
file(SIZE "${FIXDIR}/sync.modland.test/allmods.zip" zip_size)
expect("net_zip_bytes" "${v}" "${zip_size}")
counter(v db_songs)
math(EXPR want_songs "${want_rows} + ${want_added} - ${want_deleted}")
expect("db_songs (listing plus added minus deleted)" "${v}" "${want_songs}")

# The server saw the zip once and one request per window day.
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t72n-log.json"
  OUTPUT_VARIABLE o RESULT_VARIABLE rc)
file(READ "${WORK}/t72n-log.json" logjson)
string(JSON n LENGTH "${logjson}")
set(zip_hits 0)
set(cl_hits 0)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  string(JSON h GET "${logjson}" ${i} host)
  string(JSON p GET "${logjson}" ${i} path)
  if(h STREQUAL "sync.modland.test" AND p STREQUAL "/allmods.zip")
    math(EXPR zip_hits "${zip_hits} + 1")
  elseif(h STREQUAL "sync.modland.test" AND p MATCHES "^/pub/changelogs/changelog_[0-9-]+\\.txt$")
    math(EXPR cl_hits "${cl_hits} + 1")
  endif()
endforeach()
expect("allmods.zip requests" "${zip_hits}" 1)
expect("changelog requests" "${cl_hits}" "${days}")

# Persistence: a fresh process reads new_this_week back from the DB meta table.
execute_process(COMMAND "${CLI}" library meta --db "${db}" modland.new_this_week
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("meta exit code" "${rc}" 0)
expect("persisted new_this_week" "${raw}" "meta.modland.new_this_week=${want_added}\n")

# A server without the zip fails the sync and leaves the stored count alone.
set(ENV{SELECTA_NET_MAP} "sync.modland.test=${fx},fixture.test=${fx},nozip.modland.test=${fx}")
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now ${now} modland http://nozip.modland.test
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
if(rc EQUAL 0)
  message(FATAL_ERROR "T72 net: sync against a server without allmods.zip must fail\n${raw}")
endif()
execute_process(COMMAND "${CLI}" library meta --db "${db}" modland.new_this_week OUTPUT_VARIABLE o)
expect("count kept after failed sync" "${o}" "meta.modland.new_this_week=${want_added}\n")

message(STATUS "modland_net_ok listing_rows=${want_rows} new_this_week=${want_added}")
