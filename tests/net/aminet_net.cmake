# Row I405: `selecta-cli library sync aminet <url>` over the aminet.net fixture (a real 14-line cut of /INDEX plus the real
# mods/4mat/AnarchyMenu10.lha, see fixtures/PROVENANCE.md), then ONE reachability step: the same entry point plays the
# archived module. The sync runs through the engine entry point LIBRARY_SYNC; the sentinels are listing_rows and
# skipped_rows (the parser ran over the fetched INDEX) and net_requests (the network path ran); the play step opens
# aminet:mods/4mat/AnarchyMenu10.lha through the script entry and @archive_stats shows the engine unpacked the
# member AnarchyMenu10.mod from the LHA archive. Expected numbers are counted from the fixture here.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "aminet.net=${fx},fixture.test=${fx}")
set(ENV{SELECTA_MIRRORS_AMINET} "http://aminet.net/")
unset(ENV{SELECTA_MIRROR})
set(cache "${WORK}/i405-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/i405.db")
file(REMOVE "${db}")
set(index_file "${FIXDIR}/aminet.net/INDEX")

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "I405 net ${what}: got '${got}', want '${want}'\n${raw}")
  endif()
endfunction()

function(counter var key)
  if(raw MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Expected values from the fixture: data lines are the non-header lines; kept rows are archives under mods/.
file(STRINGS "${index_file}" lines)
set(want_rows 0)
set(want_skipped 0)
foreach(l IN LISTS lines)
  if(l MATCHES "^\\|")
    continue()
  endif()
  if(l MATCHES "^[^ ]+\\.(lha|lzh|zip) +mods/")
    math(EXPR want_rows "${want_rows} + 1")
  else()
    math(EXPR want_skipped "${want_skipped} + 1")
  endif()
endforeach()
file(SIZE "${index_file}" index_size)
if(want_rows LESS 1 OR want_skipped LESS 1)
  message(FATAL_ERROR "I405 net: fixture has rows=${want_rows} skipped=${want_skipped}")
endif()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now 1792756800 --dump aminet http://aminet.net
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("exit code" "${rc}" 0)
counter(v listing_rows)
expect("listing_rows (sentinel: aminet parser ran)" "${v}" "${want_rows}")
counter(v db_songs)
expect("db_songs" "${v}" "${want_rows}")
counter(v skipped_rows)
expect("skipped_rows" "${v}" "${want_skipped}")
counter(v net_requests)
expect("net_requests (sentinel: aminet network path ran)" "${v}" 1)
counter(v net_listing_bytes)
expect("net_listing_bytes" "${v}" "${index_size}")
if(NOT raw MATCHES "aminet_row=mods/4mat/AnarchyMenu10.lha\\|Aminet module\\|4mat\\|AnarchyMenu10\\|5120\\|https://aminet.net/mods/4mat/AnarchyMenu10.lha")
  message(FATAL_ERROR "I405 net: AnarchyMenu10 row missing or wrong\n${raw}")
endif()
if(raw MATCHES "aminet_row=(biz|mus|util)/" OR raw MATCHES "LN4Lev1")
  message(FATAL_ERROR "I405 net: a row outside the module archives was kept\n${raw}")
endif()

# ---- Reachability: play one archived module through the script entry point. The engine downloads the LHA archive
# from the (mapped) site, finds no replayer for it, unpacks the first member a replayer takes and plays that.
file(WRITE "${WORK}/i405-open.sel" "OPEN aminet:mods/4mat/AnarchyMenu10.lha\n@archive_stats\n@library_stats\n")
execute_process(COMMAND "${CLI}" script "${WORK}/i405-open.sel" --db "${db}" OUTPUT_VARIABLE o2 ERROR_VARIABLE e2 RESULT_VARIABLE rc2)
set(raw "${o2}${e2}")
expect("play exit code" "${rc2}" 0)
if(raw MATCHES "ERROR")
  message(FATAL_ERROR "I405 net: play script reported an error\n${raw}")
endif()
if(NOT raw MATCHES "ARCHIVE unpacks=1 member=AnarchyMenu10.mod")
  message(FATAL_ERROR "I405 net: the engine did not unpack AnarchyMenu10.mod from the archive (sentinel)\n${raw}")
endif()
counter(v songs_opened)
expect("songs_opened" "${v}" 1)
message(STATUS "aminet_net_ok rows=${want_rows} skipped=${want_skipped}")
