# I894a1: UPnP MediaServer discovery against the python fixture (unicast SSDP to 127.0.0.1, HTTP description).
#  -DTEST=<upnp_discover_test> -DWORK=<scratch dir> -DSRV=<upnp_server.py>
# Asserts: exactly 1 server although the fixture answers twice; friendlyName with its entity decoded; the relative
# controlURL resolved against LOCATION; the ContentDirectory (not the ConnectionManager) control path; the USN; and that
# the fixture saw one M-SEARCH for MediaServer:1 and one description GET (the code ran, no cached answer).
set(PORT "${WORK}/upnp-port")
file(REMOVE "${PORT}" "${PORT}.requests")
execute_process(COMMAND sh -c "python3 -I '${SRV}' '${PORT}' 30 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${PORT}")
    file(READ "${PORT}" sp)
    if(NOT sp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${sp}" sp)
if(NOT sp MATCHES "^([0-9]+) ([0-9]+)$")
  message(FATAL_ERROR "I894a1: fixture did not start (${sp})")
endif()
set(UDP "${CMAKE_MATCH_1}")
set(HTTP "${CMAKE_MATCH_2}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
execute_process(COMMAND "${TEST}" 127.0.0.1 ${UDP} OUTPUT_VARIABLE so ERROR_VARIABLE se RESULT_VARIABLE rc TIMEOUT 30)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "I894a1: discover failed rc=${rc}\n${so}${se}")
endif()
if(NOT so MATCHES "upnp_found=1\n")
  message(FATAL_ERROR "I894a1: want exactly 1 server\n${so}")
endif()
if(NOT so MATCHES "upnp_name=Fixture Media & Music\n")
  message(FATAL_ERROR "I894a1: friendlyName wrong\n${so}")
endif()
if(NOT so MATCHES "upnp_control=http://127.0.0.1:${HTTP}/upnp/cd/control\n")
  message(FATAL_ERROR "I894a1: controlURL wrong\n${so}")
endif()
if(NOT so MATCHES "upnp_usn=uuid:fixture-0001::urn:schemas-upnp-org:device:MediaServer:1\n")
  message(FATAL_ERROR "I894a1: USN wrong\n${so}")
endif()
file(READ "${PORT}.requests" rq)
string(REGEX MATCHALL "ssdp_search=urn:schemas-upnp-org:device:MediaServer:1" s_all "${rq}")
string(REGEX MATCHALL "desc_get=/desc.xml" d_all "${rq}")
list(LENGTH s_all ns)
list(LENGTH d_all nd)
if(NOT ns EQUAL 1 OR NOT nd EQUAL 1)
  message(FATAL_ERROR "I894a1: want 1 M-SEARCH and 1 description GET, got ${ns} and ${nd}\n${rq}")
endif()
message(STATUS "upnp_discover_ok")
