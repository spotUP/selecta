# T73 network part (row I162a): `selecta-cli library sync hvsc <url>` over the hvsc.c64.org fixture.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures>
# The server holds Songlengths.md5 and STIL.txt excerpts under /download/C64Music/DOCUMENTS/ (real HVSC layout);
# the listing is derived from the `; /PATH` lines. Expected numbers are counted from the fixture sources here.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "hvsc.c64.org=${fx},fixture.test=${fx}")
set(cache "${WORK}/t73n-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/t73n.db")
file(REMOVE "${db}")
set(docs "${FIXDIR}/hvsc.c64.org/download/C64Music/DOCUMENTS")

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "T73 net ${what}: got '${got}', want '${want}'\n${raw}")
  endif()
endfunction()

function(counter var key)
  if(raw MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Expected values from the fixture sources.
file(STRINGS "${docs}/Songlengths.md5" sl_lines)
set(want_rows 0)
set(want_lengths 0)
set(want_subtunes 0)
foreach(l IN LISTS sl_lines)
  if(l MATCHES "^; /(MUSICIANS|GAMES|DEMOS)/")
    math(EXPR want_rows "${want_rows} + 1")
  elseif(l MATCHES "^[0-9a-f]+=(.*)$")
    math(EXPR want_lengths "${want_lengths} + 1")
    string(REGEX MATCHALL "[0-9]+:[0-9]+" times "${CMAKE_MATCH_1}")
    list(LENGTH times nt)
    math(EXPR want_subtunes "${want_subtunes} + ${nt}")
  endif()
endforeach()
file(STRINGS "${docs}/STIL.txt" stil_lines)
set(want_stil 0)
foreach(l IN LISTS stil_lines)
  if(l MATCHES "^/")
    math(EXPR want_stil "${want_stil} + 1")
  endif()
endforeach()
file(SIZE "${docs}/Songlengths.md5" sl_size)
file(SIZE "${docs}/STIL.txt" stil_size)
if(want_rows LESS 1 OR want_lengths LESS 1 OR want_stil LESS 1)
  message(FATAL_ERROR "T73 net: fixture is empty (rows=${want_rows} lengths=${want_lengths} stil=${want_stil})")
endif()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now 1792756800 --dump hvsc http://hvsc.c64.org/download
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("exit code" "${rc}" 0)
counter(v listing_rows)
expect("listing_rows" "${v}" "${want_rows}")
counter(v songlengths)
expect("songlengths" "${v}" "${want_lengths}")
counter(v subtunes)
expect("subtunes" "${v}" "${want_subtunes}")
counter(v stil_entries)
expect("stil_entries" "${v}" "${want_stil}")
counter(v db_songs)
expect("db_songs" "${v}" "${want_rows}")
# Sentinel: the network path ran (two GETs, byte counts equal the fixture files, listing derived from Songlengths).
counter(v net_requests)
expect("net_requests (sentinel: network path ran)" "${v}" 2)
counter(v net_songlengths_bytes)
expect("net_songlengths_bytes" "${v}" "${sl_size}")
counter(v net_stil_bytes)
expect("net_stil_bytes" "${v}" "${stil_size}")
counter(v net_listing_derived)
expect("net_listing_derived" "${v}" "${want_rows}")
# First entry of the excerpt: 10_Orbyte.sid is 1:17 = 77000 ms with the md5 from the file.
if(NOT raw MATCHES "hvsc_row=DEMOS/0-9/10_Orbyte.sid\\|[^|]*\\|5f08a730b280e54fd1e75a7046b93fdc\\|77000\\|1\\|77000\\|")
  message(FATAL_ERROR "T73 net: 10_Orbyte.sid row missing or wrong\n${raw}")
endif()
# 12th_Sector_Music.sid 4:33.108 = 273108 ms (millisecond field survives the HTTP path).
if(NOT raw MATCHES "hvsc_row=DEMOS/0-9/12th_Sector_Music.sid\\|[^|]*\\|[0-9a-f]+\\|273108\\|")
  message(FATAL_ERROR "T73 net: 12th_Sector_Music.sid row missing or wrong\n${raw}")
endif()
message(STATUS "hvsc_net_ok rows=${want_rows} lengths=${want_lengths} stil=${want_stil}")
