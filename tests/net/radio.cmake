function(run_script out)
  execute_process(COMMAND "${CLI}" script "${WORK}/t88-radio.sel" --db "${db}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0 OR o MATCHES "ERROR" OR e MATCHES "ERROR")
    message(FATAL_ERROR "T88 radio: script failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}" PARENT_SCOPE)
endfunction()

run_script(r1)
run_script(r2)
# the driver itself, not the code under test, lists what the radio may append
string(REGEX MATCHALL "RADIO radio_appends=[0-9]+ min_ahead=[0-9]+" stats "${r1}")
list(LENGTH stats nstats)
if(NOT nstats EQUAL 2)
  message(FATAL_ERROR "T88 radio: want two RADIO lines, got ${nstats}\n${r1}")
endif()
list(GET stats 1 last)
string(REGEX MATCH "radio_appends=([0-9]+) min_ahead=([0-9]+)" m "${last}")
set(appends ${CMAKE_MATCH_1})
set(min_ahead ${CMAKE_MATCH_2})
if(appends LESS 20)
  message(FATAL_ERROR "T88 radio: radio_appends=${appends}, want at least 20\n${r1}")
endif()
if(min_ahead LESS 5)
  message(FATAL_ERROR "T88 radio: queue fell to ${min_ahead} songs ahead, want at least 5\n${r1}")
endif()
string(FIND "${r1}" "${last}" _x REVERSE)
string(SUBSTRING "${r1}" ${_x} -1 tail)
string(REGEX MATCHALL "queue=[^\n]*" rows "${tail}")
set(seq "")
foreach(row IN LISTS rows)
  string(REGEX REPLACE "^queue=" "" p "${row}")
  string(REGEX REPLACE "^.*/" "" base "${p}")
  list(APPEND seq "${base}")
endforeach()
list(LENGTH seq n)
if(n LESS 25)
  message(FATAL_ERROR "T88 radio: queue holds ${n} rows, want at least 25\n${r1}")
endif()
list(GET seq 0 first)
if(NOT first STREQUAL "ambient.mod")
  message(FATAL_ERROR "T88 radio: first row ${first} is not the seed")
endif()
list(REMOVE_AT seq 0)
foreach(b IN LISTS seq)
  if(NOT b STREQUAL "nogenre.mod" AND NOT b STREQUAL "techno.mod")
    message(FATAL_ERROR "T88 radio: appended ${b}: not genre/composer/rating>=4, or skip-flagged\n${r1}")
  endif()
endforeach()
if(NOT r1 STREQUAL r2)
  message(FATAL_ERROR "T88 radio: the same seed gave two sequences\n--- first\n${r1}--- second\n${r2}")
endif()
message(STATUS "radio_ok radio_appends=${appends} min_ahead=${min_ahead}")
