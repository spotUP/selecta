function(run_cli out)
  execute_process(COMMAND "${CLI}" ${ARGN} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T88 similar: selecta-cli ${ARGN} failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}${e}" PARENT_SCOPE)
endfunction()

function(sql out stmt)
  execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=1" "${db}" "${stmt}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T88 similar: sqlite3 '${stmt}' failed rc=${rc}\n${o}${e}")
  endif()
  string(STRIP "${o}" o)
  set(${out} "${o}" PARENT_SCOPE)
endfunction()

function(key_of var file)
  sql(k "SELECT key FROM songs WHERE path LIKE '%/${file}'")
  if(k STREQUAL "")
    message(FATAL_ERROR "T88 similar: no song row for ${file}")
  endif()
  set(${var} "${k}" PARENT_SCOPE)
endfunction()

function(expect_counter text name want)
  if(NOT text MATCHES "${name}=([0-9]+)")
    message(FATAL_ERROR "T88 similar: counter ${name}= missing\n${text}")
  endif()
  if(NOT CMAKE_MATCH_1 EQUAL want)
    message(FATAL_ERROR "T88 similar: ${name}=${CMAKE_MATCH_1}, want ${want}\n${text}")
  endif()
endfunction()

# The rows of a CLI answer without their keys (keys depend on the checkout path): "name|genre|rating|match".
function(rows_without_keys var text)
  set(out "")
  string(REPLACE "\n" ";" lines "${text}")
  foreach(l IN LISTS lines)
    if(l MATCHES "^row=[^|]*\\|(.*)$")
      string(APPEND out "${CMAKE_MATCH_1}\n")
    endif()
  endforeach()
  set(${var} "${out}" PARENT_SCOPE)
endfunction()

