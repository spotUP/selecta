# Row I413: `selecta-cli library sync asma <url>` over the asma.atari.org fixture (a real excerpt of
# /asmadb/asmadb.js, see fixtures/PROVENANCE.md). Reachability test of the asma source: the sync runs through
# the engine entry point LIBRARY_SYNC. Expected numbers are counted from the fixture file here.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "asma.atari.org=${fx},fixture.test=${fx}")
set(cache "${WORK}/i413-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/i413.db")
file(REMOVE "${db}")
set(list_file "${FIXDIR}/asma.atari.org/asmadb/asmadb.js")

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "I413 net ${what}: got '${got}', want '${want}'\n${raw}")
  endif()
endfunction()

function(counter var key)
  if(raw MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Expected values from the fixture: one song per "filePath" key.
file(READ "${list_file}" list_text)
string(REGEX MATCHALL "\"filePath\"" paths "${list_text}")
list(LENGTH paths want_rows)
file(SIZE "${list_file}" list_size)
if(want_rows LESS 1)
  message(FATAL_ERROR "I413 net: fixture is empty")
endif()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now 1792756800 --dump asma http://asma.atari.org
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("exit code" "${rc}" 0)
counter(v listing_rows)
expect("listing_rows" "${v}" "${want_rows}")
counter(v db_songs)
expect("db_songs" "${v}" "${want_rows}")
counter(v skipped_rows)
expect("skipped_rows" "${v}" 0)
# Sentinel: the asma network path ran (one GET, byte count equals the fixture file).
counter(v net_requests)
expect("net_requests (sentinel: asma network path ran)" "${v}" 1)
counter(v net_listing_bytes)
expect("net_listing_bytes" "${v}" "${list_size}")
if(NOT raw MATCHES "asma_row=Composers/Aki/Atari_Style.sap\\|Slight Atari Player\\|Aki\\|\\[pong\\] Atari Style\\|[0-9]+\\|https://asma.atari.org/asma/Composers/Aki/Atari_Style.sap")
  message(FATAL_ERROR "I413 net: Atari_Style.sap row missing or wrong\n${raw}")
endif()
if(NOT raw MATCHES "asma_row=Composers/Bernard_Jeremie/Altazar.ttt\\|TIATracker\\|Glafouk\\|[^|]*\\|90996\\|")
  message(FATAL_ERROR "I413 net: Altazar.ttt row missing or wrong\n${raw}")
endif()
if(NOT raw MATCHES "asma_row=Games/221B_Baker_Street.sap\\|Slight Atari Player\\|- unknown\\|[^|]*\\|1969\\|")
  message(FATAL_ERROR "I413 net: 221B_Baker_Street.sap row missing or wrong\n${raw}")
endif()
message(STATUS "asma_net_ok rows=${want_rows}")
