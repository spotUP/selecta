# I550: the Modland index sync on the Amiga route (design D9) goes through the DEViLBOX mirror proxy.
# -DCLI -DWORK -DFIXDIR -DM3 as modland_net.cmake. SELECTA_AMIGA_ROUTE=1 is the host switch for the SEL_NO_TLS path.
# Server contract: GET <devilbox>/api/mirror/modland/allmods.zip (200, the zip) and
# GET <devilbox>/api/mirror/modland/pub/changelogs/changelog_YYYY-MM-DD.txt (200, or 404 when absent).
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "sync.modland.test=${fx},devilbox.sync.test=${fx},fixture.test=${fx}")
set(ENV{SELECTA_DEVILBOX_URL} "http://devilbox.sync.test")
set(ENV{SELECTA_AMIGA_ROUTE} "1")
set(cache "${WORK}/t72a-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/t72a.db")
file(REMOVE "${db}")

file(STRINGS "${M3}/modland_listing/allmods_md5.txt" listing_lines)
list(LENGTH listing_lines want_rows)
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now 1792756800 modland http://sync.modland.test
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "T72 amiga: sync exit ${rc}\n${raw}")
endif()
if(NOT raw MATCHES "listing_rows=([0-9]+)" OR CMAKE_MATCH_1 LESS 1 OR NOT CMAKE_MATCH_1 EQUAL want_rows)
  message(FATAL_ERROR "T72 amiga: listing_rows want ${want_rows}\n${raw}")
endif()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t72a-log.json"
  RESULT_VARIABLE lrc)
file(READ "${WORK}/t72a-log.json" logjson)
string(JSON n LENGTH "${logjson}")
set(zip_hits 0)
set(cl_hits 0)
set(direct_hits 0)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  string(JSON h GET "${logjson}" ${i} host)
  string(JSON p GET "${logjson}" ${i} path)
  if(h STREQUAL "devilbox.sync.test" AND p STREQUAL "/api/mirror/modland/allmods.zip")
    math(EXPR zip_hits "${zip_hits} + 1")
  elseif(h STREQUAL "devilbox.sync.test" AND p MATCHES "^/api/mirror/modland/pub/changelogs/changelog_[0-9-]+\\.txt$")
    math(EXPR cl_hits "${cl_hits} + 1")
  elseif(h STREQUAL "sync.modland.test")
    math(EXPR direct_hits "${direct_hits} + 1")
  endif()
endforeach()
if(NOT zip_hits EQUAL 1 OR NOT cl_hits EQUAL 14 OR NOT direct_hits EQUAL 0)
  message(FATAL_ERROR "T72 amiga: zip=${zip_hits} (want 1) changelogs=${cl_hits} (want 14) direct=${direct_hits} (want 0)\n${logjson}")
endif()
message(STATUS "modland_amiga_route_ok rows=${want_rows}")
