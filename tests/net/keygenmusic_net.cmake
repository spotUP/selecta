# Row I416: `selecta-cli library sync keygenmusic <url>` over the keygenmusic.tk fixture (9 real objects of the site's
# lib.txt, see fixtures/PROVENANCE.md). Reachability test of the keygenmusic source: the sync runs through the engine
# entry point LIBRARY_SYNC and asks the site for one file. Expected numbers are counted from the fixture here.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "keygenmusic.tk=${fx},fixture.test=${fx}")
set(cache "${WORK}/i416-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
set(db "${WORK}/i416.db")
file(REMOVE "${db}")
set(lib "${FIXDIR}/keygenmusic.tk/kgm/lib.txt")

function(expect what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "I416 net ${what}: got '${got}', want '${want}'\n${raw}")
  endif()
endfunction()

function(counter var key)
  if(raw MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Expected values from the fixture: one song per object, bytes of the one file.
file(READ "${lib}" text)
string(REGEX MATCHALL "\"path\":" songs "${text}")
list(LENGTH songs want_rows)
file(SIZE "${lib}" want_bytes)
if(want_rows LESS 1)
  message(FATAL_ERROR "I416 net: fixture is empty")
endif()

execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
execute_process(COMMAND "${CLI}" library sync --db "${db}" --now 1792756800 --dump keygenmusic http://keygenmusic.tk
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
expect("exit code" "${rc}" 0)
counter(v listing_rows)
expect("listing_rows" "${v}" "${want_rows}")
counter(v db_songs)
expect("db_songs" "${v}" "${want_rows}")
counter(v skipped_rows)
expect("skipped_rows" "${v}" 0)
# Sentinel: the keygenmusic network path ran: exactly one request, for the whole list.
counter(v net_requests)
expect("net_requests (sentinel: keygenmusic network path ran)" "${v}" 1)
counter(v net_listing_bytes)
expect("net_listing_bytes" "${v}" "${want_bytes}")
# Escaped paths are stored decoded and the url encodes them again; format from the extension, artist the group.
if(NOT raw MATCHES "keygenmusic_row=!Others/Lazzy - CrackMe#1\\.xm\\|Fasttracker 2\\|Lazzy\\|CrackMe#1\\|0\\|https://keygenmusic\\.tk/kgm/%21Others/Lazzy%20-%20CrackMe%231\\.xm")
  message(FATAL_ERROR "I416 net: escaped-path row missing or wrong\n${raw}")
endif()
if(NOT raw MATCHES "keygenmusic_row=!Others/DOT\\.EXE - Alcohol 120% 1\\.9\\.5\\.4327 crk\\.xm\\|Fasttracker 2\\|DOT\\.EXE\\|Alcohol 120% 1\\.9\\.5\\.4327 crk\\|")
  message(FATAL_ERROR "I416 net: percent row missing or wrong\n${raw}")
endif()
if(NOT raw MATCHES "keygenmusic_row=2000AD/[^|]*\\.mod\\|Protracker\\|2000AD\\|")
  message(FATAL_ERROR "I416 net: mod row missing or wrong\n${raw}")
endif()
if(NOT raw MATCHES "\\|Impulse Tracker\\|909DEAD\\|" OR NOT raw MATCHES "\\|Scream Tracker 3\\|CiO\\|")
  message(FATAL_ERROR "I416 net: it or s3m row missing or wrong\n${raw}")
endif()
message(STATUS "keygenmusic_net_ok rows=${want_rows}")
