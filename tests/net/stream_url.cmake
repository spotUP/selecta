# T94 URL part (row I195): OPEN of an http URL and of pipe:<cmd> through `selecta-cli script`, and an M3U that holds
# only URL lines. -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DM3=<tests/m3> -DSONG=<tests/net/fixtures/fixture.test/stream.mod>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "fixture.test=http://127.0.0.1:${port}")
file(SIZE "${SONG}" want_bytes)

function(run_script out file)
  execute_process(COMMAND "${CLI}" script "${file}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0 OR o MATCHES "ERROR" OR e MATCHES "ERROR")
    message(FATAL_ERROR "T94 url: script ${file} failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}" PARENT_SCOPE)
endfunction()

file(READ "${M3}/stream_url.sel" tmpl)
# OPEN takes one word, so the command is a script without arguments
file(WRITE "${WORK}/t94-pipe.sh" "#!/bin/sh\nexec cat '${SONG}'\n")
file(CHMOD "${WORK}/t94-pipe.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
string(REPLACE "@PIPE@" "pipe:${WORK}/t94-pipe.sh" tmpl "${tmpl}")
string(REPLACE "@LOCAL@" "${SONG}" tmpl "${tmpl}")
string(REPLACE "@OUT@" "${WORK}" tmpl "${tmpl}")
file(WRITE "${WORK}/t94-url.sel" "${tmpl}")
run_script(r1 "${WORK}/t94-url.sel")
string(REGEX MATCHALL "STREAM stream_reads=[0-9]+ stream_bytes=[0-9]+" st "${r1}")
list(LENGTH st nst)
if(NOT nst EQUAL 3)
  message(FATAL_ERROR "T94 url: want three STREAM lines\n${r1}")
endif()
list(GET st 0 s1)
list(GET st 1 s2)
list(GET st 2 s3)
if(NOT s1 STREQUAL "STREAM stream_reads=1 stream_bytes=${want_bytes}")
  message(FATAL_ERROR "T94 url: URL read '${s1}', want reads=1 bytes=${want_bytes}\n${r1}")
endif()
if(NOT s2 STREQUAL "STREAM stream_reads=2 stream_bytes=${want_bytes}")
  message(FATAL_ERROR "T94 url: pipe read '${s2}', want reads=2 bytes=${want_bytes}\n${r1}")
endif()
if(NOT s3 STREQUAL s2)
  message(FATAL_ERROR "T94 url: the local file went through the stream reader ('${s3}')\n${r1}")
endif()
# 1 s of stereo s16 each, not silent, and the URL and the pipe render exactly what the local file renders
foreach(k url pipe local)
  file(SIZE "${WORK}/${k}.raw" sz)
  if(NOT sz EQUAL 176400)
    message(FATAL_ERROR "T94 url: ${k} render is ${sz} bytes, want 176400")
  endif()
  file(READ "${WORK}/${k}.raw" hex HEX)
  if(NOT hex MATCHES "[1-9a-f]")
    message(FATAL_ERROR "T94 url: ${k} render is silent")
  endif()
  file(SHA256 "${WORK}/${k}.raw" h_${k})
endforeach()
if(NOT h_url STREQUAL h_local OR NOT h_pipe STREQUAL h_local)
  message(FATAL_ERROR "T94 url: render hashes differ url=${h_url} pipe=${h_pipe} local=${h_local}")
endif()

# M3U holding only URL lines
file(WRITE "${WORK}/t94-urls.m3u" "#EXTM3U\n#EXTINF:-1,Stream\nhttp://fixture.test/stream.mod\nhttp://fixture.test/other.mod\n")
file(READ "${M3}/stream_m3u.sel" tmpl)
string(REPLACE "@M3U@" "${WORK}/t94-urls.m3u" tmpl "${tmpl}")
file(WRITE "${WORK}/t94-m3u.sel" "${tmpl}")
run_script(r2 "${WORK}/t94-m3u.sel")
if(NOT r2 MATCHES "ids=1,2")
  message(FATAL_ERROR "T94 url: URL-only M3U imported other than 2 entries\n${r2}")
endif()
if(NOT r2 MATCHES "stream_reads=1 stream_bytes=${want_bytes}")
  message(FATAL_ERROR "T94 url: M3U URL did not play\n${r2}")
endif()
# I195a: a STOP sent from another thread ends an OPEN stuck on a server that accepts and never answers. Without the
# cancel flag the engine thread waits out the HTTP first-byte timeout (3 s and more); with it the OPEN returns within
# one poll slice of the STOP. CANCEL net_cancels=1 proves the cancel path ran.
set(CANCEL_BOUND_MS 1000)
file(REMOVE "${WORK}/hang-port")
execute_process(COMMAND sh -c "python3 -I '${CMAKE_CURRENT_LIST_DIR}/silent_server.py' '${WORK}/hang-port' 40 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${WORK}/hang-port")
    file(READ "${WORK}/hang-port" hp)
    if(NOT hp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${hp}" hp)
set(ENV{SELECTA_NET_MAP} "fixture.test=http://127.0.0.1:${port},hang.test=http://127.0.0.1:${hp}")
file(WRITE "${WORK}/t94-hang.sel" "@stop_after 300\n@timed OPEN http://hang.test/stream.mod\n@cancel_stats\n")
execute_process(COMMAND "${CLI}" script "${WORK}/t94-hang.sel" OUTPUT_VARIABLE o3 ERROR_VARIABLE e3 RESULT_VARIABLE rc3)
if(NOT rc3 EQUAL 0 OR NOT o3 MATCHES "timed_ms=([0-9]+)")
  message(FATAL_ERROR "I195a: hang script failed rc=${rc3}\n${o3}${e3}")
endif()
set(hang_ms "${CMAKE_MATCH_1}")
message(STATUS "I195a OPEN of a hanging URL then STOP: ${hang_ms} ms (bound ${CANCEL_BOUND_MS})")
if(hang_ms GREATER CANCEL_BOUND_MS)
  message(FATAL_ERROR "I195a: OPEN waited ${hang_ms} ms for the hanging URL, want <= ${CANCEL_BOUND_MS} ms\n${o3}")
endif()
if(NOT o3 MATCHES "CANCEL net_cancels=1")
  message(FATAL_ERROR "I195a: the cancel path did not run (want net_cancels=1)\n${o3}")
endif()
message(STATUS "stream_url_ok")
