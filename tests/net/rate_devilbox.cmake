# T79 rate-devilbox (row I173, D-M3-12): RATE pushes to DEViLBOX PUT/DELETE /api/ratings with the Bearer token, batch
# reads of 250 keys take 2 requests, an unreachable server leaves the rating pending until the next run, local songs
# are never pushed, and the token file is mode 0600.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures> -DM3=<tests/m3>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(down "http://127.0.0.1:1")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_DEVILBOX_URL} "http://devilbox.uprough.net")
unset(ENV{SELECTA_MIRROR})
set(ENV{SELECTA_MIRRORS_MODLAND} "http://fast.mirror.test/mods/")
set(cfg "${WORK}/t79-cfg")
set(db "${WORK}/t79.db")
set(song "modland:Protracker/test/play1.mod")
set(last_raw "")
file(REMOVE_RECURSE "${cfg}" "${WORK}/t79-cache")
file(REMOVE "${db}" "${db}-wal" "${db}-shm")
set(ENV{SELECTA_CACHE_DIR} "${WORK}/t79-cache")

function(devilbox_up up)
  if(up)
    set(ENV{SELECTA_NET_MAP} "devilbox.uprough.net=${fx},fixture.test=${fx},fast.mirror.test=${fx}" PARENT_SCOPE)
  else()
    set(ENV{SELECTA_NET_MAP} "devilbox.uprough.net=${down},fixture.test=${fx},fast.mirror.test=${fx}" PARENT_SCOPE)
  endif()
endfunction()

function(fail what)
  message(FATAL_ERROR "T79 ${what}\n${last_raw}")
endfunction()

function(expect_counter name want)
  if(NOT last_raw MATCHES "${name}=([0-9]+)")
    fail("counter ${name}= missing")
  endif()
  if(NOT CMAKE_MATCH_1 EQUAL want)
    fail("${name}=${CMAKE_MATCH_1}, want ${want}")
  endif()
endfunction()

function(run_script file)
  execute_process(COMMAND "${CLI}" script "${file}" --db "${db}" --config-dir "${cfg}"
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  set(last_raw "${o}${e}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    set(last_raw "${o}${e}")
    fail("script ${file} failed rc=${rc}")
  endif()
endfunction()

# The nth (0-based) fixture log entry of the devilbox host with this method and path prefix, "" when none.
function(log_entry var n method prefix)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t79-log.json" OUTPUT_VARIABLE o)
  file(READ "${WORK}/t79-log.json" logjson)
  string(JSON len LENGTH "${logjson}")
  set(found "")
  set(seen 0)
  if(len GREATER 0)
    math(EXPR last "${len} - 1")
    foreach(i RANGE ${last})
      string(JSON h GET "${logjson}" ${i} host)
      string(JSON m GET "${logjson}" ${i} method)
      string(JSON p GET "${logjson}" ${i} path)
      if(h STREQUAL "devilbox.uprough.net" AND m STREQUAL "${method}" AND p MATCHES "^${prefix}")
        if(seen EQUAL ${n})
          string(JSON found GET "${logjson}" ${i})
          break()
        endif()
        math(EXPR seen "${seen} + 1")
      endif()
    endforeach()
  endif()
  set(${var} "${found}" PARENT_SCOPE)
endfunction()

function(reset_log)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
endfunction()

# 0. login: the password comes from stdin, the token lands in <cfg>/devilbox.token with mode 0600.
devilbox_up(TRUE)
reset_log()
file(WRITE "${WORK}/t79-pw" "fixture-password\n")
execute_process(COMMAND "${CLI}" devilbox login rater --password-stdin --config-dir "${cfg}" INPUT_FILE "${WORK}/t79-pw"
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(last_raw "${o}${e}")
if(NOT rc EQUAL 0 OR NOT o MATCHES "devilbox_login=ok")
  fail("login failed rc=${rc}")
endif()
file(WRITE "${WORK}/t79-pw" "wrong\n")
execute_process(COMMAND "${CLI}" devilbox login rater --config-dir "${WORK}/t79-cfg-bad" INPUT_FILE "${WORK}/t79-pw"
  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
if(rc EQUAL 0 OR EXISTS "${WORK}/t79-cfg-bad/devilbox.token")
  fail("a wrong password must fail and store no token")
endif()
file(REMOVE "${WORK}/t79-pw")
if(NOT EXISTS "${cfg}/devilbox.token")
  fail("no token file")
endif()
execute_process(COMMAND python3 -I -c "import os,stat,sys; sys.exit(0 if stat.S_IMODE(os.stat(sys.argv[1]).st_mode) == 0o600 else 1)"
  "${cfg}/devilbox.token" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  fail("token file is not mode 0600")
endif()
log_entry(login 0 POST /api/auth/login)
string(JSON body GET "${login}" body)
if(NOT body STREQUAL "{\"username\":\"rater\",\"password\":\"fixture-password\"}")
  fail("login body ${body}")
endif()

# 1. RATE 4 -> PUT with the Bearer token and the exact body; 250 keys -> 2 batch requests.
run_script("${M3}/rate.sel")
log_entry(put 0 PUT /api/ratings)
if(put STREQUAL "")
  fail("no PUT /api/ratings in the fixture log")
endif()
string(JSON body GET "${put}" body)
if(NOT body STREQUAL "{\"source\":\"modland\",\"itemKey\":\"Protracker/test/play1.mod\",\"rating\":4}")
  fail("PUT body '${body}'")
endif()
string(JSON auth GET "${put}" headers authorization)
if(NOT auth STREQUAL "Bearer fixture-jwt-rater")
  fail("PUT Authorization '${auth}'")
endif()
expect_counter(rating_pushes 1)
expect_counter(rating_batches 2)
expect_counter(rating_pending 0)
if(NOT last_raw MATCHES "RATINGS_READ keys=250 requests=2 stored=1")
  fail("batch read of 250 keys")
endif()
if(NOT last_raw MATCHES "RATING_READ key=modland:Protracker/test/play1.mod stars=4")
  fail("own rating not read back")
endif()
log_entry(b0 0 GET /api/ratings/batch)
log_entry(b1 1 GET /api/ratings/batch)
log_entry(b2 2 GET /api/ratings/batch)
if(b0 STREQUAL "" OR b1 STREQUAL "" OR NOT b2 STREQUAL "")
  fail("want exactly 2 batch requests")
endif()
string(JSON bauth GET "${b0}" headers authorization)
if(NOT bauth STREQUAL "Bearer fixture-jwt-rater")
  fail("batch read sends the token to get userRating")
endif()

# 2. RATE 0 -> DELETE, no rating field.
file(WRITE "${WORK}/t79-clear.sel" "OPEN ${song}\nRATE 0\n@ratings\n")
run_script("${WORK}/t79-clear.sel")
log_entry(del 0 DELETE /api/ratings)
if(del STREQUAL "")
  fail("RATE 0 sent no DELETE")
endif()
string(JSON body GET "${del}" body)
if(NOT body STREQUAL "{\"source\":\"modland\",\"itemKey\":\"Protracker/test/play1.mod\"}")
  fail("DELETE body '${body}'")
endif()
expect_counter(rating_pushes 1)
expect_counter(rating_pending 0)

# 3. fixture down: stored locally, pending 1; the next run with the fixture up flushes it.
reset_log()
devilbox_up(FALSE)
file(WRITE "${WORK}/t79-offline.sel" "OPEN ${song}\nRATE 3\n@ratings\n")
run_script("${WORK}/t79-offline.sel")
expect_counter(rating_pushes 0)
expect_counter(rating_pending 1)
devilbox_up(TRUE)
file(WRITE "${WORK}/t79-flush.sel" "@ratings\n")
run_script("${WORK}/t79-flush.sel")
expect_counter(rating_pushes 1)
expect_counter(rating_pending 0)
log_entry(put 0 PUT /api/ratings)
string(JSON body GET "${put}" body)
if(NOT body STREQUAL "{\"source\":\"modland\",\"itemKey\":\"Protracker/test/play1.mod\",\"rating\":3}")
  fail("flushed PUT body '${body}'")
endif()
run_script("${WORK}/t79-flush.sel")
expect_counter(rating_pushes 0)

# 4. a local song is rated locally only: no push, no pending.
reset_log()
file(WRITE "${WORK}/t79-local.sel" "OPEN ${SONGS}/ambient.mod\nRATE 2\n@ratings\n")
run_script("${WORK}/t79-local.sel")
expect_counter(rating_pushes 0)
expect_counter(rating_pending 0)
log_entry(put 0 PUT /api/ratings)
if(NOT put STREQUAL "")
  fail("a local song was pushed")
endif()

# 5. (I173c) a slow server does not stall engine commands: the fixture answers a push of a "slowrate" key after 2 s.
# RATE and the command right after it must return in far less than that; the push still lands (drained by @ratings).
reset_log()
devilbox_up(TRUE)
set(RATE_STALL_BOUND_MS 700)
file(WRITE "${WORK}/t79-slow.sel" "OPEN modland:Protracker/test/slowrate.mod\n@timed RATE 5\n@timed VOLUME 80\n@ratings\n")
run_script("${WORK}/t79-slow.sel")
string(REGEX MATCHALL "timed_ms=([0-9]+)" timed "${last_raw}")
list(LENGTH timed ntimed)
if(NOT ntimed EQUAL 2)
  fail("want 2 timed_ms lines, got ${ntimed}")
endif()
foreach(t IN LISTS timed)
  string(REGEX REPLACE "timed_ms=" "" ms "${t}")
  if(ms GREATER ${RATE_STALL_BOUND_MS})
    fail("an engine command took ${ms} ms (bound ${RATE_STALL_BOUND_MS}) behind a 2 s DEViLBOX push")
  endif()
endforeach()
expect_counter(rating_pushes 1)
expect_counter(rating_pending 0)
log_entry(put 0 PUT /api/ratings)
string(JSON body GET "${put}" body)
if(NOT body STREQUAL "{\"source\":\"modland\",\"itemKey\":\"Protracker/test/slowrate.mod\",\"rating\":5}")
  fail("slow PUT body '${body}'")
endif()

file(REMOVE_RECURSE "${cfg}")
message("rate_devilbox_ok")
