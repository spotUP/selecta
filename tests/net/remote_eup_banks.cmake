# Row I1127b: a remote .eup plays with the banks its header names. The library cache reads the song's bytes through the
# eupmini CONTENT_COMPANIONS hook and fetches fmtone2.fmb / piano.pmb beside the song; no SEL_RP_COMPANIONS rule maps
# Mondschein.eup to those names, so only the hook can make those requests (the sentinel).
# Three runs of the same script shape and frame count: (a) local song with banks beside it, (b) the song alone,
# (c) OPEN modland:Euphony/Aya/Mondschein/Mondschein.eup through the fixture mirror.
# Asserts: the cache holds the song and both banks; the fixture log holds exactly one GET per bank; the remote energy is
# at least EUP_BANK_RATIO (3) times the bank-less energy (the I1127 bar) and within 1% of the local with-bank energy.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DFIXDIR=<tests/net/fixtures> -DM3=<tests/m3/fixtures> -DPLUGINS=<module dir>
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "fast.mirror.test=http://127.0.0.1:${port}")
set(ENV{SELECTA_PLUGIN_PATH} "${PLUGINS}")
unset(ENV{SELECTA_MIRROR})
set(ENV{SELECTA_MIRRORS_MODLAND} "http://fast.mirror.test/mods/")
set(cache "${WORK}/i1127b-cache")
file(REMOVE_RECURSE "${cache}")
set(ENV{SELECTA_CACHE_DIR} "${cache}")
if(NOT DEFINED ENV{EUP_BANK_RATIO})
  set(ratio 3)
else()
  set(ratio "$ENV{EUP_BANK_RATIO}")
endif()
set(frames 441000)

function(run_energy tag key out_energy)
  set(raw "${WORK}/i1127b-${tag}.raw")
  file(REMOVE "${raw}" "${WORK}/i1127b-${tag}.db")
  file(WRITE "${WORK}/i1127b-${tag}.sel" "@dump ${raw}\nOPEN ${key}\nPLAY\n@render ${frames}\nSTOP\n")
  execute_process(COMMAND "${CLI}" script "${WORK}/i1127b-${tag}.sel" --db "${WORK}/i1127b-${tag}.db"
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc TIMEOUT 90)
  if(NOT rc EQUAL 0 OR "${o}${e}" MATCHES "ERROR|open_failed")
    message(FATAL_ERROR "I1127b ${tag}: script exited ${rc}\n${o}${e}")
  endif()
  execute_process(COMMAND sh -c "od -An -v -t d2 '${raw}' | tr -s ' ' '\\n' | awk '$1 != \"\" { s += $1 * $1 } END { printf \"%d\", s }'"
    OUTPUT_VARIABLE en)
  set(${out_energy} "${en}" PARENT_SCOPE)
endfunction()

# (a) banks beside the song, (b) the song alone in a directory of its own.
set(alone "${WORK}/i1127b-alone")
file(REMOVE_RECURSE "${alone}")
file(MAKE_DIRECTORY "${alone}")
file(COPY "${M3}/eup_test.eup" DESTINATION "${alone}")
run_energy(bank "${M3}/eup_test.eup" e_bank)
run_energy(none "${alone}/eup_test.eup" e_none)

execute_process(COMMAND "${CLI}" fetch http://fast.mirror.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
run_energy(remote "modland:Euphony/Aya/Mondschein/Mondschein.eup" e_remote)

set(dir "${cache}/files/modland/Euphony/Aya/Mondschein")
foreach(f Mondschein.eup fmtone2.fmb piano.pmb)
  if(NOT EXISTS "${dir}/${f}")
    message(FATAL_ERROR "I1127b: ${dir}/${f} not in the cache")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" fetch http://fast.mirror.test/__fixture/log --out "${WORK}/i1127b-log.json" OUTPUT_VARIABLE lo)
file(READ "${WORK}/i1127b-log.json" log)
string(JSON n LENGTH "${log}")
math(EXPR last "${n} - 1")
set(fmb 0)
set(pmb 0)
foreach(i RANGE ${last})
  string(JSON p GET "${log}" ${i} path)
  string(JSON st GET "${log}" ${i} status)
  if("${p}" STREQUAL "/mods/Euphony/Aya/Mondschein/fmtone2.fmb" AND st EQUAL 200)
    math(EXPR fmb "${fmb} + 1")
  endif()
  if("${p}" STREQUAL "/mods/Euphony/Aya/Mondschein/piano.pmb" AND st EQUAL 200)
    math(EXPR pmb "${pmb} + 1")
  endif()
endforeach()
if(NOT fmb EQUAL 1 OR NOT pmb EQUAL 1)
  message(FATAL_ERROR "I1127b: bank GETs fmb=${fmb} pmb=${pmb}, want 1 each (the hook did not run)\n${log}")
endif()
math(EXPR need "${e_none} * ${ratio}")
if(e_remote LESS need)
  message(FATAL_ERROR "I1127b: remote energy ${e_remote} is under ${ratio}x the bank-less energy [${e_none}] (with-bank local [${e_bank}])")
endif()
math(EXPR diff "${e_remote} - ${e_bank}")
if(diff LESS 0)
  math(EXPR diff "0 - ${diff}")
endif()
math(EXPR tol "${e_bank} / 100")
if(diff GREATER tol)
  message(FATAL_ERROR "I1127b: remote energy ${e_remote} differs from the with-bank energy ${e_bank} by more than 1%")
endif()
message(STATUS "remote_eup_banks_ok fmb=${fmb} pmb=${pmb} e_remote=${e_remote} e_bank=${e_bank} e_none=${e_none}")
