# I725a: saved stream list + .pls / .m3u resolution + ICY title, driven through selecta-cli (script).
#  1. STREAM_ADD saves the playlist URL (sentinel adds=1, a repeat adds no row);
#  2. OPEN of the .pls URL fetches the list (served by icy_server.py as playlist=1), resolves it to
#     http://icy.test/live (sentinel resolves=1) and plays the MP3 stream through sel_live (STREAMLIVE opens>=1);
#  3. @title shows the ICY StreamTitle, the render is not silent;
#  4. the saved "Streams" playlist row holds the URL (sqlite3 on the library DB, when sqlite3 exists).
# -DCLI=<selecta-cli> -DWORK=<scratch dir> -DMP3=<tests/m3/stream/sine.mp3> -DICY=<icy_server.py> -DSQLITE3=<sqlite3 or empty>
set(PORT "${WORK}/slist-port")
set(DB "${WORK}/slist.db")
file(REMOVE_RECURSE "${PORT}" "${PORT}.requests" "${DB}")
execute_process(COMMAND sh -c "python3 -I '${ICY}' '${PORT}' '${MP3}' 40 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${PORT}")
    file(READ "${PORT}" sp)
    if(NOT sp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${sp}" sp)
if(sp STREQUAL "")
  message(FATAL_ERROR "I725a: ICY server did not start")
endif()
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "icy.test=http://127.0.0.1:${sp}")

file(WRITE "${WORK}/slist.sel"
  "STREAM_ADD http://icy.test/radio.pls\nSTREAM_ADD http://icy.test/radio.pls\n@dump ${WORK}/slist.raw\n"
  "OPEN http://icy.test/radio.pls\nPLAY\n@render 22050\n@sleep 600\n@render 22050\n@title\n@stream_list\n@stream_live\nOPEN http://icy.test/radio.m3u\nPLAY\n@render 22050\n@stream_list\nSTOP\n")
execute_process(COMMAND "${CLI}" script "${WORK}/slist.sel" --db "${DB}" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc TIMEOUT 25)
if(NOT rc EQUAL 0 OR o MATCHES "ERROR" OR e MATCHES "ERROR")
  message(FATAL_ERROR "I725a: script failed rc=${rc}\n${o}${e}")
endif()
if(NOT o MATCHES "STREAMLIST resolves=1 adds=2")
  message(FATAL_ERROR "I725a: want the .pls resolved once and two STREAM_ADD commands counted\n${o}")
endif()
if(NOT o MATCHES "resolves=1 adds=2.*resolves=2 adds=2")
  message(FATAL_ERROR "I725a: the .m3u URL was not resolved as a second playlist\n${o}")
endif()
if(NOT o MATCHES "TITLE text=Artist - Second Song")
  message(FATAL_ERROR "I725a: the ICY StreamTitle did not become the song title\n${o}")
endif()
if(NOT o MATCHES "STREAMLIVE opens=[1-9]")
  message(FATAL_ERROR "I725a: the resolved stream did not open through sel_live\n${o}")
endif()
file(READ "${PORT}.requests" rq)
if(NOT rq MATCHES "playlist=1" OR NOT rq MATCHES "icy=1")
  message(FATAL_ERROR "I725a: the server saw no playlist fetch or no ICY stream request\n${rq}")
endif()
file(READ "${WORK}/slist.raw" hex HEX)
if(NOT hex MATCHES "[1-9a-f]")
  message(FATAL_ERROR "I725a: the render is silent")
endif()
if(SQLITE3)
  execute_process(COMMAND "${SQLITE3}" "${DB}" ".dump"
    OUTPUT_VARIABLE dump RESULT_VARIABLE src)
  string(REGEX MATCHALL "http://icy.test/radio.pls" hits "${dump}")
  list(LENGTH hits nh)
  if(NOT src EQUAL 0 OR nh LESS 1 OR NOT dump MATCHES "Streams")
    message(FATAL_ERROR "I725a: the Streams playlist does not hold the URL (rc=${src}, ${nh} hits)")
  endif()
endif()
message(STATUS "stream_list_ok")
