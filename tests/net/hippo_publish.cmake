# T74 publish part (row I164): `selecta-cli script` drives PLAYLIST_PUBLISH over the hippoplayer.se fixture.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir>
# Small list: exactly 1 POST, body = the .prg PLAYLIST_SAVE writes (starts HiPPrg, <= 512 KB), query carries
# title/author/genre/filename, the reply `OK <id> <filename> <url>` is parsed. Oversized list: ERROR too_large, 0 POSTs.
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "hippoplayer.se=${fx},fixture.test=${fx}")
# Main case: only the ORIGIN is overridden (fixture is plain http); the PATH is the default constant, so a wrong
# default path 404s here (I417).
set(ENV{SELECTA_HIPPO_PUBLISH_ORIGIN} "http://hippoplayer.se")

function(post_log var)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t74p-log.json"
    OUTPUT_VARIABLE o RESULT_VARIABLE rc)
  file(READ "${WORK}/t74p-log.json" logjson)
  string(JSON n LENGTH "${logjson}")
  set(posts "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON m GET "${logjson}" ${i} method)
      string(JSON p GET "${logjson}" ${i} path)
      if(m STREQUAL "POST" AND p MATCHES "^/api/v1/playlists\\?")
        list(APPEND posts "${i}")
      endif()
    endforeach()
  endif()
  set(${var} "${posts}" PARENT_SCOPE)
  set(logjson "${logjson}" PARENT_SCOPE)
endfunction()

# ---- small list
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
set(sel "QUEUE_ADD songs/one.mod\nQUEUE_ADD songs/two.mod\nQUEUE_ADD songs/three.mod\n")
string(APPEND sel "PLAYLIST_SAVE ${WORK}/t74p-small.prg\n")
string(APPEND sel "PLAYLIST_PUBLISH \"selecta test\" Spot Acid acid.prg\n")
file(WRITE "${WORK}/t74p-small.sel" "${sel}")
execute_process(COMMAND "${CLI}" script "${WORK}/t74p-small.sel" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
if(NOT raw MATCHES "publish posts=1 id=181")
  message(FATAL_ERROR "T74 publish: sentinel 'publish posts=1 id=181' missing\n${raw}")
endif()
if(NOT raw MATCHES "publish_url acid.prg https://hippoplayer.se/playlist/acid.prg")
  message(FATAL_ERROR "T74 publish: reply not parsed into filename and url\n${raw}")
endif()
post_log(posts)
list(LENGTH posts np)
if(NOT np EQUAL 1)
  message(FATAL_ERROR "T74 publish: expected 1 POST, fixture saw ${np}\n${logjson}")
endif()
list(GET posts 0 idx)
string(JSON path GET "${logjson}" ${idx} path)
foreach(kv "title=selecta%20test" "author=Spot" "genre=Acid" "filename=acid.prg")
  string(FIND "${path}" "${kv}" at)
  if(at LESS 0)
    message(FATAL_ERROR "T74 publish: query lacks ${kv}: ${path}")
  endif()
endforeach()
string(JSON blen GET "${logjson}" ${idx} body_len)
if(blen GREATER 524288 OR blen LESS 6)
  message(FATAL_ERROR "T74 publish: body_len ${blen} outside 6..524288")
endif()
file(READ "${WORK}/t74p-small.prg" prg)
string(SUBSTRING "${prg}" 0 6 head)
if(NOT head STREQUAL "HiPPrg")
  message(FATAL_ERROR "T74 publish: saved list does not start HiPPrg: ${head}")
endif()
file(SHA256 "${WORK}/t74p-small.prg" want)
string(JSON got GET "${logjson}" ${idx} body_sha256)
if(NOT got STREQUAL want)
  message(FATAL_ERROR "T74 publish: posted body sha ${got} differs from the exported .prg ${want}")
endif()

# ---- server rejection: 409 `ERROR filename_taken` must surface as publish_rejected, never as a success
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
set(ENV{SELECTA_HIPPO_PUBLISH_URL} "http://hippoplayer.se/api/v1/playlists/exists")
file(WRITE "${WORK}/t74p-409.sel" "QUEUE_ADD songs/one.mod\nPLAYLIST_PUBLISH dup Spot Acid acid.prg\n")
execute_process(COMMAND "${CLI}" script "${WORK}/t74p-409.sel" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
unset(ENV{SELECTA_HIPPO_PUBLISH_URL})
set(raw "${o}${e}")
if(NOT raw MATCHES "ERROR publish_rejected PLAYLIST_PUBLISH" OR raw MATCHES "publish posts=")
  message(FATAL_ERROR "T74 publish: 409 ERROR reply not reported as publish_rejected\n${raw}")
endif()

# ---- oversized list: 5600 entries of ~110 characters is over 512 KB of .prg
execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
string(REPEAT "x" 100 pad)
set(sel "")
foreach(i RANGE 1 5600)
  string(APPEND sel "QUEUE_ADD songs/${pad}${i}.mod\n")
endforeach()
string(APPEND sel "PLAYLIST_PUBLISH big Spot Acid big.prg\n")
file(WRITE "${WORK}/t74p-big.sel" "${sel}")
execute_process(COMMAND "${CLI}" script "${WORK}/t74p-big.sel" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
set(raw "${o}${e}")
if(NOT raw MATCHES "ERROR too_large PLAYLIST_PUBLISH")
  string(SUBSTRING "${raw}" 0 600 shown)
  message(FATAL_ERROR "T74 publish: oversized list not answered ERROR too_large\n${shown}")
endif()
post_log(posts)
list(LENGTH posts np)
if(NOT np EQUAL 0)
  message(FATAL_ERROR "T74 publish: oversized list still sent ${np} POST(s)")
endif()
message(STATUS "hippo_publish_ok small_body=${blen} big_posts=${np}")
