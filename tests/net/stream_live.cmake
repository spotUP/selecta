# I195b: OPEN of an http URL starts playing before the download completes. slow_server.py sends 60% of a long MP3 and
# then holds the connection open for good, like a radio stream. Through `selecta-cli script` the first audio must
# render while the download is unfinished (@stream_live: audio_done=0, audio_bytes below the advertised length), and
# the end of the script (STOP, exit) must end the stalled download quickly instead of waiting for the server.
# -DCLI=<selecta-cli> -DWORK=<scratch dir> -DMP3=<tests/m3/stream/sine.mp3> -DSLOW=<slow_server.py>
# I195d: -DREPEAT=<n> -DEXT=<ext> serve the file n times as long.<ext>; the Ogg variant serves one long.ogg
# (repeated Ogg files would be chained streams).
if(NOT DEFINED REPEAT)
  set(REPEAT 40)
endif()
if(NOT DEFINED EXT)
  set(EXT mp3)
endif()
set(PERCENT 60)
file(SIZE "${MP3}" one)
math(EXPR total "${one} * ${REPEAT}")
math(EXPR part "${total} * ${PERCENT} / 100")
file(REMOVE "${WORK}/slow-port")
execute_process(COMMAND sh -c "python3 -I '${SLOW}' '${WORK}/slow-port' '${MP3}' ${REPEAT} ${PERCENT} 30 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${WORK}/slow-port")
    file(READ "${WORK}/slow-port" sp)
    if(NOT sp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${sp}" sp)
if(sp STREQUAL "")
  message(FATAL_ERROR "I195b: slow server did not start")
endif()
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "slow.test=http://127.0.0.1:${sp}")
file(WRITE "${WORK}/live.sel" "@dump ${WORK}/live.raw\nOPEN http://slow.test/long.${EXT}\nPLAY\n@render 22050\n@stream_live\nSTOP\n")
string(TIMESTAMP t0 "%s")
execute_process(COMMAND "${CLI}" script "${WORK}/live.sel" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc
  TIMEOUT 25)
string(TIMESTAMP t1 "%s")
math(EXPR secs "${t1} - ${t0}")
if(NOT rc EQUAL 0 OR o MATCHES "ERROR" OR e MATCHES "ERROR")
  message(FATAL_ERROR "I195b: script failed rc=${rc} after ${secs} s (a whole-file read waits for the stalled body)\n${o}${e}")
endif()
if(NOT o MATCHES "STREAMLIVE opens=1 audio_bytes=([0-9]+) audio_done=([0-9]+)")
  message(FATAL_ERROR "I195b: no live stream was played\n${o}")
endif()
set(got "${CMAKE_MATCH_1}")
set(done "${CMAKE_MATCH_2}")
message(STATUS "I195b first audio after ${got} of ${total} bytes (server sends ${part}), done=${done}, script took ${secs} s")
if(NOT done EQUAL 0 OR got LESS 1 OR NOT got LESS total)
  message(FATAL_ERROR "I195b: audio did not start inside the download (bytes ${got}, total ${total}, done ${done})")
endif()
if(secs GREATER 8)
  message(FATAL_ERROR "I195b: STOP and exit took ${secs} s with the download stalled, want a prompt end")
endif()
file(SIZE "${WORK}/live.raw" sz)
if(NOT sz EQUAL 88200)
  message(FATAL_ERROR "I195b: render is ${sz} bytes, want 88200")
endif()
file(READ "${WORK}/live.raw" hex HEX)
if(NOT hex MATCHES "[1-9a-f]")
  message(FATAL_ERROR "I195b: the live render is silent")
endif()
message(STATUS "stream_live_ok")
