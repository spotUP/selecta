# I195f: a chained Ogg stream (an Ogg radio station starts a new logical stream, with a new BOS page, serial and
# Vorbis headers, for every track) plays through the live stream path. tests/m3/stream/chained.ogg holds two one
# second streams, "Chain One" (440 Hz) and "Chain Two" (880 Hz), served whole by slow_server.py. The decoder must
# reset at the second BOS page: the title tag follows the new stream and the second part decodes.
# -DCLI=<selecta-cli> -DWORK=<scratch dir> -DOGG=<tests/m3/stream/chained.ogg> -DSLOW=<slow_server.py>
file(REMOVE "${WORK}/chain-port")
execute_process(COMMAND sh -c "python3 -I '${SLOW}' '${WORK}/chain-port' '${OGG}' 1 100 30 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${WORK}/chain-port")
    file(READ "${WORK}/chain-port" sp)
    if(NOT sp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${sp}" sp)
if(sp STREQUAL "")
  message(FATAL_ERROR "I195f: server did not start")
endif()
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "chain.test=http://127.0.0.1:${sp}")
file(REMOVE "${WORK}/chain1.raw" "${WORK}/chain2.raw")
# Engine output is 44100 Hz stereo: part one ends at frame 44100. Read 0.5 s of it, then 1.0 s that crosses into part two.
file(WRITE "${WORK}/chain.sel"
  "@dump ${WORK}/chain1.raw\nOPEN http://chain.test/long.ogg\nPLAY\n@render 22050\n@title\n@dump ${WORK}/chain2.raw\n@render 44100\n@title\n@render 8000\n@stream_live\nSTOP\n")
execute_process(COMMAND "${CLI}" script "${WORK}/chain.sel" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc TIMEOUT 25)
if(NOT rc EQUAL 0 OR o MATCHES "ERROR" OR e MATCHES "ERROR")
  message(FATAL_ERROR "I195f: script failed rc=${rc}\n${o}${e}")
endif()
if(NOT o MATCHES "STREAMLIVE opens=1")
  message(FATAL_ERROR "I195f: no live stream was played\n${o}")
endif()
string(REGEX MATCHALL "TITLE text=[^\n]*" titles "${o}")
list(LENGTH titles nt)
list(GET titles 0 t1)
list(GET titles 1 t2)
if(NOT nt EQUAL 2 OR NOT t1 STREQUAL "TITLE text=Chain One")
  message(FATAL_ERROR "I195f: first title is not Chain One: ${titles}")
endif()
if(NOT t2 STREQUAL "TITLE text=Chain Two")
  message(FATAL_ERROR "I195f: title did not change at the chained stream (${t2}, want Chain Two)")
endif()
# Both parts decode: part one's 22050 frames and the 44100 + 8000 frames are not silent. The last 4000
# frames of the second dump lie inside part two (frames 44100 .. 88200 of the stream, 1.0 s + 8000 frames in).
file(SIZE "${WORK}/chain1.raw" s1)
file(SIZE "${WORK}/chain2.raw" s2)
if(NOT s1 EQUAL 88200 OR NOT s2 EQUAL 208400)
  message(FATAL_ERROR "I195f: render sizes ${s1} ${s2}, want 88200 and 208400")
endif()
file(READ "${WORK}/chain1.raw" h1 HEX)
file(READ "${WORK}/chain2.raw" h2 HEX)
string(SUBSTRING "${h2}" 400000 16000 tail)  # bytes 200000 .. 208000 of 208400: well inside part two
if(NOT h1 MATCHES "[1-9a-f]")
  message(FATAL_ERROR "I195f: part one is silent")
endif()
if(NOT tail MATCHES "[1-9a-f]")
  message(FATAL_ERROR "I195f: part two is silent")
endif()
message(STATUS "stream_chained_ok")
