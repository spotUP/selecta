# I1029: clicking a radio-browser station whose stream no replayer can stream (AAC bytes under an audio/mpeg label) froze
# the app: the engine drained the endless ICY body whole on its own thread, up to SEL_STREAM_MAX (256 MB, hours of
# radio). An endless live stream (sel_http_res.radio) must fail the open at once instead.
#  OPEN radiobrowser:eeee-5555/Echo-AAC resolves the station through GET /json/url/<uuid> (STREAMSOURCE resolves>=1),
#  opens the stream through sel_live (STREAMLIVE opens>=1, the fixture logs endless=1), and must report open_failed well
#  inside the timeout, without an http_status (the server answered 200), after reading less than 1 MB of the stream.
# -DCLI=<selecta-cli> -DWORK=<scratch dir> -DMP3=<tests/m3/stream/sine.mp3> -DICY=<icy_server.py>
set(PORT "${WORK}/rbe-port")
file(REMOVE_RECURSE "${PORT}" "${PORT}.requests" "${WORK}/rbe-cache" "${WORK}/rbe.db")
execute_process(COMMAND sh -c "python3 -I '${ICY}' '${PORT}' '${MP3}' 40 >/dev/null 2>&1 &")
foreach(i RANGE 50)
  if(EXISTS "${PORT}")
    file(READ "${PORT}" sp)
    if(NOT sp STREQUAL "")
      break()
    endif()
  endif()
  execute_process(COMMAND sleep 0.1)
endforeach()
string(STRIP "${sp}" sp)
if(sp STREQUAL "")
  message(FATAL_ERROR "I1029: fixture server did not start")
endif()
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "icy.test=http://127.0.0.1:${sp},rb.test=http://127.0.0.1:${sp}")
set(ENV{SELECTA_CACHE_DIR} "${WORK}/rbe-cache" "${WORK}/rbe.db")
set(ENV{SELECTA_RADIO_BROWSER} "http://rb.test")

file(WRITE "${WORK}/rbe.sel" "OPEN radiobrowser:eeee-5555/Echo-AAC\n@stream_source\n@stream_live\n")
string(TIMESTAMP t0 "%s")
execute_process(COMMAND "${CLI}" script "${WORK}/rbe.sel" --db "${WORK}/rbe.db" OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc TIMEOUT 20)
string(TIMESTAMP t1 "%s")
math(EXPR took "${t1} - ${t0}")
set(all "${o}${e}")
if(NOT rc MATCHES "^[0-9]+$" OR took GREATER 10)
  message(FATAL_ERROR "I1029: OPEN of an endless stream hung (rc=${rc}, ${took} s): the engine drained it\n${all}")
endif()
if(NOT all MATCHES "ERROR open_failed")
  message(FATAL_ERROR "I1029: the endless stream did not report open_failed\n${all}")
endif()
if(all MATCHES "http_status=")
  message(FATAL_ERROR "I1029: open_failed carries an HTTP status, but the server answered 200\n${all}")
endif()
if(NOT o MATCHES "STREAMSOURCE resolves=[1-9]")
  message(FATAL_ERROR "I1029: the station was not resolved through the source\n${o}")
endif()
if(NOT o MATCHES "STREAMLIVE opens=[1-9]")
  message(FATAL_ERROR "I1029: the resolved stream did not open through sel_live\n${o}")
endif()
execute_process(COMMAND sleep 0.5) # the fixture logs the byte count once the client hung up
file(READ "${PORT}.requests" rq)
if(NOT rq MATCHES "rb_click=eeee-5555" OR NOT rq MATCHES "endless=1")
  message(FATAL_ERROR "I1029: no click ping for the station, or no stream request\n${rq}")
endif()
if(NOT rq MATCHES "endless_bytes=([0-9]+)")
  message(FATAL_ERROR "I1029: the client never hung up on the endless stream\n${rq}")
endif()
if(CMAKE_MATCH_1 GREATER 1048576)
  message(FATAL_ERROR "I1029: ${CMAKE_MATCH_1} bytes of the endless stream were read before the open failed\n${rq}")
endif()
message(STATUS "radio_endless_ok")
