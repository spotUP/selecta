# Runs CLI with ARGS and checks stdout. One of:
#   EXPECT       exact stdout (trailing newline ignored)
#   EXPECT_FILE  stdout equals the file's content
#   LINES        stdout has exactly this many lines
#   EXPECT_REGEX stdout matches this regex
# Fails with both texts on a mismatch. Used by every T row.
if(NOT CLI)
  message(FATAL_ERROR "expect.cmake: CLI not set")
endif()
separate_arguments(arg_list UNIX_COMMAND "${ARGS}")
execute_process(COMMAND "${CLI}" ${arg_list}
  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "selecta-cli ${ARGS} exited ${rc}\nstdout:\n${out}\nstderr:\n${err}")
endif()
string(REGEX REPLACE "\n$" "" got "${out}")
if(DEFINED EXPECT)
  if(NOT got STREQUAL EXPECT)
    message(FATAL_ERROR "selecta-cli ${ARGS}\nexpected:\n${EXPECT}\ngot:\n${got}")
  endif()
elseif(DEFINED EXPECT_FILE)
  if(NOT EXISTS "${EXPECT_FILE}")
    message(FATAL_ERROR "golden missing: ${EXPECT_FILE}\ngot:\n${got}")
  endif()
  file(READ "${EXPECT_FILE}" want)
  string(REGEX REPLACE "\n$" "" want "${want}")
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "selecta-cli ${ARGS} differs from ${EXPECT_FILE}\nexpected:\n${want}\ngot:\n${got}")
  endif()
elseif(DEFINED EXPECT_REGEX)
  if(NOT got MATCHES "${EXPECT_REGEX}")
    message(FATAL_ERROR "selecta-cli ${ARGS}\nexpected match:\n${EXPECT_REGEX}\ngot:\n${got}")
  endif()
elseif(DEFINED LINES)
  string(REGEX MATCHALL "\n" nl "${got}")
  list(LENGTH nl n)
  if(NOT got STREQUAL "")
    math(EXPR n "${n} + 1")
  endif()
  if(NOT n EQUAL LINES)
    message(FATAL_ERROR "selecta-cli ${ARGS}: expected ${LINES} lines, got ${n}:\n${got}")
  endif()
else()
  message(FATAL_ERROR "expect.cmake: set EXPECT, EXPECT_FILE or LINES")
endif()
