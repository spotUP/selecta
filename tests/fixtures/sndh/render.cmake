# I427b reachability test: the GPL sndh module is found through $SELECTA_PLUGIN_PATH and selecta-cli renders a real
# ICE!-packed SNDH (oculus_ice.sndh, see PROVENANCE.md) through it. Proves WIRED (plugins listing names the module
# path, dyn_loaded=1, render prints replayer=sc68 render_calls=N) and the output (non-silent: a sample of at least
# 0x0800 magnitude, about -24 dBFS, and the pinned SHA-256 of the deterministic emulator output).
# Variables: CLI MODDIR SONG OUT HASH; EXPECT_FAIL=1 is the negative run (module not on the plugin path).
# Only the module under test is on the plugin path: MODDIR is the shared build folder (every module of the build, the
# other SNDH backend psgplay among them), so the positive run links just sel_sndh.* into its own folder and
# dyn_loaded=1 then counts that one module. The negative run passes an empty folder and is used as given.
if(NOT EXPECT_FAIL)
  get_filename_component(ISO "${OUT}" DIRECTORY)
  set(ISO "${ISO}/sndh-only")
  file(REMOVE_RECURSE "${ISO}")
  file(MAKE_DIRECTORY "${ISO}")
  file(GLOB sndh_mod "${MODDIR}/sel_sndh.*")
  if(NOT sndh_mod)
    message(FATAL_ERROR "no sel_sndh module in ${MODDIR}")
  endif()
  foreach(m IN LISTS sndh_mod)
    get_filename_component(n "${m}" NAME)
    file(CREATE_LINK "${m}" "${ISO}/${n}" SYMBOLIC)
  endforeach()
  set(MODDIR "${ISO}")
endif()
set(ENV{SELECTA_PLUGIN_PATH} "${MODDIR}")
if(NOT EXPECT_FAIL)
  execute_process(COMMAND "${CLI}" plugins --stats OUTPUT_VARIABLE list ERROR_VARIABLE lerr RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "plugins exited ${rc}\n${list}\n${lerr}")
  endif()
  if(NOT list MATCHES "sc68 kind=1 version=1 origin=${MODDIR}/sel_sndh\\.(dylib|so)\n")
    message(FATAL_ERROR "plugins listing lacks the sc68 module with its path:\n${list}")
  endif()
  if(NOT list MATCHES "dyn_loaded=1\ndyn_rejected=0\n")
    message(FATAL_ERROR "stats lack dyn_loaded=1 dyn_rejected=0:\n${list}")
  endif()
endif()
file(REMOVE "${OUT}")
execute_process(COMMAND "${CLI}" render "${SONG}" --output "${OUT}" --seconds 3 --rate 8000
  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(EXPECT_FAIL)
  if(rc EQUAL 0 AND out MATCHES "replayer=sc68")
    message(FATAL_ERROR "render succeeded without the module on the plugin path:\n${out}")
  endif()
  return()
endif()
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "render exited ${rc}\nstdout:\n${out}\nstderr:\n${err}")
endif()
string(REGEX REPLACE "\n$" "" out "${out}")
if(NOT out MATCHES "^replayer=sc68 render_calls=[1-9][0-9]* rendered_frames=24000$")
  message(FATAL_ERROR "render counters wrong:\n${out}")
endif()
# 16-bit little-endian samples after the 44-byte header; the high byte is the second byte of each 4-hex-digit pair.
# Walk in 1000-sample windows so the regex stays shallow.
file(READ "${OUT}" hex OFFSET 44 HEX)
string(LENGTH "${hex}" len)
set(loud FALSE)
set(pos 0)
while(pos LESS len AND NOT loud)
  string(SUBSTRING "${hex}" ${pos} 4000 win)
  if(win MATCHES "^(....)*..(0[89a-f]|[1-7].|[89a-e].|f[0-7])")
    set(loud TRUE)
  endif()
  math(EXPR pos "${pos} + 4000")
endwhile()
if(NOT loud)
  message(FATAL_ERROR "render is silent: no sample of magnitude 0x0800 or more")
endif()
file(SHA256 "${OUT}" hash)
if(NOT hash STREQUAL "${HASH}")
  message(FATAL_ERROR "WAV SHA-256 ${hash} differs from the pinned render")
endif()
