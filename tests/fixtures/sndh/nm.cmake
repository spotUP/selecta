# I427b licence boundary: with SELECTA_GPL_PLUGINS=ON the core binaries (selecta, selecta-cli) still hold no sc68
# symbol or string. Variable: BINS (list of binaries)
find_program(NM nm)
if(NOT NM)
  message(FATAL_ERROR "nm not found")
endif()
string(REPLACE "|" ";" BINS "${BINS}")
foreach(bin IN LISTS BINS)
  execute_process(COMMAND "${NM}" "${bin}" OUTPUT_VARIABLE syms RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nm ${bin} exited ${rc}")
  endif()
  string(LENGTH "${syms}" n)
  if(n LESS 1000)
    message(FATAL_ERROR "nm output for ${bin} suspiciously short (${n} bytes); the check would pass on nothing")
  endif()
  if(NOT syms MATCHES "sel_registry_add_entry")
    message(FATAL_ERROR "nm of ${bin} lacks sel_registry_add_entry; the loader is not linked")
  endif()
  foreach(sym sc68_ emu68_ file68_ ymio unice68 vfs68_)
    if(syms MATCHES "${sym}")
      message(FATAL_ERROR "${bin} contains the GPL symbol ${sym}")
    endif()
  endforeach()
  file(READ "${bin}" blob HEX)
  string(HEX "SC68 Music-file" hex)
  if(blob MATCHES "${hex}")
    message(FATAL_ERROR "${bin} contains the sc68 string 'SC68 Music-file'")
  endif()
endforeach()
