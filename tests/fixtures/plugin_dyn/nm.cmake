# I427a licence boundary: the core selecta-cli binary holds none of the fixture module's symbols or strings
# (module.c ids "dyntone", the rp_* hooks as exported by the module, nosym.c's selfix_not_an_entry).
# Variable: CLI
find_program(NM nm)
if(NOT NM)
  message(FATAL_ERROR "nm not found")
endif()
execute_process(COMMAND "${NM}" "${CLI}" OUTPUT_VARIABLE syms RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nm exited ${rc}")
endif()
string(LENGTH "${syms}" n)
if(n LESS 1000)
  message(FATAL_ERROR "nm output suspiciously short (${n} bytes); the check would pass on nothing")
endif()
if(NOT syms MATCHES "sel_registry_add_entry")
  message(FATAL_ERROR "nm of the core lacks sel_registry_add_entry; the loader is not linked")
endif()
foreach(sym selfix_not_an_entry dyntone dyn_tone)
  if(syms MATCHES "${sym}")
    message(FATAL_ERROR "core binary contains the fixture symbol ${sym}")
  endif()
endforeach()
file(READ "${CLI}" bin HEX)
string(HEX "dyntone" hex)
if(bin MATCHES "${hex}")
  message(FATAL_ERROR "core binary contains the fixture string dyntone")
endif()
