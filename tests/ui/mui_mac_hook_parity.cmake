# I1329: every engine/uimodel hook the desktop (Mac) UI calls has a caller in the MUI UI or a named exemption.
# A hook is a name declared in include/selecta/**/*.h with prefix sel_engine_, sel_uim_ or sel_route_; a call is
# "name(" in a source file after block and line comments are stripped. A new Mac feature that reaches the engine or
# the shared uimodel through a hook MUI never calls fails here until MUI calls it or EXEMPT names it with a reason.
# Stale exemptions (MUI now calls it, or the desktop no longer does) fail too, so the list only shrinks honestly.
# Usage: cmake -DROOT=<source root> -DEXEMPT=<exempt file> -P mui_mac_hook_parity.cmake
set(HOOK_RE "sel_(engine|uim|route)_[a-z0-9_]+")

function(calls_in OUT)
  set(names "")
  foreach(F IN LISTS ARGN)
    file(READ "${F}" T)
    # shortcut: a "/*" inside a string literal would swallow code up to the next "*/"; no current source has one.
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" T "${T}")
    string(REGEX REPLACE "//[^\n]*" "" T "${T}")
    string(REGEX MATCHALL "${HOOK_RE} *\\(" M "${T}")
    list(APPEND names ${M})
  endforeach()
  list(TRANSFORM names REPLACE " *\\($" "")
  list(REMOVE_DUPLICATES names)
  set(${OUT} "${names}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE HDRS "${ROOT}/include/selecta/*.h")
calls_in(DECLARED ${HDRS})
file(GLOB_RECURSE DESK_SRC "${ROOT}/plugins/ui/desktop/*.c" "${ROOT}/plugins/ui/desktop/*.m")
file(GLOB_RECURSE MUI_SRC "${ROOT}/plugins/ui/mui/*.c")
calls_in(DESK ${DESK_SRC})
calls_in(MUI ${MUI_SRC})
list(FILTER DESK INCLUDE REGEX "^(${HOOK_RE})$")
set(HOOKS "")
foreach(N IN LISTS DESK)
  if(N IN_LIST DECLARED)
    list(APPEND HOOKS ${N})
  endif()
endforeach()
list(LENGTH HOOKS NH)
list(LENGTH MUI NM)
if(NH LESS 100 OR NM LESS 50)
  message(FATAL_ERROR "only ${NH} desktop hooks / ${NM} MUI calls parsed: the source layout or pattern changed")
endif()

# EXEMPT lines: "<hook> <reason>"; '#' starts a comment line. A gap reason names its ledger row (I<digits>).
file(STRINGS "${EXEMPT}" EL REGEX "^sel_")
set(EXEMPTED "")
set(FAILED 0)
foreach(L IN LISTS EL)
  string(REGEX MATCH "^[a-z0-9_]+" N "${L}")
  string(REGEX MATCH "[ \t].*[^ \t]" R "${L}") # MATCH, not REPLACE: REPLACE re-applies "^" after each cut
  if(R STREQUAL "")
    message(SEND_ERROR "exemption ${N} has no reason")
    set(FAILED 1)
  endif()
  if(N IN_LIST EXEMPTED)
    message(SEND_ERROR "exemption ${N} listed twice")
    set(FAILED 1)
  endif()
  list(APPEND EXEMPTED ${N})
  if(NOT N IN_LIST HOOKS)
    message(SEND_ERROR "stale exemption ${N}: the desktop UI no longer calls it, remove the line")
    set(FAILED 1)
  elseif(N IN_LIST MUI)
    message(SEND_ERROR "stale exemption ${N}: MUI calls it now, remove the line (and tick its row)")
    set(FAILED 1)
  endif()
endforeach()
set(GAPS 0)
foreach(N IN LISTS HOOKS)
  if(NOT N IN_LIST MUI AND NOT N IN_LIST EXEMPTED)
    message(SEND_ERROR "${N}: the desktop UI calls it, MUI does not and no exemption names it. Build the MUI twin, or add '${N} <reason / row>' to ${EXEMPT}")
    set(FAILED 1)
  endif()
endforeach()
if(FAILED)
  message(FATAL_ERROR "mui-mac-hook-parity failed")
endif()
list(LENGTH EXEMPTED NE)
message(STATUS "mui-mac-hook-parity: ${NH} desktop hooks, ${NE} exempt, the rest called by MUI")
