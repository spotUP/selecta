# I1362b: no two MUI control id ranges may overlap. I1362: CTL_OFFER_ROW (0x2900 + k) equalled CTL_SIDE_BASE (0x2900),
# so the offer branch of mui_control_fire swallowed sidebar presses. Reads every `#define CTL_* 0x...` (and MENU_ID_BASE)
# from mui_ui.c; a plain define is one id, a name in SPAN below owns that many ids from its value.
# Usage: cmake -DSRC=<mui_ui.c> -P mui_ctl_ranges.cmake
# A new *_BASE define must get a SPAN entry (an upper bound of the ids it can reach), else this test fails.
set(SPAN_MENU_ID_BASE 4096)
set(SPAN_CTL_BTN_BASE 256)
set(SPAN_CTL_PANE_BASE 16)
set(SPAN_CTL_DOOR_BASE 256)
set(SPAN_CTL_P4_BASE 256)
set(SPAN_CTL_P4_BASE_CTX 0) # alias of CTL_P4_BASE, checked equal below
set(SPAN_CTL_CRUMB_BASE 256)
set(SPAN_CTL_SM_BASE 256)
set(SPAN_CTL_PREF_BASE 256)
set(SPAN_CTL_EXTRA_BASE 256)
set(SPAN_CTL_SIDE_BASE 256)
set(SPAN_CTL_QUICK_BASE 16)
set(SPAN_CTL_SHELF_ALL_BASE 16)
set(SPAN_CTL_SHELF_LIST_BASE 32)
set(SPAN_CTL_TILE_BASE 64)
set(SPAN_CTL_FACET_BASE 64)
set(SPAN_CTL_KEY_BASE 256)
set(SPAN_CTL_OFFER_ROW 256)

file(STRINGS "${SRC}" LINES REGEX "^#define (CTL_|MENU_ID_BASE)[A-Z0-9_]* +0x[0-9A-Fa-f]+")
set(NAMES "")
foreach(L IN LISTS LINES)
  string(REGEX REPLACE "^#define +([A-Za-z0-9_]+) +(0x[0-9A-Fa-f]+).*$" "\\1;\\2" P "${L}")
  list(GET P 0 N)
  list(GET P 1 V)
  math(EXPR V "${V}")
  if(NOT DEFINED SPAN_${N})
    if(N MATCHES "_BASE")
      message(FATAL_ERROR "${N} has no SPAN_${N} entry in mui_ctl_ranges.cmake: add the span of ids it can reach")
    endif()
    set(SPAN_${N} 1)
  endif()
  set(VAL_${N} ${V})
  list(APPEND NAMES ${N})
endforeach()
list(LENGTH NAMES COUNT)
if(COUNT LESS 30)
  message(FATAL_ERROR "only ${COUNT} control ids parsed from ${SRC}: the pattern no longer matches")
endif()
if(NOT VAL_CTL_P4_BASE EQUAL VAL_CTL_P4_BASE_CTX)
  message(FATAL_ERROR "CTL_P4_BASE_CTX must equal CTL_P4_BASE")
endif()
set(FAILED 0)
foreach(A IN LISTS NAMES)
  foreach(B IN LISTS NAMES)
    if(A STRLESS B AND SPAN_${A} GREATER 0 AND SPAN_${B} GREATER 0)
      math(EXPR AE "${VAL_${A}} + ${SPAN_${A}}")
      math(EXPR BE "${VAL_${B}} + ${SPAN_${B}}")
      if(VAL_${A} LESS BE AND VAL_${B} LESS AE)
        message(SEND_ERROR "control id ranges overlap: ${A} [${VAL_${A}}, ${AE}) and ${B} [${VAL_${B}}, ${BE})")
        set(FAILED 1)
      endif()
    endif()
  endforeach()
endforeach()
if(FAILED)
  message(FATAL_ERROR "MUI control id ranges overlap")
endif()
message(STATUS "mui-ctl-ranges: ${COUNT} control ids, no overlap")
