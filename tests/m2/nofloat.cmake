# T54 no-float-interrupt: m68k-amigaos-nm over every object of the interrupt and audio-task path.
# The object list is written by the build from the CMake target list (build/amiga/m2-interrupt-objects.txt,
# one path per line), so the count is counted from the target and not from a grep. Sentinel objects=N.
# Inputs: NM BUILD_DIR
set(list "${BUILD_DIR}/m2-interrupt-objects.txt")
if(NOT EXISTS "${list}")
  message(FATAL_ERROR "RED[T54]: ${list} missing: no interrupt/audio-task target exists yet (audio_int.c, paula, paula14, ahi outputs not implemented).")
endif()
file(STRINGS "${list}" objs)
list(LENGTH objs n)
message(STATUS "objects=${n}")
if(n LESS 1)
  message(FATAL_ERROR "RED[T54]: objects=0, the interrupt path has no objects.")
endif()
foreach(o IN LISTS objs)
  execute_process(COMMAND "${NM}" "${o}" OUTPUT_VARIABLE syms RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "RED[T54]: nm failed on ${o}")
  endif()
  if(syms MATCHES "__(add|sub|mul|div)[sd]f3|__float|__fix")
    message(FATAL_ERROR "RED[T54]: soft-float symbol in ${o}")
  endif()
endforeach()
# Phase 2 builds audio_int and audio_task; phase 3 added paula_voices; phase 4 adds paula14 and ahi to this list.
foreach(want audio_int audio_task paula_voices paula_hw)
  if(NOT "${objs}" MATCHES "${want}")
    message(FATAL_ERROR "RED[T54]: no ${want} object in the interrupt path list")
  endif()
endforeach()
message(STATUS "[OK] T54 objects=${n}")
