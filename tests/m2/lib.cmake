# Shared helpers of the M2 red tests (plan 2026-10-24-m2-amiga.md, Phase 0, rows I105/I106).
# Inputs every script sets: MODE (desktop|vamos), CLI (host binary), and for vamos VAMOS, AMIGA_CLI.
# Every failure message starts with "RED[<tag>]:" and names the missing feature, so a red run is
# readable as "feature not there yet", never as a typo.

# m2_exec(out_var rc_var <args...>): runs the CLI (or AMIGA_CLI under vamos), captures stdout+stderr.
function(m2_exec out_var rc_var)
  if(MODE STREQUAL "vamos")
    set(cmd "${VAMOS}" -C 68020 -m 8192 ${VAMOS_VOLUMES} -- "${AMIGA_CLI}" ${ARGN})
  else()
    set(cmd "${CLI}" ${ARGN})
  endif()
  execute_process(COMMAND ${cmd} OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  set(${out_var} "${out}${err}" PARENT_SCOPE)
  set(${rc_var} "${rc}" PARENT_SCOPE)
endfunction()

# m2_get(text key var): value of "key=VALUE" (VALUE up to space or newline), empty when absent.
function(m2_get text key var)
  if("${text}" MATCHES "(^|[ \n])${key}=([^ \n]*)")
    set(${var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# m2_need_key(tag text key what): the sentinel must be present, else the feature is missing.
function(m2_need_key tag text key what)
  m2_get("${text}" "${key}" v)
  if(v STREQUAL "")
    message(FATAL_ERROR "RED[${tag}]: sentinel '${key}=' missing, ${what} not implemented.\n--- output ---\n${text}")
  endif()
endfunction()

# m2_check(tag text "key>=N,key==S,key~REGEX,...")
function(m2_check tag text checks)
  string(REPLACE "," ";" list "${checks}")
  foreach(c IN LISTS list)
    if(NOT c MATCHES "^([a-z_0-9.]+)(>=|<=|==|>|<|~)(.*)$")
      message(FATAL_ERROR "m2_check: bad check ${c}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(op "${CMAKE_MATCH_2}")
    set(want "${CMAKE_MATCH_3}")
    m2_get("${text}" "${key}" v)
    if(v STREQUAL "")
      message(FATAL_ERROR "RED[${tag}]: sentinel '${key}=' missing (wanted ${key}${op}${want}).\n--- output ---\n${text}")
    endif()
    set(ok FALSE)
    if(op STREQUAL "~")
      if(v MATCHES "${want}")
        set(ok TRUE)
      endif()
    elseif(op STREQUAL "==")
      if(v STREQUAL want)
        set(ok TRUE)
      endif()
    elseif(op STREQUAL ">=" AND v GREATER_EQUAL want)
      set(ok TRUE)
    elseif(op STREQUAL "<=" AND v LESS_EQUAL want)
      set(ok TRUE)
    elseif(op STREQUAL ">" AND v GREATER want)
      set(ok TRUE)
    elseif(op STREQUAL "<" AND v LESS want)
      set(ok TRUE)
    endif()
    if(NOT ok)
      message(FATAL_ERROR "RED[${tag}]: ${key}=${v}, wanted ${key}${op}${want}.\n--- output ---\n${text}")
    endif()
  endforeach()
endfunction()

# m2_run_ok(tag out_var <args...>): m2_exec that must exit 0; a non-zero exit is the missing feature
# (unknown command or option) and is reported as such.
function(m2_run_ok tag out_var)
  m2_exec(out rc ${ARGN})
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "RED[${tag}]: '${ARGN}' exited ${rc} (command or option not implemented).\n--- output ---\n${out}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# m2_golden(tag value file what): value must equal the first token of a pinned golden file.
function(m2_golden tag value file what)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "RED[${tag}]: golden ${file} missing (${what}).")
  endif()
  file(STRINGS "${file}" lines LIMIT_COUNT 1)
  if(lines STREQUAL "")
    message(FATAL_ERROR "RED[${tag}]: golden ${file} is empty: pin it from the first reviewed green run (${what}).")
  endif()
  string(REGEX MATCH "^[0-9a-f]+" want "${lines}")
  if(NOT value STREQUAL want)
    message(FATAL_ERROR "RED[${tag}]: ${what} ${value} differs from golden ${want}.")
  endif()
endfunction()

# m2_desktop_value(tag key var <args...>): runs the same args on the desktop CLI; value of key.
function(m2_desktop_value tag key var)
  set(MODE desktop)
  m2_run_ok(${tag} dout ${ARGN})
  m2_get("${dout}" "${key}" v)
  set(${var} "${v}" PARENT_SCOPE)
endfunction()
