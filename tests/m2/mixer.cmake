# T53 mixer-led-stereo: LED filter and stereo width through `render`. Sentinels led_frames=, width_frames=.
# Every knob moves the output hash; width 100 equals the plain render; width 0 is mono (width_mono=1);
# desktop and 68k hashes equal. Inputs: MODE CLI MOD WORK GOLDEN_DIR [VAMOS AMIGA_CLI]
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(render tag)
  m2_path(vmod "${MOD}")
  m2_path(vwav "${WORK}/${tag}.wav")
  m2_run_ok(T53 out render "${vmod}" --output "${vwav}" --seconds 2 ${ARGN})
  file(SHA256 "${WORK}/${tag}.wav" h)
  set(${tag}_out "${out}" PARENT_SCOPE)
  set(${tag}_hash "${h}" PARENT_SCOPE)
endfunction()
render(plain)
render(both --led on --stereo-width 50)
m2_check(T53 "${both_out}" "led_frames>0,width_frames>0")
render(led --led on)
render(w0 --stereo-width 0)
render(w100 --stereo-width 100)
m2_check(T53 "${w0_out}" "width_mono==1")
m2_check(T53 "${led_out}" "led_cutoff_hz>=3111,led_cutoff_hz<=3439")
if(NOT w100_hash STREQUAL plain_hash)
  message(FATAL_ERROR "RED[T53]: --stereo-width 100 differs from the plain render")
endif()
foreach(k led both)
  if(${k}_hash STREQUAL plain_hash)
    message(FATAL_ERROR "RED[T53]: knob '${k}' did not move the output hash")
  endif()
endforeach()
# Deviation from the plan text (see m2-phase5-report.md): the test module is mono (L == R in every
# frame), so width 0 and 50 must leave its hash alone; the width knob moves the hash only on a stereo
# source. libopenmpt (desktop only) pans the mk module, so the knob is proven on that one.
if(NOT w0_hash STREQUAL plain_hash)
  message(FATAL_ERROR "RED[T53]: width 0 changed a mono source")
endif()
if(MODE STREQUAL "desktop")
  function(render_mk tag)
    m2_run_ok(T53 out render "${MKMOD}" --output "${WORK}/${tag}.wav" --seconds 2 ${ARGN})
    file(SHA256 "${WORK}/${tag}.wav" h)
    set(${tag}_hash "${h}" PARENT_SCOPE)
  endfunction()
  render_mk(mkplain)
  render_mk(mkw0 --stereo-width 0)
  render_mk(mkw50 --stereo-width 50)
  render_mk(mkw100 --stereo-width 100)
  foreach(k mkw0 mkw50)
    if(${k}_hash STREQUAL mkplain_hash)
      message(FATAL_ERROR "RED[T53]: knob '${k}' did not move the stereo source hash")
    endif()
  endforeach()
  if(mkw0_hash STREQUAL mkw50_hash OR NOT mkw100_hash STREQUAL mkplain_hash)
    message(FATAL_ERROR "RED[T53]: width 0 equals 50, or width 100 differs from plain, on the stereo source")
  endif()
endif()
m2_golden(T53 "${both_hash}" "${GOLDEN_DIR}/render-led.sha256" "render --led on --stereo-width 50")
if(MODE STREQUAL "vamos")
  set(MODE desktop)
  render(dboth --led on --stereo-width 50)
  if(NOT dboth_hash STREQUAL both_hash)
    message(FATAL_ERROR "RED[T53]: 68k and desktop render differ")
  endif()
endif()
message(STATUS "[OK] T53 ${MODE}")
