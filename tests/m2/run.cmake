# Generic M2 red test: up to three steps, each `ARGS<n>` (selecta-cli arguments, @MOD@ expands to the test
# module, @WORK@ to the scratch dir) with `CHECKS<n>` (see m2_check). Optional:
#   GOLDEN_KEY/GOLDEN_FILE  value of a sentinel pinned in a golden file (step 1)
#   HASH_KEY                under vamos, the sentinel must equal the desktop run of step 1 (68k and host agree)
# Inputs: TAG MODE CLI MOD WORK [VAMOS AMIGA_CLI]
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(n 1 2 3)
  if(NOT DEFINED ARGS${n})
    continue()
  endif()
  string(REPLACE "@MOD@" "${MOD}" a "${ARGS${n}}")
  string(REPLACE "@WORK@" "${WORK}" a "${a}")
  separate_arguments(args UNIX_COMMAND "${a}")
  m2_run_ok(${TAG} out ${args})
  m2_check(${TAG} "${out}" "${CHECKS${n}}")
  if(n EQUAL 1)
    if(DEFINED GOLDEN_KEY)
      m2_get("${out}" "${GOLDEN_KEY}" gv)
      m2_golden(${TAG} "${gv}" "${GOLDEN_FILE}" "${GOLDEN_KEY}")
    endif()
    if(DEFINED HASH_KEY AND MODE STREQUAL "vamos")
      m2_get("${out}" "${HASH_KEY}" mine)
      m2_desktop_value(${TAG} "${HASH_KEY}" theirs ${args})
      if(NOT mine STREQUAL theirs)
        message(FATAL_ERROR "RED[${TAG}]: ${HASH_KEY} 68k=${mine} desktop=${theirs} differ.")
      endif()
    endif()
  endif()
endforeach()
message(STATUS "[OK] ${TAG} ${MODE}")
