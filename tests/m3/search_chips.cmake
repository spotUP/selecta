# I1456 text-ui-search-chips: / foldy Enter lists Songs, Albums, Artists; key 2 toggles the Albums chip on its own (only that group), key 1 adds Songs (chips: 1 Songs, 2 Albums, 3 Artists)
# (union of two groups), key 0 is All again. The chip row prints [Name] for a chip that is on.
#   -DSELECTA=<exe> -DCAT=<catalogue_fold.tsv> -DKEYS=<search_fold.keys> -DWORK=<dir> -DCWD=<dir>
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${KEYS}" base)
function(run_keys name text)
  file(WRITE "${WORK}/${name}.keys" "${text}")
  execute_process(
    COMMAND "${SELECTA}" --output null --size 80x25 --start-dir "${CWD}" --catalogue "${CAT}"
            --keys "${WORK}/${name}.keys" --screen-dump "${WORK}/${name}.txt"
    WORKING_DIRECTORY "${CWD}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: selecta exited ${rc}\n${out}\n${err}")
  endif()
  file(READ "${WORK}/${name}.txt" s)
  set(${name}_screen "${s}" PARENT_SCOPE)
endfunction()
run_keys(all "${base}")
if(NOT all_screen MATCHES "0 \\[All\\]" OR NOT all_screen MATCHES "│ +Songs" OR NOT all_screen MATCHES "│ +Albums")
  message(FATAL_ERROR "all screen wrong:\n${all_screen}")
endif()
run_keys(albums "${base}2\nwait 300\n")
if(NOT albums_screen MATCHES "2 \\[Albums\\]" OR albums_screen MATCHES "1 \\[Songs\\]" OR albums_screen MATCHES "│ +Songs \\(" OR NOT albums_screen MATCHES "│ +Albums \\(")
  message(FATAL_ERROR "Albums-only screen wrong:\n${albums_screen}")
endif()
run_keys(union "${base}1\n2\nwait 300\n")
if(NOT union_screen MATCHES "1 \\[Songs\\]" OR NOT union_screen MATCHES "2 \\[Albums\\]" OR NOT union_screen MATCHES "│ +Songs \\(" OR NOT union_screen MATCHES "│ +Albums \\(" OR union_screen MATCHES "│ +Artists \\(")
  message(FATAL_ERROR "Songs+Albums union screen wrong:\n${union_screen}")
endif()
run_keys(back "${base}1\n0\nwait 300\n")
if(NOT back_screen MATCHES "0 \\[All\\]" OR back_screen MATCHES "1 \\[Songs\\]")
  message(FATAL_ERROR "All chip did not clear:\n${back_screen}")
endif()
message(STATUS "search_chips ok")
