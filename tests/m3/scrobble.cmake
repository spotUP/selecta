# T95 (row I177): the engine emits SCROBBLE_DUE, the lastfm integration plugin posts a signed track.scrobble to the
# last.fm fixture, and a scrobble that could not be sent stays in the queue file and drains in the next process.
# -DCLI=<selecta-cli> -DWORK=<fixture work dir> -DM3=<tests/m3> -DSONGS=<build tests/songs>
# -DSONGS_LONG=<build tests/songs-long> (selecta-long-mk.mod, I177a)
file(READ "${WORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "ws.audioscrobbler.com=${fx},fixture.test=${fx}")
set(ENV{SELECTA_LASTFM_KEY} "fixturekey")
set(ENV{SELECTA_LASTFM_SECRET} "fixturesecret")
set(ENV{SELECTA_LASTFM_SESSION} "fixturesession")
set(ENV{SELECTA_SCROBBLE_ARTIST} "Fixture Artist")
set(ENV{SELECTA_SCROBBLE_NOW} "1700000000")
set(queue "${WORK}/t95-queue.txt")
set(live "http://ws.audioscrobbler.com/2.0/")
set(dead "http://127.0.0.1:1/2.0/")

function(reset_fixture)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/reset --method POST OUTPUT_VARIABLE o)
endfunction()

function(run_script out sel url)
  set(ENV{SELECTA_LASTFM_URL} "${url}")
  set(dir "${SONGS}")
  if(ARGC GREATER 3)
    set(dir "${ARGV3}")
  endif()
  execute_process(COMMAND "${CLI}" script "${M3}/${sel}" --integration lastfm WORKING_DIRECTORY "${dir}"
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "T95 scrobble: script ${sel} failed rc=${rc}\n${o}${e}")
  endif()
  set(${out} "${o}${e}" PARENT_SCOPE)
endfunction()

function(expect_counter text name want)
  if(NOT text MATCHES "${name}=([0-9]+)")
    message(FATAL_ERROR "T95 scrobble: counter ${name}= missing\n${text}")
  endif()
  if(NOT CMAKE_MATCH_1 EQUAL want)
    message(FATAL_ERROR "T95 scrobble: ${name}=${CMAKE_MATCH_1}, want ${want}\n${text}")
  endif()
endfunction()

# SCROBBLE_DUE must sit after the first SNAPSHOT line and before the second (one step of 200 ms around the due time).
function(expect_due_between text)
  string(FIND "${text}" "SNAPSHOT" s1)
  string(FIND "${text}" "SCROBBLE_DUE" d)
  string(FIND "${text}" "SNAPSHOT" s2 REVERSE)
  if(s1 EQUAL -1 OR d EQUAL -1 OR NOT s1 LESS d OR NOT d LESS s2)
    message(FATAL_ERROR "T95 scrobble: SCROBBLE_DUE not between the two snapshots\n${text}")
  endif()
  string(REGEX MATCHALL "SCROBBLE_DUE" all "${text}")
  list(LENGTH all n)
  if(NOT n EQUAL 1)
    message(FATAL_ERROR "T95 scrobble: SCROBBLE_DUE fired ${n} times, want 1\n${text}")
  endif()
endfunction()

function(fixture_posts var)
  execute_process(COMMAND "${CLI}" fetch http://fixture.test/__fixture/log --out "${WORK}/t95-log.json" OUTPUT_VARIABLE o)
  file(READ "${WORK}/t95-log.json" logjson)
  set(${var} "${logjson}" PARENT_SCOPE)
endfunction()

# The reference signature, built here without the plugin: parameters sorted by name, name and value concatenated,
# the secret appended, MD5.
function(expect_signed_post logjson index ts duration)
  string(JSON method GET "${logjson}" ${index} method)
  string(JSON path GET "${logjson}" ${index} path)
  string(JSON body GET "${logjson}" ${index} body)
  if(NOT method STREQUAL "POST" OR NOT path STREQUAL "/2.0/")
    message(FATAL_ERROR "T95 scrobble: request ${index} is ${method} ${path}, want POST /2.0/")
  endif()
  set(ref "api_keyfixturekeyartist[0]Fixture Artist")
  if(duration GREATER 0)
    string(APPEND ref "duration[0]${duration}")
  endif()
  string(APPEND ref "methodtrack.scrobbleskfixturesessiontimestamp[0]${ts}track[0]selecta testfixturesecret")
  string(MD5 want "${ref}")
  if(NOT body MATCHES "(^|&)api_sig=([0-9a-f]+)(&|$)" OR NOT CMAKE_MATCH_2 STREQUAL want)
    message(FATAL_ERROR "T95 scrobble: api_sig is not ${want}\n${body}")
  endif()
  foreach(part "method=track.scrobble" "api_key=fixturekey" "sk=fixturesession" "timestamp%5B0%5D=${ts}"
               "artist%5B0%5D=Fixture%20Artist" "track%5B0%5D=selecta%20test" "format=json")
    if(NOT body MATCHES "(^|&)${part}(&|$)")
      message(FATAL_ERROR "T95 scrobble: body lacks ${part}\n${body}")
    endif()
  endforeach()
endfunction()

# ---- case 1: online, half of the known duration (30080 ms, due at 15040 ms)
file(REMOVE "${queue}")
set(ENV{SELECTA_SCROBBLE_QUEUE} "${queue}")
reset_fixture()
run_script(r1 scrobble.sel "${live}")
expect_due_between("${r1}")
expect_counter("${r1}" scrobble_due 1)
expect_counter("${r1}" scrobble_posts 1)
expect_counter("${r1}" scrobble_pending 0)
fixture_posts(log1)
string(JSON n1 LENGTH "${log1}")
if(NOT n1 EQUAL 1)
  message(FATAL_ERROR "T95 scrobble: case 1 sent ${n1} requests, want 1\n${log1}")
endif()
expect_signed_post("${log1}" 0 1699999985 30)
if(EXISTS "${queue}")
  file(READ "${queue}" q1)
  if(NOT q1 STREQUAL "")
    message(FATAL_ERROR "T95 scrobble: queue not empty after a sent scrobble\n${q1}")
  endif()
endif()

# ---- case 2: offline, the scrobble is queued, nothing is lost
file(REMOVE "${queue}")
reset_fixture()
run_script(r2 scrobble.sel "${dead}")
expect_due_between("${r2}")
expect_counter("${r2}" scrobble_due 1)
expect_counter("${r2}" scrobble_posts 0)
expect_counter("${r2}" scrobble_pending 1)
file(READ "${queue}" q2)
if(NOT q2 MATCHES "^1699999985\t30\tFixture Artist\tselecta test\t")
  message(FATAL_ERROR "T95 scrobble: queue file content\n${q2}")
endif()

# ---- case 3: a second process drains the queue with the original timestamp
reset_fixture()
run_script(r3 scrobble_flush.sel "${live}")
expect_counter("${r3}" scrobble_due 0)
expect_counter("${r3}" scrobble_posts 1)
expect_counter("${r3}" scrobble_pending 0)
fixture_posts(log3)
string(JSON n3 LENGTH "${log3}")
if(NOT n3 EQUAL 1)
  message(FATAL_ERROR "T95 scrobble: case 3 sent ${n3} requests, want 1\n${log3}")
endif()
expect_signed_post("${log3}" 0 1699999985 30)
file(READ "${queue}" q3)
if(NOT q3 STREQUAL "")
  message(FATAL_ERROR "T95 scrobble: queue not drained\n${q3}")
endif()
run_script(r3b scrobble_flush.sel "${live}")
expect_counter("${r3b}" scrobble_posts 0)

# ---- case 4 (I177a): a song longer than 8 minutes is due at the 4 minute cap, not at half its length
file(REMOVE "${queue}")
reset_fixture()
run_script(r4 scrobble_long.sel "${live}" "${SONGS_LONG}")
expect_due_between("${r4}")
expect_counter("${r4}" scrobble_due 1)
expect_counter("${r4}" scrobble_posts 1)
fixture_posts(log4)
string(JSON body4 GET "${log4}" 0 body)
foreach(part "timestamp%5B0%5D=1699999760" "track%5B0%5D=selecta%20long")
  if(NOT body4 MATCHES "(^|&)${part}(&|$)")
    message(FATAL_ERROR "T95 scrobble: case 4 body lacks ${part}\n${body4}\n${r4}")
  endif()
endforeach()

file(REMOVE "${queue}")
reset_fixture()
set(ENV{SELECTA_LASTFM_KEY} "")
run_script(r5 scrobble.sel "${live}")
expect_counter("${r5}" scrobble_due 1)
expect_counter("${r5}" scrobble_posts 0)
expect_counter("${r5}" scrobble_pending 0)
if(EXISTS "${queue}")
  message(FATAL_ERROR "T95 scrobble: queue written with scrobbling off")
endif()
fixture_posts(log5)
string(JSON n5 LENGTH "${log5}")
if(NOT n5 EQUAL 0)
  message(FATAL_ERROR "T95 scrobble: scrobbling off but ${n5} requests were sent")
endif()

message(STATUS "scrobble_ok due=15040ms cap=240000ms posts=1 offline_pending=1 drained=1")
