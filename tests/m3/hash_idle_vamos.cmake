# I184b: the idle md5 pass on the 68k binary (no library threads). `script` scans a directory into a fresh DB
# and then only idles: no OPEN and no `library duplicates`, so every md5 comes from sel_library_hash_poll. One
# file is bigger than SEL_HASH_CHUNK (16384 bytes), so the pass must read it across several idle ticks with no
# tick reading more than one chunk. The desktop `library duplicates` then reads the stored values: the two equal
# big files form one group under the md5 CMake computes.
# Inputs: MODE=vamos, CLI, VAMOS, AMIGA_CLI, MOD, WORK. Included helpers: tests/m2/lib.cmake.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/../m2/lib.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/songs/sub")
file(COPY_FILE "${MOD}" "${WORK}/songs/small.mod")
# 50000 bytes: the module plus zero padding (four chunks; the last one is short).
file(READ "${MOD}" mod_hex HEX)
string(LENGTH "${mod_hex}" mod_len)
math(EXPR pad "50000 - ${mod_len} / 2")
string(REPEAT "00" ${pad} pad_hex)
file(WRITE "${WORK}/big.hex" "${mod_hex}${pad_hex}")
execute_process(COMMAND xxd -r -p "${WORK}/big.hex" "${WORK}/songs/big.mod" RESULT_VARIABLE xrc)
if(NOT xrc EQUAL 0)
  message(FATAL_ERROR "RED[I184b]: could not write the big module")
endif()
file(COPY_FILE "${WORK}/songs/big.mod" "${WORK}/songs/sub/big-copy.mod")
file(SIZE "${WORK}/songs/big.mod" big_size)
file(MD5 "${WORK}/songs/big.mod" big_md5)
if(NOT big_size EQUAL 50000)
  message(FATAL_ERROR "RED[I184b]: big module is ${big_size} bytes, want 50000")
endif()

file(WRITE "${WORK}/hash.sel" "LIBRARY_SCAN work:songs\n@hash_stats\n@idle 40\n@hash_stats\n@dup_stats\n")
set(VAMOS_VOLUMES -V "work:${WORK}")
m2_exec(out rc script work:hash.sel --db work:lib.db)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "RED[I184b]: script failed rc=${rc}\n${out}")
endif()
string(REGEX MATCHALL "HASH files=[0-9]+ chunks=[0-9]+ tick_max=[0-9]+" hs "${out}")
list(LENGTH hs nhs)
if(NOT nhs EQUAL 2)
  message(FATAL_ERROR "RED[I184b]: want two HASH lines\n${out}")
endif()
list(GET hs 1 last)
m2_get("${last}" files files)
m2_get("${last}" chunks chunks)
m2_get("${last}" tick_max tick_max)
# Three files: small (one chunk) and two of 50000 bytes (16384 * 3 + 848: four chunks each).
if(NOT files EQUAL 3)
  message(FATAL_ERROR "RED[I184b]: the idle pass hashed ${files} files, want 3\n${out}")
endif()
if(NOT chunks EQUAL 9)
  message(FATAL_ERROR "RED[I184b]: the idle pass read ${chunks} chunks, want 9 (1 + 4 + 4)\n${out}")
endif()
if(NOT tick_max EQUAL 16384)
  message(FATAL_ERROR "RED[I184b]: one idle tick read ${tick_max} bytes, want at most and exactly 16384\n${out}")
endif()
if(NOT out MATCHES "DUP redirects=0 ")
  message(FATAL_ERROR "RED[I184b]: the script opened a song\n${out}")
endif()

set(MODE desktop)
m2_exec(d_out d_rc library duplicates --db "${WORK}/lib.db")
if(NOT d_rc EQUAL 0 OR NOT d_out MATCHES "dupes=1" OR NOT d_out MATCHES "${big_md5}")
  message(FATAL_ERROR "RED[I184b]: stored md5 does not group the big copies under ${big_md5} rc=${d_rc}\n${d_out}")
endif()
message("hash_idle_vamos_ok files=${files} chunks=${chunks} tick_max=${tick_max}")
