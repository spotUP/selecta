  # Case 1 asserts muimaster.library is the MUI 3.8 family (version 19) and the list classes; case 2 asserts the tier:
  # 2 MB chip (Avail chip maximum 209xxxx) with fast RAM present. The Replay case is a manual fact.
  ami(ver exec "Version LIBS:muimaster.library" 10)
  if(NOT ver MATCHES "muimaster.library 19\\.[0-9]+")
    message(FATAL_ERROR "RED[M4MUIFACTS]: no muimaster.library 19.x:\n${ver}")
  endif()
  message(STATUS "M4MUIFACTS ${ver}")
  foreach(c NList.mcc NListview.mcc Listtree.mcc)
    ami(cls exec "List MUI:Libs/MUI/${c} LFORMAT %n" 10)
    if(NOT cls MATCHES "${c}")
      message(FATAL_ERROR "RED[M4MUIFACTS]: ${c} missing in MUI:Libs/MUI:\n${cls}")
    endif()
  endforeach()
  ami(av exec "Avail" 10)
  if(NOT av MATCHES "chip +[0-9]+ +[0-9]+ +(209[0-9]+) " OR NOT av MATCHES "fast +[0-9]+ +[0-9]+ +([0-9]+)")
