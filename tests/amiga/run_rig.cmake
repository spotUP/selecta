elseif(TAG STREQUAL "M4MUINO")
  # MUI-P1-6 / M4-P11-2: MUI absent on rig 2. The rig has MUI installed, so the test makes it absent by renaming
  # the MUI drawer from the LIBS: multi-assign (rig.py RIG_LIBS adds DH0:MUI/Libs; no reboot needed) and re-adds it on EVERY path, a RED
  # included (nomui_fail below). Sentinels: (1) a requester titled "Selecta" with a Continue button owned by the Selecta
  # process, (2) dismissed by clicking Continue, (3) the text UI then runs (--output null --keys quit.keys) and its
  # stats line shows keys>=1, (4) exit code rc=0. The requester BODY text cannot be read on the rig (the requester list
  # gives title and buttons only, and Selecta's stderr is not captured); the host test mui-open-nomui asserts the text.
  set(P "RAM:SelectaMUI")
  function(nomui_restore)
    execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" exec "Break 0 C" 10 OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
    execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" exec "Assign LIBS: DH0:MUI/Libs ADD" 10 OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
  endfunction()
  function(nomui_fail msg)
    nomui_restore()
    message(FATAL_ERROR "RED[M4MUINO]: ${msg}")
  endfunction()
  file(WRITE "${WORK}/nomui.script"
    "Stack 200000\n${P} --ui mui --output null --keys RAM:quit.keys --stats >RAM:nomui-out.txt\nEcho \"rc=$RC\" >RAM:nomui-rc.txt\n")
  ami(ignored exec "Delete >NIL: RAM:nomui-out.txt RAM:nomui-rc.txt ${P} QUIET" 10)
  ami(ignored put "${SELECTA}" "${P}")
  ami(ignored put "${KEYS}" "RAM:quit.keys")
  ami(ignored put "${WORK}/nomui.script" "RAM:nomui.script")
  # Hide: take the drawer out of LIBS:, then expunge the unused muimaster.library from memory. Measured on rig 2:
  # afterwards `Version muimaster.library` fails "object not found"; the add above is the exact reverse.
  ami(ignored exec "Assign LIBS: DH0:MUI/Libs REMOVE" 10)
  ami(ignored exec "Avail FLUSH >NIL:" 10)
  execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" exec "Version muimaster.library" 10 OUTPUT_VARIABLE hid ERROR_VARIABLE hid_err TIMEOUT 60)
  if(hid MATCHES "muimaster.library [0-9]")
    nomui_fail("muimaster.library is still found after the hide (resident in memory?): ${hid}")
  endif()
  ami(ignored exec "Run >NIL: Execute RAM:nomui.script" 10)
  # (1) the requester: poll up to 60 s (Execute, the load from RAM: and the failed MUI open take several seconds).
  set(req "")
  foreach(i RANGE 1 12)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" requesters OUTPUT_VARIABLE req ERROR_VARIABLE req_err TIMEOUT 60)
    if(req MATCHES "\"Selecta\"")
      break()
    endif()
  endforeach()
  if(NOT req MATCHES "\"Selecta\" \\(task [^,]*SelectaMUI[^,]*,[^\n]*buttons [^\n]*Continue")
    nomui_fail("no requester \"Selecta\" with a Continue button owned by SelectaMUI while MUI is absent:\n${req}")
  endif()
  # (2) dismiss it.
  ami(ignored ui click ${UIW} Continue)
  # (3) and (4): the script ends after the text UI has run the key file; poll up to 60 s for the rc file.
  set(rc_txt "")
  foreach(i RANGE 1 12)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" exec "Type RAM:nomui-rc.txt" 10 OUTPUT_VARIABLE rc_txt ERROR_VARIABLE rc_err TIMEOUT 60)
    if(rc_txt MATCHES "rc=")
      break()
    endif()
  endforeach()
  nomui_restore()
  fetch(out "RAM:nomui-out.txt")
  if(NOT rc_txt MATCHES "rc=0")
    message(FATAL_ERROR "RED[M4MUINO]: Selecta did not exit with rc=0 (rc file: '${rc_txt}') after the requester; output:\n${out}")
  endif()
  if(NOT out MATCHES "keys=([0-9]+)" OR CMAKE_MATCH_1 LESS 1)
    message(FATAL_ERROR "RED[M4MUINO]: the text UI did not run after the requester (keys>=1 missing in the stats):\n${out}")
  endif()
  ami(ignored exec "Delete >NIL: RAM:nomui-out.txt RAM:nomui-rc.txt RAM:nomui.script RAM:quit.keys ${P} QUIET" 10)
