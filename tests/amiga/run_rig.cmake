elseif(TAG STREQUAL "M4MUIMEM")
  # MUI-P0-3: memory cost of muimaster.library plus one window. Avail (chip, fast) at three points with the Selecta binary
  # already in RAM: (A0) before the start, after Avail FLUSH, (A1) with the MUI window open, (A2) after Selecta exited
  # (the library stays resident: its own cost). Prints the deltas; asserts the window really opened (ui_open_mui=1) and
  # that the open took fast RAM. Run on a fresh boot of the 68020 rig (`rig.py start --a1200`): after a prior MUI run the
  # library is resident and A0 already contains it.
  set(P "RAM:SelectaMUI")
  file(WRITE "${WORK}/mem.script" "Stack 200000\n${P} --ui mui --stats >RAM:mem-out.txt\n")
  function(avail_nums prefix)
    ami(av exec "Avail" 10)
    if(NOT av MATCHES "chip +([0-9]+) +([0-9]+) .*fast +([0-9]+) +([0-9]+)")
      message(FATAL_ERROR "RED[M4MUIMEM]: cannot parse Avail:\n${av}")
    endif()
    set(${prefix}_chip ${CMAKE_MATCH_1} PARENT_SCOPE)
    set(${prefix}_fast ${CMAKE_MATCH_3} PARENT_SCOPE)
  endfunction()
  ami(ignored exec "Delete >NIL: RAM:mem-out.txt ${P} QUIET" 10)
  ami(ignored put "${SELECTA}" "${P}")
  ami(ignored put "${WORK}/mem.script" "RAM:mem.script")
  ami(ignored exec "Avail FLUSH >NIL:" 10)
  avail_nums(a0)
  ami(ignored exec "Run >NIL: Execute RAM:mem.script" 10)
  set(pid "")
  foreach(i RANGE 1 12)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    ami(procs exec "Status" 10)
    if(procs MATCHES "Process +([0-9]+): Loaded as command: ${P}")
      set(pid "${CMAKE_MATCH_1}")
      ami(tree uitree)
      if(tree MATCHES "label - \"Selecta\"")
        break()
      endif()
    endif()
  endforeach()
  if(pid STREQUAL "")
    message(FATAL_ERROR "RED[M4MUIMEM]: ${P} never ran for 60 s")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  avail_nums(a1)
  ami(ignored exec "Break ${pid} C" 10)
  foreach(i RANGE 1 6)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    ami(procs exec "Status" 10)
    if(NOT procs MATCHES "Loaded as command: ${P}")
      break()
    endif()
  endforeach()
  avail_nums(a2)
  fetch(out "RAM:mem-out.txt")
  if(NOT out MATCHES "ui_open_mui=1")
    message(FATAL_ERROR "RED[M4MUIMEM]: ui_open_mui=1 missing, the window did not open:\n${out}")
  endif()
  math(EXPR open_chip "${a0_chip} - ${a1_chip}")
  math(EXPR open_fast "${a0_fast} - ${a1_fast}")
  math(EXPR lib_chip "${a0_chip} - ${a2_chip}")
  math(EXPR lib_fast "${a0_fast} - ${a2_fast}")
  message(STATUS "M4MUIMEM A0 chip=${a0_chip} fast=${a0_fast}; A1 (window open) chip=${a1_chip} fast=${a1_fast}; A2 (after exit) chip=${a2_chip} fast=${a2_fast}")
  message(STATUS "M4MUIMEM delta window-open: chip=${open_chip} fast=${open_fast}; resident after exit: chip=${lib_chip} fast=${lib_fast}")
  if(open_fast LESS 1)
    message(FATAL_ERROR "RED[M4MUIMEM]: opening the window took no fast RAM (${open_fast}); instrument dead")
  endif()
  ami(ignored exec "Delete >NIL: RAM:mem-out.txt RAM:mem.script ${P} QUIET" 10)
else()
  message(FATAL_ERROR "run_rig.cmake: unknown TAG ${TAG}")
endif()
clean()
message(STATUS "[OK] ${TAG}")
