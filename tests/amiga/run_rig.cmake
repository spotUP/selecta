elseif(TAG STREQUAL "I623NET")
  # I623: Ctrl-C did not quit the AGA Selecta. bsdsocket's default break mask is CTRL_C, so a wait that a break hits
  # returns EINTR and the stack CLEARS the bit; the net layer runs on the main task, so the UI poll never saw the break.
  # selecta-net-break opens 10.255.255.1 (never answers, 10 s connect timeout) with the break pending (case 1) and with
  # the break sent by Break during the wait (case 2). Both must end at once AND keep the bit: ctrl_c_kept=1.
  ami(ignored put "${NET_BREAK}" "RAM:net-break")
  ami(pend exec "RAM:net-break pending" 30)
  if(NOT pend MATCHES "net_break mode=pending rc=-[0-9]+ ms=([0-9]+) ctrl_c_kept=1")
    message(FATAL_ERROR "RED[I623NET]: the pending break was swallowed by the net layer:\n${pend}")
  endif()
  if(CMAKE_MATCH_1 GREATER 3000)
    message(FATAL_ERROR "RED[I623NET]: a pending break did not end the connect wait (ms=${CMAKE_MATCH_1}):\n${pend}")
  endif()
  ami(ignored exec "Delete RAM:net-break-out.txt QUIET" 10)
  ami(ignored exec "Run >NIL: RAM:net-break wait >RAM:net-break-out.txt" 10)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  ami(procs exec "Status" 10)
  string(REGEX MATCH "Process +([0-9]+): Loaded as command: RAM:net-break" hit "${procs}")
  if(hit STREQUAL "")
    message(FATAL_ERROR "RED[I623NET]: net-break is not waiting after 3 s: ${procs}")
  endif()
  ami(ignored exec "Break ${CMAKE_MATCH_1} C" 10)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  fetch(waitout "RAM:net-break-out.txt")
  if(NOT waitout MATCHES "net_break mode=wait rc=-[0-9]+ ms=([0-9]+) ctrl_c_kept=1")
    message(FATAL_ERROR "RED[I623NET]: the break sent during the wait was swallowed by the net layer:\n${waitout}")
  endif()
  if(CMAKE_MATCH_1 GREATER 6000)
    message(FATAL_ERROR "RED[I623NET]: the break did not end the connect wait (ms=${CMAKE_MATCH_1}):\n${waitout}")
  endif()
  message(STATUS "I623NET pending: ${pend}")
  message(STATUS "I623NET wait: ${waitout}")
  ami(ignored exec "Delete RAM:net-break RAM:net-break-out.txt QUIET" 10)
elseif(TAG STREQUAL "M4MUIFACTS")
