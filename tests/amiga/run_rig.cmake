# Rig driver for the M2 rig tests T56, T59, T60 (plan 2026-10-24-m2-amiga.md, row I106).
# The rig is FS-UAE driven by ~/Code/UP-Term/vtcon/tools/rig (`rig.py start`); the `amiga` MCP server is
# wasabi's client of the same wasabid. A test script cannot call MCP tools, so this driver uses the MCP's
# sibling: `ami.py` (ping | exec | put | get | type | key), the rig's own CLI over the same wasabid socket.
#
# Rig down: prints `SKIPPED rig not running` and exits 0; the ctest entries carry
#   SKIP_REGULAR_EXPRESSION "SKIPPED rig not running" so ctest reports Skipped, never Passed.
# Rig up: runs the scenario for TAG; a missing binary or sentinel is a red failure.
#
# Inputs: TAG (T56|T58|T59|T60)  RIG_DIR  SELECTA (Amiga binary)  SELECTA_CLI (Amiga selecta-cli)  MOD (selecta-test.mod)  WORK (scratch dir)
# The rig number comes from the caller (`UPTERM_RIG=<n> ctest -R rig-...`), never from a default: rig.py and ami.py read
# UPTERM_RIG, and a silent default once ran a rig 8 batch on rig 2 (I568).
if("$ENV{UPTERM_RIG}" STREQUAL "")
  message(FATAL_ERROR "RED[${TAG}]: UPTERM_RIG is not set: name the rig, e.g. UPTERM_RIG=8 ctest -R rig-m4-mui-open")
endif()
message(STATUS "rig ${TAG}: UPTERM_RIG=$ENV{UPTERM_RIG}")
find_program(PYTHON3 python3)
if(NOT PYTHON3 OR NOT EXISTS "${RIG_DIR}/ami.py")
  message(STATUS "SKIPPED rig not running (python3 or ${RIG_DIR}/ami.py not found)")
  return()
endif()

# Rig up = rig.py status does not say down and ami.py ping answers.
execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/rig.py" status
  OUTPUT_VARIABLE status ERROR_VARIABLE status_err RESULT_VARIABLE status_rc TIMEOUT 30)
execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" ping
  OUTPUT_VARIABLE ping_out ERROR_VARIABLE ping_err RESULT_VARIABLE ping_rc TIMEOUT 30)
if(NOT status_rc EQUAL 0 OR status MATCHES "down" OR NOT ping_rc EQUAL 0)
  message(STATUS "SKIPPED rig not running (${TAG}: status='${status}' ping rc=${ping_rc}; start: python3 ${RIG_DIR}/rig.py start)")
  return()
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
include("${CMAKE_CURRENT_LIST_DIR}/../m2/lib.cmake")

# ami(out_var <args...>): one ami.py call, must succeed.
function(ami out_var)
  execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" ${ARGN}
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc TIMEOUT 600)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "RED[${TAG}]: ami.py ${ARGN} exited ${rc}\n${out}${err}")
  endif()
  set(${out_var} "${out}${err}" PARENT_SCOPE)
endfunction()

# fetch(var path): get a file from the Amiga into a variable.
function(fetch var path)
  ami(ignored get "${path}" "${WORK}/fetched")
  file(READ "${WORK}/fetched" text)
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

# clean(): drops what this script puts in RAM: (Selecta + selecta-cli are 25 MB; RAM: on the rig holds 24 MB free).
# Runs before the put, so a run that stopped on a RED still gets cleared by the next one, and again after a pass.
function(clean)
  execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" exec
    "Delete >NIL: RAM:Selecta RAM:selecta-cli RAM:selecta-test.mod QUIET" 10
    OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
endfunction()

# rig_mode(aga|rtg): the Workbench screen mode is a boot-time pref of the rig (rig.py aga / rtg reboot it), and the two M4
# first-light tests need different ones: the AGA screen is the native 640x256 PAL mode only when Workbench is native
# (on the card the same call opens 800x600), the RTG test needs the card. Each test puts the rig in its own mode.
function(rig_mode mode)
  execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/rig.py" ${mode} OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE rc TIMEOUT 300)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "RED[${TAG}]: rig.py ${mode} exited ${rc}")
  endif()
  foreach(i RANGE 1 60)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" ping OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE prc TIMEOUT 20)
    if(prc EQUAL 0)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 10)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "RED[${TAG}]: the rig did not come back after rig.py ${mode}")
endfunction()

if(NOT EXISTS "${SELECTA}")
  message(FATAL_ERROR "RED[${TAG}]: ${SELECTA} not built: apps/selecta has no Amiga build yet.")
endif()
if(NOT TAG STREQUAL "M4RTG" AND NOT TAG STREQUAL "M4AGA" AND NOT TAG STREQUAL "M4MUI" AND NOT TAG STREQUAL "M4MUINO" AND NOT TAG STREQUAL "M4MUIFACTS" AND NOT TAG STREQUAL "M4MUIMEM" AND NOT TAG STREQUAL "M4MUIDROP" AND NOT TAG STREQUAL "M4MUISTYLES" AND NOT TAG STREQUAL "M4MUILIST" AND NOT TAG STREQUAL "M4MUIVIZ" AND NOT TAG STREQUAL "I623NET")
  clean()
  ami(ignored put "${SELECTA}" "RAM:Selecta")
  ami(ignored put "${MOD}" "RAM:selecta-test.mod")
endif()

if(TAG STREQUAL "T56")
  # Library view, keys only: Enter plays the first entry; after 5 s the stats file is read.
  ami(ignored exec "Run >NIL: RAM:Selecta --output paula --stats T:selecta-stats --start-dir RAM:" 10)
  ami(ignored key 13)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
  ami(ignored type "q")
  fetch(stats "T:selecta-stats")
  m2_check(T56 "${stats}" "paula_ints>=225,paula_ints<=275,underruns==0,out==paula")
elseif(TAG STREQUAL "T58")
  # Task priority read back on real exec (vamos stubs SetTaskPri), row I117.
  ami(ignored put "${SELECTA_CLI}" "RAM:selecta-cli")
  ami(out exec "RAM:selecta-cli --dry-run PRI=5" 10)
  m2_check(T58 "${out}" "task_pri_requested==5,task_pri==5")
elseif(TAG STREQUAL "T59")
  # RENDER-kind song on AHI; swaps = elapsed_ms * rate / buffer_frames / 1000 +-10%.
  ami(ignored exec "RAM:Selecta OUTPUT=AHI --play RAM:selecta-test.mod --seconds 10 --stats T:selecta-stats" 60)
  fetch(stats "T:selecta-stats")
  m2_check(T59 "${stats}" "ahi_bufs>0,underruns==0,ahi_swaps_expected>0,buffer_frames_default_68020==1")
  m2_get("${stats}" ahi_bufs got)
  m2_get("${stats}" ahi_swaps_expected want)
  math(EXPR lo "${want} * 90 / 100")
  math(EXPR hi "${want} * 110 / 100")
  if(got LESS lo OR got GREATER hi)
    message(FATAL_ERROR "RED[T59]: ahi_bufs=${got}, wanted ${lo}..${hi}")
  endif()
elseif(TAG STREQUAL "T60")
  # Per-player batch on the no-FPU machine (rig.py start --a1200 --nofpu), one verdict per player.
  if(NOT "$ENV{SEL_RIG_NOFPU}" STREQUAL "1")
    message(FATAL_ERROR "RED[T60]: needs the no-FPU rig: python3 ${RIG_DIR}/rig.py start --a1200 --nofpu, then SEL_RIG_NOFPU=1")
  endif()
  ami(ignored exec "RAM:Selecta --budget-batch T:selecta-budget" 1800)
  fetch(budget "T:selecta-budget")
  m2_check(T60 "${budget}" "players_measured>=1,players_over_budget_unflagged==0")
  string(REGEX MATCHALL "tick_us_max=[0-9]+" ticks "${budget}")
  foreach(t IN LISTS ticks)
    string(REGEX REPLACE "tick_us_max=" "" us "${t}")
    if(us GREATER_EQUAL 20000)
      message(FATAL_ERROR "RED[T60]: a player has ${t}, over one 50 Hz tick, without SEL_RP_NEEDS_FLOAT")
    endif()
  endforeach()
elseif(TAG STREQUAL "M4RTG")
  rig_mode(rtg)
  # I450 / M4-P5-1: RTG first light through the real entry point (Selecta --ui desktop --backend rtg), run on rig 2
  # (uaegfx; the caller sets UPTERM_RIG). A real library (the genre test modules scanned on the Amiga) is shown on the
  # Library page. Sentinels printed by the product: `rtg: screen WxH depth D` (the backend opened a Picasso96 screen),
  # `ui_backend ... backend=rtg` (the stats name the backend that ran), the composer row `|Unknown composer|4`
  # (the library rows reached the page), and `ui_scale_q16=51200 ui_zoom=fit ui_logical=1024x768` (I458: the 1024x768
  # logical UI fits the 800x600 screen at scale 0.78125). The product runs until Ctrl-C (Break), which closes the screen cleanly.
  set(B "SYS:selecta-test")
  file(WRITE "${WORK}/rtg.script" "Stack 200000\n${B}/Selecta --ui desktop --backend rtg --canvas 800x600 --view library --stats --db ${B}/library.db >RAM:rtg-out.txt\n")
  ami(ignored exec "MakeDir ${B} ${B}/mods" 10)
  ami(ignored exec "Delete RAM:rtg-out.txt ${B}/library.db QUIET" 10)
  ami(ignored put "${SELECTA}" "${B}/Selecta")
  ami(ignored put "${SELECTA_CLI}" "${B}/selecta-cli")
  file(GLOB genre_mods "${GENRE_DIR}/*.mod")
  foreach(m IN LISTS genre_mods)
    get_filename_component(mn "${m}" NAME)
    ami(ignored put "${m}" "${B}/mods/${mn}")
  endforeach()
  ami(scan exec "${B}/selecta-cli library scan --db ${B}/library.db ${B}/mods" 120)
  if(NOT scan MATCHES "db_songs=4")
    message(FATAL_ERROR "RED[M4RTG]: the Amiga scan did not find 4 songs: ${scan}")
  endif()
  ami(ignored put "${WORK}/rtg.script" "${B}/rtg.script")
  ami(ignored exec "Run >NIL: Execute ${B}/rtg.script" 10)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 15)
  ami(procs exec "Status" 10)
  string(REGEX MATCH "Process +([0-9]+): Loaded as command: ${B}/Selecta" hit "${procs}")
  if(hit STREQUAL "")
    message(FATAL_ERROR "RED[M4RTG]: Selecta is not running after 15 s (the UI did not open): ${procs}")
  endif()
  ami(ignored exec "Break ${CMAKE_MATCH_1} C" 10)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
  fetch(out "RAM:rtg-out.txt")
  foreach(want "rtg: screen 800x600 depth" "ui_backend id=desktop backend=rtg" "|Unknown composer|4" "desktop_ui closed frames=" "ui_scale_q16=51200 ui_zoom=fit ui_logical=1024x768")
    string(FIND "${out}" "${want}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "RED[M4RTG]: sentinel '${want}' missing in:\n${out}")
    endif()
  endforeach()
  ami(ignored exec "Delete RAM:rtg-out.txt QUIET" 10)
elseif(TAG STREQUAL "M4MUI")
  # I508 / MUI-P1-3, MUI-P1-5: the MUI UI opens its window through the real entry point (Selecta --ui mui) on rig 2, in
  # whatever screen mode the rig is in (no rig_mode: the window opens on the public screen either way). Sentinels: a
  # window titled "Selecta" carrying the MUI text label in the rig's window list while it runs, `ui_open_mui=1` in the
  # stats (counted only after MUIA_Window_Open reads back TRUE), the process gone after Break (SEL_UI_CLOSE disposed
  # the Application), and no "Selecta" window left behind. The binary runs as RAM:SelectaMUI so the Status match never
  # picks up another Selecta process on the rig.
  set(P "RAM:SelectaMUI")
  # MUI-P3-1 / MUI-P2-6: with a real module (SONG, from the SEL_MUI_SONG cache variable or env var; absent: those steps are
  # skipped with a NOTE and the rest of the test still runs) in a start drawer, the double-click on its list row must play it.
  set(song_ok FALSE)
  set(SONG_NAME "meme.mod")
  if(DEFINED SONG AND NOT SONG STREQUAL "" AND EXISTS "${SONG}")
    set(song_ok TRUE)
  else()
    message(STATUS "NOTE[M4MUI]: SEL_MUI_SONG not set or missing: MUI-P3-1 / MUI-P2-6 rig steps skipped")
  endif()
  if(song_ok)
    # The name is fixed and free of underscores: MUI reads "_" in a label as a shortcut mark and drops it from the text.
    ami(ignored exec "Delete >NIL: RAM:mui-mm ALL QUIET" 10)
    ami(ignored exec "MakeDir RAM:mui-mm" 10)
    ami(ignored put "${SONG}" "RAM:mui-mm/${SONG_NAME}")
    ami(ignored put "${SONG}" "RAM:mui-mm/meme2.mod")
    # Home lists a played local song only when it is in the library (I555, user.c home list), so the start drawer is scanned
    # in before the UI opens (--exec LIBRARY_SCAN); MUI-P4-1 double-clicks the Home row of that song.
    file(WRITE "${WORK}/mui.script" "Stack 200000\n${P} --ui mui --start-dir RAM:mui-mm --exec \"LIBRARY_SCAN RAM:mui-mm\" --exec \"QUEUE_ADD RAM:mui-mm/${SONG_NAME}\" --exec \"QUEUE_ADD RAM:mui-mm/meme2.mod\" --exec \"PLAYLIST_CREATE rigpl\" --stats >RAM:mui-out.txt\n")
  else()
    file(WRITE "${WORK}/mui.script" "Stack 200000\n${P} --ui mui --stats >RAM:mui-out.txt\n")
  endif()
  ami(ignored exec "Delete >NIL: RAM:mui-out.txt ${P} QUIET" 10)
  ami(ignored put "${SELECTA}" "${P}")
  ami(ignored put "${WORK}/mui.script" "RAM:mui.script")
  ami(ignored exec "Run >NIL: Execute RAM:mui.script" 10)
  # I675: the Selecta window has no title, so a window argument of one space (matches every window of the front screen)
  # selects it; ami.py drops an empty argument.
  set(UIW " ")
  # Execute, the 9 MB load from RAM: and the MUI open take several seconds: poll up to 60 s for the window.
  set(pid "")
  set(tree "")
  foreach(i RANGE 1 12)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    ami(procs exec "Status" 10)
    if(procs MATCHES "Process +([0-9]+): Loaded as command: ${P}")
      set(pid "${CMAKE_MATCH_1}")
      ami(tree uitree)
      if(tree MATCHES "button - \"Stop\"")
        break()
      endif()
    endif()
  endforeach()
  if(pid STREQUAL "")
    execute_process(COMMAND "${PYTHON3}" "${RIG_DIR}/ami.py" exec "Type RAM:mui-out.txt" 10 OUTPUT_VARIABLE out ERROR_VARIABLE out
      TIMEOUT 60)
    message(FATAL_ERROR "RED[M4MUI]: ${P} never ran for 60 s:\n${out}")
  endif()
  # I675: the window has no title bar and an empty title, so the app is identified by its screen title "Selecta".
  if(NOT tree MATCHES "S [0-9]+ [0-9]+x[0-9]+ depth=[0-9]+ \"Selecta\"" OR NOT tree MATCHES "button - \"Stop\"")
    ami(ignored exec "Break ${pid} C" 10)
    message(FATAL_ERROR "RED[M4MUI]: no MUI window \"Selecta\" with its transport gadgets in the window list:\n${tree}")
  endif()
  # I511 / MUI-P1-3 / D-M4-3: the window opens at the size of the public screen (full screen default; MUI places a
  # 100 percent window over the whole screen). The screen size comes from the `screens` record (first screen: width and
  # height as big-endian words after a count byte and a flag byte); a window of any other size, such as the 49x41 a lone
  # Text object gave, fails.
  ami(scr screens)
  if(NOT scr MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]([0-9a-f][0-9a-f][0-9a-f][0-9a-f])([0-9a-f][0-9a-f][0-9a-f][0-9a-f])")
    message(FATAL_ERROR "RED[M4MUI]: cannot parse the screens record: ${scr}")
  endif()
  math(EXPR scr_w "0x${CMAKE_MATCH_1}")
  math(EXPR scr_h "0x${CMAKE_MATCH_2}")
  if(NOT tree MATCHES "W [0-9]+ [0-9]+ [0-9]+ ${scr_w}x${scr_h} [a-z-]+ \"[^\"]*\"")
    ami(ignored exec "Break ${pid} C" 10)
    message(FATAL_ERROR "RED[M4MUI]: the MUI window is not the screen area ${scr_w}x${scr_h}:\n${tree}")
  endif()
  # MUI-P2-3 / MUI-P2-4: the native Menustrip fires an item. "Playback/Stop" carries the shortcut key "s", so the rig's
  # right-Amiga+s (ami.py ui menushort) must reach the Menuitem trigger, which sends the action line to the engine and
  # bumps the menus= counter printed on the ui_stats id=mui line.
  ami(ignored ui menushort ${UIW} s)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  if(song_ok)
    # MUI-P3-1: ".." is the selected row after the scan; the double-click on the song row plays it: the song label shows
    # the clicked song and the status word reads "Playing".
    ami(ignored ui dclick ${UIW} "${SONG_NAME}")
    set(playing FALSE)
    foreach(i RANGE 1 12)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
      ami(tree uitree)
      if(tree MATCHES "label - \"Playing\"" AND tree MATCHES "label - \"${SONG_NAME}\"")
        set(playing TRUE)
        break()
      endif()
    endforeach()
    if(NOT playing)
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P3-1: double-click on the list row \"${SONG_NAME}\" did not show the song label and \"Playing\":\n${tree}")
    endif()
    # MUI-P2-6: while playing the clock label is a time (not "--:--"), it advances between two reads, the status word is
    # not "Stopped".
    if(NOT tree MATCHES "label - \"([0-9][0-9]):([0-9][0-9])\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P2-6: no MM:SS time label while playing (still \"--:--\"?):\n${tree}")
    endif()
    math(EXPR t1 "${CMAKE_MATCH_1} * 60 + ${CMAKE_MATCH_2}" OUTPUT_FORMAT DECIMAL)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    ami(tree uitree)
    if(NOT tree MATCHES "label - \"([0-9][0-9]):([0-9][0-9])\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P2-6: the time label vanished on the second read:\n${tree}")
    endif()
    math(EXPR t2 "${CMAKE_MATCH_1} * 60 + ${CMAKE_MATCH_2}" OUTPUT_FORMAT DECIMAL)
    if(NOT t2 GREATER t1 OR tree MATCHES "label - \"Stopped\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P2-6: the time label did not advance (${t1} s then ${t2} s) or the status reads Stopped:\n${tree}")
    endif()
    message(STATUS "M4MUI P3-1 / P2-6: row double-click played ${SONG_NAME}; time ${t1} s then ${t2} s")
  endif()
  # MUI-P2-5 / MUI-P2-6 / MUI-P3-1 (wiring): the transport row is real gadgets (a Stop button the rig finds by its label
  # and clicks with the mouse); the click must reach mui_control_fire, send the action line and bump transport_hits on
  # the ui_stats id=mui line.
  ami(tree uitree)
  if(NOT tree MATCHES "G [0-9]+ [0-9]+ [0-9]+ [0-9]+x[0-9]+ [a-z-]+ [a-z-]+ \"Stop\"")
    ami(ignored exec "Break ${pid} C" 10)
    message(FATAL_ERROR "RED[M4MUI]: no transport gadget \"Stop\" in the MUI window:\n${tree}")
  endif()
  # MUI-P4-0 (rig-m4-mui-sidebar): the sidebar slot lists all 7 doors of the shared uimodel table; a click on Search moves
  # the engine view source to search (printed as view_source=search in the exit stats, checked below).
  foreach(door "Home" "Search" "Your Library" "Playlists" "Queue" "Now Playing" "Song Information")
    if(NOT tree MATCHES "\"${door}\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P4-0: sidebar door \"${door}\" missing in the window list:\n${tree}")
    endif()
  endforeach()
  # MUI-P4-2: the Library view (browse source, start drawer RAM:mui-mm) shows the path as crumb buttons "RAM:" and
  # "mui-mm"; a click on the "RAM:" crumb must send LIBRARY_BROWSE "RAM:" (crumb>=1) and the "mui-mm" crumb must go.
  if(song_ok)
    ami(ctree uitree)
    if(NOT ctree MATCHES "button - \"RAM:\"" OR NOT ctree MATCHES "button - \"mui-mm\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P4-2: no crumb buttons \"RAM:\" and \"mui-mm\" for the browse path RAM:mui-mm:\n${ctree}")
    endif()
    ami(ignored ui click ${UIW} "RAM:")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
    ami(ctree uitree)
    # The window tree keeps hidden (ShowMe FALSE) objects at their old place, so a vanished crumb button cannot be read from
    # it; the click is proved by the crumb counter on the ui_p4 exit line (checked below) and the window must still be there.
    if(NOT ctree MATCHES "W [0-9]+ [0-9]+ [0-9]+ [0-9x]+ [a-z]* *\"Selecta\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P4-2: the Selecta window is gone after the RAM: crumb click:\n${ctree}")
    endif()
    message(STATUS "M4MUI P4-2: crumb click moved the browse path RAM:mui-mm to RAM:")
    # MUI-P4-1: Stop, then the Home door, then a double-click on the first Home song row must play again.
    ami(ignored ui click ${UIW} Stop)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    ami(ignored ui click ${UIW} Home)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
    ami(htree uitree)
    message(STATUS "M4MUI P4-1: Home tree: ${htree}")
    ami(ignored ui dclick ${UIW} "${SONG_NAME}")
    set(hplay FALSE)
    foreach(i RANGE 1 8)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
      ami(htree uitree)
      if(htree MATCHES "label - \"Playing\"")
        set(hplay TRUE)
        break()
      endif()
    endforeach()
    if(NOT hplay)
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P4-1: double-click on the Home row \"${SONG_NAME}\" did not play:\n${htree}")
    endif()
  endif()
  ami(ignored ui click ${UIW} Search)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  # MUI-P4-15: the Search view without a query has no rows; the window shows the shared empty-state line.
  ami(stree uitree)
  if(NOT stree MATCHES "No results\\. Try a different search\\.")
    ami(ignored exec "Break ${pid} C" 10)
    message(FATAL_ERROR "RED[M4MUI]: MUI-P4-15: the empty Search view shows no \"No results. Try a different search.\" line:\n${stree}")
  endif()
  if(song_ok)
    # MUI-P4-17 (rig-m4-mui-arexx): the shell owns the one ARexx port SELECTA (D-M4 decision 2026-10-26); the MUI application
    # adds no command set. PLAY, QUEUE_ADD and PLAYLIST_CREATE arrive through that port while the MUI window is open and must
    # change the engine: the queue rows appear in the Queue view and the arexx_cmds counter on the exit line counts them.
    set(RXPY "${CMAKE_CURRENT_LIST_DIR}/mui_arexx.py")
    execute_process(COMMAND "${PYTHON3}" "${RXPY}" "${RIG_DIR}" SELECTA "STOP" "QUEUE_ADD RAM:mui-mm/${SONG_NAME}"
      "QUEUE_ADD RAM:mui-mm/meme2.mod" "PLAYLIST_CREATE rigpl" RESULT_VARIABLE rx_rc OUTPUT_VARIABLE rx ERROR_VARIABLE rx TIMEOUT 120)
    message(STATUS "M4MUI P4-17: rexx: ${rx}")
    if(NOT rx_rc EQUAL 0)
      list(APPEND p17_fail "the ARexx commands through port SELECTA did not return rc 0: ${rx}")
    endif()
    ami(ignored ui click ${UIW} Stop)
    execute_process(COMMAND "${PYTHON3}" "${RXPY}" "${RIG_DIR}" SELECTA "PLAY" OUTPUT_QUIET ERROR_QUIET TIMEOUT 120)
