    foreach(i RANGE 1 6)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
      ami(xtree uitree)
      if(xtree MATCHES "label - \"Playing\"")
        set(xplay TRUE)
        break()
      endif()
    endforeach()
    if(NOT xplay)
      list(APPEND p17_fail "ARexx PLAY through port SELECTA did not make the MUI window show Playing")
    endif()
    # MUI-P4-4: the Queue door lists the queued rows; Move Up / Move Down / Remove From Queue act on the cursor row (a click
    # on the row sets the cursor), each sends its QUEUE_MOVE / QUEUE_REMOVE line (qup, qdown, qremove on the ui_p4 line).
    ami(ignored ui click ${UIW} Queue)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
    ami(qtree uitree)
    message(STATUS "M4MUI P4-4: Queue tree: ${qtree}")
    ami(ignored ui click ${UIW} "meme2.mod")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    ami(ignored ui click ${UIW} "Move Up")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    ami(ignored ui click ${UIW} "Move Down")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    ami(ignored ui click ${UIW} "Remove From Queue")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    # MUI-P4-6: the Song menu entries (menu shortcuts 1 Play, 2 Play Next, 3 Add to Queue) act on the cursor row through
    # the same mui_song_menu_fire path as the list context menu (a right-click cannot be sent by the rig client).
    ami(ignored ui click ${UIW} "meme2.mod")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    foreach(smk 2 3 1)
      ami(ignored ui menushort ${UIW} ${smk})
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    endforeach()
    # MUI-P4-5: the Playlists door lists playlist rows; Open, Rename and Delete act on the cursor row.
    ami(ignored ui click ${UIW} Playlists)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
    ami(ptree uitree)
    message(STATUS "M4MUI P4-5: Playlists tree: ${ptree}")
    ami(ignored ui click ${UIW} "rigpl")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    foreach(pb "Open Playlist" "Rename Playlist" "Delete Playlist")
      ami(ignored ui click ${UIW} "${pb}")
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
    endforeach()
  endif()
  # MUI-P4-4 / MUI-P4-7: the tool row buttons Like and Clear Queue are real gadgets; each click must send its line (ui_p4 counters).
  foreach(tool "Like" "Clear Queue")
    if(NOT tree MATCHES "\"${tool}\"")
      ami(ignored exec "Break ${pid} C" 10)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P4: tool gadget \"${tool}\" missing in the window list:\n${tree}")
    endif()
    ami(ignored ui click ${UIW} "${tool}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  endforeach()
  # MUI-P4-3 / MUI-P4-13: the two String gadgets (search first, command line second) are typed into with the rig's
  # settext (click, cut, type, Return); each Return must send its line (search>=1, cmd>=1 on the ui_p4 line).
  ami(ignored ui click ${UIW} Stop)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  # `ui settext` addresses a gadget by id, and every MUI gadget has id 0 in the uitree, so it cannot reach a String gadget.
  # Needed verb: `ui settext <window> <kind>:<n> <text>` (n-th gadget of that kind). Until then: gclick on the first string
  # gadget (search), cut (ramiga+x, key x = 0x32 with qualifier 0x80), type the text and Return; then Tab to the command line.
  ami(ignored gclick ${UIW} string)
  ami(ignored key 32 80)
  ami(ignored type "abc\r")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  # MUI-P4-13 (command line, the second String gadget) is NOT driven: `gclick` and `ui settext` reach only the first one;
  # the cmd key stays out of the check below.
  # MUI-P4-7 (rating Cycle) is NOT driven here: a MUI 3.8 Cycle popup is an overlay, not a window in the uitree, and ami.py
  # has no verb that picks a Cycle entry (needed: `ui cyclepick <win> <gadget id> <entry index>`). The rating key stays out of the check.
  # MUI-P4-14: the Help button opens a second window listing the action rows.
  ami(ignored ui click ${UIW} Help)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  ami(htree uitree)
  if(NOT htree MATCHES "W [0-9]+ [0-9-]+ [0-9-]+ [0-9]+x[0-9]+ [a-z-]+ \"Selecta Help\"")
    ami(ignored exec "Break ${pid} C" 10)
    message(FATAL_ERROR "RED[M4MUI]: MUI-P4-14: no \"Selecta Help\" window after the Help click:\n${htree}")
  endif()
  # MUI-P4-12: Clear Library raises a MUI_Request; its Clear button confirms (clearlib>=1).
  ami(ignored ui click ${UIW} "Clear Library")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  ami(rtree uitree)
  message(STATUS "M4MUI P4-12: requester tree: ${rtree}")
  ami(ignored ui click ${UIW} Clear)
  ami(ignored gclick "Selecta Help" sys:close)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  # MUI-P4-16: the Settings button opens the "Selecta Settings" window; a String preference gadget is typed into and
  # its Return sends PREF_SET (pref>=1).
  ami(ignored ui click ${UIW} Settings)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
  ami(sttree uitree)
  if(NOT sttree MATCHES "W [0-9]+ [0-9-]+ [0-9-]+ [0-9]+x[0-9]+ [a-z-]+ \"Selecta Settings\"")
    ami(ignored exec "Break ${pid} C" 10)
    message(FATAL_ERROR "RED[M4MUI]: MUI-P4-16: no \"Selecta Settings\" window after the Settings click:\n${sttree}")
  endif()
  ami(ignored ui settext "Selecta Settings" string:1 "%a - %t")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  ami(ignored gclick "Selecta Settings" sys:close)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  # MUI-P4-11: the status line (toast) goes back to Ready 3 s after the last note.
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 6)
  ami(ignored exec "Break ${pid} C" 10)
  # MUI_DisposeObject, the stats print and the exit take a few seconds on the 68020: poll up to 30 s.
  # I558 rig 3 (2026-10-28): the first Break after the Settings/Help windows closed was swallowed once (the process ended on a
  # second Break 30 s later), so the poll repeats the Break each round.
  foreach(i RANGE 1 6)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    ami(procs exec "Status" 10)
    if(NOT procs MATCHES "Loaded as command: ${P}")
      break()
    endif()
    ami(ignored exec "Break ${pid} C" 10)
  endforeach()
  if(procs MATCHES "Loaded as command: ${P}")
    message(FATAL_ERROR "RED[M4MUI]: ${P} still runs after Break (SEL_UI_CLOSE did not end the UI):\n${procs}")
  endif()
  ami(tree uitree)
  if(tree MATCHES "\"Selecta\"")
    message(FATAL_ERROR "RED[M4MUI]: a \"Selecta\" window is left after the UI closed:\n${tree}")
  endif()
  fetch(out "RAM:mui-out.txt")
  string(FIND "${out}" "ui_open_mui=1" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "RED[M4MUI]: sentinel 'ui_open_mui=1' missing in:\n${out}")
  endif()
  if(NOT out MATCHES "ui_stats id=mui[^\n]* menus=([0-9]+)" OR CMAKE_MATCH_1 LESS 1)
    message(FATAL_ERROR "RED[M4MUI]: the Menustrip item did not send its action line (menus>=1 missing on the ui_stats id=mui line):\n${out}")
  endif()
  if(NOT out MATCHES "ui_stats id=mui[^\n]* transport_hits=([0-9]+)" OR CMAKE_MATCH_1 LESS 1)
    message(FATAL_ERROR "RED[M4MUI]: the Stop button click did not send its action line (transport_hits>=1 missing on the ui_stats id=mui line):\n${out}")
  endif()
  if(NOT out MATCHES "view_source=search")
    message(FATAL_ERROR "RED[M4MUI]: MUI-P4-0: the Search door did not switch the view (view_source=search missing):\n${out}")
  endif()
  foreach(k like qclear search help clearlib toast crumb state home qup qdown qremove popen prename pdelete songmenu np songinfo pref tracker settings)
    if(NOT out MATCHES "ui_p4 id=mui[^\n]* ${k}=([0-9]+)" OR CMAKE_MATCH_1 LESS 1)
      message(FATAL_ERROR "RED[M4MUI]: MUI-P4: the ${k} gadget click did not send its line (${k}>=1 missing on the ui_p4 line):\n${out}")
    endif()
  endforeach()
  if(song_ok AND (NOT out MATCHES "arexx_cmds=([0-9]+)" OR CMAKE_MATCH_1 LESS 5))
    list(APPEND p17_fail "arexx_cmds>=5 missing on the exit line: ${out}")
  endif()
  if(p17_fail)
    ami(ignored exec "Delete >NIL: RAM:mui-out.txt RAM:mui.script ${P} QUIET" 10)
    message(FATAL_ERROR "RED[M4MUI]: MUI-P4-17 (P4-4 and P4-5 steps ran first):\n${p17_fail}")
  endif()
  ami(ignored exec "Delete >NIL: RAM:mui-out.txt RAM:mui.script ${P} QUIET" 10)
  ami(ignored exec "Delete >NIL: RAM:mui-mm ALL QUIET" 10)
