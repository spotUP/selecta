# T46 sample-export: SAMPLE_LIST and SAMPLE_EXPORT through the engine (libopenmpt
# adapter). Working directory: build/host/tests/songs. Sample 1 is the 64-byte
# looped square wave of gen_testmod; sample 4 is the one-shot click.
OPEN selecta-test-mk.mod
SAMPLE_LIST
SAMPLE_EXPORT 1 samples-1.wav
SAMPLE_EXPORT 1 samples-1.8svx
SAMPLE_EXPORT 4 samples-4.8svx
SAMPLE_EXPORT 1 samples-1.xyz
SAMPLE_EXPORT 9 samples-9.wav
