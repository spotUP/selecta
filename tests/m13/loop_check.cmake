# T43: loop detect, REPEAT, fade, max_song_ms, silence_ms, stop-after options through
# `selecta-cli script`. Variables: CLI SCRIPTS SONGS (working directory with the generated modules)
function(sel_run tag)
  execute_process(COMMAND "${CLI}" script "${SCRIPTS}/${tag}.sel"
    WORKING_DIRECTORY "${SONGS}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: script exited ${rc}\nstdout:\n${out}\nstderr:\n${err}")
  endif()
  set(${tag}_out "${out}" PARENT_SCOPE)
  set(${tag}_err "${err}" PARENT_SCOPE)
endfunction()

function(sel_expect tag regex)
  if(NOT ${tag}_out MATCHES "${regex}")
    message(FATAL_ERROR "${tag}: expected /${regex}/ in:\n${${tag}_out}\nstderr:\n${${tag}_err}")
  endif()
endfunction()

function(sel_count tag needle want)
  string(REGEX MATCHALL "${needle}" hits "${${tag}_out}")
  list(LENGTH hits n)
  if(NOT n EQUAL want)
    message(FATAL_ERROR "${tag}: expected ${want} x /${needle}/, got ${n} in:\n${${tag}_out}")
  endif()
endfunction()

sel_run(loop_end)
sel_expect(loop_end "SONG_ENDED reason=end")
sel_run(loop_loop)
sel_expect(loop_loop "SONG_ENDED reason=loop")
sel_run(loop_fade)
sel_expect(loop_fade "FADE gain_q16=32768 pos=66150 total=132300")
sel_run(loop_one)
if(loop_one_out MATCHES "SONG_ENDED")
  message(FATAL_ERROR "loop_one: REPEAT one ended the song:\n${loop_one_out}")
endif()
sel_run(loop_max)
sel_expect(loop_max "SONG_ENDED reason=max_length")
sel_expect(loop_max "position_ms=13000")
sel_run(loop_silence)
sel_expect(loop_silence "SONG_ENDED reason=silence")
sel_expect(loop_silence "position_ms=5000")
sel_run(loop_stop_current)
sel_count(loop_stop_current "SONG_OPENED" 1)
sel_expect(loop_stop_current "STATE stopped")
sel_expect(loop_stop_current "QUEUE version=[0-9]+ playing=0 ")
sel_run(loop_stop_queue)
sel_count(loop_stop_queue "SONG_OPENED" 2)
sel_expect(loop_stop_queue "QUEUE version=[0-9]+ playing=0 ")
sel_run(loop_all)
sel_count(loop_all "SONG_OPENED" 4)
