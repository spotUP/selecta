# dui-song-menu-live (DUI-P3-16 song menu, I371; label song-menu, not a plan id): a right-click in the live SDL window opens the song menu.
#   -DSELECTA -DSONGS -DWORK -DSDL_BUILT
#   Violated invariant: a right button press and release delivered as SDL events reach song_menu_pointer. The scripted
#   `rclick` of dui-song-menu skips the SDL raw path (backend_sdl queue_raw, sel_gui_input_map, desk_sdl_route); this drives
#   it with SELECTA_SDL_TEST_TIMED button tokens: a left click on the composer row, a right click on song row 2, a quit.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/songs")
if(NOT SDL_BUILT)
  return()
endif()
foreach(n a b c)
  file(COPY_FILE "${SONGS}/selecta-test.mod" "${WORK}/songs/${n}.mod")
endforeach()
set(db "${WORK}/library.db")
set(ENV{SDL_VIDEODRIVER} dummy)
file(WRITE "${WORK}/in.txt" "wait 1\nexec LIBRARY_SCAN ${WORK}/songs\nwait 4\n")
dui_run(list --db "${db}" --ui desktop --backend mem --view library --canvas 900x600 --clock fixed --stats --input "${WORK}/in.txt")
if(NOT "${list}" MATCHES "row 0 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no row rectangle in the library dump:\n${list}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + 10")
math(EXPR cy "${CMAKE_MATCH_2} + 8")
math(EXPR sx "${CMAKE_MATCH_1} + 20")
math(EXPR sy "${CMAKE_MATCH_2} + 2 * ${CMAKE_MATCH_4} + ${CMAKE_MATCH_4} / 2")
file(REMOVE_RECURSE "${WORK}/cfg")
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SDL_SCREEN} 900x600)
set(ENV{SELECTA_SDL_TEST_TIMED} "m${cx},${cy}@500 d1,${cx},${cy}@600 u1,${cx},${cy}@650 m${sx},${sy}@1000 d3,${sx},${sy}@1100 u3,${sx},${sy}@1150 q@2200")
dui_run(live --db "${db}" --ui desktop --backend sdl --view library --canvas 900x600 --stats)
if(NOT "${live}" MATCHES "song_menu [^\n]*opens=([0-9]+)" OR NOT CMAKE_MATCH_1 GREATER 0)
  message(FATAL_ERROR "the live right-click never opened the song menu:\n${live}")
endif()

# I373: the menu is one raised panel; only the item under the pointer is accent. Right-click opens the menu with its first item
# at the click point (items SONG_MENU_ITEM_H = 24 high), then a timed move lands on item 2. The frame dump (written at close)
# must show item 2 in another colour than item 1, and --stats must count a hover on it.
include("${HERE}/ppm.cmake")
math(EXPR sy2 "${sy} + 2 * 24 + 12")
set(ENV{SELECTA_SDL_TEST_TIMED}
    "m${cx},${cy}@500 d1,${cx},${cy}@600 u1,${cx},${cy}@650 m${sx},${sy}@1000 d3,${sx},${sy}@1100 u3,${sx},${sy}@1150 m${sx},${sy2}@1400 q@2000")
dui_run(hv --db "${db}" --ui desktop --backend sdl --view library --canvas 900x600 --stats --frame-dump "${WORK}/menu.ppm")
ppm_load("${WORK}/menu.ppm" menuhex menuw)
function(px hex w x y out)
  math(EXPR off "(${y} * ${w} + ${x}) * 6")
  string(SUBSTRING "${hex}" ${off} 6 c)
  set(${out} "${c}" PARENT_SCOPE)
endfunction()
math(EXPR ix "${sx} + 4")
math(EXPR y1 "${sy} + 24 + 12")
px("${menuhex}" ${menuw} ${ix} ${y1} item1)
px("${menuhex}" ${menuw} ${ix} ${sy2} item2)
if(item1 STREQUAL item2)
  message(FATAL_ERROR "the hovered menu item 2 and item 1 have the same colour ${item1}: no hover state (I373)")
endif()
if(NOT "${hv}" MATCHES "ui_stats id=desktop [^\n]*hovers=([0-9a-f]+)" OR CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "the move onto menu item 2 counted no hover:\n${hv}")
endif()

# I374: a toast shown in the live loop goes away by itself. Pick Add to Queue (item 2) from the menu, then idle with no input
# past TOAST_MS (2500 ms): --stats must say toast_on=0 and the toast rectangle of the frame dump must equal the same rectangle
# of a run that never toasted.
dui_run(o0 --db "${db}" --ui desktop --backend mem --view library --canvas 900x600 --clock fixed --stats)
if(NOT "${o0}" MATCHES "toast_rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)")
  message(FATAL_ERROR "no toast_rect in the stats:\n${o0}")
endif()
set(tx ${CMAKE_MATCH_1})
set(ty ${CMAKE_MATCH_2})
set(tw ${CMAKE_MATCH_3})
set(th ${CMAKE_MATCH_4})
set(ENV{SELECTA_SDL_TEST_TIMED} "m${cx},${cy}@500 d1,${cx},${cy}@600 u1,${cx},${cy}@650 q@1000")
dui_run(quiet --db "${db}" --ui desktop --backend sdl --view library --canvas 900x600 --stats --frame-dump "${WORK}/quiet.ppm")
math(EXPR sy3 "${sy} + 2 * 24 + 12")
set(ENV{SELECTA_SDL_TEST_TIMED}
    "m${cx},${cy}@500 d1,${cx},${cy}@600 u1,${cx},${cy}@650 m${sx},${sy}@1000 d3,${sx},${sy}@1100 u3,${sx},${sy}@1150 m${sx},${sy3}@1400 d1,${sx},${sy3}@1500 u1,${sx},${sy3}@1550 q@5500")
dui_run(gone --db "${db}" --ui desktop --backend sdl --view library --canvas 900x600 --stats --frame-dump "${WORK}/gone.ppm")
if(NOT "${gone}" MATCHES "toasts=([0-9]+) toast_on=([01])")
  message(FATAL_ERROR "no toast counters in:\n${gone}")
endif()
if(CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "the menu pick showed no toast (toasts=${CMAKE_MATCH_1}):\n${gone}")
endif()
if(NOT CMAKE_MATCH_2 EQUAL 0)
  message(FATAL_ERROR "the toast is still on screen 4.3 s after it was shown with no input: the live loop never ticks it (I374)")
endif()
ppm_load("${WORK}/quiet.ppm" quiethex qw)
ppm_load("${WORK}/gone.ppm" gonehex gw)
rect_differs("${quiethex}" "${gonehex}" ${qw} ${tx} ${ty} ${tw} ${th} stuck)
if(stuck)
  message(FATAL_ERROR "the toast rectangle still differs from the never-toasted frame after the toast ended (I374)")
endif()
