# dui-aga-native-text (I526 P5; design 2026-10-27-aga-native-fonts.md sections 4-6): the 640x256 ydiv 2 desktop shell draws
# its text with the native Amiga fonts and the two Inter headline sizes, never an atlas built on the spot.
# -DSELECTA -DWORK
#   1. Library and home views at --canvas 640x256 --ydiv 2 --zoom fit: layout 640x512 with the labelled rail.
#   2. Stats: bitmap_hits_mini6 and bitmap_hits_mini8 > 0, headline_hits_22 and headline_hits_32 > 0 (the role table ran),
#      atlas_builds=0, font_misses=0, missing_glyphs=0 (every glyph came from a baked atlas).
#   3. PPM ink of the library view: the cap "L" of the title (Inter SemiBold 32 baked at 1:2, no descender) occupies 11 to 16
#      screen rows (the old fit zoom scaled it to 9 to 10); the first library row's text ink is at most 8 rows and its glyph
#      pitch is 8 columns (mini8).
# Open (I526 P5 gap G1): bitmap_hits_mini4 > 0 is not asserted; no view reachable at 640x512 draws a mini4 caption yet (see the report).
# Revert check: with the bitmap tier forced off (desk_bitmap_text returns 0) the layout, the hit counters and the
# atlas_builds=0 assertions fail.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-aga-native-text needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()

foreach(view library home)
  dui_run(o --db "${db}" --ui desktop --backend mem --view ${view} --canvas 640x256 --ydiv 2 --zoom fit --clock fixed
    --stats --resize 640x512 --frame-dump "${WORK}/${view}.ppm")
  if(NOT o MATCHES "layout width=640 height=512 id=icon-sidebar ")
    message(FATAL_ERROR "${view}: the bitmap tier must lay out 640x512 with the labelled rail:\n${o}")
  endif()
  foreach(key bitmap_hits_mini6 bitmap_hits_mini8 headline_hits_22 headline_hits_32)
    dui_stat(n "${o}" desktop ${key})
    if(NOT n GREATER 0)
      message(FATAL_ERROR "${view}: ${key}=${n}, the native font role table did not run")
    endif()
  endforeach()
  # font_misses is not a ui_stats key: the desktop prints it on its np_page_text line (every run, whatever the view).
  if(NOT o MATCHES "np_page_text [^\n]*font_misses=0\n")
    message(FATAL_ERROR "${view}: font_misses must be 0:\n${o}")
  endif()
  foreach(key atlas_builds missing_glyphs)
    dui_stat(n "${o}" desktop ${key})
    if(NOT n EQUAL 0)
      message(FATAL_ERROR "${view}: ${key}=${n}, expected 0")
    endif()
  endforeach()
  string(REGEX MATCH "ui_stats id=desktop [^\n]*" line "${o}")
  string(REGEX MATCHALL "(bitmap_hits_mini[468]|headline_hits_[0-9]+|atlas_builds|font_misses|missing_glyphs)=[0-9]+" kv "${line}")
  message(STATUS "P5 stats ${view}: ${kv}")
endforeach()

# 3. native sizes from the library PPM (one frame row = two layout rows)
function(pixel outvar x y)
  math(EXPR off "15 + (${y} * 640 + ${x}) * 3")
  file(READ "${WORK}/library.ppm" hex OFFSET ${off} LIMIT 3 HEX)
  set(${outvar} "${hex}" PARENT_SCOPE)
endfunction()
# ink(<out> <x> <y>): 1 when the pixel differs from the row's background (the pixel at x=630, right of all text).
function(ink outvar x y)
  pixel(bg 630 ${y})
  pixel(c ${x} ${y})
  if(c STREQUAL bg)
    set(${outvar} 0 PARENT_SCOPE)
  else()
    set(${outvar} 1 PARENT_SCOPE)
  endif()
endfunction()
# col_ink(<out> <x> <y0> <y1>): first and last frame row with ink in column x, or "" when the column is blank.
function(col_rows outvar x y0 y1)
  set(first -1)
  set(last -1)
  foreach(y RANGE ${y0} ${y1})
    ink(i ${x} ${y})
    if(i)
      if(first LESS 0)
        set(first ${y})
      endif()
      set(last ${y})
    endif()
  endforeach()
  set(${outvar} "${first};${last}" PARENT_SCOPE)
endfunction()

# 3a. title: the cap "L" is the first glyph run right of x=186 (its stem and foot); count its ink rows
set(x0 -1)
foreach(x RANGE 186 230)
  col_rows(r ${x} 10 40)
  list(GET r 0 f)
  if(NOT f LESS 0)
    set(x0 ${x})
    break()
  endif()
endforeach()
if(x0 LESS 0)
  message(FATAL_ERROR "no title ink found in the main region")
endif()
set(first 1000)
set(last -1)
set(x ${x0})
while(x LESS 260)
  col_rows(r ${x} 10 40)
  list(GET r 0 f)
  list(GET r 1 l)
  if(f LESS 0)
    break()
  endif()
  if(f LESS first)
    set(first ${f})
  endif()
  if(l GREATER last)
    set(last ${l})
  endif()
  math(EXPR x "${x} + 1")
endwhile()
math(EXPR rows "${last} - ${first} + 1")
message(STATUS "P5 title cap L columns ${x0}..${x} ink rows ${first}..${last} = ${rows}")
if(rows LESS 11 OR rows GREATER 16)
  message(FATAL_ERROR "the Library title cap spans ${rows} screen rows, expected 11 to 16 (Inter SemiBold 32 baked)")
endif()

dui_run(lo --db "${db}" --ui desktop --backend mem --view library --canvas 640x256 --ydiv 2 --zoom fit --clock fixed
  --stats --resize 640x512 --frame-dump "${WORK}/library.ppm")
if(NOT lo MATCHES "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no stats rect in the library stats:\n${lo}")
endif()
math(EXPR strip_end "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2 + 1")
# 3b. first library row: the first ink band below the statistics strip. The strip end comes from the "stats rect" line (layout rows, halved by --ydiv 2) and the player region starts at layout row 440 (frame row 220).
set(rfirst -1)
set(rlast -1)
foreach(y RANGE ${strip_end} 219)
  set(any 0)
  foreach(x RANGE 168 600 2)
    ink(i ${x} ${y})
    if(i)
      set(any 1)
      break()
    endif()
  endforeach()
  if(any AND rfirst LESS 0)
    set(rfirst ${y})
  endif()
  if(any)
    set(rlast ${y})
  elseif(rfirst GREATER_EQUAL 0)
    break()
  endif()
endforeach()
if(rfirst LESS 0)
  message(FATAL_ERROR "no library row text ink below the statistics strip")
endif()
math(EXPR rrows "${rlast} - ${rfirst} + 1")
message(STATUS "P5 library row ink rows ${rfirst}..${rlast} = ${rrows}")
if(rrows GREATER 8)
  message(FATAL_ERROR "the library row text spans ${rrows} screen rows, expected at most 8 (mini8)")
endif()
# glyph pitch 8: from the first ink column, the text is a sequence of 8 wide cells whose gap column (the glyph's right
# bearing) is blank in every cell, so exactly 7 of the 8 column offsets carry ink. A pitch of 6, 7 or 9 drifts the gap over
# every offset within a few glyphs and fills all 8.
set(x0r -1)
foreach(x RANGE 164 400)
  col_rows(r ${x} ${rfirst} ${rlast})
  list(GET r 0 f)
  if(NOT f LESS 0)
    set(x0r ${x})
    break()
  endif()
endforeach()
set(hit_offsets "")
foreach(x RANGE ${x0r} 400)
  col_rows(r ${x} ${rfirst} ${rlast})
  list(GET r 0 f)
  if(NOT f LESS 0)
    math(EXPR off "(${x} - ${x0r}) % 8")
    list(APPEND hit_offsets ${off})
  endif()
endforeach()
list(REMOVE_DUPLICATES hit_offsets)
list(LENGTH hit_offsets noff)
message(STATUS "P5 library row glyph cell offsets with ink: ${hit_offsets}")
if(NOT noff EQUAL 7)
  message(FATAL_ERROR "the library row glyphs are not on an 8 column pitch (ink at ${noff} of 8 offsets: ${hit_offsets}, expected exactly 7)")
endif()

# 4. I537 items 1-5 (the Library screen of the font build). Layout numbers come from the desktop's own stats lines (label,
# region, nag*, stats rects); the pixels are checked where only ink can show the fault.
function(label_rect out text name)
  if(NOT "${text}" MATCHES "label (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ink (-?[0-9]+) (-?[0-9]+) text ${name}\n")
    message(FATAL_ERROR "no label '${name}' in the stats:\n${text}")
  endif()
  set(${out} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()
# 4.1 (I537 item 1) the Clear Library button starts right of the title ink.
label_rect(clr "${lo}" "Clear Library")
list(GET clr 0 clr_x)
# The baked Inter SemiBold 32 "Library" title ends at layout column 288 (measured on the frame dump; the button outline
# merges with the title tail in pixels, so the numbers are compared). Pre-fix the button sat at x=256 on top of it.
if(clr_x LESS 289)
  message(FATAL_ERROR "I537 item 1: Clear Library button at x=${clr_x} covers the title, which ends at column 288")
endif()
# 4.4 (item 4) every mode tab ends inside the 640 px page and the tabs do not overlap the style chooser or each other.
set(prev_end 0)
foreach(tab Composers Tree Columns Files History Sources)
  label_rect(tr "${lo}" "${tab}")
  list(GET tr 0 tx)
  list(GET tr 2 tw)
  math(EXPR tend "${tx} + ${tw}")
  if(tend GREATER 640 OR tx LESS prev_end)
    message(FATAL_ERROR "I537 item 4: tab ${tab} spans ${tx}..${tend} (previous tab ends ${prev_end}, page 640)")
  endif()
  set(prev_end ${tend})
endforeach()
foreach(st Grid "Cover Flow" List)
  label_rect(sr "${lo}" "${st}")
  list(GET sr 0 sx)
  list(GET sr 1 sy)
  list(GET tr 1 ty)
  if(sy EQUAL ty AND sx LESS prev_end)
    message(FATAL_ERROR "I537 item 4: style segment ${st} at x=${sx} overlaps the tab row ending at ${prev_end}")
  endif()
endforeach()
# 4.2 (item 2) the rail labels are not ellipsized: the last 8 columns of each label's ink hold a letter (at least 4 rows),
# an ellipsis leaves only its dots (1 to 2 rows). Doors are the ink bands right of the icon, below the brand row.
function(rail_ink outvar x y)
  pixel(bg 50 ${y})
  pixel(c ${x} ${y})
  if(c STREQUAL bg)
    set(${outvar} 0 PARENT_SCOPE)
  else()
    set(${outvar} 1 PARENT_SCOPE)
  endif()
endfunction()
set(bands "")
set(inband 0)
foreach(y RANGE 30 219)
  set(any 0)
  foreach(x RANGE 54 150)
    rail_ink(i ${x} ${y})
    if(i)
      set(any 1)
      break()
    endif()
  endforeach()
  if(any AND NOT inband)
    list(APPEND bands ${y})
  endif()
  set(inband ${any})
endforeach()
list(LENGTH bands nb)
message(STATUS "I537 rail label bands start at rows ${bands}")
if(nb LESS 7)
  message(FATAL_ERROR "I537 item 2: expected 7 rail label bands, found ${nb}")
endif()
foreach(door 2 5 6) # Your Library, Now Playing, Song Information (list index = door index when the brand band is excluded)
  list(GET bands ${door} y0)
  math(EXPR y1 "${y0} + 9")
  set(xr -1)
  foreach(x RANGE 54 150)
    foreach(y RANGE ${y0} ${y1})
      rail_ink(i ${x} ${y})
      if(i)
        set(xr ${x})
      endif()
    endforeach()
  endforeach()
  set(rmin 1000)
  set(rmax -1)
  math(EXPR xl "${xr} - 7")
  foreach(x RANGE ${xl} ${xr})
    foreach(y RANGE ${y0} ${y1})
      rail_ink(i ${x} ${y})
      if(i)
        if(y LESS rmin)
          set(rmin ${y})
        endif()
        if(y GREATER rmax)
          set(rmax ${y})
        endif()
      endif()
    endforeach()
  endforeach()
  math(EXPR span "${rmax} - ${rmin} + 1")
  if(span LESS 4)
    message(FATAL_ERROR "I537 item 2: rail door ${door} ends in ink spanning ${span} rows at columns ${xl}..${xr}: it is ellipsized")
  endif()
endforeach()
# 4.3 and 4.5 (items 3 and 5) the sync banner, from the SDL backend with the launch SOURCES reply in: the buttons are as wide
# as their label plus the pad (label centred), and the banner leaves the statistics strip above the player bar.
if(SDL_BUILT)
  set(ENV{SDL_VIDEODRIVER} dummy)
  set(ENV{SELECTA_SDL_TEST_LIVE} 1)
  set(ENV{SELECTA_SOCKET} "/tmp/selecta-aga-native-text.sock")
  set(ENV{SELECTA_SDL_TEST_TIMED} "m5,5@200 m6,6@400 m7,7@600 q@800")
  file(REMOVE_RECURSE "${WORK}/cfg")
  execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" --db "${db}" --ui desktop
    --backend sdl --view library --canvas 640x256 --ydiv 2 --zoom fit --clock fixed --stats --resize 640x512
    OUTPUT_VARIABLE bo RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "banner run exited ${rc}")
  endif()
  if(NOT bo MATCHES "nag ([0-9]+) syncs 0\nnagsync (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\nnaglater (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
    message(FATAL_ERROR "no sync banner in the stats:\n${bo}")
  endif()
  set(sync_w ${CMAKE_MATCH_4})
  set(later_w ${CMAKE_MATCH_8})
  if(NOT sync_w EQUAL 48 OR NOT later_w EQUAL 72)
    message(FATAL_ERROR "I537 item 3: banner buttons are ${sync_w} (Sync) and ${later_w} (Not now) wide, expected the label plus pad: 48 and 72")
  endif()
  if(NOT bo MATCHES "region name=player x=0 y=([0-9]+) " OR NOT bo MATCHES "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\n")
    message(FATAL_ERROR "no player region or stats rect in the stats:\n${bo}")
  endif()
  string(REGEX MATCH "region name=player x=0 y=([0-9]+) " _p "${bo}")
  set(player_y ${CMAKE_MATCH_1})
  string(REGEX MATCH "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\n" _s "${bo}")
  math(EXPR stats_end "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  if(stats_end GREATER player_y)
    message(FATAL_ERROR "I537 item 5: the statistics strip ends at layout row ${stats_end}, under the player bar at ${player_y}")
  endif()
endif()
