# dui-aga-native-text (I526 P5; design 2026-10-27-aga-native-fonts.md sections 4-6): the 640x256 ydiv 2 desktop shell draws
# its text with the native Amiga fonts and the two Inter headline sizes, never an atlas built on the spot.
# -DSELECTA -DWORK
#   1. Library and home views at --canvas 640x256 --ydiv 2 --zoom fit: layout 640x512 with the labelled rail.
#   2. Stats: bitmap_hits_mini6 and bitmap_hits_mini8 > 0, headline_hits_18 (9-row section titles) and headline_hits_24 (12-row page titles) > 0 (the role table ran),
#      atlas_builds=0, font_misses=0, missing_glyphs=0 (every glyph came from a baked atlas).
#   3. PPM ink of the library view: the cap "L" of the title (I545: Inter SemiBold px 24 baked at 1:2, a 12-row page title)
#      occupies 9 to 10 screen rows (px 22 gave 8, px 32 gave 11 to 12; the old fit zoom scaled it to 9 to 10); the first library row's text ink is at most 8 rows and its glyph
#      pitch is 8 columns (mini8).
# Open (I526 P5 gap G1): bitmap_hits_mini4 > 0 is not asserted; no view reachable at 640x512 draws a mini4 caption yet (see the report).
# Revert check: with the bitmap tier forced off (desk_bitmap_text returns 0) the layout, the hit counters and the
# atlas_builds=0 assertions fail.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-aga-native-text needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()

foreach(view library home)
  dui_run(o --db "${db}" --ui desktop --backend mem --view ${view} --canvas 640x256 --ydiv 2 --zoom fit --clock fixed
    --stats --resize 640x512 --frame-dump "${WORK}/${view}.ppm")
  if(NOT o MATCHES "layout width=640 height=512 id=icon-sidebar ")
    message(FATAL_ERROR "${view}: the bitmap tier must lay out 640x512 with the labelled rail:\n${o}")
  endif()
  foreach(key bitmap_hits_mini6 bitmap_hits_mini8 headline_hits_18 headline_hits_24)
    dui_stat(n "${o}" desktop ${key})
    if(NOT n GREATER 0)
      message(FATAL_ERROR "${view}: ${key}=${n}, the native font role table did not run")
    endif()
  endforeach()
  # font_misses is not a ui_stats key: the desktop prints it on its np_page_text line (every run, whatever the view).
  if(NOT o MATCHES "np_page_text [^\n]*font_misses=0\n")
    message(FATAL_ERROR "${view}: font_misses must be 0:\n${o}")
  endif()
  foreach(key atlas_builds missing_glyphs)
    dui_stat(n "${o}" desktop ${key})
    if(NOT n EQUAL 0)
      message(FATAL_ERROR "${view}: ${key}=${n}, expected 0")
    endif()
  endforeach()
  string(REGEX MATCH "ui_stats id=desktop [^\n]*" line "${o}")
  string(REGEX MATCHALL "(bitmap_hits_mini[468]|headline_hits_[0-9]+|atlas_builds|font_misses|missing_glyphs)=[0-9]+" kv "${line}")
  message(STATUS "P5 stats ${view}: ${kv}")
endforeach()

# 3. native sizes from the library PPM (one frame row = two layout rows)
function(pixel outvar x y)
  math(EXPR off "15 + (${y} * 640 + ${x}) * 3")
  file(READ "${WORK}/library.ppm" hex OFFSET ${off} LIMIT 3 HEX)
  set(${outvar} "${hex}" PARENT_SCOPE)
endfunction()
# ink(<out> <x> <y>): 1 when the pixel differs from the row's background (the pixel at x=630, right of all text).
function(ink outvar x y)
  pixel(bg 630 ${y})
  pixel(c ${x} ${y})
  if(c STREQUAL bg)
    set(${outvar} 0 PARENT_SCOPE)
  else()
    set(${outvar} 1 PARENT_SCOPE)
  endif()
endfunction()
# col_ink(<out> <x> <y0> <y1>): first and last frame row with ink in column x, or "" when the column is blank.
function(col_rows outvar x y0 y1)
  set(first -1)
  set(last -1)
  foreach(y RANGE ${y0} ${y1})
    ink(i ${x} ${y})
    if(i)
      if(first LESS 0)
        set(first ${y})
      endif()
      set(last ${y})
    endif()
  endforeach()
  set(${outvar} "${first};${last}" PARENT_SCOPE)
endfunction()

# 3a. title: the cap "L" is the first glyph run right of x=186 (its stem and foot); count its ink rows
set(x0 -1)
foreach(x RANGE 186 230)
  col_rows(r ${x} 10 27)
  list(GET r 0 f)
  if(NOT f LESS 0)
    set(x0 ${x})
    break()
  endif()
endforeach()
if(x0 LESS 0)
  message(FATAL_ERROR "no title ink found in the main region")
endif()
set(first 1000)
set(last -1)
set(x ${x0})
while(x LESS 260)
  col_rows(r ${x} 10 27)
  list(GET r 0 f)
  list(GET r 1 l)
  if(f LESS 0)
    break()
  endif()
  if(f LESS first)
    set(first ${f})
  endif()
  if(l GREATER last)
    set(last ${l})
  endif()
  math(EXPR x "${x} + 1")
endwhile()
math(EXPR rows "${last} - ${first} + 1")
message(STATUS "P5 title cap L columns ${x0}..${x} ink rows ${first}..${last} = ${rows}")
if(rows LESS 9 OR rows GREATER 10)
  message(FATAL_ERROR "the Library title cap spans ${rows} screen rows, expected 9 to 10 (I545: Inter SemiBold px 24, a 12-row page title)")
endif()

dui_run(lo --db "${db}" --ui desktop --backend mem --view library --canvas 640x256 --ydiv 2 --zoom fit --clock fixed
  --stats --resize 640x512 --frame-dump "${WORK}/library.ppm")
if(NOT lo MATCHES "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no stats rect in the library stats:\n${lo}")
endif()
math(EXPR strip_end "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}) / 2 + 1")
# 3a. I545 all pages: every page title box is 32 layout units (16 rows) on the bitmap tier and the page content below it moved
# up by the 8 units the box gave back. The numbers come from the desktop's own page_tops line, built from the real rect
# functions of Queue (button row, list), Playlists (name field), Song Information (list top) and Tracker (tab row); the
# Library check above and the Now Playing / Visualizer tops use the same page_y rule. Pre-shrink values: 64 / 112 / 104 / 152 / 64.
foreach(pg queue playlists songinfo tracker)
  dui_run(pt --db "${db}" --ui desktop --backend mem --view ${pg} --canvas 640x256 --ydiv 2 --zoom fit --clock fixed
    --stats --resize 640x512)
  if(NOT pt MATCHES "page_tops title_h=([0-9]+) queue_btn_y=([0-9]+) queue_list_y=([0-9]+) playlists_name_y=([0-9]+) songinfo_list_y=([0-9]+) tracker_tab_y=([0-9]+)\n")
    message(FATAL_ERROR "${pg}: no page_tops line:\n${pt}")
  endif()
  set(got "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4} ${CMAKE_MATCH_5} ${CMAKE_MATCH_6}")
  if(NOT got STREQUAL "32 56 104 96 144 56")
    message(FATAL_ERROR "I545 all pages (${pg}): page title box and tops are '${got}', expected '32 56 104 96 144 56' (title_h queue_btn queue_list playlists_name songinfo_list tracker_tab)")
  endif()
endforeach()

# 3b. first library row: the first ink band below the statistics strip. The strip end comes from the "stats rect" line (layout rows, halved by --ydiv 2) and the player region starts at layout row 440 (frame row 220).
set(rfirst -1)
set(rlast -1)
foreach(y RANGE ${strip_end} 219)
  set(any 0)
  foreach(x RANGE 178 600 2)
    ink(i ${x} ${y})
    if(i)
      set(any 1)
      break()
    endif()
  endforeach()
  if(any AND rfirst LESS 0)
    set(rfirst ${y})
  endif()
  if(any)
    set(rlast ${y})
  elseif(rfirst GREATER_EQUAL 0)
    break()
  endif()
endforeach()
if(rfirst LESS 0)
  message(FATAL_ERROR "no library row text ink below the statistics strip")
endif()
math(EXPR rrows "${rlast} - ${rfirst} + 1")
message(STATUS "P5 library row ink rows ${rfirst}..${rlast} = ${rrows}")
if(rrows GREATER 8)
  message(FATAL_ERROR "the library row text spans ${rrows} screen rows, expected at most 8 (mini8)")
endif()
# glyph pitch 8: from the first ink column, the text is a sequence of 8 wide cells whose gap column (the glyph's right
# bearing) is blank in every cell, so exactly 7 of the 8 column offsets carry ink. A pitch of 6, 7 or 9 drifts the gap over
# every offset within a few glyphs and fills all 8.
set(x0r -1)
foreach(x RANGE 178 400)
  col_rows(r ${x} ${rfirst} ${rlast})
  list(GET r 0 f)
  if(NOT f LESS 0)
    set(x0r ${x})
    break()
  endif()
endforeach()
set(hit_offsets "")
foreach(x RANGE ${x0r} 400)
  col_rows(r ${x} ${rfirst} ${rlast})
  list(GET r 0 f)
  if(NOT f LESS 0)
    math(EXPR off "(${x} - ${x0r}) % 8")
    list(APPEND hit_offsets ${off})
  endif()
endforeach()
list(REMOVE_DUPLICATES hit_offsets)
list(LENGTH hit_offsets noff)
message(STATUS "P5 library row glyph cell offsets with ink: ${hit_offsets}")
if(NOT noff EQUAL 7)
  message(FATAL_ERROR "the library row glyphs are not on an 8 column pitch (ink at ${noff} of 8 offsets: ${hit_offsets}, expected exactly 7)")
endif()

# 4. I537 items 1-5 (the Library screen of the font build). Layout numbers come from the desktop's own stats lines (label,
# region, nag*, stats rects); the pixels are checked where only ink can show the fault.
function(label_rect out text name)
  if(NOT "${text}" MATCHES "label (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ink (-?[0-9]+) (-?[0-9]+) text ${name}\n")
    message(FATAL_ERROR "no label '${name}' in the stats:\n${text}")
  endif()
  set(${out} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()
# 4.1 (I537 item 1) the Clear Library button starts right of the title ink.
label_rect(clr "${lo}" "Clear Library")
list(GET clr 0 clr_x)
# The baked Inter SemiBold 32 "Library" title ends at layout column 288 (measured on the frame dump; the button outline
# merges with the title tail in pixels, so the numbers are compared). Pre-fix the button sat at x=256 on top of it.
if(clr_x LESS 289)
  message(FATAL_ERROR "I537 item 1: Clear Library button at x=${clr_x} covers the title, which ends at column 288")
endif()
# 4.4 (item 4) every mode tab ends inside the 640 px page and the tabs do not overlap the style chooser or each other.
set(prev_end 0)
foreach(tab Composers Tree Columns Files History Sources)
  label_rect(tr "${lo}" "${tab}")
  list(GET tr 0 tx)
  list(GET tr 2 tw)
  math(EXPR tend "${tx} + ${tw}")
  if(tend GREATER 640 OR tx LESS prev_end)
    message(FATAL_ERROR "I537 item 4: tab ${tab} spans ${tx}..${tend} (previous tab ends ${prev_end}, page 640)")
  endif()
  set(prev_end ${tend})
endforeach()
foreach(st Grid "Cover Flow" List)
  label_rect(sr "${lo}" "${st}")
  list(GET sr 0 sx)
  list(GET sr 1 sy)
  list(GET tr 1 ty)
  if(sy EQUAL ty AND sx LESS prev_end)
    message(FATAL_ERROR "I537 item 4: style segment ${st} at x=${sx} overlaps the tab row ending at ${prev_end}")
  endif()
endforeach()
# 4.2 (item 2) the rail labels are not ellipsized: the last 8 columns of each label's ink hold a letter (at least 4 rows),
# an ellipsis leaves only its dots (1 to 2 rows). Doors are the ink bands right of the icon, below the brand row.
function(rail_ink outvar x y)
  pixel(bg 50 ${y})
  pixel(c ${x} ${y})
  if(c STREQUAL bg)
    set(${outvar} 0 PARENT_SCOPE)
  else()
    set(${outvar} 1 PARENT_SCOPE)
  endif()
endfunction()
set(bands "")
set(inband 0)
foreach(y RANGE 30 219)
  set(any 0)
  foreach(x RANGE 54 150)
    rail_ink(i ${x} ${y})
    if(i)
      set(any 1)
      break()
    endif()
  endforeach()
  if(any AND NOT inband)
    list(APPEND bands ${y})
  endif()
  set(inband ${any})
endforeach()
list(LENGTH bands nb)
message(STATUS "I537 rail label bands start at rows ${bands}")
if(nb LESS 7)
  message(FATAL_ERROR "I537 item 2: expected 7 rail label bands, found ${nb}")
endif()
foreach(door 2 5 6) # Your Library, Now Playing, Song Information (list index = door index when the brand band is excluded)
  list(GET bands ${door} y0)
  math(EXPR y1 "${y0} + 9")
  set(xr -1)
  foreach(x RANGE 54 150)
    foreach(y RANGE ${y0} ${y1})
      rail_ink(i ${x} ${y})
      if(i)
        set(xr ${x})
      endif()
    endforeach()
  endforeach()
  set(rmin 1000)
  set(rmax -1)
  math(EXPR xl "${xr} - 7")
  foreach(x RANGE ${xl} ${xr})
    foreach(y RANGE ${y0} ${y1})
      rail_ink(i ${x} ${y})
      if(i)
        if(y LESS rmin)
          set(rmin ${y})
        endif()
        if(y GREATER rmax)
          set(rmax ${y})
        endif()
      endif()
    endforeach()
  endforeach()
  math(EXPR span "${rmax} - ${rmin} + 1")
  if(span LESS 4)
    message(FATAL_ERROR "I537 item 2: rail door ${door} ends in ink spanning ${span} rows at columns ${xl}..${xr}: it is ellipsized")
  endif()
endforeach()
# 4.3 and 4.5 (items 3 and 5) the sync dialog (I602, was a banner), from the SDL backend with the launch SOURCES reply in: its
# buttons lie inside the panel and apart, and the statistics strip stays above the player bar.
if(SDL_BUILT)
  set(ENV{SDL_VIDEODRIVER} dummy)
  set(ENV{SELECTA_SDL_TEST_LIVE} 1)
  set(ENV{SELECTA_SOCKET} "/tmp/selecta-aga-native-text.sock")
  set(ENV{SELECTA_SDL_TEST_TIMED} "m5,5@200 m6,6@400 m7,7@600 q@800")
  file(REMOVE_RECURSE "${WORK}/cfg")
  execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" --db "${db}" --ui desktop
    --backend sdl --view library --canvas 640x256 --ydiv 2 --zoom fit --clock fixed --stats --resize 640x512
    OUTPUT_VARIABLE bo RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "banner run exited ${rc}")
  endif()
  # I650: since I602 the prompt is a modal dialog (DLG_SYNC); the stats print its panel and Sync now / Not now / Never buttons
  # only while it is open. The text of the three buttons is native AGA text in fixed 112 wide buttons: each must lie inside the
  # panel, the three must not overlap, and the panel must lie inside the 640x512 page.
  if(NOT bo MATCHES "nag ([0-9]+) syncs 0\nnagdlg opens 1 done 1\n" OR CMAKE_MATCH_1 LESS 1)
    message(FATAL_ERROR "no sync dialog in the stats:\n${bo}")
  endif()
  foreach(b nagpanel nagsync naglater nagnever)
    if(NOT bo MATCHES "\n${b} (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)\n")
      message(FATAL_ERROR "the dialog has no '${b}' rectangle:\n${bo}")
    endif()
    set(${b}_x ${CMAKE_MATCH_1})
    set(${b}_y ${CMAKE_MATCH_2})
    math(EXPR ${b}_r "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
    math(EXPR ${b}_b "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  endforeach()
  if(nagpanel_x LESS 0 OR nagpanel_y LESS 0 OR nagpanel_r GREATER 640 OR nagpanel_b GREATER 512)
    message(FATAL_ERROR "I537 item 3: the dialog panel ${nagpanel_x},${nagpanel_y}..${nagpanel_r},${nagpanel_b} leaves the 640x512 page")
  endif()
  foreach(b nagsync naglater nagnever)
    if(${b}_x LESS nagpanel_x OR ${b}_y LESS nagpanel_y OR ${b}_r GREATER nagpanel_r OR ${b}_b GREATER nagpanel_b)
      message(FATAL_ERROR "I537 item 3: dialog button ${b} leaves the panel")
    endif()
  endforeach()
  if(nagnever_r GREATER naglater_x OR naglater_r GREATER nagsync_x)
    message(FATAL_ERROR "I537 item 3: the dialog buttons overlap: never ${nagnever_x}-${nagnever_r}, later ${naglater_x}-${naglater_r}, sync ${nagsync_x}-${nagsync_r}")
  endif()
  if(NOT bo MATCHES "region name=player x=0 y=([0-9]+) " OR NOT bo MATCHES "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\n")
    message(FATAL_ERROR "no player region or stats rect in the stats:\n${bo}")
  endif()
  string(REGEX MATCH "region name=player x=0 y=([0-9]+) " _p "${bo}")
  set(player_y ${CMAKE_MATCH_1})
  string(REGEX MATCH "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\n" _s "${bo}")
  math(EXPR stats_end "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  if(stats_end GREATER player_y)
    message(FATAL_ERROR "I537 item 5: the statistics strip ends at layout row ${stats_end}, under the player bar at ${player_y}")
  endif()
endif()

# 6. I548 (a) the Library title does not intersect either header button, whichever row the buttons are on. The title rect is the
# measured title width (the desktop's own lib_header line) on the title row; a button on the title row must start right of it.
# Revert check: with the buttons pinned to the title row (lib_header_inline forced to 1) Clear Library starts at 292, 1 unit short
# of the title end 285 plus the 8 unit gap, the rects intersect and this fails.
if(NOT lo MATCHES "lib_header title (-?[0-9]+) (-?[0-9]+) ([0-9]+) add (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) clear (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "I548: no lib_header line:\n${lo}")
endif()
set(t_x ${CMAKE_MATCH_1})
set(t_y ${CMAKE_MATCH_2})
math(EXPR t_r "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} + 8") # title ink plus the 8 unit gap a button keeps from it
math(EXPR t_b "${CMAKE_MATCH_2} + 32")
set(hdr "${lo}")
foreach(which add clear)
  if(which STREQUAL "add")
    string(REGEX REPLACE "^.*lib_header title [^ ]+ [^ ]+ [^ ]+ add ([^ ]+) ([^ ]+) ([^ ]+) ([^ ]+) clear.*$" "\\1;\\2;\\3;\\4" btn "${hdr}")
  else()
    string(REGEX REPLACE "^.*clear ([^ ]+) ([^ ]+) ([^ ]+) ([^ \n]+)\n.*$" "\\1;\\2;\\3;\\4" btn "${hdr}")
  endif()
  list(GET btn 0 bx)
  list(GET btn 1 by)
  list(GET btn 2 bw)
  list(GET btn 3 bh)
  math(EXPR br "${bx} + ${bw}")
  math(EXPR bb "${by} + ${bh}")
  if(bx LESS t_r AND br GREATER t_x AND by LESS t_b AND bb GREATER t_y)
    message(FATAL_ERROR "I548 (a): header button ${which} ${bx},${by} ${bw}x${bh} intersects the title ${t_x},${t_y} ending at column ${t_r}")
  endif()
endforeach()
# 6. I553 on the 640x256 ydiv 2 screen both buttons share the title's row (their y lies inside the title row, not on a second row)
# and are right aligned: Add Folder ends right of Clear Library, which starts right of the title ink end.
# Revert check: with the buttons measured and drawn in the 14 role Clear Library drops to the second row (y = title y + 32 or more).
string(REGEX MATCH "lib_header title [^ ]+ [^ ]+ [^ ]+ add ([^ ]+) ([^ ]+) ([^ ]+) ([^ ]+) clear ([^ ]+) ([^ ]+) ([^ ]+) ([^ \n]+)\n" _h "${lo}")
set(add_x ${CMAKE_MATCH_1})
set(add_y ${CMAKE_MATCH_2})
set(clr_x ${CMAKE_MATCH_5})
set(clr_y ${CMAKE_MATCH_6})
set(clr_w ${CMAKE_MATCH_7})
if(add_y GREATER t_b OR clr_y GREATER t_b OR add_y LESS t_y OR NOT add_y EQUAL clr_y)
  message(FATAL_ERROR "I553: the header buttons are not on the title row: add y ${add_y}, clear y ${clr_y}, title row ${t_y}..${t_b}")
endif()
math(EXPR clr_r "${clr_x} + ${clr_w}")
if(clr_r GREATER add_x OR clr_x LESS t_r)
  message(FATAL_ERROR "I553: Clear Library ${clr_x}..${clr_r} overlaps Add Folder at ${add_x} or the title ending at ${t_r}")
endif()
# 6. I548 (b) the statistics strip is one line high on the bitmap tier, so every value is on its label's row, and the More control
# sits inside the strip row. Revert check: the old 48 high strip (label over value) and the 48 high More box fail the height test.
if(NOT lo MATCHES "stats rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+)\nlib_header[^\n]*\nstats_more (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+) ")
  message(FATAL_ERROR "I548: no stats rect and stats_more in order:\n${lo}")
endif()
set(s_y ${CMAKE_MATCH_2})
set(s_h ${CMAKE_MATCH_4})
set(m_y ${CMAKE_MATCH_6})
set(m_h ${CMAKE_MATCH_8})
math(EXPR s_b "${s_y} + ${s_h}")
math(EXPR m_b "${m_y} + ${m_h}")
if(NOT s_h EQUAL 24)
  message(FATAL_ERROR "I548 (b): the statistics strip is ${s_h} units high, expected one 24 unit line (value on the label row)")
endif()
if(m_y LESS s_y OR m_b GREATER s_b)
  message(FATAL_ERROR "I548 (b): the More control ${m_y}..${m_b} is outside the strip row ${s_y}..${s_b}")
endif()

# 5. I547: no sidebar or tab label is truncated at 640x512 (reuses the library run `lo`). Widths come from the measured labels,
# not constants: a Library tab draws its whole label (label ink width = 8 px per character in mini8), and a sidebar door row
# leaves its label box (row width - 12 pad - 22 icon - 8 gap) the widest rail label (12 characters, "Your Library") plus a 12 px
# margin so "Now Playing" and the rest do not touch the edge of the highlight.
# Revert check: with the old 160 rail and the fixed 8 px tab centring pad, the tab ink widths drop below 8 per character and
# the door row leaves 94 px for a 96 px label.
foreach(tab Composers Tree Columns Files History Sources)
  if(NOT lo MATCHES "label (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ink (-?[0-9]+) (-?[0-9]+) text ${tab}\n")
    message(FATAL_ERROR "I547: no centred label for the ${tab} tab:\n${lo}")
  endif()
  string(LENGTH "${tab}" tl)
  math(EXPR want "${tl} * 8")
  if(NOT CMAKE_MATCH_6 EQUAL want)
    message(FATAL_ERROR "I547: the ${tab} tab label is ${CMAKE_MATCH_6} px wide, expected the whole label (${want}): it is truncated")
  endif()
endforeach()
set(widest "Your Library")
string(LENGTH "${widest}" wl)
math(EXPR need "${wl} * 8 + 12 + 12 + 22 + 8")
foreach(i RANGE 0 6)
  if(NOT lo MATCHES "door ${i} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
    message(FATAL_ERROR "I547: no door ${i} rectangle:\n${lo}")
  endif()
  if(CMAKE_MATCH_3 LESS need)
    message(FATAL_ERROR "I547: sidebar row ${i} is ${CMAKE_MATCH_3} px wide, a ${wl} character label needs ${need}")
  endif()
endforeach()

# 7. I554 on the 640x512 AGA layout the history arrows (nav_arrows, top right of the main pane) intersect no page content rect:
# the search field of Home and Search, and on the Library page the title row buttons, the statistics strip, the More control, every
# tab (the Sources tab included; the tab row does not change with the mode) and the style chooser segments. Before the fix the
# search field (202..562) ran under the back arrow (552..580).
# Revert check: with search_field_rect not ending left of the arrows the Home and Search checks fail (field right edge 562 > 552).
function(rects_apart what ax ay aw ah bx by bw bh)
  if(aw EQUAL 0 OR bw EQUAL 0)
    return()
  endif()
  math(EXPR a_r "${ax} + ${aw}")
  math(EXPR a_b "${ay} + ${ah}")
  math(EXPR b_r "${bx} + ${bw}")
  math(EXPR b_b "${by} + ${bh}")
  if(ax LESS b_r AND bx LESS a_r AND ay LESS b_b AND by LESS a_b)
    message(FATAL_ERROR "I554: ${what} ${bx},${by} ${bw}x${bh} intersects the history arrow ${ax},${ay} ${aw}x${ah}")
  endif()
endfunction()
foreach(view home search library)
  dui_run(o --db "${db}" --ui desktop --backend mem --view ${view} --canvas 640x256 --ydiv 2 --zoom fit --clock fixed
    --stats --resize 640x512)
  if(NOT o MATCHES "nav_arrows (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
    message(FATAL_ERROR "I554 ${view}: no nav_arrows line:\n${o}")
  endif()
  set(arrow_list "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4};${CMAKE_MATCH_5} ${CMAKE_MATCH_6} ${CMAKE_MATCH_7} ${CMAKE_MATCH_8}")
  if(CMAKE_MATCH_3 EQUAL 0)
    message(FATAL_ERROR "I554 ${view}: the arrows are not drawn at 640x512, the check would pass vacuously")
  endif()
  # I599: the arrows are centred on the search field row and drawn through the icon atlas (sentinel nav_icons), whose
  # tall-pixel resample keeps the upper and lower arm of each chevron the same length.
  if(NOT o MATCHES "nav_icons ([0-9]+)\n" OR CMAKE_MATCH_1 LESS 2)
    message(FATAL_ERROR "I599 ${view}: the arrows were not drawn through the icon path:\n${o}")
  endif()
  if(NOT view STREQUAL "library" AND o MATCHES "search_field (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ")
    math(EXPR field_c2 "2 * ${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
    foreach(arrow ${arrow_list})
      separate_arguments(ar UNIX_COMMAND "${arrow}")
      list(GET ar 1 ay)
      list(GET ar 3 ah)
      math(EXPR arrow_c2 "2 * ${ay} + ${ah}")
      if(NOT arrow_c2 EQUAL field_c2)
        message(FATAL_ERROR "I599 ${view}: arrow ${arrow} centre is not on the search field centre (2*cy ${arrow_c2} vs ${field_c2})")
      endif()
    endforeach()
  endif()
  set(content "")
  if(NOT view STREQUAL "library" AND o MATCHES "search_field (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ")
    list(APPEND content "search field|${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
  endif()
  if(view STREQUAL "library")
    if(NOT o MATCHES "lib_header title [^ ]+ [^ ]+ [^ ]+ add ([^ ]+) ([^ ]+) ([^ ]+) ([^ ]+) clear ([^ ]+) ([^ ]+) ([^ ]+) ([^ \n]+)\n")
      message(FATAL_ERROR "I554: no lib_header line:\n${o}")
    endif()
    list(APPEND content "Add Folder|${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}" "Clear Library|${CMAKE_MATCH_5} ${CMAKE_MATCH_6} ${CMAKE_MATCH_7} ${CMAKE_MATCH_8}")
    string(REGEX MATCHALL "(stats rect|stats_more|tab [0-5]|style_chooser [0-2] [A-Za-z ]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)" others "${o}")
    foreach(r ${others})
      string(REGEX MATCH "^(.*) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)$" _r "${r}")
      list(APPEND content "${CMAKE_MATCH_1}|${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4} ${CMAKE_MATCH_5}")
    endforeach()
    list(LENGTH content nc)
    if(nc LESS 12)
      message(FATAL_ERROR "I554: only ${nc} library content rects parsed, expected the 2 buttons, stats, More, 6 tabs and 3 styles")
    endif()
  endif()
  foreach(arrow ${arrow_list})
    separate_arguments(ar UNIX_COMMAND "${arrow}")
    foreach(c ${content})
      string(REPLACE "|" ";" cp "${c}")
      list(GET cp 0 cname)
      list(GET cp 1 crect)
      separate_arguments(cr UNIX_COMMAND "${crect}")
      rects_apart("${view} ${cname}" ${ar} ${cr})
    endforeach()
  endforeach()
endforeach()
