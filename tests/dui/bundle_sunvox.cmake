# bundle-sunvox (I706d): the shipped app plays a modern SunVox song through the SunVox Library and credits it in About.
# -DSELECTA (the Selecta.app executable) -DSONG (tests/m3/fixtures/sunvox_tune_modern.sunvox) -DWORK.
# Both runs use an isolated app layout (a symlink of the executable beside its own plugin folder), so nothing from the build
# tree or $SELECTA_PLUGIN_PATH reaches the app:
# 1. Layout built from the real bundle's plugin folder, sunvox_lib module and its sunvox_lib/ folder COPIED in: the dropped
#    modern song plays with replayer=sunvox_lib (the 2009 BSD engine refuses it), the engine rendered frames, and the
#    Settings page, opened by a click, lists the "Powered by SunVox" credit read from sunvox_lib/CREDITS.txt.
# 2. Same layout without the sunvox_lib/ folder: the song is refused (no sunvox_lib replayer) and the About list is empty.
# The test fails at once when the bundle does not carry PlugIns/sunvox_lib (the library was not staged).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/songs")

get_filename_component(EXE_DIR "${SELECTA}" DIRECTORY)
get_filename_component(EXE_NAME "${SELECTA}" NAME)
if(EXE_DIR MATCHES "/MacOS$")
  set(REAL_PLUGINS "${EXE_DIR}/../PlugIns")
  set(ISO_EXE_REL "Contents/MacOS")
  set(ISO_PLUG_REL "Contents/PlugIns")
else()
  set(REAL_PLUGINS "${EXE_DIR}/plugins")
  set(ISO_EXE_REL "bin")
  set(ISO_PLUG_REL "bin/plugins")
endif()
if(NOT EXISTS "${REAL_PLUGINS}/sunvox_lib/CREDITS.txt" OR NOT EXISTS "${REAL_PLUGINS}/sunvox_lib/LICENSE.txt")
  message(FATAL_ERROR "the app bundle does not carry sunvox_lib/ (library, licence texts, CREDITS.txt) in ${REAL_PLUGINS}")
endif()
file(GLOB svl_lib "${REAL_PLUGINS}/sunvox_lib/sunvox.*")
if(NOT svl_lib)
  message(FATAL_ERROR "the app bundle carries no SunVox Library file in ${REAL_PLUGINS}/sunvox_lib")
endif()
file(COPY_FILE "${SONG}" "${WORK}/songs/modern.sunvox")

# layout(<name> <with library 0|1>): app/<name>/... ; every shipped module linked, the sunvox_lib parts copied or left out.
function(layout name with_lib)
  set(root "${WORK}/${name}")
  file(MAKE_DIRECTORY "${root}/${ISO_EXE_REL}" "${root}/${ISO_PLUG_REL}")
  file(CREATE_LINK "${SELECTA}" "${root}/${ISO_EXE_REL}/${EXE_NAME}" SYMBOLIC)
  file(GLOB shipped "${REAL_PLUGINS}/*")
  foreach(m IN LISTS shipped)
    get_filename_component(n "${m}" NAME)
    if(n STREQUAL "sunvox_lib")
      if(with_lib)
        file(COPY "${m}" DESTINATION "${root}/${ISO_PLUG_REL}")
      endif()
    elseif(n MATCHES "^sel_sunvox_lib\\.")
      file(COPY "${m}" DESTINATION "${root}/${ISO_PLUG_REL}")
    else()
      file(CREATE_LINK "${m}" "${root}/${ISO_PLUG_REL}/${n}" SYMBOLIC)
    endif()
  endforeach()
endfunction()

function(app_run outvar name)
  unset(ENV{SELECTA_PLUGIN_PATH})
  unset(ENV{SELECTA_SUNVOX_LIB})
  set(exe "${WORK}/${name}/${ISO_EXE_REL}/${EXE_NAME}")
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(REMOVE "${WORK}/library.db")
  set(args --start-dir "${WORK}/songs" --db "${WORK}/library.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats)
  # Pass 1: find the Settings entry. Pass 2: drop the song, click the entry.
  set(SELECTA "${exe}")
  file(WRITE "${WORK}/in.txt" "wait 300\n")
  dui_run(base ${args} --input "${WORK}/in.txt")
  if(NOT base MATCHES "entry (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)\n")
    message(FATAL_ERROR "no settings entry in the dump:\n${base}")
  endif()
  math(EXPR ex "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR ey "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  file(WRITE "${WORK}/in.txt" "wait 1\ndrop ${WORK}/songs/modern.sunvox\nwait 40\nmove ${ex} ${ey}\nclick ${ex} ${ey}\nwait 200\n")
  dui_run(o ${args} --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

layout(with 1)
app_run(with with)
if(NOT with MATCHES "replayer=sunvox_lib")
  message(FATAL_ERROR "the modern song was not rendered by sunvox_lib:\n${with}")
endif()
if(NOT with MATCHES "replayer_render_calls=([1-9][0-9]*) rendered_frames=([1-9][0-9]*) ")
  message(FATAL_ERROR "sunvox_lib rendered nothing:\n${with}")
endif()
if(NOT with MATCHES "about credits=([1-9][0-9]*) first=Powered by SunVox \\(modular synth & tracker\\)\n")
  message(FATAL_ERROR "the About list does not credit SunVox:\n${with}")
endif()

layout(without 0)
app_run(without without)
if(without MATCHES "replayer=sunvox_lib")
  message(FATAL_ERROR "sunvox_lib played without its library folder:\n${without}")
endif()
if(NOT without MATCHES "about credits=0 ")
  message(FATAL_ERROR "the About list shows a credit without the module folder:\n${without}")
endif()
message(STATUS "bundle_sunvox_ok")
