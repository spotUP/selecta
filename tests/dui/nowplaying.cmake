# dui-nowplaying (DUI-P4-7): the desktop Now Playing panel with synced lyrics, metadata pairs, up next, like and rating.
# -DSELECTA -DWORK -DGOLDEN. Fixture: tests/m3/lyrics/ambient.{mod,lrc}.
# 1. At each SEEK time the dumped `lyrics line N at T` is the index of the last LRC line with a time <= T, computed here from
#    the LRC file (not hard-coded); the index must advance across the times.
# 2. STAT_META_PANEL_ROWS (the meta_panel line) equals the panel pair count the dump prints and the number of `meta` lines,
#    and equals the number of metadata fields the script set (one RATE).
# 3. The panel drew (sentinel `nowplaying draws`) and a golden hash pins the frame.
# 4. I288: a click on the fourth rating mark of an unrated song fills four marks in the same run (`rating N` in the dump is
#    the count the last Now Playing draw filled). Run A reads the mark rectangles, run B clicks there.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
set(fx "${HERE}/../m3/lyrics")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${fx}/ambient.lrc" lrc)
string(REGEX MATCHALL "\\[[0-9]+:[0-9]+\\.[0-9]+\\]" stamps "${lrc}")
set(times "")
foreach(s IN LISTS stamps)
  string(REGEX MATCH "\\[([0-9]+):([0-9]+)\\.([0-9]+)\\]" m "${s}")
  math(EXPR mm "${CMAKE_MATCH_1} * 60000 + ${CMAKE_MATCH_2} * 1000")
  string(SUBSTRING "${CMAKE_MATCH_3}00" 0 3 frac)
  string(REGEX REPLACE "^0+([0-9])" "\\1" frac "${frac}")
  math(EXPR t "${mm} + ${frac}")
  list(APPEND times ${t})
endforeach()
list(LENGTH times line_count)
if(line_count LESS 4)
  message(FATAL_ERROR "the LRC fixture has too few timed lines (${line_count})")
endif()

function(np_run tag seek_ms)
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/${tag}.db")
  file(WRITE "${WORK}/${tag}.txt" "wait 300\n")
  dui_run(o --db "${WORK}/${tag}.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
    --exec "LIBRARY_SCAN ${fx}" --exec "OPEN ${fx}/ambient.mod" --exec "RATE 4" --exec "SEEK ${seek_ms}"
    --input "${WORK}/${tag}.txt")
  if(NOT "${o}" MATCHES "lyrics line (-?[0-9]+) at ([0-9]+)")
    message(FATAL_ERROR "no lyrics sentinel in:\n${o}")
  endif()
  set(${tag}_line "${CMAKE_MATCH_1}" PARENT_SCOPE)
  if(NOT "${o}" MATCHES "nowplaying draws ([0-9]+) pairs ([0-9]+)")
    message(FATAL_ERROR "no nowplaying sentinel in:\n${o}")
  endif()
  set(${tag}_draws "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_pairs "${CMAKE_MATCH_2}" PARENT_SCOPE)
  if(NOT "${o}" MATCHES "meta_panel panel_loads=[0-9]+ meta_panel_rows=([0-9]+)")
    message(FATAL_ERROR "no meta_panel stat in:\n${o}")
  endif()
  set(${tag}_rows "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCHALL "\nmeta [0-9]+ [^\n]*" mlines "\n${o}")
  list(LENGTH mlines ml)
  set(${tag}_mlines "${ml}" PARENT_SCOPE)
  dui_stat(h "${o}" desktop canvas_hash)
  set(${tag}_hash "${h}" PARENT_SCOPE)
endfunction()

set(expected_pairs 1) # the script sets exactly one field: RATE 4
set(prev -2)
foreach(seek 1000 5000 12500)
  np_run(s${seek} ${seek})
  set(want -1)
  set(i 0)
  foreach(t IN LISTS times)
    if(NOT t GREATER ${seek})
      set(want ${i})
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
  if(NOT s${seek}_line EQUAL want)
    message(FATAL_ERROR "at ${seek} ms the highlighted lyric line is ${s${seek}_line}, the LRC says ${want}")
  endif()
  if(NOT s${seek}_line GREATER prev)
    message(FATAL_ERROR "the lyric line did not advance at ${seek} ms (${s${seek}_line} after ${prev})")
  endif()
  set(prev ${s${seek}_line})
  if(s${seek}_draws LESS 1)
    message(FATAL_ERROR "the Now Playing panel did not draw at ${seek} ms")
  endif()
  if(NOT s${seek}_rows EQUAL expected_pairs OR NOT s${seek}_pairs EQUAL expected_pairs OR NOT s${seek}_mlines EQUAL expected_pairs)
    message(FATAL_ERROR "at ${seek} ms: META_PANEL_ROWS=${s${seek}_rows} dump pairs=${s${seek}_pairs} meta lines=${s${seek}_mlines}, want ${expected_pairs}")
  endif()
endforeach()
if(s1000_hash STREQUAL s12500_hash)
  message(FATAL_ERROR "the frame did not change when the lyric line advanced")
endif()

set(gfile "${GOLDEN}/desktop/nowplaying-rgba32-1280x800@1.hash")
if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
  file(WRITE "${gfile}" "${s12500_hash}\n")
endif()
if(NOT EXISTS "${gfile}")
  message(FATAL_ERROR "missing golden ${gfile} (hash ${s12500_hash}); create it with SELECTA_GOLDEN_UPDATE=1")
endif()
file(STRINGS "${gfile}" want LIMIT_COUNT 1)
if(NOT s12500_hash STREQUAL want)
  message(FATAL_ERROR "nowplaying hash ${s12500_hash} differs from golden ${want} (${gfile})")
endif()

function(np_rate_run tag input)
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/${tag}.db")
  file(WRITE "${WORK}/${tag}.txt" "${input}")
  dui_run(o --db "${WORK}/${tag}.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
    --exec "LIBRARY_SCAN ${fx}" --exec "OPEN ${fx}/ambient.mod" --exec "SEEK 1000" --input "${WORK}/${tag}.txt")
  if(NOT "${o}" MATCHES "rating (-?[0-9]+) liked ([01]) mark (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) step ([0-9]+)")
    message(FATAL_ERROR "no rating sentinel in:\n${o}")
  endif()
  set(${tag}_rating "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_liked "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_x "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_y "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${tag}_w "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${tag}_step "${CMAKE_MATCH_7}" PARENT_SCOPE)
endfunction()

np_rate_run(ra "wait 30\n")
if(NOT ra_rating EQUAL 0)
  message(FATAL_ERROR "an unrated song shows ${ra_rating} filled rating marks")
endif()
math(EXPR cx "${ra_x} + 3 * ${ra_step} + ${ra_w} / 2")
math(EXPR cy "${ra_y} + ${ra_w} / 2")
np_rate_run(rb "wait 30\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 30\n")
if(NOT rb_rating EQUAL 4)
  message(FATAL_ERROR "after a click on the fourth rating mark at ${cx},${cy} the panel fills ${rb_rating} marks, want 4")
endif()

# I306: a click on the mark of the stored rating sends RATE 0 and clears it; the heart click is LIKE, which toggles.
np_rate_run(rc "wait 30\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 30\nclick ${cx} ${cy}\nwait 30\n")
if(NOT rc_rating EQUAL 0)
  message(FATAL_ERROR "a second click on the fourth rating mark leaves ${rc_rating} marks filled, want 0 (RATE 0)")
endif()

# I306: the heart shows the liked state of the playing song (`liked N` in the dump is what the last Now Playing draw showed).
#    Not liked: 0. After a LIKE: 1 in the same run. A second LIKE toggles it back to 0.
if(NOT ra_liked EQUAL 0)
  message(FATAL_ERROR "an unliked song shows the heart as liked")
endif()
function(np_like_run tag input)
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/${tag}.db")
  file(WRITE "${WORK}/${tag}.txt" "wait 30\n")
  dui_run(o --db "${WORK}/${tag}.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
    --exec "LIBRARY_SCAN ${fx}" --exec "OPEN ${fx}/ambient.mod" --exec "SEEK 1000" ${input} --input "${WORK}/${tag}.txt")
  if(NOT "${o}" MATCHES "rating (-?[0-9]+) liked ([01]) mark")
    message(FATAL_ERROR "no liked sentinel in:\n${o}")
  endif()
  set(${tag}_liked "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()
np_like_run(la "--exec;LIKE")
if(NOT la_liked EQUAL 1)
  message(FATAL_ERROR "after LIKE the Now Playing heart shows liked=${la_liked}, want 1")
endif()
np_like_run(lb "--exec;LIKE;--exec;LIKE")
if(NOT lb_liked EQUAL 0)
  message(FATAL_ERROR "after LIKE twice the Now Playing heart shows liked=${lb_liked}, want 0")
endif()

# 5. I290: a tracker song message has several lines (message.it: three, libopenmpt joins them with a newline). The panel lays
#    them out as wrapped lines (`message lines 3`) and no control character reaches a glyph (missing_glyphs 0).
file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/msg.db")
file(WRITE "${WORK}/msg.txt" "wait 300\n")
dui_run(om --db "${WORK}/msg.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "LIBRARY_SCAN ${fx}" --exec "OPEN ${fx}/message.it" --input "${WORK}/msg.txt")
if(NOT "${om}" MATCHES "message lines ([0-9]+)")
  message(FATAL_ERROR "no message-lines sentinel in:\n${om}")
endif()
if(NOT CMAKE_MATCH_1 EQUAL 3)
  message(FATAL_ERROR "the three-line song message laid out ${CMAKE_MATCH_1} lines, want 3")
endif()
dui_stat(msg_missing "${om}" desktop missing_glyphs)
if(NOT msg_missing EQUAL 0)
  message(FATAL_ERROR "the song message painted ${msg_missing} missing-glyph boxes (a control character reached a glyph)")
endif()

# 5. (I361) The Now Playing page draws the open song's title line, and no text draw asks for a size outside the type scale:
#    a draw with an unknown size gets no atlas and paints nothing (the 28 px headings and title were invisible on every
#    backend). `font_misses` counts those draws; it must be 0.
dui_run(op --db "${WORK}/page.db" --ui desktop --backend mem --view nowplaying --canvas 1280x800 --clock fixed --stats
  --exec "OPEN ${fx}/ambient.mod")
if(NOT "${op}" MATCHES "np_page_text title=\\[([^]]+)\\] artist=\\[[^]]*\\] font_misses=([0-9]+)")
  message(FATAL_ERROR "the Now Playing page drew no title for the open song in:\n${op}")
endif()
if(NOT CMAKE_MATCH_2 EQUAL 0)
  message(FATAL_ERROR "${CMAKE_MATCH_2} text draws used a size outside the type scale and painted nothing")
endif()
