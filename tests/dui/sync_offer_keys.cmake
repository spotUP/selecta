# dui-sync-offer-keys (I789): the sync offer dialog keeps SOURCE KEYS, not indexes into the SOURCES rows the UI holds.
# -DSELECTA -DWORK -DGOLDEN -DSDL_BUILT. Fixture: the multi-source library of dui-sync-banner (every remote source due).
# Untick every dialog row but one, press Sync now, and assert through the real entry point (the SDL loop, real mouse clicks on
# the rectangles the stats dump prints) that
#   - exactly the one ticked source was sent ("nag 0 syncs 1"),
#   - library.sync_snoozed in the stored prefs names EVERY unticked row once and not the ticked one,
#   - the next launch offers no unticked source (all snoozed).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(DUI_SYNC_BANNER ON)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
dui_require_sdl()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sync-offer-keys needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sync-offer-keys.sock")
function(click_run tag tokens)
  cmake_parse_arguments(A "KEEP" "" "" ${ARGN})
  if(NOT A_KEEP)
    file(REMOVE_RECURSE "${WORK}/cfg")
  endif()
  set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens}")
  dui_run(${tag} --db "${db}" --ui desktop --backend sdl --view library --canvas 1280x800 --clock fixed --stats)
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
function(click_at out x y t)
  math(EXPR t1 "${t} + 50")
  math(EXPR t2 "${t} + 100")
  set(${out} "m${x},${y}@${t} d1,${x},${y}@${t1} u1,${x},${y}@${t2}" PARENT_SCOPE)
endfunction()
function(rect_center out text key)
  string(REGEX MATCH "${key} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _r "${text}")
  if(_r STREQUAL "")
    message(FATAL_ERROR "no '${key}' rectangle in the stats:\n${text}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out}_x ${cx} PARENT_SCOPE)
  set(${out}_y ${cy} PARENT_SCOPE)
endfunction()

# Launch: the dialog lists every due source, all ticked. The keys come from the dialog itself.
click_run(o0 "m5,5@200 m6,6@400 m7,7@600 q@800")
string(REGEX MATCHALL "nagrow [0-9]+ [^|\n]+\\|1 " rows0 "${o0}")
set(keys "")
foreach(r ${rows0})
  string(REGEX REPLACE "nagrow [0-9]+ ([^|]+)\\|1 " "\\1" k "${r}")
  list(APPEND keys ${k})
endforeach()
list(LENGTH keys nkeys)
if(nkeys LESS 10)
  message(FATAL_ERROR "the fixture dialog lists ${nkeys} sources, the test needs 10 or more:\n${o0}")
endif()
set(keep keygenmusic) # the longest key: the unticked rest then makes the stored list longest (the old 128 byte buffer cut it)
list(FIND keys ${keep} keep_at)
if(keep_at LESS 0)
  message(FATAL_ERROR "no keygenmusic row in the dialog: ${keys}")
endif()
set(tokens "")
set(t 300)
foreach(k ${keys})
  if(NOT k STREQUAL "${keep}")
    rect_center(row "${o0}" "nagrow [0-9]+ ${k}\\|1")
    click_at(c ${row_x} ${row_y} ${t})
    string(APPEND tokens " ${c}")
    math(EXPR t "${t} + 200")
  endif()
endforeach()
rect_center(sync "${o0}" "nagsync")
click_at(sc ${sync_x} ${sync_y} ${t})
math(EXPR tq "${t} + 2500")
# The ticked source carries an expired snooze (day 19000) from an earlier session: nag_snooze keeps it, so the stored list holds
# all ten sources, 135 characters: past the 128 byte buffer (nag_snooze csv) and pref value cap (SEL_PREF_VALUE_MAX) of before I789.
file(MAKE_DIRECTORY "${WORK}/cfg")
file(WRITE "${WORK}/cfg/prefs.conf" "library.sync_snoozed=${keep}:19000\n")
click_run(a "${tokens} ${sc} q@${tq}" KEEP)
if(NOT a MATCHES "nag 0 syncs 1\n")
  message(FATAL_ERROR "Sync now must send exactly the one ticked source:\n${a}")
endif()
# The stored snooze: every unticked key, never the ticked one (whose expired entry stays as it was).
file(READ "${WORK}/cfg/prefs.conf" prefs)
if(NOT prefs MATCHES "library.sync_snoozed *= *([^\n]*)\n")
  message(FATAL_ERROR "no library.sync_snoozed stored:\n${prefs}")
endif()
set(snoozed "${CMAKE_MATCH_1}")
foreach(k ${keys})
  if(k STREQUAL "${keep}")
    if(NOT snoozed MATCHES "(^|[ ,\"])${k}:19000")
      message(FATAL_ERROR "the ticked source ${k} lost its expired snooze or got a fresh one: ${snoozed}")
    endif()
  elseif(NOT snoozed MATCHES "(^|[ ,\"])${k}:")
    message(FATAL_ERROR "the unticked source ${k} was not snoozed: ${snoozed}")
  endif()
endforeach()
# Next launch on the same config: no unticked source is offered again (all snoozed); the ticked one may be (its sync is offline).
click_run(n "m5,5@200 m6,6@400 m7,7@600 q@800" KEEP)
foreach(k ${keys})
  if(NOT k STREQUAL "${keep}" AND n MATCHES "nagrow [0-9]+ ${k}\\|")
    message(FATAL_ERROR "the next launch offers the snoozed source ${k} again:\n${n}")
  endif()
endforeach()
