# dui-search-station-click (I1038): on the desktop Search page with All sources, double-clicking a station in the "From Radio Browser"
# section plays it and leaves the results alone. Playing an online hit pins it to the library (I406b), which bumps
# sel_state.library_serial; before I1038 desk_library_follow then reloaded the Search page, which sent the query again and opened
# the results at the top. One reachability test through the real shell and the scripted --input feeder, against the net fixture.
# -DSELECTA -DSONGS -DWORK -DNETWORK=<net fixture work dir>
#  run A: type `chip`, let the fan-out answer, scroll the results down. Records searches, scroll y and the station row rect.
#  run B: the same, then double-click that station row. Asserts:
#   - the play was sent (row_plays 1, the engine song is the station: the sentinel that the click path ran);
#   - the pin landed (library_pins moved, the sentinel that the I406b path ran) and the page kept its results through it (searches and scroll unchanged);
#   - no search was sent again (the searches stat equals run A) and the scroll offset is unchanged (non-zero).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${NETWORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "www.modules.pl=${fx},radio.modules.pl=${fx},fixture.test=${fx},ia.search.test=${fx},rb.search.test=${fx},cc.search.test=${fx},jam.search.test=${fx}")
set(ENV{SELECTA_ARCHIVEORG_BASE} "http://ia.search.test")
set(ENV{SELECTA_RADIO_BROWSER} "http://rb.search.test")
set(ENV{SELECTA_CCMIXTER_BASE} "http://cc.search.test")
set(ENV{SELECTA_JAMENDO_API} "http://jam.search.test")
set(ENV{SELECTA_JAMENDO_CLIENT_ID} "searchid1")
set(ENV{SELECTA_MODULESPL_SITE} "http://www.modules.pl")
unset(ENV{SELECTA_MIRROR})
set(ENV{SELECTA_MIRRORS_MODULESPL} "http://www.modules.pl/modules/")
set(ENV{SELECTA_CACHE_DIR} "${WORK}/cache")

function(sc_run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(REMOVE "${WORK}/library.db")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --db "${WORK}/library.db" --ui desktop --backend mem --view search --canvas 1280x800 --clock fixed --stats
    --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

set(typed "wait 300\nkey c\nkey h\nkey i\nkey p\n") # the debounce sends the query (Enter is not needed)
foreach(i RANGE 1 12)
  string(APPEND typed "wait 300\n")
endforeach()
string(APPEND typed "move 700 500\n")
foreach(i RANGE 1 6)
  string(APPEND typed "wheel 0 -200\nwait 50\n")
endforeach()
string(APPEND typed "wait 300\n")

sc_run(a "${typed}")
if(NOT "${a}" MATCHES "search_section [0-9]+ rows=2 From Radio Browser \\(2\\)")
  message(FATAL_ERROR "no 'From Radio Browser (2)' section:\n${a}")
endif()
if(NOT "${a}" MATCHES "searchrow [0-9]+ (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) key=(radiobrowser:[^\n]*)\n")
  message(FATAL_ERROR "no visible searchrow with a radiobrowser: key after scrolling:\n${a}")
endif()
math(EXPR x "${CMAKE_MATCH_1} + 40")
math(EXPR y "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(station "${CMAKE_MATCH_5}")
if(NOT "${a}" MATCHES "search scroll y=([0-9]+)")
  message(FATAL_ERROR "no search scroll line:\n${a}")
endif()
set(scroll_a "${CMAKE_MATCH_1}")
if(scroll_a EQUAL 0)
  message(FATAL_ERROR "the results did not scroll (y=0); the test needs a scrolled list:\n${a}")
endif()
dui_stat(searches_a "${a}" desktop searches)

sc_run(b "${typed}move ${x} ${y}\ndclick ${x} ${y}\nwait 300\nwait 300\nwait 300\nwait 300\nwait 300\n")
dui_stat(rp "${b}" desktop row_plays)
if(NOT rp EQUAL 1)
  message(FATAL_ERROR "the double-click on ${station} must play it (row_plays ${rp}):\n${b}")
endif()
if(NOT "${b}" MATCHES "library_serial=([0-9]+) library_reloads=([0-9]+) library_pins=([0-9]+)")
  message(FATAL_ERROR "no library_serial line:\n${b}")
endif()
set(pins "${CMAKE_MATCH_3}")
if(pins LESS 1)
  message(FATAL_ERROR "playing ${station} did not pin it (library_pins ${pins}); the I406b path did not run:\n${b}")
endif()
dui_stat(searches_b "${b}" desktop searches)
if(NOT searches_b EQUAL searches_a)
  message(FATAL_ERROR "playing ${station} sent the search again (searches ${searches_a} before, ${searches_b} after):\n${b}")
endif()
if(NOT "${b}" MATCHES "search scroll y=([0-9]+)")
  message(FATAL_ERROR "no search scroll line:\n${b}")
endif()
if(NOT CMAKE_MATCH_1 EQUAL scroll_a)
  message(FATAL_ERROR "playing ${station} moved the results (scroll y ${scroll_a} before, ${CMAKE_MATCH_1} after):\n${b}")
endif()
