# dui-hover-rows (DUI-P3-11, I345): a list row takes the control hover path and changes only its ink. -DSELECTA -DSONGS -DWORK
# Before the fix only the Songs page had a row hover (hover_row, an ad hoc scrim); Library rows were not in the pointer
# hit-test list at all. A mem run finds the rectangle of composer row 1 (the `row 1 x y w h` line of the library dump);
# a live run (SELECTA_SDL_TEST_LIVE=1, SELECTA_SDL_TEST_TIMED pushes a motion onto that row at 500 ms and a quit at 1500 ms)
# must then report: hover_box equals the row, `hover_ink=` new weight 65536 (the fade ended on the full ink), and
# `paints=0` (hover_fill_of, the background blend, never ran: a hovered row has no background).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-hover-rows needs the sqlite3 command line tool to load the fixture library")
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
string(CONCAT seed
  "INSERT INTO song_composers(song_key, canon, display) VALUES('fixture:1', 'chris huelsbeck', 'Chris Huelsbeck'); "
  "INSERT INTO song_composers(song_key, canon, display) VALUES('fixture:4', 'jogeir liljedahl', 'Jogeir Liljedahl')")
execute_process(COMMAND "${SQLITE3}" "${db}" "PRAGMA trusted_schema = 1; ${seed}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "seeding the composers failed: ${err}")
endif()
set(args --start-dir "${SONGS}" --db "${db}" --ui desktop --view library --canvas 900x600)
file(REMOVE_RECURSE "${WORK}/cfg")
dui_run(o0 ${args} --backend mem --clock fixed --stats)
if(NOT "${o0}" MATCHES "row 1 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
  message(FATAL_ERROR "no 'row 1' rectangle in the library dump:\n${o0}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(box "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
set(rowh "${CMAKE_MATCH_4}")
file(REMOVE_RECURSE "${WORK}/cfg")
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SDL_TEST_TIMED} "m${cx},${cy}@500 q@1500")
dui_run(o1 ${args} --backend sdl --stats)
if(NOT "${o1}" MATCHES "hover_box (-?[0-9]+ -?[0-9]+ -?[0-9]+ -?[0-9]+) fill=([0-9a-f]+) token=([0-9a-f]+) paints=([0-9]+)")
  message(FATAL_ERROR "no hover_box line in:\n${o1}")
endif()
set(hbox_s "${CMAKE_MATCH_1}")
set(paints "${CMAKE_MATCH_4}")
# The live window lays the main region out a few pixels differently from the mem canvas, so the hovered box is checked to
# be a row-high box holding the pointer, not to equal the mem rectangle.
if(NOT "${hbox_s}" MATCHES "^(-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)$")
  message(FATAL_ERROR "bad hover box '${CMAKE_MATCH_1}'")
endif()
set(hx "${CMAKE_MATCH_1}")
set(hy "${CMAKE_MATCH_2}")
math(EXPR hx2 "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
math(EXPR hy2 "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
if(NOT "${CMAKE_MATCH_4}" EQUAL "${rowh}" OR cx LESS hx OR NOT cx LESS hx2 OR cy LESS hy OR NOT cy LESS hy2)
  message(FATAL_ERROR "the hovered box is '${hx} ${hy} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}', expected the composer row 1 around (${cx},${cy}), mem rectangle '${box}'")
endif()
if(NOT "${paints}" EQUAL 0)
  message(FATAL_ERROR "a background fill was blended for the hovered row (paints=${paints}): rows hover by ink only")
endif()
if(NOT "${o1}" MATCHES "hover_ink=([0-9]+),([0-9]+)\n")
  message(FATAL_ERROR "no hover_ink line in:\n${o1}")
endif()
if(NOT "${CMAKE_MATCH_1}" EQUAL 65536)
  message(FATAL_ERROR "the row ink weight ended at ${CMAKE_MATCH_1}, expected the full 65536")
endif()
