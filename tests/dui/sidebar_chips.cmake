# dui-sidebar-chips (I678b, I1221): the six Your Library chips filter the sidebar list through the kind mask; every chip stays in view
# (wrapped onto rows, no single label, no X) while one is selected and only the selected one takes the accent fill; a click on the chip in
# force clears the filter; the page never changes. The bitmap tier keeps its single label with chevrons and the x (section at the end).
#   -DSELECTA -DSONGS -DWORK
# Fixture fixture_sidebar_mixed.sql: all 15, Playlists 2, Albums 3, Artists 3, Composers 3, Sources 1, Local Files 1 (the pinned row).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sidebar-chips needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x1400 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_sidebar_mixed.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()
function(items_of out)
  if(NOT "${out}" MATCHES "sidelib draws=[0-9]+ rows=[0-9]+ items=([0-9]+) ")
    message(FATAL_ERROR "no sidelib line in:\n${out}")
  endif()
  set(got_items "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
# chip_rect(<tag> <out> <k>): sets <tag>_w, <tag>_cx, <tag>_cy, <tag>_sel from the `sidechip <k> x y w h sel=` line.
function(chip_rect tag out k)
  if(NOT "${out}" MATCHES "sidechip ${k} (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) sel=([01])")
    message(FATAL_ERROR "no sidechip ${k} in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${tag}_w "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_cx "${cx}" PARENT_SCOPE)
  set(${tag}_cy "${cy}" PARENT_SCOPE)
  set(${tag}_sel "${CMAKE_MATCH_5}" PARENT_SCOPE)
endfunction()

file(WRITE "${WORK}/idle.txt" "wait 100\n")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x1400)
dui_run(c0 ${common} --input "${WORK}/idle.txt")
items_of("${c0}")
# I678m: the fixture's 15 items hold one synced source; every other registered source lists with 0 songs.
dui_registered_sources(nsrc "${c0}")
math(EXPR all_items "14 + ${nsrc}")
expect_eq("all items" "${got_items}" "${all_items}")
if(NOT "${c0}" MATCHES "sidechips chip=0 filters=[0-9]+ scrolls=[0-9]+ single=0 ")
  message(FATAL_ERROR "the desktop tier is not in chip mode (single=0) in:\n${c0}")
endif()
if(NOT "${c0}" MATCHES "sidechip_x 0 ")
  message(FATAL_ERROR "the X shows with no chip in force in:\n${c0}")
endif()
foreach(j RANGE 0 5)
  chip_rect(i${j} "${c0}" ${j})
  if(i${j}_w LESS 1)
    message(FATAL_ERROR "chip ${j} has no rectangle at start in:\n${c0}")
  endif()
  expect_eq("chip ${j} unselected at start" "${i${j}_sel}" "0")
endforeach()

set(names "Playlists;Albums;Artists;Composers;Sources;Local Files")
set(counts "2;3;3;3;${nsrc};1")
set(prev_filters 0)
foreach(k RANGE 0 5)
  file(WRITE "${WORK}/step${k}.txt" "click ${i${k}_cx} ${i${k}_cy}\nwait 100\n")
  dui_run(c${k} ${common} --input "${WORK}/step${k}.txt")
  list(GET names ${k} nm)
  list(GET counts ${k} want)
  items_of("${c${k}}")
  expect_eq("${nm} chip item count" "${got_items}" "${want}")
  if(NOT "${c${k}}" MATCHES "sidechips chip=([0-9]+) filters=([0-9]+) ")
    message(FATAL_ERROR "no sidechips line in:\n${c${k}}")
  endif()
  math(EXPR chip_want "${k} + 1")
  expect_eq("${nm} chip in force" "${CMAKE_MATCH_1}" "${chip_want}")
  if(NOT CMAKE_MATCH_2 GREATER 0)
    message(FATAL_ERROR "the ${nm} chip ran no filter pass in:\n${c${k}}")
  endif()
  if(NOT "${c${k}}" MATCHES "nav page=home")
    message(FATAL_ERROR "the ${nm} chip left the Home page in:\n${c${k}}")
  endif()
  # I1221: the other five chips stay in view (a rectangle each) and only the clicked one is selected.
  if(NOT "${c${k}}" MATCHES "sidechip_x 0 ")
    message(FATAL_ERROR "an X shows with the ${nm} chip in force in:\n${c${k}}")
  endif()
  foreach(j RANGE 0 5)
    chip_rect(s${j} "${c${k}}" ${j})
    if(s${j}_w LESS 1)
      message(FATAL_ERROR "chip ${j} disappeared with the ${nm} chip in force in:\n${c${k}}")
    endif()
    if(j EQUAL k)
      expect_eq("${nm} chip is the selected one" "${s${j}_sel}" "1")
    else()
      expect_eq("chip ${j} is unselected while ${nm} is in force" "${s${j}_sel}" "0")
    endif()
  endforeach()
endforeach()

# A second click on the chip in force clears it: all items return and no chip is selected.
file(WRITE "${WORK}/clear.txt" "click ${i1_cx} ${i1_cy}\nwait 100\nclick ${i1_cx} ${i1_cy}\nwait 100\n")
dui_run(cx ${common} --input "${WORK}/clear.txt")
items_of("${cx}")
expect_eq("a second click clears the chip" "${got_items}" "${all_items}")
if(NOT "${cx}" MATCHES "sidechips chip=0 ")
  message(FATAL_ERROR "chip state wrong after the second click in:\n${cx}")
endif()
# Another chip takes over without the first one hiding: Playlists then Artists.
file(WRITE "${WORK}/swap.txt" "click ${i0_cx} ${i0_cy}\nwait 100\nclick ${i2_cx} ${i2_cy}\nwait 100\n")
dui_run(cs ${common} --input "${WORK}/swap.txt")
if(NOT "${cs}" MATCHES "sidechips chip=3 ")
  message(FATAL_ERROR "Artists did not take over from Playlists in:\n${cs}")
endif()

# I831: the label mode on the bitmap tier (640x256, ydiv 2, always the single label) follows the same shared rule as the wide tier: with All in
# force the left slot is Previous Filter (no x); once the right chevron picks Playlists the left slot is the x, and a click on it returns to All.
set(bm --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 640x256 --ydiv 2 --zoom fit)
dui_run(b0 ${bm} --input "${WORK}/idle.txt")
if(NOT "${b0}" MATCHES "sidechips chip=0 filters=[0-9]+ scrolls=[0-9]+ single=1 ")
  message(FATAL_ERROR "the bitmap tier is not in label mode in:\n${b0}")
endif()
if(NOT "${b0}" MATCHES "sidechip_x 0 ")
  message(FATAL_ERROR "the x shows with All in force in label mode in:\n${b0}")
endif()
if(NOT "${b0}" MATCHES "sidechev L [0-9]+ [0-9]+ [0-9]+ [0-9]+ R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no sidechev in:\n${b0}")
endif()
math(EXPR brx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR bry "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2) / 2") # pointer rows are canvas rows, the dump is in square pixels (ydiv 2)
file(WRITE "${WORK}/bnext.txt" "click ${brx} ${bry}\nwait 100\n")
dui_run(b1 ${bm} --input "${WORK}/bnext.txt")
if(NOT "${b1}" MATCHES "sidechips chip=1 ")
  message(FATAL_ERROR "the right chevron did not pick Playlists in label mode in:\n${b1}")
endif()
if(NOT "${b1}" MATCHES "sidechip_x 1 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no x with a filter in force in label mode in:\n${b1}")
endif()
math(EXPR bxx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR bxy "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2) / 2")
file(WRITE "${WORK}/bclear.txt" "click ${brx} ${bry}\nwait 100\nclick ${bxx} ${bxy}\nwait 100\n")
dui_run(b2 ${bm} --input "${WORK}/bclear.txt")
if(NOT "${b2}" MATCHES "sidechips chip=0 " OR NOT "${b2}" MATCHES "sidechip_x 0 ")
  message(FATAL_ERROR "the x did not clear to All in label mode in:\n${b2}")
endif()
