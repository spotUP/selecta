# dui-sidebar-chips (I678b): the six Your Library chips filter the sidebar list through the kind mask; X clears; the page never changes.
#   -DSELECTA -DSONGS -DWORK
# Fixture fixture_sidebar_mixed.sql: all 15, Playlists 2, Albums 3, Artists 3, Composers 3, Sources 1, Local Files 1 (the pinned row).
# The 220 wide sidebar shows one chip label with chevrons; the right chevron steps All, Playlists, Albums, Artists, Composers, Sources,
# Local Files. Selecting a chip shows the X in the left chevron slot (`sidechip_x <has_x> x y w h`); a click on it returns to All.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sidebar-chips needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x1400 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_sidebar_mixed.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()
function(items_of out)
  if(NOT "${out}" MATCHES "sidelib draws=[0-9]+ rows=[0-9]+ items=([0-9]+) ")
    message(FATAL_ERROR "no sidelib line in:\n${out}")
  endif()
  set(got_items "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

file(WRITE "${WORK}/idle.txt" "wait 100\n")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x1400)
dui_run(c0 ${common} --input "${WORK}/idle.txt")
items_of("${c0}")
expect_eq("all items" "${got_items}" "15")
if(NOT "${c0}" MATCHES "sidechev L [0-9]+ [0-9]+ [0-9]+ [0-9]+ R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no sidechev in:\n${c0}")
endif()
math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
if(NOT "${c0}" MATCHES "sidechip_x 0 ")
  message(FATAL_ERROR "the X shows with no chip in force in:\n${c0}")
endif()

set(names "Playlists;Albums;Artists;Composers;Sources;Local Files")
set(counts "2;3;3;3;1;1")
set(clicks "")
set(prev_filters 0)
foreach(k RANGE 0 5)
  string(APPEND clicks "click ${rx} ${ry}\nwait 100\n")
  file(WRITE "${WORK}/step${k}.txt" "${clicks}")
  dui_run(c${k} ${common} --input "${WORK}/step${k}.txt")
  list(GET names ${k} nm)
  list(GET counts ${k} want)
  items_of("${c${k}}")
  expect_eq("${nm} chip item count" "${got_items}" "${want}")
  if(NOT "${c${k}}" MATCHES "sidechips chip=([0-9]+) filters=([0-9]+) ")
    message(FATAL_ERROR "no sidechips line in:\n${c${k}}")
  endif()
  math(EXPR chip_want "${k} + 1")
  expect_eq("${nm} chip in force" "${CMAKE_MATCH_1}" "${chip_want}")
  if(NOT CMAKE_MATCH_2 GREATER prev_filters)
    message(FATAL_ERROR "the ${nm} chip ran no filter pass (${prev_filters} -> ${CMAKE_MATCH_2})")
  endif()
  set(prev_filters "${CMAKE_MATCH_2}")
  if(NOT "${c${k}}" MATCHES "sidechip_x 1 ")
    message(FATAL_ERROR "no X with the ${nm} chip in force in:\n${c${k}}")
  endif()
  if(NOT "${c${k}}" MATCHES "nav page=home")
    message(FATAL_ERROR "the ${nm} chip left the Home page in:\n${c${k}}")
  endif()
endforeach()

# The X (left chevron slot) clears the chip: all 15 items return.
if(NOT "${c1}" MATCHES "sidechip_x 1 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no X rect in:\n${c1}")
endif()
math(EXPR xx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR xy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
file(WRITE "${WORK}/clear.txt" "click ${rx} ${ry}\nwait 100\nclick ${rx} ${ry}\nwait 100\nclick ${xx} ${xy}\nwait 100\n")
dui_run(cx ${common} --input "${WORK}/clear.txt")
items_of("${cx}")
expect_eq("X clears the chip" "${got_items}" "15")
if(NOT "${cx}" MATCHES "sidechips chip=0 " OR NOT "${cx}" MATCHES "sidechip_x 0 ")
  message(FATAL_ERROR "chip or X state wrong after the X click in:\n${cx}")
endif()
