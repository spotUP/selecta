# dui-sidebar-async (I787): the sidebar Your Library read never blocks a frame. -DSELECTA -DWORK -DSDL_BUILT.
# SELECTA_LIB_ITEMS_SLOW_MS=800 makes every list read take 0.8 s in the library worker. Driven through the desktop UI's SDL timed events:
#   1. the first list read is posted at the first draw and a click on the chip chevron arrives while it is in flight,
#   2. the loop kept drawing: sidelib_async flight_frames >= 1 (frames drawn while a read was in flight),
#   3. the async path ran: posts >= 2 and takes >= 1 (sentinels),
#   4. the result of the first read (mask All) is dropped, the list is read again for the Playlists chip and the list ends with
#      2 items (fixture_sidebar_mixed.sql: 2 playlists), nothing left in flight.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
dui_require_sdl()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sidebar-async needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_sidebar_mixed.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(c0 --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x800 --input "${WORK}/idle.txt")
if(NOT "${c0}" MATCHES "sidechev L [0-9]+ [0-9]+ [0-9]+ [0-9]+ R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no sidechev in:\n${c0}")
endif()
math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
math(EXPR hx "${rx} - 40")
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sidebar-async.sock")
set(ENV{SELECTA_LIB_ITEMS_SLOW_MS} 800)
file(REMOVE_RECURSE "${WORK}/cfg")
# click the right chevron at 300 ms (first read still in flight), move the pointer across the sidebar while the reads run, quit at 4 s
set(tokens "m${rx},${ry}@300 d1,${rx},${ry}@350 u1,${rx},${ry}@400")
foreach(k RANGE 0 9)
  math(EXPR t "500 + ${k} * 120")
  math(EXPR px "${hx} + ${k} * 4")
  string(APPEND tokens " m${px},${ry}@${t}")
endforeach()
set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens} q@4000")
dui_run(a --db "${db}" --ui desktop --backend sdl --view library --canvas 1280x800 --clock fixed --stats)
if(NOT a MATCHES "sidelib_async posts=([0-9]+) takes=([0-9]+) inflight=([0-9]+) flight_frames=([0-9]+)\n")
  message(FATAL_ERROR "no sidelib_async line in:\n${a}")
endif()
set(posts ${CMAKE_MATCH_1})
set(takes ${CMAKE_MATCH_2})
set(inflight ${CMAKE_MATCH_3})
set(fframes ${CMAKE_MATCH_4})
if(posts LESS 2 OR takes LESS 1)
  message(FATAL_ERROR "the async list read did not run (posts=${posts} takes=${takes}):\n${a}")
endif()
if(NOT inflight EQUAL 0)
  message(FATAL_ERROR "a list read was still in flight after 4 s (inflight=${inflight}):\n${a}")
endif()
if(fframes LESS 1)
  message(FATAL_ERROR "no frame was drawn while a list read was in flight (flight_frames=${fframes}): the frame waited:\n${a}")
endif()
if(NOT a MATCHES "sidelib draws=[0-9]+ rows=[0-9]+ items=2 ")
  message(FATAL_ERROR "the Playlists chip list did not replace the All list (want items=2):\n${a}")
endif()
message(STATUS "dui-sidebar-async ok (posts=${posts} takes=${takes} flight_frames=${fframes})")
