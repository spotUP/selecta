# dui-np-message-paging (I1422): a song message with more rows (a MOD's sample names) than the box holds pages by one box of rows
# every 5 s (crossfading over 400 ms) and returns to page 1 after the last page. -DSELECTA -DSONGS -DWORK
#   Fixture: tests/m3/message_long/message_rows.it, a 15 row message. The dump line `nowplaying msgpage <page> of <pages>`.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
dui_require_sdl()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(lyr "${HERE}/../m3/message_long")
function(np_page_run tag ms)
  file(WRITE "${WORK}/${tag}.txt" "wait ${ms}\n")
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/${tag}.db")
  dui_run(o --db "${WORK}/${tag}.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
    --exec "LIBRARY_SCAN ${lyr}" --exec "OPEN ${lyr}/message_rows.it" --input "${WORK}/${tag}.txt")
  if(NOT "${o}" MATCHES "nowplaying msgpage ([0-9]+) of ([0-9]+) bottom (-?[0-9]+) alpha ([0-9]+)")
    message(FATAL_ERROR "no msgpage line in:\n${o}")
  endif()
  set(${tag}_page "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_pages "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_bottom "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_alpha "${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()
np_page_run(p0 300)
if(p0_pages LESS 2)
  message(FATAL_ERROR "message has too few rows to page (pages=${p0_pages})")
endif()
math(EXPR last_ms "(${p0_pages} - 1) * 5000 + 300")
np_page_run(p1 5300)
math(EXPR full "${p0_pages} * 5000 + 300")
np_page_run(pw ${full})
if(NOT p1_page EQUAL 1 OR NOT pw_page EQUAL 0)
  message(FATAL_ERROR "page after 5.3 s is ${p1_page} (want 1), after ${full} ms is ${pw_page} (want 0, wrapped)")
endif()
np_page_run(plast ${last_ms})
if(NOT p0_bottom EQUAL plast_bottom OR NOT p0_bottom EQUAL p1_bottom)
  message(FATAL_ERROR "box bottom moves between pages: ${p0_bottom} / ${p1_bottom} / ${plast_bottom} (last page ${plast_page})")
endif()
# mid-fade frames: 100 ms before and after a page step are half transparent; mid-page is fully opaque
np_page_run(pf1 4900)
np_page_run(pf2 5100)
if(NOT pf1_page EQUAL 0 OR NOT pf2_page EQUAL 1 OR pf1_alpha LESS 1 OR pf1_alpha GREATER 254 OR pf2_alpha LESS 1 OR pf2_alpha GREATER 254)
  message(FATAL_ERROR "mid-fade alpha: 4900 ms page ${pf1_page} alpha ${pf1_alpha}, 5100 ms page ${pf2_page} alpha ${pf2_alpha} (want partial)")
endif()
if(NOT p1_alpha EQUAL 255 OR NOT p0_alpha EQUAL 255)
  message(FATAL_ERROR "mid-page alpha ${p0_alpha}/${p1_alpha} is not 255")
endif()
