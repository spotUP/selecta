# I565: every "ui.*" pref a UI plugin reads through host->config_get must be declared in prefs.def
# (an undeclared key is rejected by sel_prefs_set and skipped on load, so prefs.conf could never set it),
# and ui.desktop.zoom is declared with the empty default the desktop code treats as "backend decides".
# Run: cmake -DSRC=<repo root> -P ui_prefs_declared.cmake
file(READ "${SRC}/include/selecta/prefs.def" defs)
file(GLOB_RECURSE srcs "${SRC}/plugins/ui/*.c")
set(missing "")
set(seen 0)
foreach(f IN LISTS srcs)
  file(READ "${f}" body)
  # One line per read: a host->config_get call, the desk_pref accessor wrapping it, or a
  # PREFS_CHANGED key compare. (The old cross-line config_get span missed the desk_pref sites.)
  string(REPLACE ";" "," body "${body}")
  string(REGEX MATCHALL "(config_get|desk_pref|strcmp)\\([^\n]*\"ui\\.[a-z_.]+\"" calls "${body}")
  foreach(c IN LISTS calls)
    string(REGEX MATCH "\"ui\\.[a-z_.]+\"" key "${c}")
    math(EXPR seen "${seen}+1")
    string(REGEX MATCH ",[ ]*${key}," hit "${defs}")
    if(hit STREQUAL "")
      list(APPEND missing "${key} (${f})")
    endif()
  endforeach()
endforeach()
if(seen LESS 5)
  message(FATAL_ERROR "ui_prefs_declared: scanned only ${seen} reads, the scan is broken")
endif()
if(missing)
  message(FATAL_ERROR "ui_prefs_declared: undeclared in prefs.def: ${missing}")
endif()
if(NOT defs MATCHES "\"ui\\.desktop\\.zoom\",[ ]*\"\",[ ]*SEL_PREF_PLAIN")
  message(FATAL_ERROR "ui_prefs_declared: ui.desktop.zoom lacks the empty PLAIN default")
endif()
message(STATUS "ui_prefs_declared_ok reads=${seen}")
