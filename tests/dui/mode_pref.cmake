# dui-mode-pref (DUI-P1-3): the pref ui.desktop.mode through the one option parser. -DSELECTA -DSONGS -DWORK
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
dui_run(out MODE=mini --ui desktop --backend mem --stats --exec "PREF_GET ui.desktop.mode")
dui_stat(layout "${out}" desktop uim_layout)
if(NOT layout EQUAL 2)
  message(FATAL_ERROR "MODE=mini must give the mini layout (2), got ${layout}:\n${out}")
endif()
if(NOT out MATCHES "pref ui.desktop.mode=mini")
  message(FATAL_ERROR "PREF_GET ui.desktop.mode does not print mini:\n${out}")
endif()
file(REMOVE_RECURSE "${WORK}")
dui_run(dflt --ui desktop --backend mem --stats)
dui_stat(layout "${dflt}" desktop uim_layout)
if(NOT layout EQUAL 0)
  message(FATAL_ERROR "the default layout must be full (0), got ${layout}")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" MODE=bogus --ui desktop
  --backend mem OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
if(rc EQUAL 0 AND NOT e MATCHES "MODE")
  message(FATAL_ERROR "MODE=bogus must be rejected:\n${o}\n${e}")
endif()
