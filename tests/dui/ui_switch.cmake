# dui-ui-switch (DUI-P1-1): UI_SWITCH text from the desktop UI. -DSELECTA -DSONGS -DWORK
# The desktop UI closes exactly once, the text UI draws (frames > 0) and the engine keeps playing the same song:
# one song opened, the queue version unchanged by the switch.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
set(base --ui desktop --backend mem --stats --exec "QUEUE_ADD ${SONGS}/selecta-test.mod" --exec PLAY)
dui_run(plain ${base})
dui_run(sw ${base} --exec "UI_SWITCH text")
string(REGEX MATCHALL "desktop_ui closed" closes "${sw}")
list(LENGTH closes n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "the desktop close hook must run once, ran ${n}:\n${sw}")
endif()
if(NOT sw MATCHES "ui_closed id=desktop frames=[1-9]")
  message(FATAL_ERROR "the desktop UI did not report its frames when it closed:\n${sw}")
endif()
dui_stat(text_frames "${sw}" text frames)
if(text_frames EQUAL 0)
  message(FATAL_ERROR "the text UI drew no frame after the switch:\n${sw}")
endif()
foreach(key songs_opened queue_version)
  foreach(run plain sw)
    if(NOT "${${run}}" MATCHES "${key}=([0-9]+)")
      message(FATAL_ERROR "no ${key} in ${run}:\n${${run}}")
    endif()
    set(${run}_${key} "${CMAKE_MATCH_1}")
  endforeach()
  if(NOT plain_${key} EQUAL sw_${key})
    message(FATAL_ERROR "${key} changed by the switch: ${plain_${key}} -> ${sw_${key}}")
  endif()
endforeach()
if(NOT sw_songs_opened EQUAL 1)
  message(FATAL_ERROR "the song must open once, opened ${sw_songs_opened}")
endif()
dui_run(bad ${base} --exec "UI_SWITCH nonesuch")
if(NOT bad_err MATCHES "ui_unknown nonesuch" OR bad MATCHES "ui_closed")
  message(FATAL_ERROR "an unknown id must change nothing and say so:\n${bad}\n${bad_err}")
endif()
