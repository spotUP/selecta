# dui-actions (DUI-P1-6, M4-P2-3): the action table. -DSELECTA -DSONGS -DWORK
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
dui_run(out --ui desktop --backend mem --actions)
if(NOT out MATCHES "actions count=([0-9]+) exemptions=([0-9]+) check=([^\n]*)")
  message(FATAL_ERROR "no actions line:\n${out}")
endif()
set(count ${CMAKE_MATCH_1})
set(check "${CMAKE_MATCH_3}")
if(NOT check STREQUAL "ok")
  message(FATAL_ERROR "action table check failed: ${check}")
endif()
# The help overlay lists one row per action.
string(REGEX MATCHALL "\nhelp [^\n]+" helps "\n${out}")
list(LENGTH helps nhelp)
string(REGEX MATCHALL "\naction id=[^\n]+" acts "\n${out}")
list(LENGTH acts nact)
if(NOT nhelp EQUAL count OR NOT nact EQUAL count OR count LESS 1)
  message(FATAL_ERROR "help rows ${nhelp}, action rows ${nact}, table count ${count}")
endif()
# Label lint: no all-capital token other than the allow list, no dotted abbreviation, no label of one short word.
set(allow BPM Hz kHz dB URL)
foreach(a IN LISTS acts)
  if(NOT a MATCHES "label=(.*) icon=")
    message(FATAL_ERROR "no label in: ${a}")
  endif()
  set(label "${CMAKE_MATCH_1}")
  string(REPLACE " " ";" words "${label}")
  foreach(w IN LISTS words)
    if(w MATCHES "^[A-Z]+$" AND NOT w IN_LIST allow)
      message(FATAL_ERROR "label '${label}': '${w}' is an abbreviation")
    endif()
    if(w MATCHES "\\.$")
      message(FATAL_ERROR "label '${label}': '${w}' ends in a dot")
    endif()
  endforeach()
  if(NOT label MATCHES "^[A-Z]")
    message(FATAL_ERROR "label '${label}' must start with a capital")
  endif()
  if(a MATCHES "tooltip=$" OR NOT a MATCHES "icon=[a-z0-9-]+ menu=[^ ]+/")
    message(FATAL_ERROR "tooltip, icon or menu path missing: ${a}")
  endif()
endforeach()
