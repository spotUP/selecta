# dui-stats-panel (DUI-P4-24, I455): the Library Statistics strip stays one row; a More control at its right end expands
# the full statistics as a panel over the grid. -DSELECTA -DWORK -DSONGS
# The scripted input (--input, the real desktop entry point on the mem backend) clicks More, whose rectangle the test reads
# from the dump ("stats_more x y w h open=O"). The sentinel is "stats_panel draws=N rows=R rect ...": the panel painter bumps N.
#   run A: no click          -> open=0, draws=0 (collapsed by default), the stats rect keeps the one-row strip height.
#   run B: click More        -> open=1, draws>0, R equals the number of "stat" rows in the dump, the panel lies under the strip.
#   run C: click More, Escape -> open=0 again.
#   run D: click More twice   -> open=0 again (the control itself collapses).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-stats-panel needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()

function(panel_run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --db "${db}" --ui desktop --backend mem --view library --canvas 1280x800 --clock fixed --stats --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

panel_run(a "wait 1\n")
if(NOT a MATCHES "stats_more (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) open=([01])\nstats_panel draws=([0-9]+) rows=([0-9]+) rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no stats_more / stats_panel lines in the dump:\n${a}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
if(NOT CMAKE_MATCH_5 EQUAL 0 OR NOT CMAKE_MATCH_6 EQUAL 0)
  message(FATAL_ERROR "the panel must be collapsed and unpainted by default: open=${CMAKE_MATCH_5} draws=${CMAKE_MATCH_6}")
endif()
if(NOT a MATCHES "stats rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no stats rect:\n${a}")
endif()
set(strip_y "${CMAKE_MATCH_2}")
set(strip_h "${CMAKE_MATCH_4}")
if(NOT strip_h EQUAL 48)
  message(FATAL_ERROR "the Statistics strip must stay one row (48 px at scale 1): ${strip_h}")
endif()
string(REGEX MATCHALL "\nstat [^\n]*" rows "${a}")
list(LENGTH rows nrows)
if(nrows LESS 1 OR nrows GREATER 18)
  message(FATAL_ERROR "expected 1 to 18 statistics rows in the dump, got ${nrows}:\n${a}")
endif()

panel_run(b "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\n")
if(NOT b MATCHES "stats_more [-0-9]+ [-0-9]+ [0-9]+ [0-9]+ open=1\nstats_panel draws=([0-9]+) rows=([0-9]+) rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "clicking More did not open the panel:\n${b}")
endif()
if(NOT CMAKE_MATCH_1 GREATER 0)
  message(FATAL_ERROR "the panel was never painted: draws=${CMAKE_MATCH_1}")
endif()
if(NOT CMAKE_MATCH_2 EQUAL nrows)
  message(FATAL_ERROR "the panel shows ${CMAKE_MATCH_2} rows, the statistics have ${nrows}")
endif()
math(EXPR strip_end "${strip_y} + ${strip_h}")
if(CMAKE_MATCH_4 LESS strip_end OR NOT CMAKE_MATCH_6 GREATER 0)
  message(FATAL_ERROR "the panel must lie under the strip (strip ends ${strip_end}): y=${CMAKE_MATCH_4} h=${CMAKE_MATCH_6}")
endif()
if(NOT b MATCHES "stats rect [-0-9]+ ${strip_y} [0-9]+ ${strip_h}\n")
  message(FATAL_ERROR "opening the panel moved or resized the strip (grid height must not change):\n${b}")
endif()

panel_run(c "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\nkey escape\nwait 1\n")
if(NOT c MATCHES "open=0\nstats_panel draws=([0-9]+)" OR NOT CMAKE_MATCH_1 GREATER 0)
  message(FATAL_ERROR "Escape must collapse a panel that was painted:\n${c}")
endif()

panel_run(d "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\nmove ${cx} ${cy}\nwait 700\nclick ${cx} ${cy}\nwait 1\n")
if(NOT d MATCHES "open=0\nstats_panel draws=([0-9]+)" OR NOT CMAKE_MATCH_1 GREATER 0)
  message(FATAL_ERROR "a second click on Less must collapse the panel:\n${d}")
endif()
