# I1469 dui-account-dialog (design doc 9.2, D-M3-12): the top bar avatar opens the account dialog (Log In form, logged
# out: no name), Tab moves between the fields, Escape closes it without a request.
include("${CMAKE_CURRENT_LIST_DIR}/dui_run.cmake")
set(args --ui desktop --backend mem --canvas 1280x800 --clock fixed --stats)

file(WRITE "${WORK}/acct-0.txt" "wait 1\n")
dui_run(o ${args} --input "${WORK}/acct-0.txt")
if(NOT o MATCHES "account user= open=0 busy=0 clicks=0 avatar=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)")
  message(FATAL_ERROR "I1469 no logged-out account line\n${o}")
endif()
if(CMAKE_MATCH_3 LESS 8)
  message(FATAL_ERROR "I1469 no avatar in the top bar at 1280x800\n${o}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")

file(WRITE "${WORK}/acct-1.txt" "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\nkey tab\nwait 1\n")
dui_run(o ${args} --input "${WORK}/acct-1.txt")
if(NOT o MATCHES "account user= open=1 busy=0 clicks=1 " OR NOT o MATCHES "dialog quits=[0-9]+ open=7 ")
  message(FATAL_ERROR "I1469 the avatar click did not open the account dialog\n${o}")
endif()

file(WRITE "${WORK}/acct-2.txt" "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\nkey escape\nwait 1\n")
dui_run(o ${args} --input "${WORK}/acct-2.txt")
if(NOT o MATCHES "account user= open=0 busy=0 clicks=1 " OR NOT o MATCHES "dialog quits=[0-9]+ open=0 ")
  message(FATAL_ERROR "I1469 Escape did not close the account dialog\n${o}")
endif()
# I1472: the fields take a click and typing. The form's rects come from the dump (the same rects the hit test uses); click
# the toggle (Create Account), click the Username field, type "ab", click the Password field, type "c": the name grew by 2
# and the password by 1; the same on the Log In form (no toggle click). A click on the field must not close the dialog.
file(WRITE "${WORK}/acct-3.txt" "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\n")
dui_run(o ${args} --input "${WORK}/acct-3.txt")
if(NOT o MATCHES "acctform signup=0 field=0 namelen=0 passlen=0 toggle=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+) f0=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+) f1=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)")
  message(FATAL_ERROR "I1472 no account form line\n${o}")
endif()
# CMake keeps only CMAKE_MATCH_0..9, so each rect gets its own match.
foreach(r toggle f0 f1)
  string(REGEX MATCH " ${r}=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)" _ "${o}")
  math(EXPR ${r}_x "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR ${r}_y "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
endforeach()
set(tx ${toggle_x})
set(ty ${toggle_y})
set(ux ${f0_x})
set(uy ${f0_y})
set(px ${f1_x})
set(py ${f1_y})
set(open "wait 1\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\n")
set(typed "move ${ux} ${uy}\nclick ${ux} ${uy}\nkey a\nkey b\nmove ${px} ${py}\nclick ${px} ${py}\nkey c\nwait 1\n")
foreach(form 0 1)
  if(form)
    file(WRITE "${WORK}/acct-4.txt" "${open}move ${tx} ${ty}\nclick ${tx} ${ty}\nwait 1\n${typed}")
  else()
    file(WRITE "${WORK}/acct-4.txt" "${open}${typed}")
  endif()
  dui_run(o ${args} --input "${WORK}/acct-4.txt")
  if(NOT o MATCHES "open=1 busy=0 clicks=1 " OR NOT o MATCHES "acctform signup=${form} field=1 namelen=2 passlen=1 ")
    message(FATAL_ERROR "I1472 clicking the fields and typing did not fill the signup=${form} form\n${o}")
  endif()
endforeach()
message(STATUS "dui_account_dialog_ok")
