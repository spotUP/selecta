# dui-list-keys (DUI-P3-3, I423): list keyboard parity on the songs list, through the real shell and the scripted --input feeder.
#   -DSELECTA -DSONGS -DWORK
# Six songs are queued. Down x3 moves the focus row from none to display row 3; the dump line `songs_focus` carries the row,
# the fill token the focus row draws, the Enter counter and the row-play counter. Enter then plays row 3 through the same
# function a double-click uses: activates 1, plays 1, and the engine's open song is row 3's path (playing 1).
# A run without a key press shows no focus row (row -1), so the goldens stay unchanged. End and Home move to the ends.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(queue "")
foreach(n a b c d e f)
  configure_file("${SONGS}/selecta-test.mod" "${WORK}/${n}.mod" COPYONLY)
  list(APPEND queue --exec "QUEUE_ADD ${WORK}/${n}.mod")
endforeach()

function(keys_run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --ui desktop --backend mem --view songs --canvas 1280x800 --clock fixed --stats ${queue} --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

function(focus_line out)
  if(NOT "${out}" MATCHES "songs_focus row (-?[0-9]+) fill ([0-9a-f]+) activates ([0-9]+) plays ([0-9]+) playing ([01])")
    message(FATAL_ERROR "no songs_focus line in:\n${out}")
  endif()
  set(got_row ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(got_fill ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(got_act ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(got_plays ${CMAKE_MATCH_4} PARENT_SCOPE)
  set(got_playing ${CMAKE_MATCH_5} PARENT_SCOPE)
endfunction()

keys_run(none "")
focus_line("${none}")
if(NOT got_row EQUAL -1)
  message(FATAL_ERROR "no key pressed: the focus row must be -1, got ${got_row}")
endif()

keys_run(moved "key down\nkey down\nkey down\n")
focus_line("${moved}")
if(NOT got_row EQUAL 2 OR NOT got_act EQUAL 0)
  message(FATAL_ERROR "Down x3 must focus row 2 (the first Down lands on row 0) without activating (row ${got_row}, activates ${got_act})")
endif()
set(want_fill "${got_fill}")

keys_run(entered "key down\nkey down\nkey down\nkey enter\n")
focus_line("${entered}")
if(NOT got_row EQUAL 2 OR NOT got_act EQUAL 1 OR NOT got_plays EQUAL 1 OR NOT got_playing EQUAL 1)
  message(FATAL_ERROR "Down x3 then Enter must play row 2 once (row ${got_row}, activates ${got_act}, plays ${got_plays}, playing ${got_playing})")
endif()
dui_stat(row_plays "${entered}" desktop row_plays)
if(NOT row_plays EQUAL 1)
  message(FATAL_ERROR "the stat row_plays must be 1, got ${row_plays}")
endif()

keys_run(ends "key end\n")
focus_line("${ends}")
if(NOT got_row EQUAL 5)
  message(FATAL_ERROR "End must focus the last row (5), got ${got_row}")
endif()
keys_run(home "key end\nkey home\n")
focus_line("${home}")
if(NOT got_row EQUAL 0)
  message(FATAL_ERROR "Home must focus row 0, got ${got_row}")
endif()

# ---- I498: the same keys on the other desktop lists. The dump line `list_focus page P row R activates A plays N` carries the
# focus row of whichever list the page shows (the queue index, the Library UI list row, the playlist selection or the engine
# cursor). A run without a key shows row -1 (or the page's own selection), so the goldens stay unchanged. ----
function(lf_parse out)
  if(NOT "${out}" MATCHES "list_focus page ([0-9]+) row (-?[0-9]+) activates ([0-9]+) plays ([0-9]+)")
    message(FATAL_ERROR "no list_focus line in:\n${out}")
  endif()
  set(lf_row ${CMAKE_MATCH_2} PARENT_SCOPE)
  set(lf_act ${CMAKE_MATCH_3} PARENT_SCOPE)
  set(lf_plays ${CMAKE_MATCH_4} PARENT_SCOPE)
endfunction()

function(lf_run outvar view input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/lf.txt" "${input}")
  dui_run(o --ui desktop --backend mem --view ${view} --canvas 1280x800 --clock fixed --stats ${ARGN} --input "${WORK}/lf.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

function(lf_expect tag out row act plays)
  lf_parse("${out}")
  if(NOT lf_row EQUAL ${row} OR NOT lf_act EQUAL ${act} OR NOT lf_plays EQUAL ${plays})
    message(FATAL_ERROR "${tag}: want row ${row} activates ${act} plays ${plays}, got row ${lf_row} activates ${lf_act} plays ${lf_plays}")
  endif()
endfunction()

# Queue page: Down x2 focus a row, Enter plays it, End and Home move to the ends.
lf_run(q0 queue "wait 1\n" ${queue})
lf_expect("queue without a key" "${q0}" -1 0 0)
lf_run(q00 queue "key down\nwait 1\n" ${queue})
lf_expect("queue first Down lands on absolute row 0 (I505)" "${q00}" 0 0 0)
lf_run(q1 queue "key down\nkey down\nwait 1\n" ${queue})
lf_expect("queue Down x2" "${q1}" 1 0 0)
lf_run(q2 queue "key down\nkey down\nkey enter\nwait 20\n" ${queue})
lf_expect("queue Enter" "${q2}" 1 1 1)
lf_run(q3 queue "key end\nwait 1\n" ${queue})
lf_expect("queue End" "${q3}" 5 0 0)
lf_run(q4 queue "key end\nkey home\nwait 1\n" ${queue})
lf_expect("queue Home" "${q4}" 0 0 0)

# Library lists need a library file: the fixture songs, composers, and path-keyed songs for the tree.
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-list-keys needs the sqlite3 command line tool to load the fixture library")
endif()
function(lf_db name seed)
  set(db "${WORK}/${name}.db")
  file(REMOVE "${db}")
  dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
  execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "loading the fixture failed: ${err}")
  endif()
  if(NOT "${seed}" STREQUAL "")
    execute_process(COMMAND "${SQLITE3}" "${db}" "PRAGMA trusted_schema = 1; ${seed}" RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "seeding ${name} failed: ${err}")
    endif()
  endif()
  set(lf_db_path "${db}" PARENT_SCOPE)
endfunction()

# Library composer list: Down focuses a row, Enter opens that composer (the drilldown), as a click does.
string(CONCAT comp_seed
  "INSERT INTO song_composers(song_key, canon, display) VALUES('fixture:1', 'chris huelsbeck', 'Chris Huelsbeck'); "
  "INSERT INTO song_composers(song_key, canon, display) VALUES('fixture:4', 'jogeir liljedahl', 'Jogeir Liljedahl')")
lf_db(comp "${comp_seed}")
set(cdb "${lf_db_path}")
lf_run(c0 library "wait 2\n" --db "${cdb}")
lf_expect("composer list without a key" "${c0}" -1 0 0)
lf_run(c1 library "wait 2\nkey down\nwait 1\n" --db "${cdb}")
lf_expect("composer list first Down lands on absolute row 0 (I505)" "${c1}" 0 0 0)
lf_run(c2 library "wait 2\nkey down\nkey enter\nwait 2\n" --db "${cdb}")
lf_expect("composer list Enter" "${c2}" -1 1 0)
if(NOT "${c2}" MATCHES "drill Chris Huelsbeck\\|1\n")
  message(FATAL_ERROR "Enter on the focused composer row must open that composer's drilldown:\n${c2}")
endif()

# Drilldown (the library also lists the Unknown composer, so Play Composer is row 0 and Home reaches it): the song row plays on Enter, as the click of I299 does.
file(COPY_FILE "${SONGS}/selecta-test.mod" "${WORK}/Played.mod")
string(CONCAT play_seed
  "INSERT INTO songs(key, source, path, name, artist, album, format, year, genre, duration_ms, added) VALUES('${WORK}/Played.mod', 'local', '${WORK}/Played.mod', 'Played', 'Anon', 'Disk', 'mod', 1990, 'Chiptune', 1000, 1700000010); "
  "INSERT INTO song_composers(song_key, canon, display) VALUES('${WORK}/Played.mod', 'play composer', 'Play Composer')")
lf_db(play "${play_seed}")
set(pdb "${lf_db_path}")
lf_run(d0 library "wait 1\n" --db "${pdb}")
if(NOT "${d0}" MATCHES "row 0 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no row 0 rectangle in:\n${d0}")
endif()
math(EXPR dx "${CMAKE_MATCH_1} + 10")
math(EXPR dy "${CMAKE_MATCH_2} + 8")
set(dpre "wait 1\nmove ${dx} ${dy}\nclick ${dx} ${dy}\nwait 20\n")
lf_run(d1 library "${dpre}key home\nwait 1\n" --db "${pdb}")
lf_expect("drilldown Home" "${d1}" 0 0 0)
lf_run(d2 library "${dpre}key home\nkey enter\nwait 20\n" --db "${pdb}")
lf_expect("drilldown Enter" "${d2}" 0 1 1)
if(NOT "${d2}" MATCHES "songs_opened=1")
  message(FATAL_ERROR "Enter on the drilldown song row must open the song:\n${d2}")
endif()

# Grid and cover flow: Right moves the cursor tile, Enter opens it (counted as an activation).
set(gq "")
foreach(p 1.mod 2.mod 3.xm 4.it 5.sid)
  list(APPEND gq --exec "QUEUE_ADD \"fixture/${p}\"")
endforeach()
lf_db(grid "${comp_seed}")
set(gdb "${lf_db_path}")
foreach(style grid coverflow)
  set(pre "exec VIEW_SOURCE queue\nexec VIEW_WINDOW 8\nexec VIEW_STYLE ${style}\nexec COMPOSERS_SHOW\nwait 100\n")
  lf_run(g0 library "${pre}" --db "${gdb}" ${gq})
  lf_expect("${style} without a key" "${g0}" -1 0 0)
  lf_run(g1 library "${pre}key right\nkey right\nwait 600\n" --db "${gdb}" ${gq})
  lf_expect("${style} Right x2" "${g1}" 2 0 0)
  lf_run(g2 library "${pre}key right\nkey left\nwait 600\n" --db "${gdb}" ${gq})
  lf_expect("${style} Left" "${g2}" 0 0 0)
  lf_run(g3 library "${pre}key right\nkey enter\nwait 100\n" --db "${gdb}" ${gq})
  lf_expect("${style} Enter" "${g3}" 1 1 0)
endforeach()

# Library tree: Down moves the engine cursor row, Enter expands the focused node.
string(CONCAT tree_seed
  "INSERT INTO songs(key, source, path, name, artist, album, format, year, genre, duration_ms, added) VALUES('/music/a/one.mod', 'local', '/music/a/one.mod', 'One', 'Anon', 'Disk', 'mod', 1990, 'Chiptune', 1000, 1700000010); "
  "INSERT INTO songs(key, source, path, name, artist, album, format, year, genre, duration_ms, added) VALUES('/music/a/two.xm', 'local', '/music/a/two.xm', 'Two', 'Anon', 'Disk', 'xm', 1990, 'Chiptune', 1000, 1700000011)")
lf_db(tree "${tree_seed}")
set(tdb "${lf_db_path}")
lf_run(t0 library "wait 1\n" --db "${tdb}")
if(NOT "${t0}" MATCHES "tab 1 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no tab 1 rectangle in:\n${t0}")
endif()
math(EXPR tx "${CMAKE_MATCH_1} + 10")
math(EXPR ty "${CMAKE_MATCH_2} + 8")
set(tpre "wait 2\nmove ${tx} ${ty}\nclick ${tx} ${ty}\nwait 2\n")
lf_run(t1 library "${tpre}key down\nwait 1\n" --db "${tdb}")
lf_parse("${t1}")
set(t1_row ${lf_row})
if(NOT t1_row EQUAL 0)
  message(FATAL_ERROR "tree: the first Down must focus absolute row 0 (I505), got ${t1_row}")
endif()
lf_run(t2 library "${tpre}key down\nkey down\nkey up\nwait 2\n" --db "${tdb}")
lf_parse("${t2}")
math(EXPR t1_next "${t1_row} + 0")
if(NOT lf_row EQUAL t1_next)
  message(FATAL_ERROR "tree: Down, Down, Up must end on the first row again (${t1_row} -> ${lf_row})")
endif()
lf_run(t3 library "${tpre}key down\nkey enter\nwait 2\n" --db "${tdb}")
lf_parse("${t3}")
if(NOT lf_act EQUAL 1)
  message(FATAL_ERROR "tree: Enter must count one activation, got ${lf_act}")
endif()

# Search results: Down moves the cursor row; Enter on a song row plays it (counted).
set(sdb "${WORK}/search.db")
lf_db(search "")
set(sdb "${lf_db_path}")
set(typed "key /\nkey m\nkey o\nkey d\nkey enter\nwait 600\nexec VIEW_CURSOR +0\nwait 5\n")
# the exec pumps the engine: a scripted key otherwise runs before the search answer reaches the desktop
lf_run(s1 library "${typed}key down\nwait 1\n" --db "${sdb}")
lf_parse("${s1}")
set(s1_row ${lf_row})
lf_run(s2 library "${typed}key down\nkey down\nwait 1\n" --db "${sdb}")
lf_parse("${s2}")
math(EXPR s1_next "${s1_row} + 1")
if(NOT lf_row EQUAL s1_next)
  message(FATAL_ERROR "search: a second Down must move the cursor one row (${s1_row} -> ${lf_row})")
endif()
lf_run(s3 library "${typed}key down\nkey enter\nwait 20\n" --db "${sdb}")
lf_parse("${s3}")
if(NOT lf_act EQUAL 1)
  message(FATAL_ERROR "search: Enter must count one activation, got ${lf_act}")
endif()

# Playlists page: Down selects a playlist row, Enter opens it.
lf_db(pl "")
set(pldb "${lf_db_path}")
set(plmk --db "${pldb}" ${queue} --exec "PLAYLIST_CREATE alpha" --exec "PLAYLIST_CREATE beta")
lf_run(p0 playlists "wait 1\n" ${plmk})
lf_parse("${p0}")
set(p0_row ${lf_row})
lf_run(p1 playlists "key down\nwait 1\n" ${plmk})
lf_parse("${p1}")
set(p1_row ${lf_row})
lf_run(p2 playlists "key down\nkey down\nwait 1\n" ${plmk})
lf_parse("${p2}")
math(EXPR p1_next "${p1_row} + 1")
if(p1_row EQUAL p0_row OR NOT lf_row EQUAL p1_next)
  message(FATAL_ERROR "playlists: Down must move the selection (${p0_row} -> ${p1_row} -> ${lf_row})")
endif()
lf_run(p3 playlists "key down\nkey enter\nwait 2\n" ${plmk})
lf_parse("${p3}")
if(NOT lf_act EQUAL 1)
  message(FATAL_ERROR "playlists: Enter must count one activation, got ${lf_act}")
endif()
