# 11. I611: the Your Library tools row. Magnifier opens a filter field (typed text narrows the list through the same reload as the
# chips), the sort label opens the Sort by / View as menu (Recently added reverses the order, Alphabetical sorts by name, a View as
# icon changes the cell size). Counters in the sidetools dump line prove the filter pass, the sort pass and the menu picks ran.
function(st_parse tag out)
  if(NOT "${out}" MATCHES "sidetools sort=([0-9]+) view=([0-9]+) filter=\\[([^]]*)\\] open=([0-9]+) edit=([0-9]+) cols=([0-9]+) sorts=([0-9]+) sort_picks=([0-9]+) view_picks=([0-9]+) menu_opens=")
    message(FATAL_ERROR "no sidetools line in:\n${out}")
  endif()
  set(${tag}_sort "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_view "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_filter "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_open "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${tag}_edit "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${tag}_sorts "${CMAKE_MATCH_7}" PARENT_SCOPE)
  set(${tag}_sort_picks "${CMAKE_MATCH_8}" PARENT_SCOPE)
  set(${tag}_view_picks "${CMAKE_MATCH_9}" PARENT_SCOPE)
  if(NOT "${out}" MATCHES "menu_opens=([0-9]+)")
    message(FATAL_ERROR "no menu_opens in:\n${out}")
  endif()
  set(${tag}_menu_opens "${CMAKE_MATCH_1}" PARENT_SCOPE)
  if(NOT "${out}" MATCHES "filter_keys=([0-9]+)")
    message(FATAL_ERROR "no filter_keys in:\n${out}")
  endif()
  set(${tag}_keys "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(st_centre outvar out word)
  if(NOT "${out}" MATCHES "sidetools_rect mag ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) sort ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidetools_rect line in:\n${out}")
  endif()
  if("${word}" STREQUAL "mag")
    set(x "${CMAKE_MATCH_1}")
    set(y "${CMAKE_MATCH_2}")
    set(w "${CMAKE_MATCH_3}")
    set(h "${CMAKE_MATCH_4}")
  else()
    set(x "${CMAKE_MATCH_5}")
    set(y "${CMAKE_MATCH_6}")
    set(w "${CMAKE_MATCH_7}")
    set(h "${CMAKE_MATCH_8}")
  endif()
  math(EXPR cx "${x} + ${w} / 2")
  math(EXPR cy "${y} + ${h} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

# tag is lmenu or lmenu_view: the centre of its entry idx.
function(lm_centre outvar out tag idx)
  if(NOT "${out}" MATCHES "${tag} ${idx} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no ${tag} ${idx} in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

function(row_name outvar out idx)
  if(NOT "${out}" MATCHES "sidelib_row ${idx} [0-9]+ [0-9]+ [0-9]+ [0-9]+ ([A-Za-z]+( [A-Za-z]+)*)")
    message(FATAL_ERROR "no sidelib_row ${idx} in:\n${out}")
  endif()
  set(${outvar} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

