# dui-sidebar-library (I608): the "Your Library" list under the sidebar doors, through the real desktop UI entry.
#   -DSELECTA -DSONGS -DWORK
# The dump prints `sidelib draws=<n> rows=<n> items=<n> opens=<n> y=<q16> max=<q16>` and one `sidelib_row <i> x y w h <name>`
# per visible row. A library file with three saved playlists is made by a first run; later runs read it back.
# 1. Wide layout: the list drew (draws > 0) and holds one row per saved playlist.
# 2. Clicking the centre of row 1 counts one open, goes to the Playlists page and selects that playlist.
# 3. Icon-sidebar layout (899 wide): the rows still draw (covers only) and are clickable.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
configure_file("${SONGS}/selecta-test.mod" "${WORK}/one.mod" COPYONLY)
set(db "${WORK}/lib.db")

function(sl_parse tag out)
  if(NOT "${out}" MATCHES "sidelib draws=([0-9]+) rows=([0-9]+) items=([0-9]+) opens=([0-9]+) y=(-?[0-9]+) max=(-?[0-9]+)")
    message(FATAL_ERROR "no sidelib line in:\n${out}")
  endif()
  set(${tag}_draws "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_rows "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_items "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_opens "${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()

function(sl_centre outvar out idx)
  if(NOT "${out}" MATCHES "sidelib_row ${idx} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidelib_row ${idx} in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()

# Seed: three saved playlists.
dui_run(seed --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}"
  --exec "QUEUE_ADD ${WORK}/one.mod" --exec "PLAYLIST_CREATE alpha" --exec "PLAYLIST_CREATE beta" --exec "PLAYLIST_CREATE gamma")

file(WRITE "${WORK}/idle.txt" "wait 100\n")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}")

# 1. Wide layout: the list drew and holds the three playlists.
dui_run(w1 ${common} --canvas 1280x800 --input "${WORK}/idle.txt")
sl_parse(w1 "${w1}")
if(w1_draws LESS 1)
  message(FATAL_ERROR "the sidebar library list never drew (draws=${w1_draws}) in:\n${w1}")
endif()
expect_eq("library items" "${w1_items}" "3")
expect_eq("library rows" "${w1_rows}" "3")

# 2. A click on row 1 opens that playlist on the Playlists page.
sl_centre(c1 "${w1}" 1)
file(WRITE "${WORK}/click.txt" "click ${c1}\nwait 100\n")
dui_run(w2 ${common} --canvas 1280x800 --input "${WORK}/click.txt")
sl_parse(w2 "${w2}")
expect_eq("opens after click" "${w2_opens}" "1")
if(NOT "${w2}" MATCHES "nav page=playlists")
  message(FATAL_ERROR "the click did not go to the Playlists page:\n${w2}")
endif()

# 3. Icon-sidebar layout: covers only, still clickable.
dui_run(n1 ${common} --canvas 899x700 --input "${WORK}/idle.txt")
sl_parse(n1 "${n1}")
expect_eq("narrow rows" "${n1_rows}" "3")
sl_centre(c2 "${n1}" 1)
file(WRITE "${WORK}/click2.txt" "click ${c2}\nwait 100\n")
dui_run(n2 ${common} --canvas 899x700 --input "${WORK}/click2.txt")
sl_parse(n2 "${n2}")
expect_eq("narrow opens" "${n2_opens}" "1")

# 4. A list longer than the sidebar scrolls with the wheel under the pointer, clamped to its maximum; a short list does not
# take the wheel (the main region keeps it).
set(db2 "${WORK}/long.db")
set(mk --exec "QUEUE_ADD ${WORK}/one.mod")
foreach(i RANGE 1 14)
  list(APPEND mk --exec "PLAYLIST_CREATE list${i}")
endforeach()
dui_run(seed2 --ui desktop --backend mem --view home --canvas 1280x600 --clock fixed --stats --db "${db2}" ${mk})
set(long ${common})
list(REMOVE_ITEM long "${db}")
list(APPEND long "${db2}")
dui_run(l1 ${long} --canvas 1280x600 --input "${WORK}/idle.txt")
sl_parse(l1 "${l1}")
expect_eq("long items" "${l1_items}" "14")
sl_centre(c3 "${l1}" 0)
file(WRITE "${WORK}/wheel.txt" "move ${c3}\nwheel 0 -3\nwait 100\n")
dui_run(l2 ${long} --canvas 1280x600 --input "${WORK}/wheel.txt")
if(NOT "${l2}" MATCHES "sidelib draws=[0-9]+ rows=[0-9]+ items=[0-9]+ opens=[0-9]+ y=([0-9]+) max=([0-9]+)")
  message(FATAL_ERROR "no sidelib line in:\n${l2}")
endif()
if(CMAKE_MATCH_1 LESS 1 OR CMAKE_MATCH_1 GREATER CMAKE_MATCH_2)
  message(FATAL_ERROR "wheel y=${CMAKE_MATCH_1} not within (0, max=${CMAKE_MATCH_2}] in:\n${l2}")
endif()

# 5. I627: with no saved playlist the list draws the Create your first playlist card (sideempty draws > 0, a button
# rectangle) and no rows; a click on its button sends the New Playlist action once, and the playlist's row appears.
set(db3 "${WORK}/empty.db")
dui_run(seed3 --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db3}"
  --exec "QUEUE_ADD ${WORK}/one.mod")
set(empty ${common})
list(REMOVE_ITEM empty "${db}")
list(APPEND empty "${db3}")
dui_run(e1 ${empty} --canvas 1280x800 --input "${WORK}/idle.txt")
sl_parse(e1 "${e1}")
expect_eq("empty library items" "${e1_items}" "0")
expect_eq("empty library rows" "${e1_rows}" "0")
if(NOT "${e1}" MATCHES "sideempty draws=([0-9]+) clicks=0 btn ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" OR CMAKE_MATCH_1 LESS 1 OR CMAKE_MATCH_4 LESS 1)
  message(FATAL_ERROR "the empty-state card was not drawn in:\n${e1}")
endif()
math(EXPR bx "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
math(EXPR by "${CMAKE_MATCH_3} + ${CMAKE_MATCH_5} / 2")
file(WRITE "${WORK}/create.txt" "click ${bx} ${by}\nwait 100\n")
dui_run(e2 ${empty} --canvas 1280x800 --input "${WORK}/create.txt")
sl_parse(e2 "${e2}")
if(NOT "${e2}" MATCHES "sideempty draws=[0-9]+ clicks=1 ")
  message(FATAL_ERROR "the button click was not counted in:\n${e2}")
endif()
expect_eq("items after create" "${e2_items}" "1")
expect_eq("rows after create" "${e2_rows}" "1")

# 6. I646: Create playlist creates AND opens, like Spotify: the Playlists page shows the new playlist (plpage with its id) and
# the name field has the keyboard (edit=1), so typing renames it. Typing "Road" and Enter renames it to Road.
if(NOT "${e2}" MATCHES "nav page=playlists")
  message(FATAL_ERROR "the card click did not go to the Playlists page:\n${e2}")
endif()
if(NOT "${e2}" MATCHES "plpage id=([0-9]+) name=\\[New Playlist\\] [^\n]* edit=1")
  message(FATAL_ERROR "the new playlist was not opened with the name field focused in:\n${e2}")
endif()
set(db4 "${WORK}/empty2.db")
dui_run(seed4 --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db4}"
  --exec "QUEUE_ADD ${WORK}/one.mod")
set(empty2 ${common})
list(REMOVE_ITEM empty2 "${db}")
list(APPEND empty2 "${db4}")
file(WRITE "${WORK}/create_name.txt" "click ${bx} ${by}\nwait 100\nkey R\nkey o\nkey a\nkey d\nkey enter\nwait 100\n")
dui_run(e3 ${empty2} --canvas 1280x800 --input "${WORK}/create_name.txt")
if(NOT "${e3}" MATCHES "plpage id=[0-9]+ name=\\[Road\\] [^\n]* edit=0")
  message(FATAL_ERROR "typing did not rename the opened playlist in:\n${e3}")
endif()

# 7. I649: a right-click on a sidebar row opens the Rename/Delete menu at the pointer, over the sidebar, not at the main region's
# left edge. Invariant: a floating menu is placed in window coordinates at the pointer, clamped to the window only.
sl_centre(c7 "${w1}" 1)
string(REPLACE " " ";" c7_xy "${c7}")
list(GET c7_xy 0 c7x)
file(WRITE "${WORK}/rclick.txt" "move ${c7}\nrclick ${c7}\nwait 50\n")
dui_run(r1 ${common} --canvas 1280x800 --input "${WORK}/rclick.txt")
if(NOT "${r1}" MATCHES "smenu ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no smenu line (the sidebar row menu did not open) in:\n${r1}")
endif()
expect_eq("sidebar menu x" "${CMAKE_MATCH_1}" "${c7x}")

# 10. I610: the library chips under the header. Invariant: a chip filters the list through the one reload (filters counts the passes), the
# chip in force clicked again clears it, a chip of a kind without rows shows no row, and a chip row wider than the sidebar scrolls with
# the chevron buttons. Entry point: a click through the real desktop UI.
function(sc_parse tag out)
  if(NOT "${out}" MATCHES "sidechips chip=([0-9]+) filters=([0-9]+) scrolls=([0-9]+) x=(-?[0-9]+) max=(-?[0-9]+)")
    message(FATAL_ERROR "no sidechips line in:\n${out}")
  endif()
  set(${tag}_chip "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_filters "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_scrolls "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_x "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${tag}_max "${CMAKE_MATCH_5}" PARENT_SCOPE)
endfunction()
function(sc_centre outvar out idx)
  if(NOT "${out}" MATCHES "sidechip ${idx} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidechip ${idx} in:\n${out}")
  endif()
  # the left edge plus 8: a chip wider than the visible band is clipped on the right, its left end is always in view
  math(EXPR cx "${CMAKE_MATCH_1} + 8")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(sc_chev outvar out which)
  if(NOT "${out}" MATCHES "sidechev L ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidechev in:\n${out}")
  endif()
  if(which STREQUAL "L")
    math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
    math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  else()
    math(EXPR cx "${CMAKE_MATCH_5} + ${CMAKE_MATCH_7} / 2")
    math(EXPR cy "${CMAKE_MATCH_6} + ${CMAKE_MATCH_8} / 2")
  endif()
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
sc_parse(k0 "${w1}")
expect_eq("no chip in force at start" "${k0_chip}" "0")
sc_centre(chip_pl "${w1}" 0)
sc_centre(chip_al "${w1}" 1)
# Albums: the list is filtered to no row and the filter pass ran again.
file(WRITE "${WORK}/chip_al.txt" "click ${chip_al}\nwait 100\n")
dui_run(k1 ${common} --canvas 1280x800 --input "${WORK}/chip_al.txt")
sc_parse(k1 "${k1}")
sl_parse(k1 "${k1}")
expect_eq("Albums chip in force" "${k1_chip}" "2")
expect_eq("Albums leaves no row" "${k1_rows}" "0")
expect_eq("Albums leaves no item" "${k1_items}" "0")
if(NOT k1_filters GREATER k0_filters)
  message(FATAL_ERROR "the chip click did not run the filter pass (filters ${k0_filters} -> ${k1_filters}) in:\n${k1}")
endif()
# Albums again clears the filter: the three playlists are back.
file(WRITE "${WORK}/chip_al2.txt" "click ${chip_al}\nwait 100\nclick ${chip_al}\nwait 100\n")
dui_run(k2 ${common} --canvas 1280x800 --input "${WORK}/chip_al2.txt")
sc_parse(k2 "${k2}")
sl_parse(k2 "${k2}")
expect_eq("second click clears the chip" "${k2_chip}" "0")
expect_eq("rows are back" "${k2_rows}" "3")
# Playlists keeps the three rows, and clicked again clears.
file(WRITE "${WORK}/chip_pl2.txt" "click ${chip_pl}\nwait 100\nclick ${chip_pl}\nwait 100\n")
dui_run(k6 ${common} --canvas 1280x800 --input "${WORK}/chip_pl2.txt")
sc_parse(k6 "${k6}")
expect_eq("Playlists clicked twice clears" "${k6_chip}" "0")
file(WRITE "${WORK}/chip_pl.txt" "click ${chip_pl}\nwait 100\n")
dui_run(k3 ${common} --canvas 1280x800 --input "${WORK}/chip_pl.txt")
sc_parse(k3 "${k3}")
sl_parse(k3 "${k3}")
expect_eq("Playlists chip in force" "${k3_chip}" "1")
expect_eq("Playlists keeps the rows" "${k3_rows}" "3")
# Overflow: the row is wider than the sidebar, so the chevrons scroll it; the right one moves it, the left one brings it back.
if(k0_max LESS 1)
  message(FATAL_ERROR "the chip row does not overflow the sidebar (max=${k0_max}), the chevron test proves nothing:\n${w1}")
endif()
sc_chev(cr "${w1}" R)
sc_chev(cl "${w1}" L)
file(WRITE "${WORK}/chev.txt" "click ${cr}\nwait 100\n")
dui_run(k4 ${common} --canvas 1280x800 --input "${WORK}/chev.txt")
sc_parse(k4 "${k4}")
expect_eq("right chevron counted" "${k4_scrolls}" "1")
if(k4_x LESS 1)
  message(FATAL_ERROR "the right chevron did not scroll the chips (x=${k4_x}) in:\n${k4}")
endif()
file(WRITE "${WORK}/chev2.txt" "click ${cr}\nwait 100\nclick ${cl}\nwait 100\nclick ${cl}\nwait 100\n")
dui_run(k5 ${common} --canvas 1280x800 --input "${WORK}/chev2.txt")
sc_parse(k5 "${k5}")
expect_eq("left chevron brings the row back" "${k5_x}" "0")
expect_eq("three chevron clicks" "${k5_scrolls}" "3")

# 8. I655: the sidebar row menu stays on top while the pointer hovers its items. Invariant: the song menu is a window-level overlay,
# so a repaint of the sidebar region (the hover tween of a menu item that lies over the sidebar) must be followed by the overlay pass.
# Before the fix draw_sidebar painted over the part of the menu inside the sidebar. A live run opens the menu and quits (rest frame:
# the menu from the full frame); a second run also moves the pointer onto the last item first (the click point lies in item 0, already lit). The 3 px strip at the panel's left edge is
# never lit by an item, so it must be pixel-identical in both frames.
if(SDL_BUILT)
  include("${HERE}/ppm.cmake")
  string(REPLACE " " ";" c7_pt "${c7}")
  list(GET c7_pt 1 c7y)
  if(NOT "${r1}" MATCHES "smenu ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no smenu line in:\n${r1}")
  endif()
  set(mx ${CMAKE_MATCH_1})
  set(my ${CMAKE_MATCH_2})
  set(mw ${CMAKE_MATCH_3})
  set(mh ${CMAKE_MATCH_4})
  math(EXPR ix "${mx} + ${mw} / 2")
  math(EXPR iy "${my} + ${mh} - 6")
  set(ENV{SDL_VIDEODRIVER} dummy)
  set(ENV{SELECTA_SDL_TEST_LIVE} 1)
  set(ENV{SELECTA_SDL_SCREEN} 1280x800)
  function(menu_live timed ppm)
    set(ENV{SELECTA_SDL_TEST_TIMED} "${timed}")
    dui_run(o --ui desktop --view home --clock fixed --stats --db "${db}" --canvas 1280x800 --backend sdl --frame-dump "${ppm}")
  endfunction()
  menu_live("m${c7x},${c7y}@300 d3,${c7x},${c7y}@400 u3,${c7x},${c7y}@450 q@900" "${WORK}/menu_rest.ppm")
  menu_live("m${c7x},${c7y}@300 d3,${c7x},${c7y}@400 u3,${c7x},${c7y}@450 m${ix},${iy}@600 q@900" "${WORK}/menu_hover.ppm")
  ppm_load("${WORK}/menu_rest.ppm" resthex w)
  ppm_load("${WORK}/menu_hover.ppm" hoverhex hw)
  rect_differs("${resthex}" "${hoverhex}" ${w} ${mx} ${my} 3 ${mh} strip_differs)
  if(strip_differs)
    message(FATAL_ERROR "I655: the menu's left edge differs after the pointer hovered an item: the sidebar repaint went over the menu")
  endif()
  rect_differs("${resthex}" "${hoverhex}" ${w} ${mx} ${my} ${mw} ${mh} item_differs)
  if(NOT item_differs)
    message(FATAL_ERROR "I655: hovering the last item changed nothing in the menu panel: the hover never lit it, so the test proves nothing")
  endif()
endif()

# 9. I609: the Your Library header holds a Create Playlist plus and an Expand Library toggle. Invariant: the plus runs the same create path
# as the Playlists page (counter plus_clicks, a fourth playlist in the list); the toggle widens the sidebar and a second click restores it.
# The dump prints `sidehdr plus|wide plus_clicks=N wide_clicks=N wide=N sidebar_w=W rect x y w h`.
function(hdr_centre outvar out which)
  if(NOT "${out}" MATCHES "sidehdr ${which} plus_clicks=[0-9]+ wide_clicks=[0-9]+ wide=[0-9]+ sidebar_w=[0-9]+ rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidehdr ${which} line in:\n${out}")
  endif()
  if(CMAKE_MATCH_3 EQUAL 0)
    message(FATAL_ERROR "sidehdr ${which} has an empty rect in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(hdr_field outvar out which field)
  if(NOT "${out}" MATCHES "sidehdr ${which} [^\n]*${field}=([0-9]+)")
    message(FATAL_ERROR "no ${field} in sidehdr ${which} of:\n${out}")
  endif()
  set(${outvar} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

dui_run(h0 ${common} --canvas 1280x800 --input "${WORK}/idle.txt")
hdr_centre(plus_c "${h0}" plus)
hdr_centre(wide_c "${h0}" wide)
hdr_field(w_base "${h0}" plus sidebar_w)
expect_eq("default sidebar width" "${w_base}" "220")

