endif()

# 9b. Toggle: one click widens, a second click in the same run restores.
file(WRITE "${WORK}/wide1.txt" "click ${wide_c}\nwait 100\n")
dui_run(h2 ${common} --canvas 1280x800 --input "${WORK}/wide1.txt")
hdr_field(wc "${h2}" wide wide_clicks)
hdr_field(wv "${h2}" wide wide)
hdr_field(ww "${h2}" wide sidebar_w)
