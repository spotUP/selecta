# dui-viz (DUI-P4-11): the desktop visualizer. -DSELECTA -DWORK -DSONGS. Fixture: tests/m3/lyrics/ambient.mod.
# Every run drives the real `selecta --ui desktop` entry point and reads the sentinels the desktop prints:
# 1. Now Playing with the scope plugin: `viz frames` (sentinel) grows at least 25 per second of song time, the plugin that
#    rendered is viz_scope, the plugin printed a primitive count, and the strip exists.
# 2. The layout id is 0 by default, 3 after Visual Layout (C-4), 0 again after Full Layout (C-1); the visual layout drew.
# 3. The Visualizer page (--view viz, and the "v" key) draws one pane per plugin (3) and the signal path text.
# 4. The levels and spectrum plugins are selectable (ui.desktop.viz) and render too.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
set(fx "${HERE}/../m3/lyrics")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(viz_run tag view script)
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/${tag}.db")
  file(WRITE "${WORK}/${tag}.txt" "${script}")
  dui_run(o --db "${WORK}/${tag}.db" --ui desktop --backend mem --view ${view} --canvas 1280x800 --clock fixed --stats
    --exec "OPEN ${fx}/ambient.mod" --ticks 12 --input "${WORK}/${tag}.txt" ${ARGN})
  if(NOT "${o}" MATCHES "viz frames ([0-9]+) song_ms ([0-9]+) plugin ([a-z_]+) plugins ([0-9]+) layout ([0-9]+) panes ([0-9]+) sigpath ([0-9]+) prims ([0-9]+) visual ([0-9]+) strip ([0-9]+)")
    message(FATAL_ERROR "no viz sentinel in:\n${o}")
  endif()
  set(${tag}_frames "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_ms "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_plugin "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_plugins "${CMAKE_MATCH_4}" PARENT_SCOPE)
  set(${tag}_layout "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(${tag}_panes "${CMAKE_MATCH_6}" PARENT_SCOPE)
  set(${tag}_sigpath "${CMAKE_MATCH_7}" PARENT_SCOPE)
  set(${tag}_prims "${CMAKE_MATCH_8}" PARENT_SCOPE)
  set(${tag}_visual "${CMAKE_MATCH_9}" PARENT_SCOPE)
  string(REGEX MATCH "strip ([0-9]+)" ignore "${o}")
  set(${tag}_strip "${CMAKE_MATCH_1}" PARENT_SCOPE) # CMake keeps only nine match groups
  set(${tag}_out "${o}" PARENT_SCOPE)
endfunction()

# 1. Frame rate on Now Playing, scope selected.
viz_run(np home "wait 300\nkey ctrl+5\nwait 100\n")
if(NOT np_plugins EQUAL 3)
  message(FATAL_ERROR "expected 3 viz plugins found by the desktop, got ${np_plugins}")
endif()
if(NOT np_plugin STREQUAL "viz_scope")
  message(FATAL_ERROR "the scope plugin was not the one drawing: ${np_plugin}")
endif()
if(NOT np_strip EQUAL 1)
  string(REGEX MATCH "viz frames[^\n]*" line "${np_out}")
  message(FATAL_ERROR "Now Playing did not give the visualizer a strip: ${line}")
endif()
if(np_frames EQUAL 0 OR np_ms EQUAL 0)
  message(FATAL_ERROR "no viz frames (${np_frames}) or no song time (${np_ms})")
endif()
math(EXPR got "${np_frames} * 1000")
math(EXPR need "25 * ${np_ms}")
if(got LESS need)
  message(FATAL_ERROR "VIZ_FRAMES ${np_frames} over ${np_ms} ms of song is under 25 per second")
endif()
if(np_prims EQUAL 0)
  message(FATAL_ERROR "the scope plugin reported no primitives: it did not draw")
endif()
if(NOT "${np_out}" MATCHES "[ \n]viz_frames=([0-9]+)" OR NOT CMAKE_MATCH_1 EQUAL np_frames)
  message(FATAL_ERROR "the VIZ_FRAMES stat differs from the sentinel ${np_frames}")
endif()

# 2. Layout id: default 0, Visual Layout 3, Full Layout 0 again.
viz_run(lay home "wait 100\nkey ctrl+4\nwait 100\n")
dui_stat(lay_mid "${lay_out}" desktop uim_layout)
if(NOT lay_mid EQUAL 3 OR NOT lay_layout EQUAL 3)
  message(FATAL_ERROR "layout after Visual Layout is ${lay_mid}/${lay_layout}, want 3")
endif()
if(lay_visual EQUAL 0 OR lay_sigpath EQUAL 0)
  message(FATAL_ERROR "the visual layout drew ${lay_visual} frames and ${lay_sigpath} signal paths")
endif()
viz_run(back home "wait 100\nkey ctrl+4\nwait 100\nkey ctrl+1\nwait 100\n")
if(NOT back_layout EQUAL 0)
  message(FATAL_ERROR "layout after Full Layout is ${back_layout}, want 0")
endif()
viz_run(dflt home "wait 100\n")
if(NOT dflt_layout EQUAL 0 OR NOT dflt_visual EQUAL 0)
  message(FATAL_ERROR "default layout is ${dflt_layout} with ${dflt_visual} visual draws, want 0 and 0")
endif()

# 3. The Visualizer page: --view viz and the "v" key.
viz_run(pg viz "wait 100\n")
if(NOT pg_panes EQUAL 3 OR pg_sigpath EQUAL 0 OR pg_frames EQUAL 0)
  message(FATAL_ERROR "Visualizer page: ${pg_panes} panes, ${pg_sigpath} signal paths, ${pg_frames} frames")
endif()
if(NOT "${pg_out}" MATCHES "Signal Path" AND NOT pg_sigpath GREATER 0)
  message(FATAL_ERROR "no signal path on the Visualizer page")
endif()
viz_run(key home "wait 100\nkey v\nwait 100\n")
if(NOT key_panes EQUAL 3)
  message(FATAL_ERROR "the v key did not open the Visualizer page (${key_panes} panes)")
endif()

# 4. The other plugins are selectable and draw.
set(key_viz_levels ctrl+6)
set(key_viz_spectrum ctrl+7)
foreach(id viz_levels viz_spectrum)
  viz_run(sel_${id} home "wait 100\nkey ${key_${id}}\nwait 100\n")
  if(NOT sel_${id}_plugin STREQUAL "${id}")
    message(FATAL_ERROR "ui.desktop.viz ${id} selected ${sel_${id}_plugin}")
  endif()
  if(sel_${id}_prims EQUAL 0 OR sel_${id}_frames EQUAL 0)
    message(FATAL_ERROR "${id} drew ${sel_${id}_frames} frames with ${sel_${id}_prims} primitives")
  endif()
endforeach()
message(STATUS "dui-viz ok: ${np_frames} frames in ${np_ms} ms, layout 0/3/0, 3 panes")
