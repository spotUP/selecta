# dui-row-text-widths (I1079c): a collection page row's text columns take their share of the REAL row width (design
# thoughts/shared/plans/2026-11-05-I1079-row-text-widths.md sections 3.1 and 3.2), through the real desktop UI entry. -DSELECTA -DSONGS -DWORK
# The podcast shape: songs with a title and an artist, no album and no plays. Before the fix the title got 45 percent of
# (row - number - 180 point Plays slot) and the empty album column and the Plays slot stayed blank on the right.
# Dump lines: `plcols_calls <n>` (the splitter sentinel) and `plsongcols <i> row_w= cols=<x>:<w>,... title_tw= title_elided=` per drawn row,
# columns lead, title, artist, album, tail (x relative to the row).
# Asserts, at 1280x800 and 900x700: the splitter ran (calls > 0), the album and tail columns are absent (width 0), the artist column ends exactly at
# the row edge, the title is at least 0.6 of (row - lead), and a title that fits its column is not elided.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-row-text-widths needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}")
foreach(sql_file "${HERE}/fixture_library.sql")
  execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${sql_file}" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "loading the fixture failed: ${err}")
  endif()
endforeach()
# Rekey like dui-collection-page, then drop the album: the podcast shape.
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" "UPDATE songs SET key = 'local:' || path WHERE key LIKE 'fixture:%'; UPDATE songs SET album = ''"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "reshaping the fixture failed: ${err}")
endif()
function(side_row out dump name)
  if(NOT "${dump}" MATCHES "sidelib_row [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=[01] open=[01] kind=[0-9]+ ${name}\n")
    message(FATAL_ERROR "no sidebar row '${name}' in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

dui_run(seed --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x800
  --exec "PLAYLIST_CREATE alpha" --exec "PLAYLIST_ADD_SONG 1 fixture/2.mod" --exec "PLAYLIST_ADD_SONG 1 fixture/1.mod" --exec "PLAYLIST_ADD_SONG 1 fixture/5.sid")

function(check_canvas canvas)
  set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas ${canvas})
  file(WRITE "${WORK}/idle.txt" "wait 100\n")
  dui_run(idle_${canvas} ${common} --input "${WORK}/idle.txt")
  side_row(xy "${idle_${canvas}}" "alpha")
  file(WRITE "${WORK}/open_${canvas}.txt" "click ${xy}\nwait 200\n")
  dui_run(run_${canvas} ${common} --input "${WORK}/open_${canvas}.txt")
  set(dump "${run_${canvas}}")
  if(NOT "${dump}" MATCHES "page=collection")
    message(FATAL_ERROR "${canvas}: the page is not the collection page:\n${dump}")
  endif()
  if(NOT "${dump}" MATCHES "plcols_calls ([0-9]+)")
    message(FATAL_ERROR "${canvas}: no plcols_calls line in:\n${dump}")
  endif()
  if(CMAKE_MATCH_1 LESS 1)
    message(FATAL_ERROR "${canvas}: the shared splitter never ran (plcols_calls ${CMAKE_MATCH_1})")
  endif()
  string(REGEX MATCHALL "plsongcols [0-9]+ row_w=[0-9-]+ cols=[^\n]*" rows "${dump}")
  list(LENGTH rows nrows)
  if(nrows LESS 3)
    message(FATAL_ERROR "${canvas}: expected 3 plsongcols rows, got ${nrows}:\n${dump}")
  endif()
  foreach(l IN LISTS rows)
    if(NOT "${l}" MATCHES "row_w=([0-9]+) cols=([0-9-]+):([0-9-]+),([0-9-]+):([0-9-]+),([0-9-]+):([0-9-]+),([0-9-]+):([0-9-]+),([0-9-]+):([0-9-]+) title_tw=([0-9]+) title_elided=([01])")
      message(FATAL_ERROR "${canvas}: cannot parse ${l}")
    endif()
    set(row_w ${CMAKE_MATCH_1})
    set(lead_w ${CMAKE_MATCH_3})
    set(title_w ${CMAKE_MATCH_5})
    set(art_x ${CMAKE_MATCH_6})
    set(art_w ${CMAKE_MATCH_7})
    set(alb_w ${CMAKE_MATCH_9})
    # CMake keeps only CMAKE_MATCH_0..9, so the tail width and the title lines come from their own matches.
    string(REGEX REPLACE "^.* cols=[^ ]*,[^ :]*:([0-9-]+) title_tw=([0-9]+) title_elided=([01]).*$" "\\1;\\2;\\3" tail_parts "${l}")
    list(GET tail_parts 0 tail_w)
    list(GET tail_parts 1 tw)
    list(GET tail_parts 2 el)
    if(NOT alb_w EQUAL 0 OR NOT tail_w EQUAL 0)
      message(FATAL_ERROR "${canvas}: the empty album/tail columns are not absent (album ${alb_w}, tail ${tail_w}): ${l}")
    endif()
    math(EXPR art_end "${art_x} + ${art_w}")
    if(NOT art_end EQUAL row_w)
      message(FATAL_ERROR "${canvas}: the last column ends at ${art_end}, the row at ${row_w}: ${l}")
    endif()
    math(EXPR need "(${row_w} - ${lead_w}) * 6 / 10")
    if(title_w LESS need)
      message(FATAL_ERROR "${canvas}: title column ${title_w} < 60 percent (${need}) of the room: ${l}")
    endif()
    if(el AND NOT tw GREATER title_w)
      message(FATAL_ERROR "${canvas}: title elided although it fits (${tw} <= ${title_w}): ${l}")
    endif()
    message(STATUS "${canvas}: row_w ${row_w} lead ${lead_w} title ${title_w} artist ${art_w}")
  endforeach()
endfunction()
check_canvas(1280x800)
check_canvas(900x700)
message(STATUS "row_text_widths_ok")
