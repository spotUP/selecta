# dui-sync-nowait (I782): while a sync runs, the desktop UI shows its state and the draw path never waits on the library.
# -DSELECTA -DWORK -DGOLDEN -DSDL_BUILT. Driven from the desktop UI's real entry point (SDL timed events), with the test source
# testsrc slowed by SELECTA_TESTSRC_SLOW_MS so the sync outlives several frames. Checks:
#   1. "Sync now" starts the sync: the sync card appears ("sync_ui ... shown=1 draws>=1") and is gone after the sync ("active=0"),
#   2. a click on the card's Cancel button reaches the engine ("cancels=1") and the sync ends ("active=0"),
#   3. the frame loop kept drawing through the sync: the stats dump is produced at the timed quit, after the sync ended.
# The nowait refusal itself (a draw request returning at once while the library is owned) is proven in engine-library-nowait.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(DUI_SYNC_BANNER ON)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
dui_require_sdl()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sync-nowait needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sync-nowait.sock")
function(click_run tag tokens)
  file(REMOVE_RECURSE "${WORK}/cfg")
  set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens}")
  dui_run(${tag} --db "${db}" --ui desktop --backend sdl --view library --canvas 1280x800 --clock fixed --stats)
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
function(click_at out x y t)
  math(EXPR t1 "${t} + 50")
  math(EXPR t2 "${t} + 100")
  set(${out} "m${x},${y}@${t} d1,${x},${y}@${t1} u1,${x},${y}@${t2}" PARENT_SCOPE)
endfunction()
function(rect_center out text key)
  string(REGEX MATCH "${key} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _r "${text}")
  if(_r STREQUAL "")
    message(FATAL_ERROR "no '${key}' rectangle in the stats:\n${text}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out}_x ${cx} PARENT_SCOPE)
  set(${out}_y ${cy} PARENT_SCOPE)
endfunction()
set(want_keys modland hvsc hippo asma keygenmusic sndh zxart testsrc)

# The dialog opens on the Library visit; read its rectangles, then untick everything but testsrc and press Sync now.
click_run(o0 "m5,5@200 m6,6@400 m7,7@600 q@800")
if(NOT o0 MATCHES "nagdlg opens 1 done 1\n")
  message(FATAL_ERROR "no sync dialog at launch:\n${o0}")
endif()
if(NOT o0 MATCHES "sync_ui active=0 rows=0 queued=0 source=[^ ]* shown=0 draws=0 cancels=0 ")
  message(FATAL_ERROR "the sync card is up before any sync ran:\n${o0}")
endif()
rect_center(sync "${o0}" "nagsync")
rect_center(cancel "${o0}" "synccancel")
set(tokens "")
set(t 300)
string(REGEX MATCHALL "nagrow [0-9]+ [a-z0-9_]+\\|1" row_lines "${o0}")
set(row_keys "")
foreach(rl ${row_lines})
  string(REGEX REPLACE "^nagrow [0-9]+ ([a-z0-9_]+)\\|1$" "\\1" rk "${rl}")
  list(APPEND row_keys ${rk})
endforeach()
foreach(k ${row_keys})
  if(NOT k STREQUAL "testsrc")
    rect_center(row "${o0}" "nagrow [0-9]+ ${k}\\|1")
    click_at(c ${row_x} ${row_y} ${t})
    string(APPEND tokens " ${c}")
    math(EXPR t "${t} + 200")
  endif()
endforeach()
click_at(sc ${sync_x} ${sync_y} ${t})
set(ENV{SELECTA_TESTSRC_SLOW_MS} 1200)

# 1. The sync runs 1.2 s: the card is shown and drawn, and gone when the sync ends.
math(EXPR tq "${t} + 3500")
click_run(a "${tokens} ${sc} q@${tq}")
if(NOT a MATCHES "nag 0 syncs 1\n")
  message(FATAL_ERROR "Sync now did not start the sync:\n${a}")
endif()
if(NOT a MATCHES "sync_ui active=0 rows=[0-9]+ queued=0 source=[^ ]* shown=1 draws=([0-9]+) cancels=0 " OR CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "the sync card did not appear while the sync ran, or did not clear after it:\n${a}")
endif()

# 2. Cancel: a click on the card's Cancel button reaches the engine and the sync ends.
math(EXPR tcancel "${t} + 700")
click_at(cc ${cancel_x} ${cancel_y} ${tcancel})
file(REMOVE "${db}" "${db}-wal" "${db}-shm")
dui_run(init2 --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql" RESULT_VARIABLE rc)
click_run(b "${tokens} ${sc} ${cc} q@${tq}")
if(NOT b MATCHES "sync_ui active=0 rows=[0-9]+ queued=0 source=[^ ]* shown=1 draws=[0-9]+ cancels=1 ")
  message(FATAL_ERROR "a click on Cancel did not reach the engine, or the sync did not end:\n${b}")
endif()
message(STATUS "dui-sync-nowait ok")
