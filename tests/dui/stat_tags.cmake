# ui-stat-tags (I603): every SEL_UI_STAT_* tag value in tags.def is unique, counting the 15-slot ranges the cover flow per-class
# tags use (FLOW_MS_REST + k, FLOW_MS_SLIDE + k). STAT_PT_MS_OVERLAY and STAT_LIST_VIEW both held 0x509A: once an overlay took a
# millisecond to paint, sel_tag_find(LIST_VIEW) returned that number as a string pointer and --stats segfaulted in printf.
# -DTAGS_DEF=<include/selecta/tags.def>
file(STRINGS "${TAGS_DEF}" lines REGEX "^SEL_TAG\\(UI, STAT_")
set(seen "")
set(bad "")
foreach(l ${lines})
  string(REGEX MATCH "STAT_([A-Z0-9_]+), *0x([0-9A-Fa-f]+)" _m "${l}")
  if(_m STREQUAL "")
    continue()
  endif()
  set(name ${CMAKE_MATCH_1})
  string(TOUPPER "${CMAKE_MATCH_2}" hex)
  math(EXPR base "0x${hex}")
  set(span 1)
  if(name STREQUAL "FLOW_MS_REST" OR name STREQUAL "FLOW_MS_SLIDE")
    set(span 16)
  endif()
  math(EXPR last "${base} + ${span} - 1")
  foreach(v RANGE ${base} ${last})
    if(DEFINED owner_${v})
      string(APPEND bad "  ${name} and ${owner_${v}} both use value ${v}\n")
    else()
      set(owner_${v} ${name})
    endif()
  endforeach()
endforeach()
if(NOT bad STREQUAL "")
  message(FATAL_ERROR "duplicate SEL_UI_STAT_* tag values:\n${bad}")
endif()
list(LENGTH lines n)
message(STATUS "${n} UI stat tag rows, no duplicate value")
