# dui-grid-coverflow (DUI-P4-5): the Library grid and 2D cover flow views. -DSELECTA -DSONGS -DWORK -DGOLDEN
# 1. Golden hashes for the grid and for the cover flow (update only with SELECTA_GOLDEN_UPDATE=1).
# 2. Sentinels from the library dump: "grid draws N tiles T cols C" and "flow draws N centre I" count the new draw code.
#    The grid run draws the grid (5 tiles) and never the cover flow; the cover flow run the reverse.
# 3. Right in cover flow moves the centred album by exactly 1 (0 -> 1), changes the frame, and clamps at the last album;
#    Left clamps at the first. Right in the grid moves the cursor (the frame changes), Down moves it by one row.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-grid-coverflow needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(queue "")
foreach(p 1.mod 2.mod 3.xm 4.it 5.sid)
  list(APPEND queue --exec "QUEUE_ADD \"fixture/${p}\"")
endforeach()

# Runs the desktop with VIEW_STYLE ${style} and the key script ${script}; sets <tag>_out and <tag>_hash.
set(CANVAS 1280x800)
function(flow_run tag style script)
  file(REMOVE_RECURSE "${WORK}/cfg")
  # --view library enters the page in the first turn and the page sets its own source: the test's source follows it (I266).
  file(WRITE "${WORK}/${tag}.txt" "exec VIEW_SOURCE queue\nexec VIEW_WINDOW 8\nexec VIEW_STYLE ${style}\nexec COMPOSERS_SHOW\nwait 100\n${script}")
  dui_run(o --db "${db}" --ui desktop --backend mem --view library --canvas ${CANVAS} --clock fixed --stats ${queue}
    --input "${WORK}/${tag}.txt")
  set(out "${o}\n${o_err}")
  dui_stat(hash "${o}" desktop canvas_hash)
  set(${tag}_out "${out}" PARENT_SCOPE)
  set(${tag}_hash "${hash}" PARENT_SCOPE)
endfunction()

function(golden name hash)
  set(gfile "${GOLDEN}/desktop/${name}-rgba32-1280x800@1.hash")
  if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
    file(WRITE "${gfile}" "${hash}\n")
  endif()
  if(NOT EXISTS "${gfile}")
    message(FATAL_ERROR "missing golden ${gfile} (hash ${hash}); create it with SELECTA_GOLDEN_UPDATE=1")
  endif()
  file(STRINGS "${gfile}" want LIMIT_COUNT 1)
  if(NOT hash STREQUAL want)
    message(FATAL_ERROR "${name} hash ${hash} differs from golden ${want} (${gfile})")
  endif()
endfunction()

function(expect out pattern what)
  if(NOT out MATCHES "${pattern}")
    message(FATAL_ERROR "${what}: no match for '${pattern}' in:\n${out}")
  endif()
endfunction()

# 1 + 2: the grid.
flow_run(grid grid "wait 600\n")
golden(grid-view "${grid_hash}")
expect("${grid_out}" "grid draws [1-9][0-9]* tiles [1-9][0-9]* cols [1-9]" "grid sentinel")
expect("${grid_out}" "flow draws 0 centre 0\n" "the grid run must not draw the cover flow")

# 1 + 2: the cover flow, centre on album 0.
flow_run(flow0 coverflow "wait 600\n")
golden(coverflow "${flow0_hash}")
expect("${flow0_out}" "flow draws [1-9][0-9]* centre 0\n" "cover flow sentinel")
expect("${flow0_out}" "grid draws 0 tiles 0 cols 0\n" "the cover flow run must not draw the grid")

# 3: Right moves the centre by exactly 1; the glide has ended after the wait, so the frame is deterministic.
flow_run(flow1 coverflow "key right\nwait 600\n")
expect("${flow1_out}" "flow draws [1-9][0-9]* centre 1\n" "Right in cover flow moves the centre by 1")
if(flow1_hash STREQUAL flow0_hash)
  message(FATAL_ERROR "Right in cover flow did not change the frame")
endif()
flow_run(flow1b coverflow "key right\nwait 600\n")
if(NOT flow1b_hash STREQUAL flow1_hash)
  message(FATAL_ERROR "the cover flow frame after Right is not deterministic")
endif()
flow_run(flow2 coverflow "key right\nkey right\nwait 600\n")
expect("${flow2_out}" "centre 2\n" "two Right keys")
flow_run(flowend coverflow "key right\nkey right\nkey right\nkey right\nkey right\nkey right\nwait 600\n")
expect("${flowend_out}" "centre 4\n" "Right clamps at the last album")
flow_run(flowback coverflow "key right\nkey left\nwait 600\n")
expect("${flowback_out}" "centre 0\n" "Left returns to the first album")
if(NOT flowback_hash STREQUAL flow0_hash)
  message(FATAL_ERROR "Right then Left must restore the first cover flow frame")
endif()
flow_run(flowleft coverflow "key left\nwait 600\n")
expect("${flowleft_out}" "centre 0\n" "Left clamps at the first album")

# The grid: Right and Down move the selection.
flow_run(gridr grid "key right\nwait 600\n")
if(gridr_hash STREQUAL grid_hash)
  message(FATAL_ERROR "Right in the grid did not move the selection")
endif()
flow_run(gridd grid "key down\nwait 600\n")
if(gridd_hash STREQUAL grid_hash) # beside the Statistics column the grid is one column wide, so Down and Right coincide (I379)
  message(FATAL_ERROR "Down in the grid must move the selection")
endif()

# I379 / I382: the Statistics panel (the run passes --stats) sits in its own column; no grid tile and no cover flow cover may
# intersect it. The dump gives the bounding box of the drawn tiles ("grid box x y w h", filled by both views) and the panel
# column ("stats rect x y w h").
function(no_stats_overlap out what)
  expect("${out}" "stats rect [0-9]+ [0-9]+ [1-9][0-9]* [1-9][0-9]*\n" "the ${what} run shows the Statistics panel")
  string(REGEX MATCH "grid box ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _gb "${out}")
  set(gx ${CMAKE_MATCH_1})
  set(gw ${CMAKE_MATCH_3})
  string(REGEX MATCH "stats rect ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _sr "${out}")
  set(sx ${CMAKE_MATCH_1})
  set(sw ${CMAKE_MATCH_3})
  if(gw EQUAL 0)
    message(FATAL_ERROR "the ${what} run drew no tile box")
  endif()
  math(EXPR grid_right "${gx} + ${gw}")
  math(EXPR stats_right "${sx} + ${sw}")
  message(STATUS "${what}: tiles x ${gx}..${grid_right}, Statistics x ${sx}..${stats_right}")
  if(grid_right GREATER sx AND gx LESS stats_right)
    message(FATAL_ERROR "${what} (x ${gx}..${grid_right}) overlaps the Statistics panel (x ${sx}..${stats_right})")
  endif()
endfunction()
no_stats_overlap("${grid_out}" "grid")

# I391 (Johan's decision): the cover flow hides the Statistics column and uses the whole main width. The flow run still passes
# --stats, yet its "stats rect" is empty (the panel draws only in a non-empty rect) and its free area runs to the same right edge the grid's Statistics column ends at.
string(REGEX MATCH "stats rect ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _gs "${grid_out}")
math(EXPR grid_stats_right "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
expect("${flow0_out}" "stats rect [0-9]+ [0-9]+ 0 0\n" "the cover flow run must not show the Statistics column")
string(REGEX MATCH "flow cover [0-9]+ [0-9]+ [0-9]+ [0-9]+ area ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _fa "${flow0_out}")
math(EXPR flow_area_right "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
math(EXPR dright "${grid_stats_right} - ${flow_area_right}")
# the dump takes the main region, the draw its panel inset (4 px narrower); a Statistics column would cost 300 px or more
if(dright GREATER 4 OR dright LESS -4)
  message(FATAL_ERROR "cover flow area ends at x ${flow_area_right}, expected the full main width (x ${grid_stats_right})")
endif()

# I391: the centre cover follows the free area (below the tab row to the panel bottom, beside the Statistics column), the
# stack plus caption is centred vertically in it, and the caption is centred under the cover. The dump line
# "flow cover x y w h area x y w h" gives the cover and the free area; the caption is the centred label whose box starts
# GAP below the cover (its ink span is recorded by draw_text_centered).
set(FLOW_GAP 8)
set(FLOW_CAPT 42) # HOME_TILE_TEXT_GAP + HOME_TITLE_H + HOME_META_H
function(flow_layout out what)
  string(REGEX MATCH "flow cover ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) area ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _m "${out}")
  if(NOT _m)
    message(FATAL_ERROR "${what}: no 'flow cover' line in:\n${out}")
  endif()
  set(cx ${CMAKE_MATCH_1})
  set(cy ${CMAKE_MATCH_2})
  set(cw ${CMAKE_MATCH_3})
  set(ay ${CMAKE_MATCH_6})
  set(aw ${CMAKE_MATCH_7})
  set(ah ${CMAKE_MATCH_8})
  # (1) the cover is the smaller of the width fit (stack = 1.9 times the cover) and the height fit.
  math(EXPR fit_w "10 * ${aw} / 19")
  math(EXPR fit_h "${ah} - ${FLOW_CAPT}")
  if(fit_w LESS fit_h)
    set(want ${fit_w})
  else()
    set(want ${fit_h})
  endif()
  math(EXPR dfit "${cw} - ${want}")
  if(dfit GREATER 2 OR dfit LESS -2)
    message(FATAL_ERROR "${what}: centre cover ${cw} px, expected ${want} (width fit ${fit_w}, height fit ${fit_h})")
  endif()
  # (2) equal gaps above the cover and below the caption.
  math(EXPR top_gap "${cy} - ${ay}")
  math(EXPR bot_gap "${ay} + ${ah} - (${cy} + ${cw} + ${FLOW_CAPT})")
  math(EXPR dgap "${top_gap} - ${bot_gap}")
  if(dgap GREATER 2 OR dgap LESS -2)
    message(FATAL_ERROR "${what}: top gap ${top_gap} px, bottom gap ${bot_gap} px (cover y ${cy} size ${cw}, area y ${ay} h ${ah})")
  endif()
  # (3) the caption title is centred under the cover.
  math(EXPR cap_y "${cy} + ${cw} + ${FLOW_GAP}")
  string(REGEX MATCH "label [0-9]+ ${cap_y} [0-9]+ [0-9]+ ink ([0-9]+) ([0-9]+) text" _l "${out}")
  if(NOT _l)
    message(FATAL_ERROR "${what}: no centred caption label at y ${cap_y}")
  endif()
  math(EXPR cap_mid2 "2 * ${CMAKE_MATCH_1} + ${CMAKE_MATCH_2}")
  math(EXPR cov_mid2 "2 * ${cx} + ${cw}")
  math(EXPR dmid "(${cap_mid2} - ${cov_mid2}) / 2")
  if(dmid GREATER 2 OR dmid LESS -2)
    message(FATAL_ERROR "${what}: caption centre x*2 ${cap_mid2} differs from the cover centre x*2 ${cov_mid2}")
  endif()
  # (4) tucked stack: the centre cover is big (Johan: about 330-380 px at 1280x800) and the stack lies inside the free area.
  if(DEFINED MIN_COVER AND cw LESS "${MIN_COVER}")
    message(FATAL_ERROR "${what}: centre cover ${cw} px, expected at least ${MIN_COVER}")
  endif()
  string(REGEX MATCH "grid box ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _b "${out}")
  math(EXPR bl "${CMAKE_MATCH_1}")
  math(EXPR br "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
  string(REGEX MATCH "area ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _a "${out}")
  math(EXPR ar "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
  if(bl LESS ${CMAKE_MATCH_1} OR br GREATER ar)
    message(FATAL_ERROR "${what}: stack x ${bl}..${br} leaves the area x ${CMAKE_MATCH_1}..${ar}")
  endif()
  message(STATUS "${what}: stack x ${bl}..${br} in area ${CMAKE_MATCH_1}..${ar};")
  message(STATUS "${what}: cover ${cw} px (fit w ${fit_w} h ${fit_h}), gaps top ${top_gap} bottom ${bot_gap}, caption off ${dmid}")
endfunction()
set(MIN_COVER 330)
flow_layout("${flow0_out}" "cover flow 1280x800")
unset(MIN_COVER)
set(CANVAS 1280x1024)
flow_run(tall coverflow "wait 600\n")
flow_layout("${tall_out}" "cover flow 1280x1024")
