# dui-sync-banner (I527, rewritten for I602): the sync-on-launch dialog, driven from the desktop UI's real entry point.
# -DSELECTA -DWORK -DGOLDEN -DSDL_BUILT. There is no inline banner: the Library list starts directly under the tabs. A modal
# dialog ("nag N" rows, "nagdlg opens X", one "nagrow" per due source, "nagsync" / "naglater" / "nagnever" buttons) opens once
# per launch on the first Library visit when a source is due, and never at start on Home. The test checks:
#   1. the list starts at the same y with the dialog open and after it closed, and no row of a banner is left,
#   2. started on Home the dialog does not open ("nagdlg opens 0"); the first Library visit opens it once,
#   3. "Sync now" syncs the ticked sources only (testsrc song count becomes 3, an unticked source stays unsynced),
#   4. "Not now" closes the dialog and snoozes the rows,
#   5. "Never" switches the ticked sources off for good (Sources tab enabled flag 0 after a restart on the same config and
#      database); the unticked source still prompts at the restart,
#   6. (I582) a failed sync of a ticked source leaves it due: the next launch asks again for it alone.
# Every click uses the rectangles the stats dump prints. The config directory is kept between runs where a run is the
# "next launch" of an earlier one (click_run KEEP).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(DUI_SYNC_BANNER ON) # I527: this test runs with the sync prompt on (see dui_run.cmake)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sync-banner needs the sqlite3 command line tool to load the fixture library")
endif()
function(load_db path tag)
  dui_run(${tag} --db "${path}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
  execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${path}" INPUT_FILE "${HERE}/fixture_library.sql"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "loading the fixture failed: ${err}")
  endif()
endfunction()
set(db "${WORK}/library.db")
load_db("${db}" init)
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sync-banner.sock")
# click_run(tag tokens [KEEP] [VIEW name]): KEEP leaves the config directory of the last run, so the run is the next launch.
function(click_run tag tokens)
  cmake_parse_arguments(A "KEEP" "VIEW" "" ${ARGN})
  if(NOT A_KEEP)
    file(REMOVE_RECURSE "${WORK}/cfg")
  endif()
  if(NOT A_VIEW)
    set(A_VIEW library)
  endif()
  set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens}")
  dui_run(${tag} --db "${db}" --ui desktop --backend sdl --view ${A_VIEW} --canvas 1280x800 --clock fixed --stats)
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
function(click_at out x y t)
  math(EXPR t1 "${t} + 50")
  math(EXPR t2 "${t} + 100")
  set(${out} "m${x},${y}@${t} d1,${x},${y}@${t1} u1,${x},${y}@${t2}" PARENT_SCOPE)
endfunction()
function(rect_center out text key)
  string(REGEX MATCH "${key} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _r "${text}")
  if(_r STREQUAL "")
    message(FATAL_ERROR "no '${key}' rectangle in the stats:\n${text}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out}_x ${cx} PARENT_SCOPE)
  set(${out}_y ${cy} PARENT_SCOPE)
endfunction()
# untick_tokens(out text keep_key t0): click tokens that untick every dialog row except keep_key; ${out}_t is the next free time.
function(untick_tokens out text keep_key t0)
  set(tokens "")
  set(t ${t0})
  foreach(k ${want_keys})
    if(NOT k STREQUAL "${keep_key}")
      rect_center(row "${text}" "nagrow [0-9]+ ${k}\\|1")
      click_at(c ${row_x} ${row_y} ${t})
      string(APPEND tokens " ${c}")
      math(EXPR t "${t} + 200")
    endif()
  endforeach()
  set(${out} "${tokens}" PARENT_SCOPE)
  set(${out}_t ${t} PARENT_SCOPE)
endfunction()
set(want_keys modland hvsc hippo asma keygenmusic sndh zxart testsrc)

# Launch on the Library: the dialog lists every enabled remote source that was never synced, all ticked.
# Mouse moves give the loop frames, so the engine pumps and the SOURCES reply asked for at launch lands before the dump.
click_run(o0 "m5,5@200 m6,6@400 m7,7@600 q@800")
if(NOT o0 MATCHES "nag ([0-9]+) syncs 0\n" OR CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "no sync dialog at launch although remote sources were never synced:\n${o0}")
endif()
if(NOT o0 MATCHES "nagdlg opens 1 done 1\n")
  message(FATAL_ERROR "the dialog must open exactly once on the first Library visit:\n${o0}")
endif()
foreach(k ${want_keys})
  if(NOT o0 MATCHES "nagrow [0-9]+ ${k}\\|1 ")
    message(FATAL_ERROR "the dialog has no ticked row for '${k}':\n${o0}")
  endif()
endforeach()
foreach(b nagpanel nagsync naglater nagnever)
  if(NOT o0 MATCHES "${b} [0-9]+ [0-9]+ [0-9]+ [0-9]+\n")
    message(FATAL_ERROR "the dialog has no '${b}' rectangle:\n${o0}")
  endif()
endforeach()
# 0. (I602) The dialog fits the AGA layout, 640x512 INDEX8, with every source due (two columns): panel and the three buttons lie
# inside the canvas, the buttons inside the panel and not on top of each other. SDL_VIDEODRIVER dummy, memory back end.
unset(ENV{SELECTA_SDL_TEST_TIMED})
dui_run(aga --db "${db}" --ui desktop --backend mem --view library --canvas 640x512 --format index8 --clock fixed --stats)
if(NOT aga MATCHES "nag ([0-9]+) syncs 0\n" OR CMAKE_MATCH_1 LESS 8)
  message(FATAL_ERROR "the 640x512 INDEX8 launch did not open the dialog with all 8 sources due:\n${aga}")
endif()
set(aga_rects "")
foreach(b nagpanel nagsync naglater nagnever)
  string(REGEX MATCH "${b} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _r "${aga}")
  if(_r STREQUAL "")
    message(FATAL_ERROR "no '${b}' rectangle at 640x512:\n${aga}")
  endif()
  set(${b}_x ${CMAKE_MATCH_1})
  set(${b}_y ${CMAKE_MATCH_2})
  math(EXPR ${b}_r "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
  math(EXPR ${b}_b "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  if(${b}_x LESS 0 OR ${b}_y LESS 0 OR ${b}_r GREATER 640 OR ${b}_b GREATER 512)
    message(FATAL_ERROR "${b} leaves the 640x512 canvas: ${${b}_x},${${b}_y} to ${${b}_r},${${b}_b}")
  endif()
  if(NOT b STREQUAL "nagpanel" AND (${b}_x LESS nagpanel_x OR ${b}_y LESS nagpanel_y OR ${b}_r GREATER nagpanel_r OR ${b}_b GREATER nagpanel_b))
    message(FATAL_ERROR "${b} leaves the dialog panel at 640x512")
  endif()
endforeach()
# Button order left to right: Never, Not now, Sync now; each ends before the next one starts.
if(nagnever_r GREATER naglater_x OR naglater_r GREATER nagsync_x)
  message(FATAL_ERROR "the dialog buttons overlap at 640x512: never ${nagnever_x}-${nagnever_r}, later ${naglater_x}-${naglater_r}, sync ${nagsync_x}-${nagsync_r}")
endif()
# Every row box lies inside the panel and the rows stay above the buttons.
string(REGEX MATCHALL "nagrow [0-9]+ [^\n]*\n" aga_rows "${aga}")
foreach(row ${aga_rows})
  string(REGEX MATCH "\\|[01] (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)" _b "${row}")
  math(EXPR rb "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  if(CMAKE_MATCH_1 LESS nagpanel_x OR CMAKE_MATCH_2 LESS nagpanel_y OR rb GREATER nagsync_y)
    message(FATAL_ERROR "a dialog row box at 640x512 leaves the panel or reaches the buttons: ${row}")
  endif()
endforeach()
set(ENV{SELECTA_SDL_TEST_TIMED} "")
string(REGEX MATCH "liststart (-?[0-9]+)\n" _l "${o0}")
set(list_open ${CMAKE_MATCH_1})
string(REGEX MATCH "tab 0 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _t "${o0}")
math(EXPR tab_bottom "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
set(tab_y ${CMAKE_MATCH_2})
# 1. No banner rows: the list starts one small gap under the tab row, not a banner (>= 100 px) lower.
math(EXPR gap "${list_open} - ${tab_bottom}")
if(gap LESS 0 OR gap GREATER 24)
  message(FATAL_ERROR "the Library list does not start directly under the tabs (tab bottom ${tab_bottom}, list start ${list_open}):\n${o0}")
endif()

# 2. A launch on Home never opens the dialog although sources are due.
click_run(h0 "m5,5@200 m6,6@400 q@800" VIEW home)
if(NOT h0 MATCHES "nagdlg opens 0 done 0\n" OR NOT h0 MATCHES "nag 0 syncs 0\n")
  message(FATAL_ERROR "the dialog opened at start on Home:\n${h0}")
endif()
# The first Library visit from Home opens it once; Not now closes it; Home and Library again do not open it a second time.
rect_center(libdoor "${h0}" "sidehdr title") # I673: the Your Library header is the Library door
rect_center(homedoor "${h0}" "door 0")
rect_center(later "${o0}" "naglater")
click_at(d1 ${libdoor_x} ${libdoor_y} 300)
click_at(lc ${later_x} ${later_y} 800)
click_at(d0 ${homedoor_x} ${homedoor_y} 1300)
click_at(d2 ${libdoor_x} ${libdoor_y} 1800)
click_run(h1 "${d1} ${lc} ${d0} ${d2} q@2600" VIEW home)
if(NOT h1 MATCHES "nagdlg opens 1 done 1\n" OR NOT h1 MATCHES "nag 0 syncs 0\n")
  message(FATAL_ERROR "the Library visit from Home must open the dialog once, Not now close it and a second visit not reopen it:\n${h1}")
endif()
if(NOT h1 MATCHES "liststart ${list_open}\n")
  message(FATAL_ERROR "the list start moved after the dialog closed (was ${list_open}):\n${h1}")
endif()

# 3. Sync now: untick everything but testsrc, press Sync now. Only the ticked source is synced.
untick_tokens(un "${o0}" testsrc 300)
rect_center(sync "${o0}" "nagsync")
click_at(sc ${sync_x} ${sync_y} ${un_t})
math(EXPR tq "${un_t} + 1500")
click_run(a "${un} ${sc} q@${tq}")
if(NOT a MATCHES "nag 0 syncs 1\n")
  message(FATAL_ERROR "Sync now was not sent for exactly the one ticked source, or the dialog stayed:\n${a}")
endif()
# The Sources page (tab 5) shows what the sync did.
click_run(p0 "m5,5@200 m6,6@400 q@600" KEEP)
string(REGEX MATCH "tab 5 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _t "${p0}")
if(_t STREQUAL "")
  message(FATAL_ERROR "no tab 5 line in the stats:\n${p0}")
endif()
math(EXPR tx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ty "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
click_at(tc ${tx} ${ty} 500)
# Next launch on the same config: the ticked source is synced, the unticked ones are snoozed, so no dialog blocks the tab.
click_run(c "m5,5@200 ${tc} m5,5@900 m6,6@1200 m7,7@1500 q@1800" KEEP)
if(NOT c MATCHES "source [0-9] testsrc\\|remote\\|[^|]+\\|1\\|3\n")
  message(FATAL_ERROR "the testsrc sync did not run (its song count is not 3):\n${c}")
endif()
if(c MATCHES "source [0-9] modland\\|remote\\|[^|]+\\|1\\|[1-9]")
  message(FATAL_ERROR "an unticked source was synced:\n${c}")
endif()

# 4. Not now closes the dialog.
click_at(lc ${later_x} ${later_y} 300)
click_run(b "${lc} q@1500")
if(NOT b MATCHES "nag 0 syncs 0\n")
  message(FATAL_ERROR "Not now did not close the dialog:\n${b}")
endif()
if(NOT b MATCHES "liststart ${list_open}\n")
  message(FATAL_ERROR "the list start differs with the dialog closed (was ${list_open}):\n${b}")
endif()
if(b MATCHES "nagrow")
  message(FATAL_ERROR "dialog rows are still drawn after Not now:\n${b}")
endif()

# 5. Never (own database: step 3 synced testsrc in the first one): untick testsrc only, press Never. The other seven sources are switched off for good.
set(db "${WORK}/library3.db")
load_db("${db}" init3)
click_run(o3 "m5,5@200 m6,6@400 m7,7@600 q@800")
rect_center(tsrow "${o3}" "nagrow [0-9]+ testsrc\\|1")
click_at(tu ${tsrow_x} ${tsrow_y} 900)
rect_center(never "${o3}" "nagnever")
click_at(nc ${never_x} ${never_y} 1400)
click_run(n1 "m5,5@200 m6,6@500 ${tu} ${nc} q@2200")
if(NOT n1 MATCHES "nag 0 syncs 0\n")
  message(FATAL_ERROR "Never did not close the dialog:\n${n1}")
endif()
# Restart on the same config and database: only testsrc still prompts.
click_run(n2 "m5,5@200 m6,6@600 m7,7@1000 m8,8@1400 q@1800" KEEP)
if(NOT n2 MATCHES "nagrow [0-9]+ testsrc\\|1 ")
  message(FATAL_ERROR "after Never the unticked source no longer prompts:\n${n2}")
endif()
foreach(k modland hvsc hippo asma keygenmusic sndh zxart)
  if(n2 MATCHES "nagrow [0-9]+ ${k}\\|")
    message(FATAL_ERROR "after Never the source '${k}' still prompts:\n${n2}")
  endif()
endforeach()
# The Sources tab shows them switched off (enabled 0) and testsrc still on.
rect_center(later_n "${n2}" "naglater")
click_at(ln ${later_n_x} ${later_n_y} 300)
click_at(tn ${tx} ${ty} 800)
click_run(n3 "m5,5@100 ${ln} ${tn} m5,5@1300 q@1600" KEEP)
foreach(k modland hvsc hippo asma keygenmusic sndh zxart)
  if(NOT n3 MATCHES "source [0-9] ${k}\\|remote\\|[^|]+\\|0\\|")
    message(FATAL_ERROR "after Never the source '${k}' is not switched off on the Sources tab:\n${n3}")
  endif()
endforeach()
if(NOT n3 MATCHES "source [0-9] testsrc\\|remote\\|[^|]+\\|1\\|")
  message(FATAL_ERROR "after Never the unticked source was switched off too:\n${n3}")
endif()

# 6. (I582) Fresh library, testsrc fails. Untick everything but testsrc, press Sync now. The failed source stays due: the next
# launch asks for it alone, the unticked rows were snoozed.
set(db "${WORK}/library2.db")
load_db("${db}" init2)
set(ENV{SELECTA_TESTSRC_FAIL} 1)
click_run(f0 "m5,5@200 m6,6@400 m7,7@600 q@800")
untick_tokens(fu "${f0}" testsrc 300)
rect_center(fsync "${f0}" "nagsync")
click_at(fsc ${fsync_x} ${fsync_y} ${fu_t})
math(EXPR ftq "${fu_t} + 2500")
click_run(f1 "${fu} ${fsc} q@${ftq}")
if(NOT f1 MATCHES "nag 0 syncs 1\n")
  message(FATAL_ERROR "the failing source was not sent once:\n${f1}")
endif()
click_run(f2 "m5,5@200 m6,6@400 m7,7@600 q@800" KEEP)
if(NOT f2 MATCHES "nag 1 syncs 0\n" OR NOT f2 MATCHES "nagrow 0 testsrc\\|1 ")
  message(FATAL_ERROR "after a failed sync the next launch must ask for the failed source alone:\n${f2}")
endif()
unset(ENV{SELECTA_TESTSRC_FAIL})
