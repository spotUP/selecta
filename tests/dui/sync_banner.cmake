# dui-sync-banner (I527): the sync-on-launch banner, driven from the desktop UI's real entry point.
# -DSELECTA -DWORK -DGOLDEN -DSDL_BUILT. Launching the Library page with a library whose remote sources were never synced
# must show the banner ("nag N" in the stats dump, one "nagrow" per due source). The test unticks every source except
# testsrc (real mouse clicks on the row rectangles), presses Sync (the "nagsync" rectangle), and asserts:
#   - the Sync press reached the code ("nag 0 syncs 1" counts the sentinel in the desktop UI),
#   - the engine ran the testsrc sync: its SOURCES row now counts 3 songs (the plugin writes 3), and it is no longer due,
#   - the banner is gone ("nag 0") although the unticked sources were never synced (no network sync was started).
# Second run: "Not now" hides the banner for the rest of the stale window.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(DUI_SYNC_BANNER ON) # I527: this test runs with the banner on (see dui_run.cmake)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sync-banner needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sync-banner.sock")
function(click_run tag tokens)
  file(REMOVE_RECURSE "${WORK}/cfg")
  set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens}")
  dui_run(${tag} --db "${db}" --ui desktop --backend sdl --view library --canvas 1280x800 --clock fixed --stats)
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
function(click_at out x y t)
  math(EXPR t1 "${t} + 50")
  math(EXPR t2 "${t} + 100")
  set(${out} "m${x},${y}@${t} d1,${x},${y}@${t1} u1,${x},${y}@${t2}" PARENT_SCOPE)
endfunction()
function(rect_center out text key)
  string(REGEX MATCH "${key} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _r "${text}")
  if(_r STREQUAL "")
    message(FATAL_ERROR "no '${key}' rectangle in the stats:\n${text}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out}_x ${cx} PARENT_SCOPE)
  set(${out}_y ${cy} PARENT_SCOPE)
endfunction()

# Launch: the banner lists every enabled remote source that was never synced.
# Mouse moves give the loop frames, so the engine pumps and the SOURCES reply asked for at launch lands before the dump.
click_run(o0 "m5,5@200 m6,6@400 m7,7@600 q@800")
if(NOT o0 MATCHES "nag ([0-9]+) syncs 0\n" OR CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "no sync banner at launch although remote sources were never synced:\n${o0}")
endif()
set(want_keys modland hvsc hippo asma keygenmusic sndh zxart testsrc)
foreach(k ${want_keys})
  if(NOT o0 MATCHES "nagrow [0-9]+ ${k}\\|1 ")
    message(FATAL_ERROR "the banner has no ticked row for '${k}':\n${o0}")
  endif()
endforeach()

# Run A: untick everything but testsrc, press Sync.
set(tokens "")
set(t 300)
foreach(k ${want_keys})
  if(NOT k STREQUAL "testsrc")
    rect_center(row "${o0}" "nagrow [0-9]+ ${k}\\|1")
    click_at(c ${row_x} ${row_y} ${t})
    string(APPEND tokens " ${c}")
    math(EXPR t "${t} + 200")
  endif()
endforeach()
rect_center(sync "${o0}" "nagsync")
click_at(sc ${sync_x} ${sync_y} ${t})
math(EXPR tq "${t} + 1500")
click_run(a "${tokens} ${sc} q@${tq}")
if(NOT a MATCHES "nag 0 syncs 1\n")
  message(FATAL_ERROR "run A: Sync was not pressed once or the banner stayed:\n${a}")
endif()
# The Sources page (tab 5, now without the banner) shows what the sync did.
click_run(p0 "m5,5@200 m6,6@400 q@600")
string(REGEX MATCH "tab 5 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _t "${p0}")
if(_t STREQUAL "")
  message(FATAL_ERROR "no tab 5 line in the stats:\n${p0}")
endif()
math(EXPR tx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ty "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
click_at(tc ${tx} ${ty} 300)
click_run(c "${tc} m5,5@700 q@1000")
if(NOT c MATCHES "source [0-9] testsrc\\|remote\\|[^|]+\\|1\\|3\n")
  message(FATAL_ERROR "run A: the testsrc sync did not run (its song count is not 3):\n${c}")
endif()
if(c MATCHES "source [0-9] modland\\|remote\\|[^|]+\\|1\\|[1-9]")
  message(FATAL_ERROR "run A: an unticked source was synced:\n${c}")
endif()

# Run B: "Not now" hides the banner.
rect_center(later "${o0}" "naglater")
click_at(lc ${later_x} ${later_y} 300)
click_run(b "${lc} q@1500")
if(NOT b MATCHES "nag 0 syncs 0\n")
  message(FATAL_ERROR "run B: Not now did not hide the banner:\n${b}")
endif()
