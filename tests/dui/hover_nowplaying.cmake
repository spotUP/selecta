# dui-hover-nowplaying (DUI-P3-16, I357): the Now Playing heart and the five rating marks light under the pointer. -DSELECTA -DSONGS -DWORK
# A mem run on a playing song gives the heart rectangle (`hover_ctl ... detail`) and the first rating mark (`rating ... mark`).
# Live runs quit at 400 ms: the rest run has no pointer, the moved runs put it on the heart / on the fifth mark at 300 ms. The
# frame dump must differ from the rest frame inside that rectangle, and --stats must count a hover.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
include("${HERE}/ppm.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
set(fx "${HERE}/../m3/lyrics")
set(args --ui desktop --view home --canvas 1280x800 --stats
         --exec "LIBRARY_SCAN ${fx}" --exec "OPEN ${fx}/ambient.mod" --exec "SEEK 1000")
function(np_live outvar timed ppm)
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/live.db")
  set(ENV{SELECTA_SDL_TEST_LIVE} 1)
  set(ENV{SELECTA_SDL_TEST_TIMED} "${timed}")
  dui_run(o --db "${WORK}/live.db" ${args} --backend sdl --frame-dump "${ppm}")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()
file(REMOVE_RECURSE "${WORK}/cfg")
unset(ENV{SELECTA_SDL_TEST_LIVE})
dui_run(o0 --db "${WORK}/mem.db" ${args} --backend mem --clock fixed)
if(NOT "${o0}" MATCHES "hover_ctl [^\n]* detail (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) ")
  message(FATAL_ERROR "no hover_ctl detail (heart) rectangle in:\n${o0}")
endif()
set(hx ${CMAKE_MATCH_1})
set(hy ${CMAKE_MATCH_2})
set(hw ${CMAKE_MATCH_3})
set(hh ${CMAKE_MATCH_4})
if(NOT "${o0}" MATCHES "rating (-?[0-9]+) liked ([01]) mark (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) step ([0-9]+)")
  message(FATAL_ERROR "no rating sentinel in:\n${o0}")
endif()
math(EXPR mx "${CMAKE_MATCH_3} + 4 * ${CMAKE_MATCH_7}")
set(my ${CMAKE_MATCH_4})
set(mw ${CMAKE_MATCH_5})
set(mh ${CMAKE_MATCH_6})
if(hw LESS 1 OR mw LESS 1)
  message(FATAL_ERROR "the Now Playing panel is empty (heart ${hw}, mark ${mw}): no song playing in:\n${o0}")
endif()

np_live(rest "q@400" "${WORK}/rest.ppm")
ppm_load("${WORK}/rest.ppm" resthex w)
dui_stat(hovers_rest "${rest}" desktop hovers)

function(np_case name cx cy rx ry rw rh)
  math(EXPR px "${cx} + ${rw} / 2")
  math(EXPR py "${cy} + ${rh} / 2")
  np_live(moved "m${px},${py}@300 q@400" "${WORK}/${name}.ppm")
  ppm_load("${WORK}/${name}.ppm" movedhex mw2)
  rect_differs("${resthex}" "${movedhex}" ${w} ${rx} ${ry} ${rw} ${rh} lit)
  if(NOT lit)
    message(FATAL_ERROR "the Now Playing ${name} under the pointer is pixel-identical to the rest frame: it does not light (I357)")
  endif()
  dui_stat(hv "${moved}" desktop hovers)
  if(hv LESS 1)
    message(FATAL_ERROR "the move onto the ${name} counted no hover (hovers=${hv})")
  endif()
endfunction()
np_case(heart ${hx} ${hy} ${hx} ${hy} ${hw} ${hh})
np_case(rating_mark ${mx} ${my} ${mx} ${my} ${mw} ${mh})
