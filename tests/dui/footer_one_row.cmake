# dui-footer-one-row (DUI-P4-20, ledger I601): on a short canvas the player bar is ONE row. At the AGA open
# (--canvas 640x256 --ydiv 2 --format index8 --zoom fit, layout 640x512) the player region is 40 logical px tall (it was 72),
# so main gains 32 rows; every transport button, the seek bar and the volume bar lie inside that row and no two overlap;
# a click on the seek bar still sends SEEK and a click on the volume bar still sends VOLUME (the dui-footer approach).
# At 1280x800 rgba32 the two row footer stays (player 72 tall).
# -DSELECTA -DSONGS -DWORK
# Revert check: with the desktop_ui.c change reverted (footer_one_row returns 0) the player region is 72 tall and the bars sit on
# two rows, so the height assertions and the in-row assertions fail.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
configure_file("${SONGS}/selecta-test-mk.mod" "${WORK}/song.mod" COPYONLY)

function(fr_run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/in.txt" "wait 2\n${input}wait 1\n")
  dui_run(o --ui desktop --backend mem --view home --canvas 640x256 --ydiv 2 --format index8 --zoom fit --clock fixed --stats
    --resize 640x512 --exec "QUEUE_ADD ${WORK}/song.mod" --exec "PLAY" --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

fr_run(base "")
if(NOT base MATCHES "layout width=640 height=512 id=icon-sidebar ")
  message(FATAL_ERROR "expected the 640x512 bitmap layout:\n${base}")
endif()
if(NOT base MATCHES "region name=player x=0 y=([0-9]+) w=640 h=([0-9]+)")
  message(FATAL_ERROR "no player region:\n${base}")
endif()
set(py ${CMAKE_MATCH_1})
set(ph ${CMAKE_MATCH_2})
if(NOT ph EQUAL 40 OR NOT py EQUAL 472)
  message(FATAL_ERROR "the player region must be one row, 40 tall at y=472 (was 72 at y=440); got y=${py} h=${ph}")
endif()
if(NOT base MATCHES "region name=main x=[0-9]+ y=0 w=[0-9]+ h=([0-9]+)" OR NOT CMAKE_MATCH_1 EQUAL 472)
  message(FATAL_ERROR "main must gain the 32 saved rows (h=472):\n${base}")
endif()
math(EXPR pbottom "${py} + ${ph}")

# Every rectangle lies inside the row; collect them for the overlap check.
set(rects "")
string(REGEX MATCHALL "button id=[a-z_]+ x=-?[0-9]+ y=-?[0-9]+ w=[0-9]+ h=[0-9]+" buttons "${base}")
list(LENGTH buttons nbtn)
if(nbtn LESS 5)
  message(FATAL_ERROR "expected at least the five transport buttons, got ${nbtn}:\n${base}")
endif()
foreach(b ${buttons})
  string(REGEX MATCH "x=(-?[0-9]+) y=(-?[0-9]+) w=([0-9]+) h=([0-9]+)" _ "${b}")
  list(APPEND rects "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
endforeach()
if(NOT base MATCHES "footer vol_bar ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) seek_bar ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no footer bar rectangles:\n${base}")
endif()
set(vx ${CMAKE_MATCH_1})
set(vyy ${CMAKE_MATCH_2})
set(vw ${CMAKE_MATCH_3})
set(vh ${CMAKE_MATCH_4})
set(sx ${CMAKE_MATCH_5})
set(syy ${CMAKE_MATCH_6})
set(sw ${CMAKE_MATCH_7})
set(sh ${CMAKE_MATCH_8})
list(APPEND rects "${vx} ${vyy} ${vw} ${vh}" "${sx} ${syy} ${sw} ${sh}")
set(i 0)
foreach(r ${rects})
  string(REPLACE " " ";" a "${r}")
  list(GET a 0 x)
  list(GET a 1 y)
  list(GET a 2 w)
  list(GET a 3 h)
  math(EXPR xe "${x} + ${w}")
  math(EXPR ye "${y} + ${h}")
  if(x LESS 0 OR xe GREATER 640 OR y LESS ${py} OR ye GREATER ${pbottom} OR w LESS 1)
    message(FATAL_ERROR "rect ${r} lies outside the footer row y=${py}..${pbottom}")
  endif()
  set(j 0)
  foreach(r2 ${rects})
    if(j GREATER i)
      string(REPLACE " " ";" b2 "${r2}")
      list(GET b2 0 x2)
      list(GET b2 1 y2)
      list(GET b2 2 w2)
      list(GET b2 3 h2)
      math(EXPR x2e "${x2} + ${w2}")
      math(EXPR y2e "${y2} + ${h2}")
      if(x LESS x2e AND x2 LESS xe AND y LESS y2e AND y2 LESS ye)
        message(FATAL_ERROR "footer rects overlap: ${r} and ${r2}")
      endif()
    endif()
    math(EXPR j "${j} + 1")
  endforeach()
  math(EXPR i "${i} + 1")
endforeach()
# The bars are centred on the row, not stacked on two rows.
math(EXPR vmidy "${vyy} + ${vh} / 2")
math(EXPR smidy "${syy} + ${sh} / 2")
if(NOT vmidy EQUAL smidy)
  message(FATAL_ERROR "seek and volume bars must share one row centre (seek ${smidy}, volume ${vmidy})")
endif()

# A click on the seek bar sends SEEK, a click on the volume bar sends VOLUME.
math(EXPR vmid "${vx} + ${vw} / 2")
math(EXPR smid "${sx} + ${sw} / 2")
# Input is in canvas rows: the 640x256 canvas shows layout rows at half height (ydiv 2).
math(EXPR cy "${vmidy} / 2")
fr_run(vclick "click ${vmid} ${cy}\n")
if(NOT vclick MATCHES "vol_clicks=1 seek_clicks=0" OR NOT vclick MATCHES "volume=50")
  message(FATAL_ERROR "a click on the volume bar must set volume 50:\n${vclick}")
endif()
fr_run(sclick "click ${smid} ${cy}\n")
if(NOT sclick MATCHES "vol_clicks=0 seek_clicks=1" OR sclick MATCHES "seek_path=0")
  message(FATAL_ERROR "a click on the seek bar must send SEEK:\n${sclick}")
endif()

# 1280x800 rgba32 keeps the two row footer.
dui_run(big --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --resize 1280x800)
if(NOT big MATCHES "region name=player x=0 y=728 w=1280 h=72")
  message(FATAL_ERROR "the 1280x800 footer must stay 72 tall:\n${big}")
endif()
