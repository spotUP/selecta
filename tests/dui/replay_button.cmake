# dui-replay-button (I1424): the Replay button left of Previous restarts the current song from the start, same song,
# and leaves Repeat alone; with no song loaded a click sends nothing.
#   -DSELECTA -DSONGS -DWORK
# The layout output (`button id=replay`) gives the click point. The song plays for 3 s, then the click: one second later
# the clock reads 0:00 or 0:01 (without the click it reads 0:04), the song line is unchanged and repeat_mode stays 0.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
configure_file("${SONGS}/selecta-test.mod" "${WORK}/banana.mod" COPYONLY)

dui_run(lay --ui desktop --backend mem --canvas 1280x800 --resize 1280x800)
if(NOT lay MATCHES "button id=replay x=(-?[0-9]+) y=(-?[0-9]+) w=([0-9]+) h=([0-9]+)")
  message(FATAL_ERROR "the layout output lists no replay button:\n${lay}")
endif()
math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
function(replay_run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --ui desktop --backend mem --view songs --canvas 1280x800 --stats --exec "QUEUE_ADD ${WORK}/banana.mod"
    --exec "PLAY" ${ARGN} --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

replay_run(plain "wait 4\n")
replay_run(replayed "wait 3\nclick ${rx} ${ry}\nwait 1\n")
if(NOT plain MATCHES "closed [^\n]* clock=([0-9:]+) ")
  message(FATAL_ERROR "no clock after plain play:\n${plain}")
endif()
set(clock_plain "${CMAKE_MATCH_1}")
if(NOT replayed MATCHES "closed [^\n]* clock=([0-9:]+) ")
  message(FATAL_ERROR "no clock after replay:\n${replayed}")
endif()
set(clock_replayed "${CMAKE_MATCH_1}")
if(NOT clock_replayed MATCHES "^0:0[01]$")
  message(FATAL_ERROR "replay did not restart the song: clock ${clock_replayed} (plain run ${clock_plain})")
endif()
if(clock_plain MATCHES "^0:0[01]$")
  message(FATAL_ERROR "the plain run never advanced (clock ${clock_plain}): the test proves nothing")
endif()
if(NOT plain MATCHES "song=([^\n]*)\n" )
  message(FATAL_ERROR "no song line:\n${plain}")
endif()
set(song_plain "${CMAKE_MATCH_1}")
if(NOT replayed MATCHES "song=([^\n]*)\n" OR NOT CMAKE_MATCH_1 STREQUAL song_plain)
  message(FATAL_ERROR "replay changed the song: '${CMAKE_MATCH_1}' vs '${song_plain}'")
endif()
dui_stat(rep "${replayed}" desktop repeat_mode)
dui_stat(hits "${replayed}" desktop transport_hits)
if(NOT rep EQUAL 0 OR NOT hits EQUAL 1)
  message(FATAL_ERROR "repeat_mode=${rep} transport_hits=${hits}, expected 0 and 1")
endif()

# No song loaded: the click reaches nothing.
file(REMOVE_RECURSE "${WORK}/cfg")
file(WRITE "${WORK}/in.txt" "click ${rx} ${ry}\nwait 1\n")
dui_run(idle --ui desktop --backend mem --view songs --canvas 1280x800 --stats --input "${WORK}/in.txt")
dui_stat(idle_hits "${idle}" desktop transport_hits)
if(NOT idle_hits EQUAL 0)
  message(FATAL_ERROR "replay with no song sent a command: transport_hits=${idle_hits}")
endif()
