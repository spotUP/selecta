# dui-coverflow-slide (I400): a cover flow slide is continuous. One Right key, sampled at fixed clock offsets into the glide.
# The dump line "flow covers N g:x:size:|p| ..." lists the covers of the last frame in draw order (far to near); |p| is the
# fractional slot distance from the centre in 16.16 (65536 = one slot). Asserts:
#   1. frame 0 of the glide shows the old layout (centre cover = the old centre at its rest size and x), not the new one;
#   2. per cover, x and size move monotonically over the glide, |p| changes by less than half a slot per 20 ms sample, and
#      draw order is by decreasing |p| in every frame;
#   3. the cover nearest the centre never changes size by more than a small bound between samples;
#   4. the end of the glide equals the rest layout of centre 1;
#   5. a second Right key mid-glide starts from the covers' current positions (no snap).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-coverflow-slide needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(queue "")
foreach(p 1.mod 2.mod 3.xm 4.it 5.sid)
  list(APPEND queue --exec "QUEUE_ADD \"fixture/${p}\"")
endforeach()

# Runs the cover flow with the key script ${script}; sets ${tag} to the "flow covers" entries (a list of g:x:size:a).
function(flow_sample tag script)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/${tag}.txt" "exec VIEW_STYLE regular\nexec VIEW_SOURCE queue\nexec VIEW_WINDOW 8\nexec VIEW_STYLE coverflow\nexec COMPOSERS_SHOW\nwait 100\n${script}")
  dui_run(o --db "${db}" --ui desktop --backend mem --view library --canvas 1280x800 --clock fixed --stats --exec "PREF_SET ui.desktop.reduce_motion 0" ${queue}
    --input "${WORK}/${tag}.txt")
  # script `flowsnap` lines (the frame drawn so far, mid-glide): ${tag}_snaps = list of snap indexes, ${tag}_<i> = entries
  string(REGEX MATCHALL "flow snap [^\n]*" snaps "${o}")
  set(si 0)
  foreach(sn IN LISTS snaps)
    string(REPLACE "flow snap " "" sn "${sn}")
    string(REPLACE " " ";" sn "${sn}")
    set(${tag}_${si} "${sn}" PARENT_SCOPE)
    math(EXPR si "${si} + 1")
  endforeach()
  set(${tag}_n ${si} PARENT_SCOPE)
  if("${o}" MATCHES "ui_paint id=desktop span_px=([0-9]+)")
    set(${tag}_span "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endif()
  if(NOT "${o}" MATCHES "flow covers ([0-9]+)([^\n]*)\n")
    message(FATAL_ERROR "${tag}: no 'flow covers' line in:\n${o}")
  endif()
  set(cnt "${CMAKE_MATCH_1}")
  set(rest "${CMAKE_MATCH_2}")
  string(STRIP "${rest}" rest)
  string(REPLACE " " ";" rest "${rest}")
  list(LENGTH rest n)
  if(NOT n EQUAL cnt)
    message(FATAL_ERROR "${tag}: flow covers count ${cnt} but ${n} entries")
  endif()
  set(${tag} "${rest}" PARENT_SCOPE)
endfunction()

# Field f (1 g, 2 x, 3 size, 4 |p|) of the cover with index g in entries ${list}; "" when the cover is not drawn.
function(cover_field out list g f)
  set(res "")
  foreach(e IN LISTS list)
    string(REPLACE ":" ";" parts "${e}")
    list(GET parts 0 eg)
    if(eg EQUAL g)
      list(GET parts ${f} res)
    endif()
  endforeach()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

function(nearest out list f)
  list(GET list -1 last)
  string(REPLACE ":" ";" parts "${last}")
  list(GET parts ${f} v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

flow_sample(rest0 "wait 600\n")
flow_sample(rest1 "key right\nwait 600\n")
# I401: the frame cost of the slide is the rasterizer. Fills, rounded bodies and vertical gradient rows write pixel runs; a run per row
# instead of a put() per pixel made the whole UI about 5x cheaper at 2560x1600. A 1280x800 run of the slide writes millions of span pixels;
# 0 means the per-pixel path is back.
if(NOT DEFINED rest1_span OR rest1_span LESS 1000000)
  message(FATAL_ERROR "I401: the rasterizer wrote only ${rest1_span} span pixels in the slide run (want >= 1000000): fills are not running as spans")
endif()
# One run: Right, then a snapshot of the frame being shown every 20 ms of the glide (the run's own end shows the end state).
set(script "key right\nwait 1\nflowsnap\n")
foreach(i RANGE 1 11)
  string(APPEND script "wait 20\nflowsnap\n")
endforeach()
flow_sample(glide "${script}")
if(NOT glide_n EQUAL 12)
  message(FATAL_ERROR "expected 12 glide snapshots, got ${glide_n}")
endif()
set(samples "")
foreach(i RANGE 0 11)
  set(s${i} "${glide_${i}}")
  message(STATUS "glide ${i}: ${s${i}}")
  list(APPEND samples s${i})
endforeach()

# 1: frame 0 is the old layout: the nearest cover is index 0 and still (nearly) at its rest size and x.
nearest(n0g "${s0}" 0)
nearest(n0x "${s0}" 1)
nearest(n0w "${s0}" 2)
nearest(r0x "${rest0}" 1)
nearest(r0w "${rest0}" 2)
math(EXPR dx0 "${n0x} - ${r0x}")
math(EXPR dw0 "${r0w} - ${n0w}")
if(NOT n0g EQUAL 0 OR dx0 GREATER 40 OR dx0 LESS -40 OR dw0 GREATER 20 OR dw0 LESS 0)
  message(FATAL_ERROR "frame 0 of the slide is not the old layout: nearest cover ${n0g} x ${n0x} size ${n0w}, rest centre 0 has x ${r0x} size ${r0w}")
endif()

# 2 + 3: per cover monotone x and size, |p| steps below half a slot, draw order by decreasing |p|, nearest size steps bounded.
set(prev "")
set(prev_name "")
set(first TRUE)
foreach(name IN LISTS samples)
  set(cur "${${name}}")
  # draw order
  set(last_a 99999999)
  foreach(e IN LISTS cur)
    string(REPLACE ":" ";" parts "${e}")
    list(GET parts 3 a)
    if(a GREATER last_a)
      message(FATAL_ERROR "${name}: covers not drawn far to near (|p| ${a} after ${last_a}) in: ${cur}")
    endif()
    set(last_a ${a})
  endforeach()
  if(NOT first)
    foreach(g -1 0 1 2 3 4)
      cover_field(px "${prev}" ${g} 1)
      cover_field(cx "${cur}" ${g} 1)
      cover_field(pw "${prev}" ${g} 2)
      cover_field(cw "${cur}" ${g} 2)
      cover_field(pa "${prev}" ${g} 3)
      cover_field(ca "${cur}" ${g} 3)
      if(NOT px STREQUAL "" AND NOT cx STREQUAL "")
        if(cx GREATER px)
          message(FATAL_ERROR "cover ${g} moved right (${px} -> ${cx}) from ${prev_name} to ${name}")
        endif()
        # the size direction of a cover is fixed by its end state
        cover_field(ew "${rest1}" ${g} 2)
        cover_field(ow "${rest0}" ${g} 2)
        if(NOT ew STREQUAL "" AND NOT ow STREQUAL "")
          if(ew GREATER ow AND cw LESS pw)
            message(FATAL_ERROR "cover ${g} shrank (${pw} -> ${cw}) from ${prev_name} to ${name} while it grows")
          elseif(ew LESS ow AND cw GREATER pw)
            message(FATAL_ERROR "cover ${g} grew (${pw} -> ${cw}) from ${prev_name} to ${name} while it shrinks")
          endif()
        endif()
        math(EXPR da "${ca} - ${pa}")
        if(da GREATER 32768 OR da LESS -32768)
          message(FATAL_ERROR "cover ${g} jumped ${da}/65536 of a slot from ${prev_name} to ${name}")
        endif()
      endif()
    endforeach()
    nearest(nw "${cur}" 2)
    nearest(pnw "${prev}" 2)
    math(EXPR dn "${nw} - ${pnw}")
    math(EXPR bound "${n0w} / 8")
    if(dn GREATER bound OR dn LESS -${bound})
      message(FATAL_ERROR "the nearest cover changed size by ${dn} px from ${prev_name} to ${name} (bound ${bound})")
    endif()
  endif()
  set(first FALSE)
  set(prev "${cur}")
  set(prev_name ${name})
endforeach()

# 4: the end of the glide is the rest layout of centre 1.
flow_sample(end "key right\nwait 220\nwait 400\n")
if(NOT end STREQUAL rest1)
  message(FATAL_ERROR "the glide end differs from the rest layout of centre 1:\n${end}\n${rest1}")
endif()

# 5: a second Right 60 ms into the glide continues from where the covers are (snapshot just before and just after the key).
flow_sample(mid "key right\nwait 60\nflowsnap\nkey right\nwait 1\nflowsnap\n")
set(before "${mid_0}")
set(after "${mid_1}")
foreach(g 0 1 2)
  foreach(f 1 2)
    cover_field(bv "${before}" ${g} ${f})
    cover_field(av "${after}" ${g} ${f})
    math(EXPR d "${av} - ${bv}")
    if(d GREATER 12 OR d LESS -12)
      message(FATAL_ERROR "a key mid-glide snapped cover ${g} field ${f}: ${bv} -> ${av}\nbefore: ${before}\nafter: ${after}")
    endif()
  endforeach()
endforeach()
