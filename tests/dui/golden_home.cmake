# dui-golden-home (DUI-P2-6): the mem backend as a golden harness. -DSELECTA -DSONGS -DWORK -DGOLDEN
#   --view home       the tile grid of the queued names (fixture album titles, tests/dui/fixture_library.sql)
#   --frame-dump F    the canvas as binary PPM at close
#   --input F         scripted clicks (`click X Y`, `tile N`), replayed on the first quiet turn
#   --clock fixed     the only mem clock; the run is deterministic
# 1. The home view hash matches the golden (update only with SELECTA_GOLDEN_UPDATE=1) and the dump is a valid PPM.
# 2. Sentinel view_opens: a `tile 0` click raises it by exactly 1 and changes the frame; a click on empty space and
#    a click outside the main region leave it at 0 and the hash unchanged.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")

file(STRINGS "${HERE}/fixture_library.sql" album_lines REGEX "^INSERT INTO albums")
set(execs "")
foreach(line IN LISTS album_lines)
  # No regex here: CMake regex does not match non-ASCII bytes inside a bracket class.
  string(FIND "${line}" "VALUES(" at)
  if(NOT at EQUAL -1)
    string(SUBSTRING "${line}" ${at} -1 rest)
    string(FIND "${rest}" "'" q1)
    math(EXPR from "${q1} + 1")
    string(SUBSTRING "${rest}" ${from} -1 rest)
    string(FIND "${rest}" "'" q2)
    string(SUBSTRING "${rest}" 0 ${q2} title)
    list(APPEND execs --exec "QUEUE_ADD \"fixture/${title}.mod\"")
  endif()
endforeach()
list(LENGTH execs exec_n)
if(exec_n LESS 8)
  message(FATAL_ERROR "expected at least 4 fixture albums, found ${exec_n} exec arguments")
endif()
set(common --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats ${execs})

file(MAKE_DIRECTORY "${WORK}")
dui_run(home ${common} --frame-dump "${WORK}/home.ppm")
dui_stat(opens "${home}" desktop view_opens)
dui_stat(hash "${home}" desktop canvas_hash)
dui_stat(missing "${home}" desktop missing_glyphs)
if(NOT opens EQUAL 0 OR NOT missing EQUAL 0)
  message(FATAL_ERROR "home without input: view_opens=${opens} missing_glyphs=${missing}")
endif()
set(gfile "${GOLDEN}/desktop/home-rgba32-1280x800@1.hash")
if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
  file(WRITE "${gfile}" "${hash}\n")
endif()
if(NOT EXISTS "${gfile}")
  message(FATAL_ERROR "missing golden ${gfile} (hash ${hash}); create it with SELECTA_GOLDEN_UPDATE=1")
endif()
file(STRINGS "${gfile}" want LIMIT_COUNT 1)
if(NOT hash STREQUAL want)
  message(FATAL_ERROR "home hash ${hash} differs from golden ${want} (${gfile})")
endif()

file(READ "${WORK}/home.ppm" head LIMIT 16)
if(NOT head STREQUAL "P6\n1280 800\n255\n")
  message(FATAL_ERROR "frame dump header is not 'P6 1280 800 255'")
endif()
file(SIZE "${WORK}/home.ppm" ppm_size)
math(EXPR ppm_want "16 + 1280 * 800 * 3")
if(NOT ppm_size EQUAL ppm_want)
  message(FATAL_ERROR "frame dump is ${ppm_size} bytes, want ${ppm_want}")
endif()

file(WRITE "${WORK}/open.txt" "# open the first tile\ntile 0\n")
dui_run(opened ${common} --input "${WORK}/open.txt")
dui_stat(opens1 "${opened}" desktop view_opens)
dui_stat(hash1 "${opened}" desktop canvas_hash)
if(NOT opens1 EQUAL 1)
  message(FATAL_ERROR "a click on tile 0 must open exactly one view (view_opens=${opens1})")
endif()
if(hash1 STREQUAL hash)
  message(FATAL_ERROR "the opened view looks the same as home (hash ${hash1})")
endif()

file(WRITE "${WORK}/miss.txt" "click 1 1\nclick 1270 700\n")
dui_run(missed ${common} --input "${WORK}/miss.txt")
dui_stat(opens0 "${missed}" desktop view_opens)
dui_stat(hash0 "${missed}" desktop canvas_hash)
if(NOT opens0 EQUAL 0 OR NOT hash0 STREQUAL hash)
  message(FATAL_ERROR "clicks outside any tile must change nothing (view_opens=${opens0}, hash ${hash0} vs ${hash})")
endif()

execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" --ui desktop --backend mem
  --clock wall RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
if(rc EQUAL 0)
  message(FATAL_ERROR "--clock wall must be rejected by the mem backend")
endif()
