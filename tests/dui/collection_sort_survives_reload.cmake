# dui-collection-sort-survives-reload (I1195): a sort chosen on a song list page survives the page reloads that follow.
# -DSELECTA -DSONGS -DWORK
# Violated invariant: the page order is the view (COLLECTION_VIEW sort) applied to the page's songs; a reload of the same song set (library
# changes elsewhere, a republish, briefs landing late) must not change which order the rows show. Johan: "clicking sort order in song lists
# switches to the new order for 1 frame and then switch back on mac".
# Path: the sidebar alpha row click, the sort button click (Custom Order -> Title), then library writes with no wait between them (each one
# republishes or touches the page) while the briefs read is slow, then a wait. Asserts:
# 1. sentinel: library_reloads >= 3 (the reloads really ran), and the engine applied COLLECTION_VIEW once;
# 2. the final collection line says sort=1 and the rows are in Title order (Bass Line;Intro;Main Theme), not the custom order.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-collection-sort-survives-reload needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" "UPDATE songs SET key = 'local:' || path WHERE key LIKE 'fixture:%'"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "rekeying the fixture failed: ${err}")
endif()
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x800)
dui_run(seed ${common}
  --exec "PLAYLIST_CREATE alpha" --exec "PLAYLIST_ADD_SONG 1 fixture/2.mod" --exec "PLAYLIST_ADD_SONG 1 fixture/1.mod" --exec "PLAYLIST_ADD_SONG 1 fixture/5.sid")
file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(idle ${common} --input "${WORK}/idle.txt")
if(NOT "${idle}" MATCHES "sidelib_row [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=[01] open=[01] kind=[0-9]+ alpha\n")
  message(FATAL_ERROR "no alpha sidebar row in:\n${idle}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
file(WRITE "${WORK}/open.txt" "click ${cx} ${cy}\nwait 100\n")
dui_run(opened ${common} --input "${WORK}/open.txt")
if(NOT "${opened}" MATCHES "collection kind=playlist [^\n]* sortbtn=([0-9]+),([0-9]+),([0-9]+),([0-9]+)")
  message(FATAL_ERROR "no sortbtn rectangle in:\n${opened}")
endif()
math(EXPR sx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR sy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(script "click ${cx} ${cy}\nwait 100\nclick ${sx} ${sy}\n")
foreach(n 1 2 3 4 5 6)
  string(APPEND script "exec PLAYLIST_CREATE touch${n}\nwait 20\n")
endforeach()
string(APPEND script "wait 300\n")
file(WRITE "${WORK}/run.txt" "${script}")
set(ENV{SELECTA_LIB_BRIEFS_SLOW_MS} 200)
dui_run(o ${common} --input "${WORK}/run.txt")
unset(ENV{SELECTA_LIB_BRIEFS_SLOW_MS})
if(NOT "${o}" MATCHES "library_serial=[0-9]+ library_reloads=([0-9]+) ")
  message(FATAL_ERROR "no library_reloads in:\n${o}")
endif()
set(reloads ${CMAKE_MATCH_1})
message(STATUS "reloads=${reloads}")
if(reloads LESS 3)
  message(FATAL_ERROR "sentinel: library_reloads=${reloads}: the invalidates did not run:\n${o}")
endif()
if(NOT "${o}" MATCHES "collection kind=playlist [^\n]* sort=([0-9]+) ")
  message(FATAL_ERROR "no collection line in:\n${o}")
endif()
if(NOT CMAKE_MATCH_1 STREQUAL "1")
  message(FATAL_ERROR "the sort mode ended at ${CMAKE_MATCH_1}, expected 1 (Title):\n${o}")
endif()
string(REGEX MATCHALL "plsong [0-9]+ [0-9]+ [0-9]+ [0-9]+ [0-9]+ file=[^ \n]* title=[^\n]*" lines "${o}")
set(titles "")
foreach(l IN LISTS lines)
  string(REGEX MATCH "title=(.*)" m "${l}")
  list(APPEND titles "${CMAKE_MATCH_1}")
endforeach()
if(NOT "${titles}" STREQUAL "Bass Line;Intro;Main Theme")
  message(FATAL_ERROR "after the sort and the reloads the rows show '${titles}', expected Title order Bass Line;Intro;Main Theme:\n${o}")
endif()
