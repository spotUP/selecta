# dui-tokens (DUI-P1-10, M4-P2-1): through the real shell, the desktop UI paints with design tokens read from a theme file.
#   -DSELECTA=<exe> -DSONGS=<dir> -DWORK=<dir> -DGOLDEN=<tests/golden>
# The red-accent fixture overrides one token. The play button pixel must take it, every other pixel and metric must stay,
# and the reported change set must be exactly that one token. A value outside a token's range, a missing file and an
# unknown gui key must refuse to open; a theme with role lines and token lines together must load.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
set(base --ui desktop --backend mem --tokens)
dui_run(dflt ${base})
dui_run(red ${base} --theme "${GOLDEN}/desktop/accent-red.theme")

function(pixel_lines out text)
  string(REPLACE "\n" ";" lines "${text}")
  set(keep "")
  foreach(l IN LISTS lines)
    if(l MATCHES "^(pixel|metric) ")
      list(APPEND keep "${l}")
    endif()
  endforeach()
  set(${out} "${keep}" PARENT_SCOPE)
endfunction()
pixel_lines(dflt_px "${dflt}")
pixel_lines(red_px "${red}")
list(LENGTH dflt_px npx)
if(npx LESS 5)
  message(FATAL_ERROR "the desktop UI printed ${npx} pixel and metric lines, expected 5:\n${dflt}")
endif()
if(NOT "${dflt}" MATCHES "pixel widget=play_button rgb=0x3b82f6")
  message(FATAL_ERROR "default play button is not the default accent 0x3b82f6:\n${dflt}")
endif()
if(NOT "${red}" MATCHES "pixel widget=play_button rgb=0xe53935")
  message(FATAL_ERROR "red theme did not repaint the play button 0xe53935:\n${red}")
endif()
if(NOT "${dflt}" MATCHES "tokens count=25 changed=0")
  message(FATAL_ERROR "defaults must report no changed token:\n${dflt}")
endif()
if(NOT "${red}" MATCHES "tokens count=25 changed=1" OR NOT "${red}" MATCHES "token changed=gui.accent")
  message(FATAL_ERROR "red theme must change exactly gui.accent:\n${red}")
endif()
# Every pixel and metric line except the play button is identical in both runs.
foreach(l IN LISTS dflt_px)
  if(NOT l MATCHES "widget=play_button")
    list(FIND red_px "${l}" at)
    if(at LESS 0)
      message(FATAL_ERROR "the accent theme moved another pixel: '${l}' is gone from:\n${red}")
    endif()
  endif()
endforeach()

# Role lines and token lines together.
dui_run(mixed ${base} --theme "${GOLDEN}/desktop/mixed.theme")
if(NOT "${mixed}" MATCHES "metric name=gap px=12" OR NOT "${mixed}" MATCHES "metric name=corner_radius px=16")
  message(FATAL_ERROR "mixed theme: decimal and hex token values not applied:\n${mixed}")
endif()
if(NOT "${mixed}" MATCHES "tokens count=25 changed=2")
  message(FATAL_ERROR "mixed theme must change exactly two tokens:\n${mixed}")
endif()

# Refusals: out of range, missing file, unknown gui key.
file(WRITE "${WORK}/unknown.theme" "gui.glow = 3\n")
foreach(bad "${GOLDEN}/desktop/radius-range.theme" "${WORK}/missing.theme" "${WORK}/unknown.theme")
  execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" ${base} --theme "${bad}"
    --exec STATUS RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
  if(rc EQUAL 0)
    message(FATAL_ERROR "--theme ${bad} must make the desktop UI refuse to open")
  endif()
endforeach()

# Two token layers (I237, D-DUI-9). Roles follow base tokens; `@name` references resolve once at parse time.
# (1) A theme that swaps only the base layer recolours the roles that follow it (surface follows gui.base.grey_2).
file(WRITE "${WORK}/base-only.theme" "gui.base.grey_2 = 0x123456\n")
dui_run(baseonly ${base} --theme "${WORK}/base-only.theme")
if(NOT "${baseonly}" MATCHES "pixel widget=panel rgb=0x123456")
  message(FATAL_ERROR "a base-only theme must recolour gui.surface:\n${baseonly}")
endif()
if(NOT "${baseonly}" MATCHES "tokens count=25 changed=1" OR NOT "${baseonly}" MATCHES "token changed=gui.surface")
  message(FATAL_ERROR "a base-only theme must change exactly gui.surface:\n${baseonly}")
endif()
# (2) A reference on a role line resolves to the base value, and a later base line still moves it.
file(WRITE "${WORK}/ref.theme" "gui.accent = @gui.base.grey_9\ngui.base.grey_9 = 0xABCDEF\n")
dui_run(ref ${base} --theme "${WORK}/ref.theme")
if(NOT "${ref}" MATCHES "pixel widget=play_button rgb=0xabcdef")
  message(FATAL_ERROR "gui.accent = @gui.base.grey_9 must resolve to 0xabcdef:\n${ref}")
endif()
# (3) A literal role line cuts the reference: the base layer no longer moves it.
file(WRITE "${WORK}/literal.theme" "gui.surface = 0x010203\ngui.base.grey_2 = 0x123456\n")
dui_run(literal ${base} --theme "${WORK}/literal.theme")
if(NOT "${literal}" MATCHES "pixel widget=panel rgb=0x010203")
  message(FATAL_ERROR "a literal role value must not follow the base layer:\n${literal}")
endif()
# (4) A cycle and a missing reference are refused and the error names the token.
file(WRITE "${WORK}/cycle.theme" "gui.base.grey_1 = @gui.base.grey_2\ngui.base.grey_2 = @gui.base.grey_1\n")
file(WRITE "${WORK}/missing-ref.theme" "gui.surface = @gui.base.nope\n")
foreach(case "cycle|gui.base.grey_2" "missing-ref|gui.base.nope")
  string(REPLACE "|" ";" parts "${case}")
  list(GET parts 0 file)
  list(GET parts 1 token)
  execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" ${base}
    --theme "${WORK}/${file}.theme" --exec STATUS RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(rc EQUAL 0)
    message(FATAL_ERROR "${file}.theme must make the desktop UI refuse to open")
  endif()
  if(NOT err MATCHES "'${token}'")
    message(FATAL_ERROR "the ${file}.theme error must name the token ${token}:\n${err}")
  endif()
endforeach()
# (5) A role whose resolved base value is outside the role's range is refused with its own message naming the role.
file(WRITE "${WORK}/range-ref.theme" "gui.radius = @gui.base.grey_9\n")
execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" ${base}
  --theme "${WORK}/range-ref.theme" --exec STATUS RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
if(rc EQUAL 0)
  message(FATAL_ERROR "range-ref.theme must make the desktop UI refuse to open")
endif()
if(NOT err MATCHES "token 'gui.radius' resolves to a value outside its range" OR err MATCHES "circular")
  message(FATAL_ERROR "an out-of-range base value needs its own message naming gui.radius:\n${err}")
endif()
