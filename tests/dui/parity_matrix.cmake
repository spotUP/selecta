# dui-parity-matrix (DUI-P1-8, M4-P2-5): the HippoPlayer and bbmp parity matrix parses; every row carries a DUI item
# ID or an exemption, and equals the same row of plan section 8.2; every ID named exists in the plan's checklist.
#   -DPLAN=<plan .md> -DMATRIX=<parity_matrix.tsv>
# mui-parity (MUI-P0-7) runs the same parse with -DMUIPLAN=<MUI plan .md>: the fourth column is the MUI column, a MUI
# plan ID (several allowed) or "not carried: <reason>"; "NO ROW" or an ID missing from the MUI plan fails the run.
# Rows keyed desk:* are the desktop surface inventory (thoughts/shared/research/2026-10-27-mui-parity-inventory.md)
# and are not in plan section 8.2.
function(read_lines var path)
  file(READ "${path}" all)
  string(REPLACE ";" "@SEMI@" all "${all}")
  string(REPLACE "[" "@LB@" all "${all}")
  string(REPLACE "]" "@RB@" all "${all}")
  string(REPLACE "\n" ";" all "${all}")
  set(${var} "${all}" PARENT_SCOPE)
endfunction()

read_lines(plan_lines "${PLAN}")
set(plan_ids "")
set(plan_rows "")
foreach(l IN LISTS plan_lines)
  if(l MATCHES "^- @LB@.@RB@ (DUI-P[0-9]+-[0-9]+) ")
    list(APPEND plan_ids "${CMAKE_MATCH_1}")
  elseif(l MATCHES "^\\| ((hippo|bbmp):[0-9]+) \\| (.*) \\| ([^|]*) \\| ([^|]*) \\|$")
    set(plan_item_${CMAKE_MATCH_1} "${CMAKE_MATCH_3}")
    set(plan_map_${CMAKE_MATCH_1} "${CMAKE_MATCH_5}")
    list(APPEND plan_rows "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(LENGTH plan_rows nplan)
list(LENGTH plan_ids nids)

set(mui_ids "")
if(DEFINED MUIPLAN)
  read_lines(mui_lines "${MUIPLAN}")
  foreach(l IN LISTS mui_lines)
    if(l MATCHES "^- @LB@.@RB@ (MUI-P[0-9]+-[0-9]+)[ :]")
      list(APPEND mui_ids "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(LENGTH mui_ids nmui)
  if(nmui EQUAL 0)
    message(FATAL_ERROR "no MUI-Px-y checklist items found in ${MUIPLAN}")
  endif()
endif()
set(mui_norow "")
set(mui_unknown "")

read_lines(m_lines "${MATRIX}")
set(seen "")
set(n82 0)
foreach(l IN LISTS m_lines)
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  string(REPLACE "\t" ";" f "${l}")
  list(LENGTH f nf)
  if(NOT nf EQUAL 4)
    message(FATAL_ERROR "matrix row must have 4 tab separated fields, has ${nf}: ${l}")
  endif()
  list(GET f 0 src)
  list(GET f 1 item)
  list(GET f 2 map)
  list(GET f 3 mui)
  if(src IN_LIST seen)
    message(FATAL_ERROR "duplicate matrix row ${src}")
  endif()
  list(APPEND seen "${src}")
  if(DEFINED MUIPLAN)
    if(mui STREQUAL "NO ROW")
      list(APPEND mui_norow "${src}")
    elseif(mui MATCHES "^not carried: .+")
      # an exemption with its reason
    else()
      string(REGEX MATCHALL "MUI-P[0-9]+-[0-9]+" named_mui "${mui}")
      if(NOT named_mui)
        message(FATAL_ERROR "matrix row ${src} has neither a MUI ID, NO ROW nor a not-carried reason: ${mui}")
      endif()
      foreach(id IN LISTS named_mui)
        if(NOT id IN_LIST mui_ids)
          list(APPEND mui_unknown "${src}:${id}")
        endif()
      endforeach()
    endif()
  endif()
  if(src MATCHES "^desk:")
    continue() # inventory rows are not in plan section 8.2
  endif()
  math(EXPR n82 "${n82} + 1")
  if(NOT src IN_LIST plan_rows)
    message(FATAL_ERROR "matrix row ${src} is not in plan section 8.2")
  endif()
  if(NOT "${item}" STREQUAL "${plan_item_${src}}" OR NOT "${map}" STREQUAL "${plan_map_${src}}")
    message(FATAL_ERROR "matrix row ${src} differs from the plan:\n  matrix: ${item} -> ${map}\n  plan:   ${plan_item_${src}} -> ${plan_map_${src}}")
  endif()
  # The desktop column is an exemption with a reason, names an ID, or is an M4 item marked (Amiga); every ID named exists in the checklist.
  if(map MATCHES "^not in this milestone.+")
    continue()
  endif()
  if(NOT map MATCHES "DUI-P[0-9]+-[0-9]+" AND NOT map MATCHES "^M4-P[0-9]+-[0-9]+ [(]Amiga[)]")
    message(FATAL_ERROR "matrix row ${src} has neither a DUI ID nor an exemption: ${map}")
  endif()
  string(REGEX MATCHALL "DUI-P[0-9]+-[0-9]+" named "${map}")
  foreach(id IN LISTS named)
    if(NOT id IN_LIST plan_ids)
      message(FATAL_ERROR "matrix row ${src} names ${id}, which is not a checklist item of the plan")
    endif()
  endforeach()
endforeach()
list(LENGTH seen nseen)
if(NOT n82 EQUAL nplan OR n82 EQUAL 0)
  message(FATAL_ERROR "matrix has ${n82} hippo and bbmp rows, plan section 8.2 has ${nplan}")
endif()
message(STATUS "parity matrix: ${nseen} rows, ${nids} checklist items")
if(DEFINED MUIPLAN)
  list(LENGTH mui_norow nno)
  list(LENGTH mui_unknown nunk)
  if(nno GREATER 0 OR nunk GREATER 0)
    string(REPLACE ";" "\n  " no_list "${mui_norow}")
    message(FATAL_ERROR "mui-parity RED: ${nno} of ${nseen} rows have NO ROW, ${nunk} name a MUI ID missing from the MUI plan (${mui_unknown})\nNO ROW:\n  ${no_list}")
  endif()
  message(STATUS "mui parity: all ${nseen} rows carry a MUI row or a reason")
endif()
