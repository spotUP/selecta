# dui-search-chip-wrap (I1224, supersedes I1073 dui-search-chip-scroll): the Search page source chips wrap onto several rows (the sidebar chip
# flow of I1221, one shared chip_flow_place) so none is clipped or hidden behind a chevron. One reachability test through the real shell
# (mem backend, scripted --input click on dump coordinates): -DSELECTA -DWORK -DNETWORK=<net fixture work dir>
#  1. at 1280 px the old single row overflowed: `online_chips rows` (sentinel that the wrap ran) is at least 2;
#  2. every `online_chip` rect has width > 0 and lies inside the main region, and the last chip is on a row below the first;
#  3. a click on the centre of the last chip (Modules.pl) picks it: `online scope=modulespl`.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${NETWORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "www.modules.pl=${fx},radio.modules.pl=${fx},fixture.test=${fx}")
set(ENV{SELECTA_CACHE_DIR} "${WORK}/cache")

function(cs_run outvar input)
  file(REMOVE "${WORK}/library.db")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --db "${WORK}/library.db" --ui desktop --backend mem --view search --canvas 1280x800 --clock fixed --stats --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

cs_run(a "wait 300\n")
if(NOT "${a}" MATCHES "online_chips rows=([0-9]+)\n" OR CMAKE_MATCH_1 LESS 2)
  message(FATAL_ERROR "at 1280 px the source chips must wrap onto at least 2 rows:\n${a}")
endif()
set(mx 0)
set(mend 1280) # the canvas width: no chip may leave the window
string(REGEX MATCHALL "online_chip [0-9]+ -?[0-9]+ -?[0-9]+ [0-9]+ [0-9]+ scope=[^\n]*" chips "${a}")
list(LENGTH chips nchips)
if(nchips LESS 3)
  message(FATAL_ERROR "expected the All, Library and source chips in the dump:\n${a}")
endif()
set(first_y "")
foreach(c IN LISTS chips)
  string(REGEX MATCH "online_chip [0-9]+ (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) scope=(.*)" m "${c}")
  set(x ${CMAKE_MATCH_1})
  set(y ${CMAKE_MATCH_2})
  set(w ${CMAKE_MATCH_3})
  math(EXPR e "${x} + ${w}")
  if(w EQUAL 0 OR x LESS mx OR e GREATER mend)
    message(FATAL_ERROR "chip is clipped or hidden (x=${x} w=${w}, main ${mx}..${mend}): ${c}")
  endif()
  if(first_y STREQUAL "")
    set(first_y ${y})
  endif()
  set(last_y ${y})
  set(lx ${x})
  set(lw ${w})
  set(lh ${CMAKE_MATCH_4})
  set(lscope "${CMAKE_MATCH_5}")
endforeach()
if(NOT last_y GREATER first_y)
  message(FATAL_ERROR "the last chip must sit on a row below the first (first y=${first_y}, last y=${last_y}):\n${a}")
endif()
math(EXPR cx "${lx} + ${lw} / 2")
math(EXPR cy "${last_y} + ${lh} / 2")
cs_run(c "wait 300\nmove ${cx} ${cy}\nclick ${cx} ${cy}\nwait 50\n")
if(NOT "${c}" MATCHES "online scope=${lscope} ")
  message(FATAL_ERROR "a click on the wrapped last chip must pick it (${lscope}):\n${c}")
endif()
