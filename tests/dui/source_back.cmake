# dui-source-back (I1286): Back and Forward walk the drill levels of a source page, through the real desktop UI entry. -DSELECTA -DWORK
# Johan 2026-11-10: "clicking the < button in the hero area takes me home not to the prior page", after Sources, a source, folder clicks in
# the main list. The folder levels of a source page (design doc 2026-10-22 section 9b) opened through drl_open_q, which pushed no history
# entry, so Back fell to the entry before the source: Home. Design doc 2026-10-29 section 9 (I678h): one history, every page open pushes.
# Seed: source "hvsc" with 20 Protracker songs (5 artists) and 20 Fasttracker 2 songs (10 artists): the root level has 4 rows, the formats level 2,
# the artists level of Fasttracker 2 (the first format, A-Z) 10 rows.
# Path: Home, the Sources chip, the source row (root level), the Formats row (formats level), the first format (artists level), then Back, Back, Back.
# 1. The three clicks push three entries: sentinel `pushes=2` on the drill line (formats and artists levels; the source row goes through desk_route).
# 2. Back 1: the formats level (page=2, rows=2, crumbs=2). Back 2: the root level (page=1, rows=4). Back 3: Home (no drill line, cur=home).
# 3. Forward after Back 2: the formats level again, Forward again: the artists level (rows=10, crumbs=3). Walking runs no push (pushes stays 2).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-source-back needs the sqlite3 command line tool to seed the library")
endif()
set(db "${WORK}/lib.db")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x1600)
dui_run(init ${common})
string(CONCAT seed
  "DROP TRIGGER IF EXISTS songs_ai; "
  "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 40) "
  "INSERT INTO songs(key, source, path, name, artist, album, format, added) "
  "SELECT 'hvsc:' || i, 'hvsc', '/h/' || i || '.mod', 'Song ' || i, "
  "CASE WHEN i <= 20 THEN 'Pro artist ' || (i % 5) ELSE 'Fast artist ' || (i % 10) END, '', "
  "CASE WHEN i <= 20 THEN 'Protracker' ELSE 'Fasttracker 2' END, 1 FROM n")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" "${seed}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "seeding the drill source failed: ${err}")
endif()
file(COPY_FILE "${db}" "${WORK}/base.db")
function(fresh)
  file(COPY_FILE "${WORK}/base.db" "${db}")
endfunction()
function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()
function(drill_field out dump field)
  if(NOT "${dump}" MATCHES "\ndrill ([^\n]* )?${field}=([^ \n]*)")
    message(FATAL_ERROR "no drill line with ${field} in:\n${dump}")
  endif()
  set(${out} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()
# The sentinel: history entries the drill levels pushed (the drillpush line).
function(route_pushes out dump)
  if(NOT "${dump}" MATCHES "\ndrillpush pushes=([0-9]+)\n")
    message(FATAL_ERROR "no drillpush line in:\n${dump}")
  endif()
  set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
# The first row name holds spaces ("[Fasttracker 2]"): match up to the closing bracket.
function(drill_first out dump)
  if(NOT "${dump}" MATCHES "\ndrill [^\n]* first=(\\[[^]\n]*\\])")
    message(FATAL_ERROR "no drill line with first in:\n${dump}")
  endif()
  set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
function(drill_center out dump name)
  if(NOT "${dump}" MATCHES "\ndrill [^\n]* ${name}=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)")
    message(FATAL_ERROR "no ${name} rectangle on the drill line in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(side_row out dump name)
  if(NOT "${dump}" MATCHES "sidelib_row [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=[01] open=[01] kind=7 ${name}\n")
    message(FATAL_ERROR "no sidebar row of kind 7 '${name}' in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(arrow_center out dump which) # which 0 = Back, 1 = Forward: the nav_arrows line holds the two rectangles
  if(NOT "${dump}" MATCHES "nav_arrows (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no nav_arrows line in:\n${dump}")
  endif()
  if(which EQUAL 0)
    math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
    math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
    set(w ${CMAKE_MATCH_3})
  else()
    math(EXPR cx "${CMAKE_MATCH_5} + ${CMAKE_MATCH_7} / 2")
    math(EXPR cy "${CMAKE_MATCH_6} + ${CMAKE_MATCH_8} / 2")
    set(w ${CMAKE_MATCH_7})
  endif()
  if(w EQUAL 0)
    message(FATAL_ERROR "the ${which} history arrow is not drawn in:\n${dump}")
  endif()
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(route_cur out dump)
  if(NOT "${dump}" MATCHES "route route_calls=[0-9]+ cur=([a-z:_]+) n=([0-9]+) pos=([0-9]+) ")
    message(FATAL_ERROR "no route line in:\n${dump}")
  endif()
  set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

# The Sources chip (index 4) narrows the list to the source rows; then the source row opens the source page at its root level.
file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(idle ${common} --input "${WORK}/idle.txt")
if(NOT "${idle}" MATCHES "sidechip 4 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no sidechip 4 in:\n${idle}")
endif()
math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(chip "click ${rx} ${ry}\nwait 300\n")
file(WRITE "${WORK}/chip.txt" "${chip}")
fresh()
dui_run(chipped ${common} --input "${WORK}/chip.txt")
side_row(src_xy "${chipped}" "HVSC")
file(WRITE "${WORK}/root.txt" "${chip}click ${src_xy}\nwait 100\n")
fresh()
dui_run(root ${common} --input "${WORK}/root.txt")
drill_field(pg "${root}" page)
expect_eq("the source page opens the root level" "${pg}" "1")
drill_center(row0 "${root}" row0)
set(open_root "${chip}click ${src_xy}\nwait 100\n")
set(open_fmt "${open_root}click ${row0}\nwait 100\n")
set(open_art "${open_fmt}click ${row0}\nwait 100\n")

# Step 1: the folder levels. Formats: 2 rows, A-Z so Fasttracker 2 first; its artists: 10 rows, 3 crumbs.
file(WRITE "${WORK}/fmt.txt" "${open_fmt}")
fresh()
dui_run(fmt ${common} --input "${WORK}/fmt.txt")
drill_field(rows "${fmt}" rows)
expect_eq("formats level rows" "${rows}" "2")
drill_first(first "${fmt}")
expect_eq("formats level first row" "${first}" "[Fasttracker 2]")
file(WRITE "${WORK}/art.txt" "${open_art}")
fresh()
dui_run(art ${common} --input "${WORK}/art.txt")
drill_field(rows "${art}" rows)
expect_eq("artists level rows" "${rows}" "10")
drill_field(cr "${art}" crumbs)
expect_eq("artists level crumbs (source, Formats, format)" "${cr}" "3")
route_pushes(pushes "${art}")
expect_eq("sentinel: two drill clicks pushed two history entries (I1286)" "${pushes}" "2")
arrow_center(back "${art}" 0)
route_cur(cur "${art}")
expect_eq("on the artists level the history is on the source page" "${cur}" "collection:source")

# Step 2: Back one level at a time.
file(WRITE "${WORK}/b1.txt" "${open_art}click ${back}\nwait 100\n")
fresh()
dui_run(b1 ${common} --input "${WORK}/b1.txt")
drill_field(pg "${b1}" page)
expect_eq("Back 1: still a drill page (I1286: it went Home)" "${pg}" "2")
drill_field(rows "${b1}" rows)
expect_eq("Back 1: the formats level rows" "${rows}" "2")
drill_field(cr "${b1}" crumbs)
expect_eq("Back 1: the formats level crumbs" "${cr}" "2")
drill_first(first "${b1}")
expect_eq("Back 1: the formats level first row" "${first}" "[Fasttracker 2]")
route_pushes(pushes "${b1}")
expect_eq("Back pushes no entry" "${pushes}" "2")

file(WRITE "${WORK}/b2.txt" "${open_art}click ${back}\nwait 100\nclick ${back}\nwait 100\n")
fresh()
dui_run(b2 ${common} --input "${WORK}/b2.txt")
drill_field(pg "${b2}" page)
expect_eq("Back 2: the root level" "${pg}" "1")
drill_field(rows "${b2}" rows)
expect_eq("Back 2: the root level rows" "${rows}" "4")
drill_first(first "${b2}")
expect_eq("Back 2: the root level first row" "${first}" "[Formats]")

file(WRITE "${WORK}/b3.txt" "${open_art}click ${back}\nwait 100\nclick ${back}\nwait 100\nclick ${back}\nwait 100\n")
fresh()
dui_run(b3 ${common} --input "${WORK}/b3.txt")
route_cur(cur "${b3}")
expect_eq("Back 3: Home" "${cur}" "home")

# Step 3: Forward after two Backs walks down again, one level per click, without a push.
arrow_center(fwd "${b2}" 1)
file(WRITE "${WORK}/f1.txt" "${open_art}click ${back}\nwait 100\nclick ${back}\nwait 100\nclick ${fwd}\nwait 100\n")
fresh()
dui_run(f1 ${common} --input "${WORK}/f1.txt")
drill_field(rows "${f1}" rows)
expect_eq("Forward 1: the formats level rows" "${rows}" "2")
drill_field(cr "${f1}" crumbs)
expect_eq("Forward 1: the formats level crumbs" "${cr}" "2")
file(WRITE "${WORK}/f2.txt" "${open_art}click ${back}\nwait 100\nclick ${back}\nwait 100\nclick ${fwd}\nwait 100\nclick ${fwd}\nwait 100\n")
fresh()
dui_run(f2 ${common} --input "${WORK}/f2.txt")
drill_field(rows "${f2}" rows)
expect_eq("Forward 2: the artists level rows" "${rows}" "10")
drill_field(cr "${f2}" crumbs)
expect_eq("Forward 2: the artists level crumbs" "${cr}" "3")
route_pushes(pushes "${f2}")
expect_eq("Back and Forward push no entry" "${pushes}" "2")
