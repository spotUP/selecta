# viz-krakatoa-reach (I1052, design thoughts/shared/research/2026-10-27-krakatoa-port-design.md section 2; finish line of
# the Smoke row). -DSELECTA -DWORK -DKRK_BUILT. Drives the real `selecta --ui desktop` entry point with the Krakatoa
# plugin picked through the ui.desktop.viz pref and the Visual Layout (C-4), then reads the plugin's VIZ_STATS line from
# the --stats dump:
#   steps > 0 (sentinel: krk_gpu_step ran and returned its Jacobi dispatch count), gpu 1,
#   quality high (SELECTA_KRK_QUALITY=high): Y 112, Z 76, X = round(112 * w / h / 4) * 4 (capped at 3 Y) of the surface,
#   jacobi 28 per step and jacobi_total = 28 * steps (every step dispatched all 28 Jacobi iterations).
if(NOT KRK_BUILT)
  message(STATUS "SELECTA_SKIP: viz_krakatoa not built (needs APPLE, -DSELECTA_UI_DESKTOP=ON, glslangValidator and spirv-cross)")
  return()
endif()
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/cfg")
file(WRITE "${WORK}/cfg/prefs.conf" "library.sync_stale_days=0\nui.desktop.viz=viz_krakatoa\n")
file(WRITE "${WORK}/in.txt" "wait 100\nkey ctrl+4\nwait 150\n")
set(ENV{SELECTA_KRK_QUALITY} high)
dui_run(o --db "${WORK}/k.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "OPEN ${HERE}/../m3/lyrics/ambient.mod" --ticks 12 --input "${WORK}/in.txt")

if(NOT "${o}" MATCHES "viz frames [0-9]+ song_ms [0-9]+ plugin ([a-z_]+) plugins ([0-9]+)")
  message(FATAL_ERROR "no viz sentinel in:\n${o}")
endif()
if(NOT CMAKE_MATCH_1 STREQUAL "viz_krakatoa" OR NOT CMAKE_MATCH_2 EQUAL 5)
  message(FATAL_ERROR "drawing plugin ${CMAKE_MATCH_1} of ${CMAKE_MATCH_2}, want viz_krakatoa of 5")
endif()
if(NOT "${o}" MATCHES "viz_stats viz_krakatoa krakatoa grid ([0-9]+)x([0-9]+)x([0-9]+) jacobi ([0-9]+) steps ([0-9]+) jacobi_total ([0-9]+) beats ([0-9]+) surface ([0-9]+)x([0-9]+) quality ([a-z]+) gpu ([01])")
  message(FATAL_ERROR "no viz_stats line for viz_krakatoa in:\n${o}")
endif()
set(gx ${CMAKE_MATCH_1})
set(gy ${CMAKE_MATCH_2})
set(gz ${CMAKE_MATCH_3})
set(jac ${CMAKE_MATCH_4})
set(steps ${CMAKE_MATCH_5})
set(jtot ${CMAKE_MATCH_6})
set(beats ${CMAKE_MATCH_7})
set(sw ${CMAKE_MATCH_8})
set(sh ${CMAKE_MATCH_9})
string(REGEX MATCH "quality ([a-z]+) gpu ([01])" _m "${o}") # CMake keeps only nine match groups
set(quality ${CMAKE_MATCH_1})
set(gpu ${CMAKE_MATCH_2})
set(line "grid ${gx}x${gy}x${gz} jacobi ${jac} steps ${steps} jacobi_total ${jtot} beats ${beats} surface ${sw}x${sh} quality ${quality} gpu ${gpu}")

if(NOT gpu EQUAL 1)
  message(FATAL_ERROR "the SDL GPU device or pipelines did not come up: ${line}")
endif()
if(steps EQUAL 0)
  message(FATAL_ERROR "the smoke step never ran: ${line}")
endif()
if(NOT quality STREQUAL "high" OR NOT gy EQUAL 112 OR NOT gz EQUAL 76 OR NOT jac EQUAL 28)
  message(FATAL_ERROR "high quality wants Y 112, Z 76, 28 Jacobi iterations: ${line}")
endif()
math(EXPR want_x "((112 * ${sw} + 2 * ${sh}) / (4 * ${sh})) * 4")
if(want_x GREATER 336)
  set(want_x 336)
endif()
if(NOT gx EQUAL want_x)
  message(FATAL_ERROR "grid X ${gx} for a ${sw}x${sh} surface, want ${want_x}: ${line}")
endif()
math(EXPR want_j "28 * ${steps}")
if(NOT jtot EQUAL want_j)
  message(FATAL_ERROR "jacobi_total ${jtot} over ${steps} steps, want ${want_j}: ${line}")
endif()
message(STATUS "viz-krakatoa-reach ok: ${line}")
