# Shared helpers of the frame-dump dui tests: read a PPM (the --frame-dump file) and compare a rectangle of two frames.
# Pixels of a PPM as one hex string with the width, so a rectangle can be cut out row by row.
function(ppm_load ppm outhex outw)
  file(READ "${ppm}" head LIMIT 14)
  if(NOT head MATCHES "^P6\n([0-9]+) ([0-9]+)\n")
    message(FATAL_ERROR "${ppm} has no P6 header")
  endif()
  set(w "${CMAKE_MATCH_1}")
  string(LENGTH "${CMAKE_MATCH_0}" hl)
  math(EXPR hl "${hl} + 4") # "255\n"
  file(READ "${ppm}" all HEX)
  math(EXPR skip "${hl} * 2")
  string(SUBSTRING "${all}" ${skip} -1 px)
  set(${outhex} "${px}" PARENT_SCOPE)
  set(${outw} "${w}" PARENT_SCOPE)
endfunction()

# 1 when the two frames differ anywhere inside the rectangle.
function(rect_differs hexa hexb w x y rw rh outvar)
  set(diff 0)
  set(row 0)
  while(row LESS rh)
    math(EXPR off "((${y} + ${row}) * ${w} + ${x}) * 6")
    math(EXPR len "${rw} * 6")
    string(SUBSTRING "${hexa}" ${off} ${len} ra)
    string(SUBSTRING "${hexb}" ${off} ${len} rb)
    if(NOT ra STREQUAL rb)
      set(diff 1)
      break()
    endif()
    math(EXPR row "${row} + 1")
  endwhile()
  set(${outvar} ${diff} PARENT_SCOPE)
endfunction()
