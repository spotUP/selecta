# dui-home-cover-shadow (I507): home cover has no dark ring at top edge. -DSELECTA -DWORK
# Johan, Mac: Home covers showed a black border. The cause was the tile shadow, drawn as a square ring around the rounded
# cover with no offset (darkest 1 px outside the edge). A flat one-colour cover is drawn on Home (frame dump); then
# 1. the pixels 1 px above the cover's top middle, left of its left middle and right of its right middle equal the card
#    fill exactly (no ring, no hairline at the sides);
# 2. the pixel just below the cover's bottom middle is darker than the card fill (the soft shadow is still there), but by
#    at most 3 levels: the second Mac check still saw a dark border, the shadow starting at its darkest value under the
#    cover edge (8 levels below the fill).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
include("${HERE}/ppm.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-home-cover-shadow needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
# Every album (the Unicode one had none) gets a cover; each becomes one flat 8x8 PNG of (240,200,60): nothing in the art can look like a ring.
set(flat "89504E470D0A1A0A0000000D49484452000000080000000808020000004B6D29DC0000001149444154789C63F870C2062B62185A120004A77D01143E47B20000000049454E44AE426082")
execute_process(COMMAND "${SQLITE3}" "${db}" "PRAGMA trusted_schema = 1; UPDATE artwork SET data = X'${flat}' WHERE kind = 'cover'; INSERT INTO artwork(album_id, kind, data) VALUES(4, 'cover', X'${flat}')"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "flat covers failed: ${err}")
endif()
set(execs "")
foreach(q 1.mod 2.mod 3.xm 4.it)
  list(APPEND execs --exec "QUEUE_ADD \"fixture/${q}\"")
endforeach()
dui_run(shot --db "${db}" --ui desktop --backend mem --view home --canvas 1920x1000 --clock fixed --stats ${execs}
  --frame-dump "${WORK}/home.ppm")
if(NOT "${shot}" MATCHES "\ntile_art corner=([0-9a-f]+) centre=([0-9a-f]+) fill=([0-9a-f]+)\ntile_art_rect (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
  message(FATAL_ERROR "no tile_art / tile_art_rect line (a Home cover was drawn) in:\n${shot}")
endif()
set(fill "${CMAKE_MATCH_3}")
set(ax ${CMAKE_MATCH_4})
set(ay ${CMAKE_MATCH_5})
set(aw ${CMAKE_MATCH_6})
set(ah ${CMAKE_MATCH_7})
ppm_load("${WORK}/home.ppm" hex w)

# Red, green, blue of the PPM pixel (x, y) as a list.
function(pixel outvar x y)
  math(EXPR off "(${y} * ${w} + ${x}) * 6")
  string(SUBSTRING "${hex}" ${off} 6 h)
  string(SUBSTRING "${h}" 0 2 r)
  string(SUBSTRING "${h}" 2 2 g)
  string(SUBSTRING "${h}" 4 2 b)
  math(EXPR r "0x${r}")
  math(EXPR g "0x${g}")
  math(EXPR b "0x${b}")
  set(${outvar} "${r};${g};${b}" PARENT_SCOPE)
endfunction()
string(SUBSTRING "${fill}" 0 2 fr)
string(SUBSTRING "${fill}" 2 2 fg)
string(SUBSTRING "${fill}" 4 2 fb)
math(EXPR fr "0x${fr}")
math(EXPR fg "0x${fg}")
math(EXPR fb "0x${fb}")

function(expect_near what x y tol)
  pixel(p ${x} ${y})
  list(GET p 0 r)
  list(GET p 1 g)
  list(GET p 2 b)
  foreach(pair "${r}:${fr}" "${g}:${fg}" "${b}:${fb}")
    string(REPLACE ":" ";" ab "${pair}")
    list(GET ab 0 got)
    list(GET ab 1 want)
    math(EXPR d "${got} - ${want}")
    if(d LESS -${tol} OR d GREATER ${tol})
      message(FATAL_ERROR "${what}: pixel (${x},${y}) is ${r},${g},${b}, card fill is ${fr},${fg},${fb} (dark ring)")
    endif()
  endforeach()
endfunction()

math(EXPR mx "${ax} + ${aw} / 2")
math(EXPR my "${ay} + ${ah} / 2")
math(EXPR above "${ay} - 1")
math(EXPR beside "${ax} - 1")
math(EXPR below "${ay} + ${ah}")
expect_near("1 px above the cover top middle" ${mx} ${above} 0)
expect_near("1 px left of the cover left middle" ${beside} ${my} 0)
math(EXPR beside "${ax} + ${aw}")
expect_near("1 px right of the cover right middle" ${beside} ${my} 0)
# I507 follow-up: the shadow starts faint under the cover; a step of more than 3 levels reads as a dark border.
expect_near("1 px below the cover bottom middle" ${mx} ${below} 3)
pixel(under ${mx} ${below})
list(GET under 0 ur)
if(NOT ur LESS ${fr})
  message(FATAL_ERROR "pixel just below the cover bottom (${mx},${below}) is ${under}, not darker than the card fill ${fr},${fg},${fb}: the shadow is gone")
endif()
