# dui-library-scroll-drag (I549): a held-button drag on the Library scrollbar follows the pointer while the button is
# held, and each drag frame repaints the list only.
# Entry point: the desktop UI's --input script through desk_route_input; the script line `move X Y X2 Y2` is the move event the
# window's input mapping builds while the primary button is held since X2 Y2. No release line follows, so only the
# held moves can scroll the list.
# Sentinels: "libheld presents N px_max M" (presents of held scrollbar moves, most pixels one repainted) and "libbar ... q16".
#   A: the held moves scroll the list to the track end before any release (q16 > 0, handle moved down).
#   B: one present per held move (N == number of moves), each below 40 percent of a full 640x256 frame (163840 pixels).
# The queue half (N mouse reports cost one frame, not N) is gui-input-map's coalesce check: the backends queue through it.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-library-scroll-drag needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-library-scroll-drag.sock")
function(scenario tag lines)
  file(REMOVE_RECURSE "${WORK}/cfg")
  # The Sources tab is the sixth tab (centre 581,64 at 640x512 with the canvas rows halved).
  file(WRITE "${WORK}/${tag}.txt" "click 581 46\nwait 300\n${lines}wait 300\n")
  dui_run(${tag} --db "${db}" --ui desktop --backend mem --view library --canvas 640x256 --ydiv 2
    --zoom fit --clock fixed --stats --resize 640x512 --input "${WORK}/${tag}.txt")
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
scenario(a "")
if(NOT a MATCHES "mode Sources\n")
  message(FATAL_ERROR "the Sources tab did not open:\n${a}")
endif()
if(NOT a MATCHES "libbar ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) handle")
  message(FATAL_ERROR "no Library scrollbar:\n${a}")
endif()
set(tx ${CMAKE_MATCH_1})
set(ty ${CMAKE_MATCH_2})
set(tw ${CMAKE_MATCH_3})
set(th ${CMAKE_MATCH_4})
math(EXPR cx "${tx} + ${tw} / 2")
math(EXPR top "(${ty} + 4) / 2")
math(EXPR bottom "(${ty} + ${th} - 4) / 2")
set(moves "")
set(n 0)
foreach(i RANGE 1 12)
  math(EXPR y "${top} + (${bottom} - ${top}) * ${i} / 12")
  string(APPEND moves "move ${cx} ${y} ${cx} ${top}\n")
  math(EXPR n "${n} + 1")
endforeach()
scenario(b "${moves}")
if(NOT b MATCHES "libbar [0-9]+ [0-9]+ [0-9]+ [0-9]+ handle [0-9]+ ([0-9]+) [0-9]+ [0-9]+ q16 (-?[0-9]+) draws")
  message(FATAL_ERROR "no scrollbar after the held moves:\n${b}")
endif()
if(NOT CMAKE_MATCH_2 GREATER 0)
  message(FATAL_ERROR "A: held moves without a release must scroll the list, q16 is ${CMAKE_MATCH_2}:\n${b}")
endif()
if(NOT b MATCHES "libheld presents ([0-9]+) px_max ([0-9]+)")
  message(FATAL_ERROR "no libheld line:\n${b}")
endif()
if(NOT CMAKE_MATCH_1 EQUAL n)
  message(FATAL_ERROR "B: ${n} held moves must give ${n} presents, got ${CMAKE_MATCH_1}")
endif()
if(NOT CMAKE_MATCH_2 LESS 65536)
  message(FATAL_ERROR "B: a held-drag frame repainted ${CMAKE_MATCH_2} pixels, the bound is 65536 (a full frame is 163840)")
endif()
