# dui-widgets (DUI-P3-1): the widget gallery through the product entry point. -DSELECTA -DWORK -DGOLDEN
#   --view widgets    every widget kind of include/selecta/gui/gui_widget.h drawn once
#   --stats           prints one `widget_kind name=<k> draws=<n>` line per kind
# For the dark defaults and the light preset (tests/golden/desktop/light.theme):
# 1. every kind in the enum drew at least once, and the number of kind lines equals the enum size (the enum is read
#    from the header, not typed here), so a kind added without a gallery cell fails;
# 2. no missing glyph, primitives ran, the frame dump is a valid PPM;
# 3. pixel probes of the I233 defects: the dialog button has a label, the scrim dims the whole canvas, the split pane
#    has titles, the Favourites row draws the heart icon, the tile artwork stays dark under the on-accent icon;
# 4. the canvas hash matches the golden (update only with SELECTA_GOLDEN_UPDATE=1), and the two themes differ.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")

file(READ "${HERE}/../../include/selecta/gui/gui_widget.h" header)
string(REGEX MATCHALL "\n    X\\([A-Z_]+, \"" kind_lines "${header}")
list(LENGTH kind_lines kind_n)
if(kind_n LESS 20)
  message(FATAL_ERROR "found only ${kind_n} widget kinds in gui_widget.h")
endif()

# Raw pixels of the frame dump: the hex of w pixels of row y from column x, and the number of distinct colours of a box.
function(ppm_row out file x y w)
  math(EXPR off "15 + (${y} * 1280 + ${x}) * 3")
  math(EXPR len "${w} * 3")
  file(READ "${file}" hex OFFSET ${off} LIMIT ${len} HEX)
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()
function(ppm_distinct out file x y w h)
  set(all "")
  math(EXPR y1 "${y} + ${h} - 1")
  foreach(row RANGE ${y} ${y1})
    ppm_row(hex "${file}" ${x} ${row} ${w})
    string(REGEX MATCHALL "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]" px "${hex}")
    list(APPEND all ${px})
  endforeach()
  list(REMOVE_DUPLICATES all)
  list(LENGTH all n)
  set(${out} ${n} PARENT_SCOPE)
endfunction()
function(ppm_box_md5 out file x y w h)
  set(all "")
  math(EXPR y1 "${y} + ${h} - 1")
  foreach(row RANGE ${y} ${y1})
    ppm_row(hex "${file}" ${x} ${row} ${w})
    string(APPEND all "${hex}")
  endforeach()
  string(MD5 m "${all}")
  set(${out} ${m} PARENT_SCOPE)
endfunction()
set(heart_md5_dark dd6fa69ec85bcfac04dec6da73053a0a)
set(heart_md5_light b8816f3494674bc1212a5845caf71966)

set(common --ui desktop --backend mem --view widgets --canvas 1280x800 --clock fixed --stats)
set(hashes "")
foreach(theme dark light)
  set(args ${common} --frame-dump "${WORK}/${theme}.ppm")
  if(theme STREQUAL "light")
    list(APPEND args --theme "${GOLDEN}/desktop/light.theme")
  endif()
  dui_run(out ${args})
  string(REGEX MATCHALL "widget_kind name=[a-z_0-9]+ draws=[0-9]+" lines "${out}")
  list(LENGTH lines line_n)
  if(NOT line_n EQUAL kind_n)
    message(FATAL_ERROR "${theme}: ${line_n} widget_kind lines, the enum has ${kind_n} kinds\n${out}")
  endif()
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "name=([a-z_0-9]+) draws=([0-9]+)" OR CMAKE_MATCH_2 EQUAL 0)
      message(FATAL_ERROR "${theme}: widget kind never drawn: ${line}")
    endif()
  endforeach()
  dui_stat(missing "${out}" desktop missing_glyphs)
  dui_stat(prims "${out}" desktop draw_prims)
  dui_stat(hash "${out}" desktop canvas_hash)
  if(NOT missing EQUAL 0 OR prims EQUAL 0)
    message(FATAL_ERROR "${theme}: missing_glyphs=${missing} draw_prims=${prims}")
  endif()
  set(gfile "${GOLDEN}/desktop/widgets-${theme}-rgba32-1280x800@1.hash")
  if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
    file(WRITE "${gfile}" "${hash}\n")
  endif()
  if(NOT EXISTS "${gfile}")
    message(FATAL_ERROR "missing golden ${gfile} (hash ${hash}); create it with SELECTA_GOLDEN_UPDATE=1")
  endif()
  file(STRINGS "${gfile}" want LIMIT_COUNT 1)
  if(NOT hash STREQUAL want)
    message(FATAL_ERROR "${theme} gallery hash ${hash} differs from golden ${want} (${gfile})")
  endif()
  file(READ "${WORK}/${theme}.ppm" head LIMIT 16)
  if(NOT head STREQUAL "P6\n1280 800\n255\n")
    message(FATAL_ERROR "${theme}: frame dump header is not 'P6 1280 800 255'")
  endif()
  list(APPEND hashes ${hash})
  set(ppm "${WORK}/${theme}.ppm")
  # (a) the dialog's confirm button (x 660, y 435, 96x36) draws a label: its inside is not one flat colour
  ppm_distinct(n "${ppm}" 668 440 80 24)
  if(n LESS 3)
    message(FATAL_ERROR "${theme}: the dialog confirm button draws no label (${n} colours inside)")
  endif()
  # (b) the scrim dims the whole canvas: black at 60 percent leaves every channel of any colour at 102 or less, at all
  #     four corners (the theme backgrounds are 0x12 and 0xF4)
  foreach(corner "2;2" "1277;2" "2;797" "1277;797")
    list(GET corner 0 cx)
    list(GET corner 1 cy)
    ppm_row(hex "${ppm}" ${cx} ${cy} 1)
    string(SUBSTRING "${hex}" 0 2 c0)
    string(SUBSTRING "${hex}" 2 2 c1)
    string(SUBSTRING "${hex}" 4 2 c2)
    foreach(c ${c0} ${c1} ${c2})
      math(EXPR v "0x${c}")
      if(v GREATER 102)
        message(FATAL_ERROR "${theme}: canvas corner (${cx},${cy}) is ${hex}, the scrim does not cover the canvas")
      endif()
    endforeach()
  endforeach()
  # (c) the split pane shows its titles: the strip inside the left pane is not one flat colour
  ppm_distinct(n "${ppm}" 30 556 100 20)
  if(n LESS 3)
    message(FATAL_ERROR "${theme}: the split pane draws no title (${n} colours in its title strip)")
  endif()
  # (d) the Favourites sidebar row (fourth row, icon box x 338 y 358, 24x24) is the heart icon, pinned by pixels
  ppm_box_md5(m "${ppm}" 338 358 24 24)
  if(NOT m STREQUAL heart_md5_${theme})
    message(FATAL_ERROR "${theme}: the Favourites row icon is not the heart (box md5 ${m})")
  endif()
  # (e) tile artwork stays dark and saturated under the dim, also in the light theme (it faded to the near white
  #     surface tokens before): the artwork bottom at (1000,150) has no channel above 70
  ppm_row(hex "${ppm}" 1000 150 1)
  foreach(o 0 2 4)
    string(SUBSTRING "${hex}" ${o} 2 c)
    math(EXPR v "0x${c}")
    if(v GREATER 70)
      message(FATAL_ERROR "${theme}: tile artwork bottom is ${hex}, it fades towards the surface")
    endif()
  endforeach()
endforeach()
list(GET hashes 0 h0)
list(GET hashes 1 h1)
if(h0 STREQUAL h1)
  message(FATAL_ERROR "the light theme drew the same frame as the dark one")
endif()
