# dui-hover-regions (DUI-P3-8): hover repaint covers every region that holds a control. -DSELECTA -DSONGS -DWORK -DSDL_BUILT
# hover_repaint used to repaint the sidebar, the main region and the player footer only: a control in the Now Playing panel
# (detail) or a history arrow never faded, and every hover move repainted the sidebar whatever the pointer touched. A live
# run (SELECTA_SDL_TEST_LIVE=1) without any pointer event gives the rest frame and the rectangles (`hover_ctl`: one control
# per region, `hover_regions`: the four region rectangles); a live run per control pushes one motion onto its centre at
# 300 ms and quits at 900 ms, long after the 100 ms fade. Two things must hold for each of the five controls (sidebar
# door, Home tile, transport Play button, Now Playing like heart, back arrow):
#   1. the frame dump (PPM at close) differs from the rest frame inside the control rectangle;
#   2. the stats line `hover_dirty=N` (the most pixels one present repainted while the hover fade ran) is at most the area
#      of the region that holds the control, so no other region was repainted for it.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
file(MAKE_DIRECTORY "${WORK}/cfg")
# A queue entry gives the Home page its tile; no PLAY, so the clock and the visualizer stay still.
function(live_run outvar timed ppm)
  file(REMOVE_RECURSE "${WORK}/cfg")
  set(ENV{SELECTA_SDL_TEST_TIMED} "${timed}")
  execute_process(
    COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" --ui desktop --backend sdl --view home
            --canvas 1280x800 --stats --frame-dump "${ppm}" --exec "QUEUE_ADD ${SONGS}/selecta-test.mod"
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "selecta exited ${rc}\nstdout:\n${out}\nstderr:\n${err}")
  endif()
  set(${outvar} "${out}" PARENT_SCOPE)
endfunction()

live_run(rest "q@900" "${WORK}/rest.ppm")
set(rect "(-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)")
# CMAKE_MATCH_n stops at 9, so cut each line out first and match one rectangle per name.
string(REGEX MATCH "hover_ctl [^\n]*" ctl_line "${rest}")
string(REGEX MATCH "hover_regions [^\n]*" reg_line "${rest}")
if(ctl_line STREQUAL "" OR reg_line STREQUAL "")
  message(FATAL_ERROR "no hover_ctl or hover_regions line in:\n${rest}")
endif()
foreach(n sidebar main player detail nav)
  if(NOT ctl_line MATCHES " ${n} ${rect}( |$)")
    message(FATAL_ERROR "no '${n}' rectangle in '${ctl_line}'")
  endif()
  set(ctl_${n} "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
endforeach()
foreach(n sidebar main detail player)
  if(NOT reg_line MATCHES " ${n} ${rect}( |$)")
    message(FATAL_ERROR "no '${n}' rectangle in '${reg_line}'")
  endif()
  set(reg_${n} "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
  math(EXPR area_${n} "${CMAKE_MATCH_3} * ${CMAKE_MATCH_4}")
endforeach()
set(names sidebar main player detail nav)
# The region that holds each control; the history arrows belong to the main region.
set(region_of_sidebar sidebar)
set(region_of_main main)
set(region_of_player player)
set(region_of_detail detail)
set(region_of_nav main)

# Pixels of a PPM as one hex string with the width, so a rectangle can be cut out row by row.
function(ppm_load ppm outhex outw)
  file(READ "${ppm}" head LIMIT 14)
  if(NOT head MATCHES "^P6\n([0-9]+) ([0-9]+)\n")
    message(FATAL_ERROR "${ppm} has no P6 header")
  endif()
  set(w "${CMAKE_MATCH_1}")
  string(LENGTH "${CMAKE_MATCH_0}" hl)
  math(EXPR hl "${hl} + 4") # "255\n"
  file(READ "${ppm}" all HEX)
  math(EXPR skip "${hl} * 2")
  string(SUBSTRING "${all}" ${skip} -1 px)
  set(${outhex} "${px}" PARENT_SCOPE)
  set(${outw} "${w}" PARENT_SCOPE)
endfunction()

# 1 when the two frames differ anywhere inside the rectangle.
function(rect_differs hexa hexb w x y rw rh outvar)
  set(diff 0)
  set(row 0)
  while(row LESS rh)
    math(EXPR off "((${y} + ${row}) * ${w} + ${x}) * 6")
    math(EXPR len "${rw} * 6")
    string(SUBSTRING "${hexa}" ${off} ${len} ra)
    string(SUBSTRING "${hexb}" ${off} ${len} rb)
    if(NOT ra STREQUAL rb)
      set(diff 1)
      break()
    endif()
    math(EXPR row "${row} + 1")
  endwhile()
  set(${outvar} ${diff} PARENT_SCOPE)
endfunction()

ppm_load("${WORK}/rest.ppm" resthex w)
foreach(n ${names})
  string(REPLACE " " ";" r "${ctl_${n}}")
  list(GET r 0 cx0)
  list(GET r 1 cy0)
  list(GET r 2 cw)
  list(GET r 3 ch)
  if(cw LESS 1 OR ch LESS 1)
    message(FATAL_ERROR "control '${n}' has no rectangle (${ctl_${n}}) at rest")
  endif()
  math(EXPR px "${cx0} + ${cw} / 2")
  math(EXPR py "${cy0} + ${ch} / 2")
  live_run(moved "m${px},${py}@300 q@900" "${WORK}/${n}.ppm")
  ppm_load("${WORK}/${n}.ppm" movedhex mw)
  rect_differs("${resthex}" "${movedhex}" ${w} ${cx0} ${cy0} ${cw} ${ch} differs)
  if(NOT differs)
    message(FATAL_ERROR "${n}: a move onto (${px},${py}) left every pixel of the control '${ctl_${n}}' unchanged after the fade")
  endif()
  if(NOT "${moved}" MATCHES "hover_dirty=([0-9]+) ")
    message(FATAL_ERROR "${n}: no hover_dirty line in:\n${moved}")
  endif()
  set(dirty "${CMAKE_MATCH_1}")
  set(area "${area_${region_of_${n}}}")
  if(dirty EQUAL 0)
    message(FATAL_ERROR "${n}: no frame was presented while the hover fade ran (hover_dirty=0)")
  endif()
  if(dirty GREATER area)
    message(FATAL_ERROR "${n}: the hover fade repainted ${dirty} pixels, more than the ${region_of_${n}} region (${reg_${region_of_${n}}}, ${area} pixels)")
  endif()
  message(STATUS "${n}: pixels changed, hover_dirty=${dirty} <= ${area}")
endforeach()
