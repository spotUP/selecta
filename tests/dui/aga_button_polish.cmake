# dui-aga-button-polish (I588): the transport buttons on the AGA canvas, through the real binary. -DSELECTA -DWORK
#   --canvas 640x256 --ydiv 2 --format index8 --zoom fit (what the aga backend opens), home view, layout 640x512.
# 1. (a) The prev glyph is mirror symmetric top to bottom: it is built from the exact baked size by a 2:1 row merge, not
#    resampled from the next larger size with 12:5 weights.
# 2. (b) Its ink is centred in the button: equal margins left and right, equal rows above and below.
# 3. (c) The round play button edge carries in-between shades on INDEX8 (a blended corner pixel): in its top rows some
#    pixel is neither the ground nor the fill.
# Sentinel: the layout line names the buttons and the frame dump is the AGA size, so the checks read the drawn glyphs.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
include("${HERE}/ppm.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
dui_run(o --ui desktop --backend mem --view home --canvas 640x256 --ydiv 2 --format index8 --zoom fit --clock fixed
  --stats --resize 640x512 --frame-dump "${WORK}/aga.ppm")
foreach(id prev play)
  if(NOT o MATCHES "button id=${id} x=([0-9]+) y=([0-9]+) w=([0-9]+) h=([0-9]+)")
    message(FATAL_ERROR "no ${id} button line:\n${o}")
  endif()
  set(${id}_x ${CMAKE_MATCH_1})
  math(EXPR ${id}_y "${CMAKE_MATCH_2} / 2") # layout rows to canvas rows
  set(${id}_w ${CMAKE_MATCH_3})
  math(EXPR ${id}_h "${CMAKE_MATCH_4} / 2")
endforeach()
ppm_load("${WORK}/aga.ppm" hex w)
if(NOT w EQUAL 640)
  message(FATAL_ERROR "the frame dump is ${w} wide, not the 640 of the AGA canvas")
endif()
function(px out x y)
  math(EXPR off "(${y} * ${w} + ${x}) * 6")
  string(SUBSTRING "${hex}" ${off} 6 v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Ink rows of the prev glyph: the rows of the button where a pixel differs from the ground beside the button.
px(ground ${prev_x} ${prev_y})
set(counts "")
set(top -1)
set(bot -1)
set(left 9999)
set(right -1)
math(EXPR y_end "${prev_y} + ${prev_h} - 1")
math(EXPR x_end "${prev_x} + ${prev_w} - 1")
foreach(y RANGE ${prev_y} ${y_end})
  set(sig "")
  set(n 0)
  foreach(x RANGE ${prev_x} ${x_end})
    px(c ${x} ${y})
    string(APPEND sig "${c}")
    if(NOT c STREQUAL ground)
      math(EXPR n "${n} + 1")
      if(top LESS 0)
        set(top ${y})
      endif()
      set(bot ${y})
      if(x LESS left)
        set(left ${x})
      endif()
      if(x GREATER right)
        set(right ${x})
      endif()
    endif()
  endforeach()
  set(row_${y} "${sig}")
  if(n GREATER 0)
    list(APPEND counts ${n})
  endif()
endforeach()
if(top LESS 0)
  message(FATAL_ERROR "no prev glyph ink in the button (${prev_x},${prev_y} ${prev_w}x${prev_h})")
endif()
# 1. symmetric
set(lo ${top})
set(hi ${bot})
while(lo LESS hi)
  if(NOT row_${lo} STREQUAL row_${hi})
    message(FATAL_ERROR "(a) the prev glyph is not symmetric top to bottom: rows ${lo} and ${hi} differ")
  endif()
  math(EXPR lo "${lo} + 1")
  math(EXPR hi "${hi} - 1")
endwhile()
# 1b. the exact 20 px bake merged 2:1: pinned ink pixels per row (the old resample from the 24 px bake gave
#     10 13 13 11 11 13 13 10, a blurred arrow tip)
if(NOT counts STREQUAL "8;13;12;10;10;12;13;8")
  message(FATAL_ERROR "(a) the prev glyph is not the exact bake, ink per row: ${counts}")
endif()
# 2. centred: whole rows above and below, columns within one
math(EXPR above "${top} - ${prev_y}")
math(EXPR below "${y_end} - ${bot}")
math(EXPR lm "${left} - ${prev_x}")
math(EXPR rm "${x_end} - ${right}")
if(NOT above EQUAL below)
  message(FATAL_ERROR "(b) the prev glyph has ${above} rows above and ${below} below")
endif()
math(EXPR dm "${lm} - ${rm}")
if(dm LESS 0 OR dm GREATER 0)
  message(FATAL_ERROR "(b) the prev glyph has ${lm} columns left and ${rm} right")
endif()

# 3. the play circle edge: in its top four rows, count pixels that are neither the ground nor the solid fill
px(ground ${play_x} ${play_y})
math(EXPR cx "${play_x} + ${play_w} / 2")
px(fill ${cx} ${play_y})
math(EXPR rim_end "${play_y} + 3")
math(EXPR px_end "${play_x} + ${play_w} - 1")
set(shades 0)
foreach(y RANGE ${play_y} ${rim_end})
  foreach(x RANGE ${play_x} ${px_end})
    px(c ${x} ${y})
    if(NOT c STREQUAL ground AND NOT c STREQUAL fill)
      math(EXPR shades "${shades} + 1")
    endif()
  endforeach()
endforeach()
if(shades LESS 4)
  message(FATAL_ERROR "(c) the play button edge has ${shades} blended pixels, the INDEX8 corner is thresholded")
endif()
message(STATUS "prev ink rows ${top}..${bot} cols ${left}..${right}, play edge shades ${shades}")
