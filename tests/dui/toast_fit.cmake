# dui-toast-fit (I1046): the toast box sizes to its text and wraps past the cap, so the sync error Johan could not read fits.
# Entry point: the desktop UI's source page Sync button (src_sync_send), the testsrc source failing like a source without network
# (SELECTA_TESTSRC_FAIL), the engine's ERROR sync_failed, the UI's "Cannot sync <source>: the source could not be fetched" toast.
# -DSELECTA -DWORK -DSDL_BUILT. The sentinel is `toasts=N` on the overlay line (the toast ran) plus the toast_text line.
# The dump line `toast on= rect x y w h lines= textw= lineh=` comes from the same function the draw uses (toast_layout):
#   one line: the box is at least the measured text width plus the 16 px side padding wide (no clip),
#   several lines: the box is as high as its lines (lines * lineh plus the 12 px top and bottom padding) and inside the canvas.
# 1280 px canvas: the whole message fits one line. 900 px canvas: the cap is 320 px, so the message wraps.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-toast-fit needs the sqlite3 command line tool to seed the library")
endif()
set(ENV{SELECTA_TESTSRC_FAIL} 1)
set(db "${WORK}/lib.db")
function(side_row out dump name)
  if(NOT "${dump}" MATCHES "sidelib_row [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=[01] open=[01] kind=7 ${name}\n")
    message(FATAL_ERROR "no sidebar row of kind 7 '${name}' in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(toast_case tag canvas)
  file(REMOVE_RECURSE "${WORK}/cfg" "${db}")
  set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas ${canvas})
  dui_run(init ${common})
  file(WRITE "${WORK}/idle.txt" "wait 100\n")
  dui_run(idle ${common} --input "${WORK}/idle.txt")
  if(NOT "${idle}" MATCHES "sidechev L [0-9]+ [0-9]+ [0-9]+ [0-9]+ R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidechev in:\n${idle}")
  endif()
  math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(chip "")
  foreach(k RANGE 1 5)
    string(APPEND chip "click ${rx} ${ry}\nwait 300\n")
  endforeach()
  file(WRITE "${WORK}/chip.txt" "${chip}")
  dui_run(chipped ${common} --input "${WORK}/chip.txt")
  side_row(src_xy "${chipped}" "@TESTSRC_NAME@")
  file(WRITE "${WORK}/page.txt" "${chip}click ${src_xy}\nwait 300\n")
  dui_run(page ${common} --input "${WORK}/page.txt")
  if(NOT "${page}" MATCHES "kindhead [^\n]* sync=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+) ")
    message(FATAL_ERROR "no sync rectangle on the kindhead line:\n${page}")
  endif()
  math(EXPR sx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR sy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  if(CMAKE_MATCH_3 EQUAL 0)
    message(FATAL_ERROR "the source page has no Sync button (sync rect empty):\n${page}")
  endif()
  file(WRITE "${WORK}/sync.txt" "${chip}click ${src_xy}\nwait 300\nclick ${sx} ${sy}\nwait 300\n")
  dui_run(synced ${common} --input "${WORK}/sync.txt")
  set(${tag} "${synced}" PARENT_SCOPE)
endfunction()

toast_case(wide "1280x1600")
if(NOT wide MATCHES "toast_text Cannot sync [^\n]*: the source could not be fetched\n")
  message(FATAL_ERROR "the failed Sync did not raise the sync_failed toast:\n${wide}")
endif()
if(NOT wide MATCHES "\ntoast on=1 rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) lines=([0-9]+) textw=([0-9]+) lineh=([0-9]+)\n")
  message(FATAL_ERROR "no toast line in the dump:\n${wide}")
endif()
math(EXPR need "${CMAKE_MATCH_6} + 32")
if(NOT CMAKE_MATCH_5 EQUAL 1 OR CMAKE_MATCH_3 LESS ${need})
  message(FATAL_ERROR "wide canvas: the toast box (w=${CMAKE_MATCH_3} lines=${CMAKE_MATCH_5}) does not cover the text (${CMAKE_MATCH_6} px + 32 padding):\n${wide}")
endif()

toast_case(narrow "900x1600")
if(NOT narrow MATCHES "toast_text Cannot sync [^\n]*: the source could not be fetched\n")
  message(FATAL_ERROR "narrow: no sync_failed toast:\n${narrow}")
endif()
if(NOT narrow MATCHES "\ntoast on=1 rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) lines=([0-9]+) textw=([0-9]+) lineh=([0-9]+)\n")
  message(FATAL_ERROR "narrow: no toast line in the dump:\n${narrow}")
endif()
set(nx ${CMAKE_MATCH_1})
set(nw ${CMAKE_MATCH_3})
set(nh ${CMAKE_MATCH_4})
set(nl ${CMAKE_MATCH_5})
math(EXPR need "${CMAKE_MATCH_6} + 32")
if(nl EQUAL 1)
  if(nw LESS ${need})
    message(FATAL_ERROR "narrow: one line but the box (${nw}) is narrower than the text plus padding (${need})")
  endif()
else()
  math(EXPR needh "${nl} * ${CMAKE_MATCH_7} + 24")
  if(nh LESS ${needh} OR nx LESS 0 OR nw GREATER 900)
    message(FATAL_ERROR "narrow: wrapped to ${nl} lines but the box ${nw}x${nh} at x=${nx} cannot hold them (needs ${needh} high, inside 900 wide)")
  endif()
endif()
if(NOT nl GREATER 1)
  message(FATAL_ERROR "narrow canvas: the long message should wrap past the 320 px cap, got ${nl} line(s)")
endif()
