# dui-collection-titles-touch (I1198): a collection page whose library changes only touch (Recents on the page open, a play count, a playlist
# created elsewhere) keeps its resolved titles and never starves the briefs read. -DSELECTA -DSONGS -DWORK
# Violated invariant: the page's song set is its identity. desk_library_invalidate marked the page stale on every library_serial change;
# every pls_reload_run reset the titles to file names, bumped pls_ver and re-posted the briefs read, and pls_briefs_follow drops an answer whose
# brf_ver != pls_ver, so a stream of invalidates while the read was in flight (SELECTA_LIB_BRIEFS_SLOW_MS) left the rows on file names.
# Path: the sidebar alpha row click (the real entry), then library writes with no wait between them, then a wait. Asserts:
# 1. sentinel: library_reloads >= 3 (the invalidates really ran) and briefs_async takes >= 1;
# 2. the rows end on the catalogue titles (Main Theme;Intro;Bass Line), not the file names;
# 3. briefs_async posts == 1: the unchanged song set did not re-post the read (before the fix every reload posted again).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-collection-titles-touch needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" "UPDATE songs SET key = 'local:' || path WHERE key LIKE 'fixture:%'"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "rekeying the fixture failed: ${err}")
endif()
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x800)
dui_run(seed ${common}
  --exec "PLAYLIST_CREATE alpha" --exec "PLAYLIST_ADD_SONG 1 fixture/2.mod" --exec "PLAYLIST_ADD_SONG 1 fixture/1.mod" --exec "PLAYLIST_ADD_SONG 1 fixture/5.sid")
file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(idle ${common} --input "${WORK}/idle.txt")
if(NOT "${idle}" MATCHES "sidelib_row [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=[01] open=[01] kind=[0-9]+ alpha\n")
  message(FATAL_ERROR "no alpha sidebar row in:\n${idle}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(script "click ${cx} ${cy}\n")
foreach(n 1 2 3 4 5 6)
  string(APPEND script "exec PLAYLIST_CREATE touch${n}\n")
endforeach()
string(APPEND script "wait 100\n")
file(WRITE "${WORK}/run.txt" "${script}")
set(ENV{SELECTA_LIB_BRIEFS_SLOW_MS} 200)
dui_run(o ${common} --input "${WORK}/run.txt")
unset(ENV{SELECTA_LIB_BRIEFS_SLOW_MS})
if(NOT "${o}" MATCHES "library_serial=[0-9]+ library_reloads=([0-9]+) ")
  message(FATAL_ERROR "no library_reloads in:\n${o}")
endif()
set(reloads ${CMAKE_MATCH_1})
if(NOT "${o}" MATCHES "briefs_async posts=([0-9]+) takes=([0-9]+) ")
  message(FATAL_ERROR "no briefs_async line in:\n${o}")
endif()
set(posts ${CMAKE_MATCH_1})
set(takes ${CMAKE_MATCH_2})
message(STATUS "reloads=${reloads} briefs posts=${posts} takes=${takes}")
if(reloads LESS 3 OR takes LESS 1)
  message(FATAL_ERROR "sentinel: reloads=${reloads} takes=${takes}: the invalidates or the briefs read did not run:\n${o}")
endif()
string(REGEX MATCHALL "plsong [0-9]+ [0-9]+ [0-9]+ [0-9]+ [0-9]+ file=[^ \n]* title=[^\n]*" lines "${o}")
set(titles "")
foreach(l IN LISTS lines)
  string(REGEX MATCH "title=(.*)" m "${l}")
  list(APPEND titles "${CMAKE_MATCH_1}")
endforeach()
if(NOT "${titles}" STREQUAL "Main Theme;Intro;Bass Line")
  message(FATAL_ERROR "the page ended on '${titles}', expected the catalogue titles:\n${o}")
endif()
if(NOT posts EQUAL 1)
  message(FATAL_ERROR "the briefs read was posted ${posts} times for one unchanged song set (want 1)")
endif()
