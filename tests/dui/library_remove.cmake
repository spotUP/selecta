# dui-library-remove (DUI-P4-18, I313): Remove from Library and Clear Library.
#   -DSELECTA -DSONGS -DWORK
#   Violated invariant: the catalogue can only grow. The song menu gets Remove from Library (item 5, not on queue rows) and the
#   Library page gets Clear Library; each opens a confirm dialog and only Confirm sends the engine command LIBRARY_REMOVE or
#   LIBRARY_CLEAR (the UI writes nothing to the database itself).
#   Three songs are scanned. Cancel keeps 3. Confirm on the second song drops the count to 2 and the file stays on disk. Clear
#   with a queued song, a playlist and thumbnail rows: songs 0, playlists 0 (dialog names the count), ratings and notes gone, settings kept, queue 0, thumbnail rows 0.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
find_program(SQLITE3 sqlite3 REQUIRED)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/songs")
foreach(n a b c)
  file(COPY_FILE "${SONGS}/selecta-test.mod" "${WORK}/songs/${n}.mod")
endforeach()
set(db "${WORK}/library.db")

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got ${got}, want ${want}")
  endif()
endfunction()

function(sql outvar query)
  execute_process(COMMAND "${SQLITE3}" "${db}" "${query}" OUTPUT_VARIABLE r ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "sqlite3 failed: ${e}")
  endif()
  string(STRIP "${r}" r)
  set(${outvar} "${r}" PARENT_SCOPE)
endfunction()

function(run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --db "${db}" --ui desktop --backend mem --view library --canvas 900x600 --clock fixed --stats --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

# Centre of the rectangle named `key` (cancel, confirm, clear) on the dialog sentinel line.
function(centre xv yv out key)
  if(NOT "${out}" MATCHES "dialog [^\n]*${key}=([0-9]+),([0-9]+),([0-9]+),([0-9]+)")
    message(FATAL_ERROR "no dialog ${key} in:\n${out}")
  endif()
  math(EXPR x "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR y "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${xv} ${x} PARENT_SCOPE)
  set(${yv} ${y} PARENT_SCOPE)
endfunction()

function(field outvar out line name)
  if(NOT "${out}" MATCHES "${line} [^\n]*${name}=([0-9]+)")
    message(FATAL_ERROR "no ${line} ${name} in:\n${out}")
  endif()
  set(${outvar} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

set(scan "wait 1\nexec LIBRARY_SCAN ${WORK}/songs\nwait 4\n")
run(list "${scan}")
sql(n "SELECT COUNT(*) FROM songs")
expect_eq("scanned songs" "${n}" 3)
field(shown "${list}" dialog songs)
expect_eq("engine state library_songs" "${shown}" 3)

# Row 0 of the library list is the Composers entry; drill in so the three songs show (as dui-song-menu does).
if(NOT "${list}" MATCHES "row 0 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no row rectangle in the library dump:\n${list}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + 10")
math(EXPR cy "${CMAKE_MATCH_2} + 8")
set(drill "${scan}move ${cx} ${cy}\nclick ${cx} ${cy}\nwait 1\n")
run(drilled "${drill}")
if(NOT "${drilled}" MATCHES "row 0 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)\n")
  message(FATAL_ERROR "no row rectangle in the drilldown dump:\n${drilled}")
endif()
math(EXPR sx "${CMAKE_MATCH_1} + 20")
math(EXPR sy "${CMAKE_MATCH_2} + 2 * ${CMAKE_MATCH_4} + ${CMAKE_MATCH_4} / 2")
math(EXPR rx "${sx} + 10")
math(EXPR ry "${sy} + 4 * 24 + 12")
set(menu "${drill}move ${sx} ${sy}\nrclick ${sx} ${sy}\nclick ${rx} ${ry}\nwait 1\n")

# The menu has the fifth item and picking it opens the dialog (nothing is sent yet).
run(asked "${menu}")
field(dopen "${asked}" dialog open)
field(dsongs "${asked}" dialog songs)
expect_eq("dialog open after Remove from Library" "${dopen}" 1)
expect_eq("nothing removed before Confirm" "${dsongs}" 3)
sql(n "SELECT COUNT(*) FROM songs")
expect_eq("songs before Confirm" "${n}" 3)

# Cancel keeps the library.
centre(kx ky "${asked}" cancel)
run(cancelled "${menu}move ${kx} ${ky}\nclick ${kx} ${ky}\nwait 1\n")
field(cancels "${cancelled}" dialog cancels)
expect_eq("cancels" "${cancels}" 1)
sql(n "SELECT COUNT(*) FROM songs")
expect_eq("songs after Cancel" "${n}" 3)

# Confirm removes one song; the audio files stay.
centre(ox oy "${asked}" confirm)
run(removed "${menu}move ${ox} ${oy}\nclick ${ox} ${oy}\nwait 2\n")
field(confirms "${removed}" dialog confirms)
expect_eq("confirms" "${confirms}" 1)
sql(n "SELECT COUNT(*) FROM songs")
expect_eq("songs after Confirm" "${n}" 2)
foreach(f a b c)
  if(NOT EXISTS "${WORK}/songs/${f}.mod")
    message(FATAL_ERROR "audio file ${f}.mod was deleted")
  endif()
endforeach()

# Clear Library: set up a playlist and thumbnail rows, queue one song, confirm.
sql(ignore "INSERT INTO playlists(id, name) VALUES(1, 'keep'); INSERT INTO playlist_entries(playlist_id, pos, key) VALUES(1, 0, 'x:1'); INSERT INTO albums(id, name) VALUES(901, 'Thumb Album'); INSERT INTO artwork(album_id, kind, data) VALUES(901, 'thumb256', X'00'), (901, 'cover', X'00')")
sql(t "SELECT COUNT(*) FROM artwork WHERE kind LIKE 'thumb%'")
expect_eq("thumbnail rows before" "${t}" 1)
sql(ignore "INSERT INTO playlists(id, name) VALUES(2, 'second'); INSERT INTO ratings(key, rating) VALUES('x:1', 5); INSERT INTO notes(key, note) VALUES('x:1', 'n'); INSERT INTO meta(key, value) VALUES('keepme', '1') ON CONFLICT(key) DO UPDATE SET value = '1'")
set(queue "wait 1\nexec QUEUE_ADD ${WORK}/songs/a.mod\nwait 1\n")
run(queued "${queue}")
field(q0 "${queued}" overlay queue)
expect_eq("queue before Clear" "${q0}" 1)
if(NOT "${queued}" MATCHES "dialog [^\n]*clear=([0-9]+),([0-9]+),([0-9]+),([0-9]+)")
  message(FATAL_ERROR "no clear button rectangle in:\n${queued}")
endif()
centre(lx ly "${queued}" clear)
run(asked2 "${queue}move ${lx} ${ly}\nclick ${lx} ${ly}\nwait 1\n")
field(open2 "${asked2}" dialog open)
expect_eq("Clear Library dialog open (kind 2)" "${open2}" 2)
field(dpl "${asked2}" dialog playlists)
expect_eq("dialog names the playlist count" "${dpl}" 2)
sql(n "SELECT COUNT(*) FROM songs")
expect_eq("songs before Clear Confirm" "${n}" 2)
centre(ox oy "${asked2}" confirm)
run(cleared "${queue}move ${lx} ${ly}\nclick ${lx} ${ly}\nmove ${ox} ${oy}\nclick ${ox} ${oy}\nwait 2\n")
sql(n "SELECT COUNT(*) FROM songs")
expect_eq("songs after Clear" "${n}" 0)
sql(n "SELECT COUNT(*) FROM playlists")
expect_eq("playlists after Clear" "${n}" 0)
sql(n "SELECT COUNT(*) FROM playlist_entries")
expect_eq("playlist entries after Clear" "${n}" 0)
sql(n "SELECT COUNT(*) FROM ratings")
expect_eq("ratings after Clear" "${n}" 0)
sql(n "SELECT COUNT(*) FROM notes")
expect_eq("notes after Clear" "${n}" 0)
sql(n "SELECT value FROM meta WHERE key = 'keepme'")
expect_eq("settings kept after Clear" "${n}" 1)
foreach(f a b c)
  if(NOT EXISTS "${WORK}/songs/${f}.mod")
    message(FATAL_ERROR "audio file ${f}.mod was deleted by Clear")
  endif()
endforeach()
sql(n "SELECT COUNT(*) FROM artwork WHERE kind LIKE 'thumb%'")
expect_eq("thumbnail rows after Clear" "${n}" 0)
field(q1 "${cleared}" overlay queue)
expect_eq("queue after Clear" "${q1}" 0)
field(s1 "${cleared}" dialog songs)
expect_eq("engine state library_songs after Clear" "${s1}" 0)
