# dui-bar-nowplaying (I960d, Mac half): a click on the player bar's cover art or song title opens the Now Playing page.
# Driven through the desktop UI's real live SDL loop (SELECTA_SDL_TEST_LIVE, timed mouse events) on the Home page, 1280x800 so the bar's
# left block is shown. A first run (mem backend) reads the cover rect from the `bar_np art X Y W H` dump line. Asserts:
# 1. no click: bar_np clicks=0 and page=other (the Home page, not Now Playing);
# 2. a left click in the cover centre: clicks=1 (the sentinel, the new path ran) and page=nowplaying;
# 3. a click at the title box (right of the cover) does the same.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
dui_require_sdl()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-bar-nowplaying needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}")
if(NOT "${init}" MATCHES "bar_np art (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)")
  message(FATAL_ERROR "no bar_np line in:\n${init}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
math(EXPR tx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} + 40")
if(CMAKE_MATCH_3 EQUAL 0)
  message(FATAL_ERROR "the bar's left block is not shown at 1280x800")
endif()
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_home_shelves.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "${WORK}/dui-bar-nowplaying.sock")

function(live tag timed)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(MAKE_DIRECTORY "${WORK}/cfg")
  file(WRITE "${WORK}/cfg/prefs.conf" "library.sync_stale_days=0\n")
  set(ENV{SELECTA_SDL_TEST_TIMED} "${timed}")
  execute_process(COMMAND "${SELECTA}" --config-dir "${WORK}/cfg" --db "${db}" --ui desktop --backend sdl --view home --canvas 1280x800 --clock fixed --stats
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: selecta exited ${rc}\nstdout:\n${o}\nstderr:\n${e}")
  endif()
  if(NOT "${o}" MATCHES "bar_np art [-0-9 ]+ clicks=([0-9]+) page=([a-z]+)")
    message(FATAL_ERROR "${tag}: no bar_np line in:\n${o}")
  endif()
  set(${tag}_clicks ${CMAKE_MATCH_1} PARENT_SCOPE)
  set(${tag}_page ${CMAKE_MATCH_2} PARENT_SCOPE)
endfunction()

live(none "q@3500")
live(art "m${cx},${cy}@1500 d1,${cx},${cy}@2000 u1,${cx},${cy}@2100 q@3500")
live(title "m${tx},${cy}@1500 d1,${tx},${cy}@2000 u1,${tx},${cy}@2100 q@3500")
message(STATUS "none clicks=${none_clicks} page=${none_page}; art clicks=${art_clicks} page=${art_page}; title clicks=${title_clicks} page=${title_page}")
if(NOT none_clicks EQUAL 0 OR NOT none_page STREQUAL "other")
  message(FATAL_ERROR "no click: clicks=${none_clicks} page=${none_page}, want 0 and other")
endif()
if(NOT art_clicks EQUAL 1 OR NOT art_page STREQUAL "nowplaying")
  message(FATAL_ERROR "a click on the bar cover must open Now Playing: clicks=${art_clicks} page=${art_page}")
endif()
if(NOT title_clicks EQUAL 1 OR NOT title_page STREQUAL "nowplaying")
  message(FATAL_ERROR "a click on the bar title must open Now Playing: clicks=${title_clicks} page=${title_page}")
endif()
