# dui-library-sources (I265): the Library page Sources tab, generic over the engine's SOURCES rows.
# -DSELECTA -DWORK -DGOLDEN -DSDL_BUILT. The tab is reached by a real click on the tab row (SELECTA_SDL_TEST_LIVE=1 makes
# the SDL dummy driver a live display, SELECTA_SDL_TEST_TIMED pushes the mouse tokens); the rectangles come from the stats
# dump ("tab 5 x y w h", "sourcetoggle i x y w h"). The sentinels are the "sources N draws M" line (the Sources painter ran)
# and the "source i key|kind|name|enabled|count" lines, which print what the engine's SOURCES reply said.
#   run A: click the Sources tab -> one row per registered source (9, the last a test-only plugin, none named in the UI), local holds the fixture songs,
#          every source enabled, the painter ran, a golden hash of the page.
#   run B: click the Sources tab, then the switch of row 1 -> the engine's SOURCES reply reports that source disabled (the
#          pref library.sources_off was stored and read back) while the others stay enabled.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-library-sources needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-library-sources.sock")
function(click_run tag tokens)
  file(REMOVE_RECURSE "${WORK}/cfg")
  set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens}")
  dui_run(${tag} --db "${db}" --ui desktop --backend sdl --view library --canvas 1280x800 --clock fixed --stats)
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
function(click_tokens out x y t)
  math(EXPR t1 "${t} + 100")
  math(EXPR t2 "${t} + 150")
  set(${out} "m${x},${y}@${t} d1,${x},${y}@${t1} u1,${x},${y}@${t2}" PARENT_SCOPE)
endfunction()

# The tab rectangle, from a run that clicks nothing.
click_run(o0 "q@600")
string(REGEX MATCH "tab 5 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _t "${o0}")
if(_t STREQUAL "")
  message(FATAL_ERROR "no tab 5 line in the stats:\n${o0}")
endif()
math(EXPR tx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ty "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
if(NOT o0 MATCHES "mode Composers\n")
  message(FATAL_ERROR "the Library page does not start on Composers:\n${o0}")
endif()
click_tokens(tab_click ${tx} ${ty} 400)

# Run A: open the tab.
click_run(a "${tab_click} q@1500")
if(NOT a MATCHES "mode Sources\n")
  message(FATAL_ERROR "run A: the Sources tab did not open:\n${a}")
endif()
string(REGEX MATCH "sources ([0-9]+) draws ([0-9]+)\n" _s "${a}")
if(_s STREQUAL "" OR NOT CMAKE_MATCH_2 GREATER 0)
  message(FATAL_ERROR "run A: the Sources painter did not run:\n${a}")
endif()
set(n_src "${CMAKE_MATCH_1}")
set(want_keys local modland hvsc hippo asma sndh keygenmusic zxart testsrc)
list(LENGTH want_keys want_n)
if(NOT n_src EQUAL want_n)
  message(FATAL_ERROR "run A: ${n_src} source rows, expected one per registered source (${want_n}):\n${a}")
endif()
set(i 0)
foreach(k ${want_keys})
  if(NOT a MATCHES "source ${i} ${k}\\|(local|remote)\\|[^|]+\\|1\\|[0-9]+\n")
    message(FATAL_ERROR "run A: row ${i} is not the enabled source '${k}' with a name, kind and count:\n${a}")
  endif()
  math(EXPR i "${i} + 1")
endforeach()
if(NOT a MATCHES "source 0 local\\|local\\|[^|]+\\|1\\|[1-9][0-9]*\n")
  message(FATAL_ERROR "run A: the local source counts no songs although the library holds the fixture:\n${a}")
endif()
dui_stat(hash "${a}" desktop canvas_hash)
set(gfile "${GOLDEN}/desktop/library-sources-rgba32-1280x800@1.hash")
if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
  file(WRITE "${gfile}" "${hash}\n")
endif()
if(NOT EXISTS "${gfile}")
  message(FATAL_ERROR "missing golden ${gfile} (hash ${hash}); create it with SELECTA_GOLDEN_UPDATE=1")
endif()
file(STRINGS "${gfile}" want LIMIT_COUNT 1)
if(NOT hash STREQUAL want)
  message(FATAL_ERROR "Sources page hash ${hash} differs from golden ${want} (${gfile})")
endif()

# Run B: click the switch of row 1.
string(REGEX MATCH "sourcetoggle 1 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n" _g "${a}")
if(_g STREQUAL "")
  message(FATAL_ERROR "run A: no sourcetoggle 1 line:\n${a}")
endif()
math(EXPR gx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR gy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
click_tokens(tg_click ${gx} ${gy} 800)
click_run(b "${tab_click} ${tg_click} q@1800")
if(NOT b MATCHES "source 1 modland\\|remote\\|[^|]+\\|0\\|[0-9]+\n")
  message(FATAL_ERROR "run B: the switch did not turn modland off in the engine's SOURCES reply:\n${b}")
endif()
foreach(k local hvsc hippo asma sndh keygenmusic zxart testsrc)
  if(NOT b MATCHES "source [0-9] ${k}\\|[a-z]+\\|[^|]+\\|1\\|")
    message(FATAL_ERROR "run B: source '${k}' should stay enabled:\n${b}")
  endif()
endforeach()
