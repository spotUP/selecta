# dui-tooltips (DUI-P3-6): tooltips on the transport buttons, through the real shell and the scripted --input feeder.
#   -DSELECTA -DSONGS -DWORK
# Text rule: the action's tooltip field (its label when the tooltip is empty), then its default key in brackets in the
# Spotify way: C- is Ctrl+, M- is Alt+, S- is Shift+, a single letter is upper case ("Skip to the next track (N)").
# The buttons come from the layout output (`button id=` lines of --resize) and the expected text from the action table
# (`--actions`) with the rule above written again here, so neither a count nor a text is hardcoded.
# 1. move onto a button + wait 600 shows a tooltip with exactly the expected text (the stat is the sentinel that the
#    tooltip code ran: tooltips=1 and the text stat).
# 2. move + wait 300 shows none.
# 3. move + wait 600 + move away hides it (text empty, tooltips stays 1).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

dui_run(table --ui desktop --backend mem --actions)
dui_run(lay --ui desktop --backend mem --canvas 1280x800 --resize 1280x800)

function(expected_text id outvar)
  string(REPLACE "\n" ";" lines "${table}")
  foreach(line IN LISTS lines)
    if(line MATCHES "^action id=${id} label=(.*) icon=[^ ]* menu=.* key=([^ ]+) line=.* tooltip=(.*)$")
      set(body "${CMAKE_MATCH_3}")
      if(body STREQUAL "")
        set(body "${CMAKE_MATCH_1}")
      endif()
      set(spec "${CMAKE_MATCH_2}")
      set(keytext "")
      if(NOT spec STREQUAL "-")
        while(spec MATCHES "^([CMS])-(.+)$")
          if(CMAKE_MATCH_1 STREQUAL "C")
            string(APPEND keytext "Ctrl+")
          elseif(CMAKE_MATCH_1 STREQUAL "M")
            string(APPEND keytext "Alt+")
          else()
            string(APPEND keytext "Shift+")
          endif()
          set(spec "${CMAKE_MATCH_2}")
        endwhile()
        if(spec MATCHES "^[a-z]$")
          string(TOUPPER "${spec}" spec)
        endif()
        set(body "${body} (${keytext}${spec})")
      endif()
      set(${outvar} "${body}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "no action ${id} in:\n${table}")
endfunction()

function(tip_run outvar input)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/in.txt" "${input}")
  dui_run(o --ui desktop --backend mem --canvas 1280x800 --clock fixed --stats --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

function(check out count text what)
  dui_stat(got "${out}" desktop tooltips)
  if(NOT got EQUAL count)
    message(FATAL_ERROR "${what}: tooltips=${got}, expected ${count} in:\n${out}")
  endif()
  if(NOT "${out}" MATCHES "ui_tooltip id=desktop text=([^\n]*)")
    message(FATAL_ERROR "${what}: no ui_tooltip line in:\n${out}")
  endif()
  if(NOT "${CMAKE_MATCH_1}" STREQUAL "${text}")
    message(FATAL_ERROR "${what}: tooltip text '${CMAKE_MATCH_1}', expected '${text}'")
  endif()
endfunction()

string(REPLACE "\n" ";" laylines "${lay}")
set(buttons 0)
foreach(line IN LISTS laylines)
  if(line MATCHES "^button id=([a-z_]+) x=(-?[0-9]+) y=(-?[0-9]+) w=([0-9]+) h=([0-9]+)$")
    set(id "${CMAKE_MATCH_1}")
    math(EXPR cx "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
    math(EXPR cy "${CMAKE_MATCH_3} + ${CMAKE_MATCH_5} / 2")
    math(EXPR buttons "${buttons} + 1")
    expected_text(${id} want)
    tip_run(shown "move ${cx} ${cy}\nwait 600\n")
    check("${shown}" 1 "${want}" "${id} after 600 ms")
    tip_run(early "move ${cx} ${cy}\nwait 300\n")
    check("${early}" 0 "" "${id} after 300 ms")
    tip_run(gone "move ${cx} ${cy}\nwait 600\nmove 5 5\n")
    check("${gone}" 1 "" "${id} after moving away")
  endif()
endforeach()
if(buttons LESS 1)
  message(FATAL_ERROR "the layout output lists no transport button:\n${lay}")
endif()
message(STATUS "dui-tooltips: ${buttons} transport buttons checked")

# I363: the icon-only rail (canvas under 900 wide) has no labels, so resting on a door shows the door's full label.
# Door 2 is "Your Library" and door 4 "Queue"; a wide canvas draws the labels and shows no tooltip.
function(door_tip_run outvar canvas door)
  file(REMOVE_RECURSE "${WORK}/cfg")
  dui_run(rects --ui desktop --backend mem --view songs --canvas ${canvas} --clock fixed --stats)
  if(NOT "${rects}" MATCHES "door ${door} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
    message(FATAL_ERROR "no 'door ${door}' rectangle in:\n${rects}")
  endif()
  math(EXPR dx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR dy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  file(WRITE "${WORK}/in.txt" "move ${dx} ${dy}\nwait 600\n")
  dui_run(o --ui desktop --backend mem --view songs --canvas ${canvas} --clock fixed --stats --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()
door_tip_run(lib 800x600 2)
check("${lib}" 1 "Your Library" "rail door 2")
door_tip_run(que 800x600 4)
check("${que}" 1 "Queue" "rail door 4")
door_tip_run(wide 1280x800 4)
dui_stat(wide_n "${wide}" desktop tooltips)
if(NOT wide_n EQUAL 0)
  message(FATAL_ERROR "a labelled sidebar showed a door tooltip: tooltips=${wide_n}")
endif()
