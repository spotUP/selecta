# dui-sidebar-mixed (I678b): the sidebar draws the mixed Your Library list with three pinned rows, through the real desktop UI entry.
#   -DSELECTA -DSONGS -DWORK
# Fixture fixture_sidebar_mixed.sql: 2 playlists, 3 albums, 3 artists, 3 composers, 1 source, so 3 pinned + 12 = 15 items.
# The dump prints `sidelib ... items=<n> opens=<n> ... item_calls=<n>`, `sidelib_row <i> x y w h pinned=<0|1> open=<0|1> kind=<k> <name>` per
# drawn row and `sidelib_open kind=<k> row=<i>` once a non-playlist row is open.
# 1. Sentinel: the list came from the engine item query (item_calls >= 1); 15 items; the first three rows are the pinned Liked
#    Songs, Recently Played and Local Files; every other row is unpinned and the kinds run playlist, album, artist, composer, source.
# 2. A click on the first album row opens exactly that row: opens=1, one row marked open, kind 4.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sidebar-mixed needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x1400 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_sidebar_mixed.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()
function(row_of out idx)
  if(NOT "${out}" MATCHES "sidelib_row ${idx} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=([01]) open=([01]) kind=([0-9]+) ([^\n]*)")
    message(FATAL_ERROR "no sidelib_row ${idx} in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(row_xy "${cx} ${cy}" PARENT_SCOPE)
  set(row_pinned "${CMAKE_MATCH_5}" PARENT_SCOPE)
  set(row_kind "${CMAKE_MATCH_7}" PARENT_SCOPE)
  set(row_name "${CMAKE_MATCH_8}" PARENT_SCOPE)
endfunction()

file(WRITE "${WORK}/idle.txt" "wait 100\n")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x1400)
dui_run(m1 ${common} --input "${WORK}/idle.txt")
if(NOT "${m1}" MATCHES "sidelib draws=([0-9]+) rows=([0-9]+) items=([0-9]+) opens=([0-9]+) y=-?[0-9]+ max=-?[0-9]+ item_calls=([0-9]+)")
  message(FATAL_ERROR "no sidelib line in:\n${m1}")
endif()
if(CMAKE_MATCH_5 LESS 1)
  message(FATAL_ERROR "the sidebar list never reached the engine item query (item_calls=${CMAKE_MATCH_5})")
endif()
expect_eq("items" "${CMAKE_MATCH_3}" "15")
expect_eq("rows drawn" "${CMAKE_MATCH_2}" "15")
set(want_names "Liked Songs;Recently Played;Local Files")
set(want_kinds "0;1;2;3;3;4;4;4;5;5;5;6;6;6;7")
foreach(i RANGE 0 14)
  row_of("${m1}" ${i})
  list(GET want_kinds ${i} k)
  expect_eq("kind of row ${i}" "${row_kind}" "${k}")
  if(i LESS 3)
    list(GET want_names ${i} nm)
    expect_eq("name of pinned row ${i}" "${row_name}" "${nm}")
    expect_eq("row ${i} pinned" "${row_pinned}" "1")
  else()
    expect_eq("row ${i} unpinned" "${row_pinned}" "0")
  endif()
endforeach()

# 2. Click the first album row (index 5).
row_of("${m1}" 5)
file(WRITE "${WORK}/click.txt" "click ${row_xy}\nwait 100\n")
dui_run(m2 ${common} --input "${WORK}/click.txt")
if(NOT "${m2}" MATCHES "sidelib draws=[0-9]+ rows=[0-9]+ items=[0-9]+ opens=([0-9]+) ")
  message(FATAL_ERROR "no sidelib line in:\n${m2}")
endif()
expect_eq("opens after the album click" "${CMAKE_MATCH_1}" "1")
if(NOT "${m2}" MATCHES "sidelib_open kind=4 row=5")
  message(FATAL_ERROR "the album row was not marked open in:\n${m2}")
endif()
string(REGEX MATCHALL "sidelib_row [0-9]+ [0-9]+ [0-9]+ [0-9]+ [0-9]+ pinned=[01] open=1 " open_rows "${m2}")
list(LENGTH open_rows n_open)
expect_eq("exactly one open row" "${n_open}" "1")
