# dui-hidpi (DUI-P2-8): integer pixel scale. -DSELECTA -DSONGS -DWORK -DGOLDEN
#   --scale S         the pixel scale of the canvas; layout and sizes are logical, drawn S times as large
#   scale N           input directive: the window moved to a screen of another scale
# 1. Opening at scale 2 on a 2560x1600 canvas matches the 2x golden and rebuilds nothing (atlas_rebuilds 0).
# 2. Opening at scale 1 and a scripted `scale 2` (twice) rebuilds the text atlases once and the icon atlas once
#    (the same scale again is not a change), builds the atlases again at the new pixel size, and ends on the same
#    frame hash as the direct 2x run: the rebuilt text is crisp, not an upscaled 1x bitmap.
# 3. The 2x frame differs from the 1x frame of the same canvas; scale 3 renders without a missing glyph; a scale
#    outside 1 to 3 is refused.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")

file(STRINGS "${HERE}/fixture_library.sql" album_lines REGEX "^INSERT INTO albums")
set(execs "")
foreach(line IN LISTS album_lines)
  # No regex here: CMake regex does not match non-ASCII bytes inside a bracket class.
  string(FIND "${line}" "VALUES(" at)
  if(NOT at EQUAL -1)
    string(SUBSTRING "${line}" ${at} -1 rest)
    string(FIND "${rest}" "'" q1)
    math(EXPR from "${q1} + 1")
    string(SUBSTRING "${rest}" ${from} -1 rest)
    string(FIND "${rest}" "'" q2)
    string(SUBSTRING "${rest}" 0 ${q2} title)
    list(APPEND execs --exec "QUEUE_ADD \"fixture/${title}.mod\"")
  endif()
endforeach()
list(LENGTH execs exec_n)
if(exec_n LESS 8)
  message(FATAL_ERROR "expected at least 4 fixture albums, found ${exec_n} exec arguments")
endif()
set(common --ui desktop --backend mem --view home --clock fixed --stats ${execs})
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/scale.txt" "scale 2\nscale 2\n")

dui_run(direct ${common} --canvas 2560x1600 --scale 2 --frame-dump "${WORK}/home2x.ppm")
dui_stat(hash2 "${direct}" desktop canvas_hash)
dui_stat(scale_d "${direct}" desktop scale)
dui_stat(arb_d "${direct}" desktop atlas_rebuilds)
dui_stat(irb_d "${direct}" desktop icon_rebuilds)
dui_stat(builds_d "${direct}" desktop atlas_builds)
dui_stat(missing_d "${direct}" desktop missing_glyphs)
if(NOT scale_d EQUAL 2 OR NOT arb_d EQUAL 0 OR NOT irb_d EQUAL 0 OR NOT missing_d EQUAL 0)
  message(FATAL_ERROR "direct 2x: scale=${scale_d} atlas_rebuilds=${arb_d} icon_rebuilds=${irb_d} missing=${missing_d}")
endif()

dui_run(step ${common} --canvas 2560x1600 --scale 1 --input "${WORK}/scale.txt" --frame-dump "${WORK}/home1to2.ppm")
dui_stat(hash_s "${step}" desktop canvas_hash)
dui_stat(scale_s "${step}" desktop scale)
dui_stat(arb_s "${step}" desktop atlas_rebuilds)
dui_stat(irb_s "${step}" desktop icon_rebuilds)
dui_stat(builds_s "${step}" desktop atlas_builds)
if(NOT scale_s EQUAL 2)
  message(FATAL_ERROR "after the scripted change the scale is ${scale_s}, not 2")
endif()
if(NOT arb_s EQUAL 1 OR NOT irb_s EQUAL 1)
  message(FATAL_ERROR "1 to 2 must rebuild the atlases once: atlas_rebuilds=${arb_s} icon_rebuilds=${irb_s} (sentinel)")
endif()
if(builds_s LESS_EQUAL builds_d)
  message(FATAL_ERROR "atlases were not built again at the new size: ${builds_s} builds, direct 2x ${builds_d}")
endif()
if(NOT hash_s STREQUAL hash2)
  message(FATAL_ERROR "1 to 2 frame hash ${hash_s} differs from the direct 2x hash ${hash2}")
endif()

set(gfile "${GOLDEN}/desktop/home-rgba32-2560x1600@2.hash")
if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
  file(WRITE "${gfile}" "${hash2}\n")
endif()
if(NOT EXISTS "${gfile}")
  message(FATAL_ERROR "missing golden ${gfile} (hash ${hash2}); create it with SELECTA_GOLDEN_UPDATE=1")
endif()
file(STRINGS "${gfile}" want LIMIT_COUNT 1)
if(NOT hash2 STREQUAL want)
  message(FATAL_ERROR "2x home hash ${hash2} differs from golden ${want} (${gfile})")
endif()
file(READ "${WORK}/home2x.ppm" head LIMIT 17)
if(NOT head STREQUAL "P6\n2560 1600\n255\n")
  message(FATAL_ERROR "frame dump header is not 'P6 2560 1600 255'")
endif()

dui_run(one ${common} --canvas 2560x1600 --scale 1)
dui_stat(hash1 "${one}" desktop canvas_hash)
if(hash1 STREQUAL hash2)
  message(FATAL_ERROR "scale 1 and scale 2 painted the same frame")
endif()

# I449: the "Recently played" heading keeps a gap of at least the spacing token above the first tile's shadow, at 1x and 2x.
foreach(pair "1:one" "2:direct")
  string(REPLACE ":" ";" pair "${pair}")
  list(GET pair 0 sc)
  list(GET pair 1 var)
  if(NOT "${${var}}" MATCHES "home head bottom (-?[0-9]+) shadow top (-?[0-9]+) token ([0-9]+)")
    message(FATAL_ERROR "no 'home head' line in the ${sc}x output")
  endif()
  math(EXPR hgap "${CMAKE_MATCH_2} - ${CMAKE_MATCH_1}")
  if(hgap LESS CMAKE_MATCH_3)
    message(FATAL_ERROR "scale ${sc}: the section heading ends at ${CMAKE_MATCH_1} and the tile shadow starts at ${CMAKE_MATCH_2}: gap ${hgap} px, want at least the spacing token ${CMAKE_MATCH_3} px (I449)")
  endif()
endforeach()

dui_run(three ${common} --canvas 3840x2400 --scale 3)
dui_stat(scale_3 "${three}" desktop scale)
dui_stat(missing_3 "${three}" desktop missing_glyphs)
if(NOT scale_3 EQUAL 3 OR NOT missing_3 EQUAL 0)
  message(FATAL_ERROR "scale 3: scale=${scale_3} missing_glyphs=${missing_3}")
endif()

execute_process(COMMAND "${SELECTA}" --output null --size 80x25 --config-dir "${WORK}/cfg" ${common} --scale 4
  RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_VARIABLE out)
if(rc EQUAL 0 OR NOT err MATCHES "is not 1, 2 or 3")
  message(FATAL_ERROR "scale 4 must be refused (rc=${rc}): ${err}")
endif()
