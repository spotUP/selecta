# dui-hover-sidebar-ink (DUI-P3-12, I346, I356): the sidebar hover moves the ink only, and it switches instantly both ways. The instant light-in is dui-hover-instant. -DSELECTA -DSONGS -DWORK
# A mem run lists the door rectangles (`door I x y w h`). A live run without a pointer event gives the rest frame (frame dump
# at close). A second live run moves the pointer onto door 2 at 500 ms, onto door 3 at 550 ms and quits at 610 ms, 60 ms
# after the pointer left door 2: the old door must be pixel-identical to its rest frame (the ink dropped to muted at once;
# with the I346 fade-out it was still mid-way back at 60 ms), and door 3 must differ (lit).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
include("${HERE}/ppm.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
set(args --ui desktop --view songs --canvas 1280x800)
dui_run(o0 ${args} --backend mem --clock fixed --stats)
foreach(k 2 3)
  if(NOT "${o0}" MATCHES "door ${k} (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
    message(FATAL_ERROR "no 'door ${k}' rectangle in the stats:\n${o0}")
  endif()
  set(rx${k} ${CMAKE_MATCH_1})
  set(ry${k} ${CMAKE_MATCH_2})
  set(rw${k} ${CMAKE_MATCH_3})
  set(rh${k} ${CMAKE_MATCH_4})
  math(EXPR x${k} "${rx${k}} + ${rw${k}} / 2")
  math(EXPR y${k} "${ry${k}} + ${rh${k}} / 2")
endforeach()
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
function(live_run timed ppm)
  file(REMOVE_RECURSE "${WORK}/cfg")
  set(ENV{SELECTA_SDL_TEST_TIMED} "${timed}")
  dui_run(o ${args} --backend sdl --frame-dump "${ppm}")
endfunction()
live_run("q@900" "${WORK}/rest.ppm")
live_run("m${x2},${y2}@500 m${x3},${y3}@550 q@610" "${WORK}/moved.ppm")
ppm_load("${WORK}/rest.ppm" resthex w)
ppm_load("${WORK}/moved.ppm" movedhex mw)
rect_differs("${resthex}" "${movedhex}" ${w} ${rx2} ${ry2} ${rw2} ${rh2} old_differs)
if(old_differs)
  message(FATAL_ERROR "60 ms after the pointer left door 2 its pixels still differ from the rest frame: the ink fades out instead of dropping at once (I356)")
endif()
rect_differs("${resthex}" "${movedhex}" ${w} ${rx3} ${ry3} ${rw3} ${rh3} new_differs)
if(NOT new_differs)
  message(FATAL_ERROR "door 3 under the pointer is pixel-identical to the rest frame: it is not lit")
endif()
