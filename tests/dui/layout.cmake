# dui-layout (DUI-P1-7, M4-P2-4): resize events pick the layout and the regions stay on the canvas.
# -DSELECTA -DSONGS -DWORK
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
dui_run(out --ui desktop --backend mem --resize 1400x900,1050x900,850x900,500x900)
set(expect three-column two-column icon-sidebar mini-suggestion)
set(widths 1400 1050 850 500)
foreach(w id IN ZIP_LISTS widths expect)
  if(NOT out MATCHES "layout width=${w} height=900 id=${id} regions=([0-9]+) check=ok")
    message(FATAL_ERROR "width ${w} must give ${id} with check=ok:\n${out}")
  endif()
endforeach()
# Rectangles in the output: none may leave the canvas (the C check says so too; this reads the printed numbers).
string(REGEX MATCHALL "region name=[a-z]+ x=-?[0-9]+ y=-?[0-9]+ w=[0-9]+ h=[0-9]+" regions "${out}")
list(LENGTH regions n)
if(n LESS 13)
  message(FATAL_ERROR "expected the regions of four layouts, got ${n}")
endif()
foreach(r IN LISTS regions)
  string(REGEX MATCH "x=(-?[0-9]+) y=(-?[0-9]+) w=([0-9]+) h=([0-9]+)" m "${r}")
  math(EXPR right "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
  math(EXPR bottom "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
  if(CMAKE_MATCH_1 LESS 0 OR CMAKE_MATCH_2 LESS 0 OR right GREATER 1400 OR bottom GREATER 900)
    message(FATAL_ERROR "region outside the canvas: ${r}")
  endif()
endforeach()
# Breakpoint edges.
file(REMOVE_RECURSE "${WORK}")
dui_run(edge --ui desktop --backend mem --resize 1100x700,1099x700,900x700,899x700,700x700,699x700)
foreach(spec "1100:three-column" "1099:two-column" "900:two-column" "899:icon-sidebar" "700:icon-sidebar" "699:mini-suggestion")
  string(REPLACE ":" ";" pair "${spec}")
  list(GET pair 0 w)
  list(GET pair 1 id)
  if(NOT edge MATCHES "layout width=${w} height=700 id=${id} ")
    message(FATAL_ERROR "edge width ${w} must give ${id}:\n${edge}")
  endif()
endforeach()
# I526 P3: the bitmap tier (--ydiv 2) lays out in 1:1 pixels, so 640 wide gets the labelled rail (sidebar region 166 wide: the measured widest rail label plus icon and pads, I547; the 8x8 bitmap font is 8 px a glyph, so Now Playing (11 characters) now sets the width where Your Library (12, 174 wide) did, before the door became Browse Folders with the short label Folders);
# the default tier at the same width still gives the mini suggestion.
dui_run(bm --ui desktop --backend mem --canvas 640x256 --ydiv 2 --zoom fit --resize 640x512)
if(NOT bm MATCHES "layout width=640 height=512 id=icon-sidebar " OR NOT bm MATCHES "region name=sidebar x=0 y=0 w=166 ")
  message(FATAL_ERROR "I526 P3: the bitmap tier at 640x512 must give the labelled rail:\n${bm}")
endif()
dui_run(dflt --ui desktop --backend mem --resize 640x512)
if(NOT dflt MATCHES "layout width=640 height=512 id=mini-suggestion ")
  message(FATAL_ERROR "the default tier at 640 wide must stay mini-suggestion:\n${dflt}")
endif()
# I972b: the sidebar runs from the window top down to the player bar, the top bar starts at the sidebar's right edge and spans the
# main and detail columns only (Spotify). Three-column, two-column and icon-sidebar widths.
foreach(spec "1280x800:three-column" "1050x800:two-column" "850x800:icon-sidebar")
  string(REPLACE ":" ";" pair "${spec}")
  list(GET pair 0 size)
  list(GET pair 1 id)
  string(REPLACE "x" ";" wh "${size}")
  list(GET wh 0 w)
  list(GET wh 1 h)
  file(REMOVE_RECURSE "${WORK}")
  dui_run(top --ui desktop --backend mem --resize ${size})
  if(NOT top MATCHES "layout width=${w} height=${h} id=${id} ")
    message(FATAL_ERROR "I972b: ${size} must give ${id}:\n${top}")
  endif()
  if(NOT top MATCHES "region name=sidebar x=0 y=0 w=([0-9]+) h=([0-9]+)")
    message(FATAL_ERROR "I972b: ${size} sidebar must start at y=0:\n${top}")
  endif()
  set(side_w ${CMAKE_MATCH_1})
  set(side_h ${CMAKE_MATCH_2})
  if(NOT top MATCHES "region name=player x=0 y=${side_h} w=${w} h=([0-9]+)")
    message(FATAL_ERROR "I972b: ${size} sidebar must run down to the player bar:\n${top}")
  endif()
  math(EXPR full "${side_h} + ${CMAKE_MATCH_1}")
  if(NOT full EQUAL h)
    message(FATAL_ERROR "I972b: ${size} sidebar plus player must be the window height ${h}, got ${full}")
  endif()
  math(EXPR bar_w "${w} - ${side_w}")
  if(NOT top MATCHES "layout-topbar x=${side_w} y=0 w=${bar_w} h=([0-9]+)")
    message(FATAL_ERROR "I972b: ${size} top bar must start at x=${side_w} and be ${bar_w} wide:\n${top}")
  endif()
endforeach()
