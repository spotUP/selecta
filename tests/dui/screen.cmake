# dui-screen (I340): without --canvas the canvas takes the size the backend reports for its screen (on Amiga the
# Workbench screen, full screen by default, D-M4-3). The sdl backend reports 1280x800 unless SELECTA_SDL_SCREEN=WxH
# stands in for a small screen. -DSELECTA -DSONGS -DWORK -DSDL_BUILT
# 1. sdl backend on a 640x400 and a 680x270 screen: the frame dump (PPM header) has exactly that size and the first
#    frame painted at most that many pixels (nothing is drawn past the canvas).
# 2. No screen override: still 1280x800 (the Mac default and goldens do not move).
# 3. The layout fits those small canvases: check=ok and every region lies inside the canvas.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
function(screen_case w h env)
  if(env)
    set(ENV{SELECTA_SDL_SCREEN} "${w}x${h}")
  else()
    unset(ENV{SELECTA_SDL_SCREEN})
  endif()
  dui_run(out --ui desktop --backend sdl --view home --clock fixed --stats --frame-dump "${WORK}/f${w}.ppm")
  dui_stat(presents "${out}" desktop presents)
  if(presents LESS 1)
    message(FATAL_ERROR "${w}x${h}: the sdl backend presented nothing (sentinel)")
  endif()
  file(READ "${WORK}/f${w}.ppm" head LIMIT 16)
  if(NOT head MATCHES "^P6\n${w} ${h}\n")
    string(REPLACE "\n" " " flat "${head}")
    message(FATAL_ERROR "canvas must be ${w}x${h}; PPM header: ${flat}")
  endif()
endfunction()
screen_case(640 400 TRUE)
screen_case(680 270 TRUE)
screen_case(1280 800 FALSE)
unset(ENV{SELECTA_SDL_SCREEN})
foreach(size 640x400 680x270)
  string(REPLACE "x" ";" wh "${size}")
  list(GET wh 0 w)
  list(GET wh 1 h)
  dui_run(lay --ui desktop --backend mem --canvas ${size} --resize ${size})
  if(NOT lay MATCHES "layout width=${w} height=${h} id=[a-z-]+ regions=([0-9]+) check=ok")
    message(FATAL_ERROR "layout does not fit ${size}:\n${lay}")
  endif()
  string(REGEX MATCHALL "region name=[a-z]+ x=-?[0-9]+ y=-?[0-9]+ w=[0-9]+ h=[0-9]+" regions "${lay}")
  foreach(r IN LISTS regions)
    string(REGEX MATCH "x=(-?[0-9]+) y=(-?[0-9]+) w=([0-9]+) h=([0-9]+)" m "${r}")
    math(EXPR right "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
    math(EXPR bottom "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4}")
    if(CMAKE_MATCH_1 LESS 0 OR CMAKE_MATCH_2 LESS 0 OR right GREATER ${w} OR bottom GREATER ${h})
      message(FATAL_ERROR "region outside the ${size} canvas: ${r}")
    endif()
  endforeach()
endforeach()
