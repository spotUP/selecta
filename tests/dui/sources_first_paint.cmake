# dui-sources-first-paint (I825): clicking the Sources kind chip in the Your Library sidebar paints the source rows with no
# scroll input. -DSELECTA -DWORK -DSDL_BUILT. Design doc: Your Library sidebar kind chips (I610/I678b) and the async sidebar read (I787).
# Entry point: the live SDL loop (dummy video driver, timed events), the same render decision a window on a display takes.
# Events: five clicks on the right chevron (All, Playlists, Albums, Artists, Composers, Sources), no wheel, no key. The list read
# takes 300 ms in the library worker. The run quits 600 ms after the last click, well before the next second boundary, where the
# idle wait of the live loop used to end and take the finished read.
# Proof: "sidelib draws= rows= items=" are the LAST DRAWN sidebar frame's row count and the held item count. At quit the held
# items must be the registered sources (not the Composers list still on screen) and the last drawn frame must have drawn rows.
# Before the fix the finished read waited for the next second boundary: items stayed the Composers list.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(NOT SDL_BUILT)
  return()
endif()
set(ENV{SDL_VIDEODRIVER} dummy)
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-sources-first-paint needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/lib.db")
dui_run(init --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_sidebar_mixed.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(c0 --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x800 --input "${WORK}/idle.txt")
if(NOT "${c0}" MATCHES "sidechev L [0-9]+ [0-9]+ [0-9]+ [0-9]+ R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no sidechev in:\n${c0}")
endif()
math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sources-first-paint.sock")
set(ENV{SELECTA_LIB_ITEMS_SLOW_MS} 2500)
file(REMOVE_RECURSE "${WORK}/cfg")
dui_registered_sources(nsrc "${c0}")
set(ENV{SELECTA_SDL_TEST_LIVE} 1)
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-sources-first-paint.sock")
set(ENV{SELECTA_LIB_ITEMS_SLOW_MS} 300)
file(REMOVE_RECURSE "${WORK}/cfg")
set(tokens "m${rx},${ry}@300")
foreach(k RANGE 0 4)
  math(EXPR t "400 + ${k} * 1200")
  math(EXPR t2 "${t} + 50")
  string(APPEND tokens " d1,${rx},${ry}@${t} u1,${rx},${ry}@${t2}")
endforeach()
set(ENV{SELECTA_SDL_TEST_TIMED} "${tokens} q@5800")
dui_run(a --db "${db}" --ui desktop --backend sdl --view library --canvas 1280x800 --clock fixed --stats)
if(NOT a MATCHES "sidechips chip=([0-9]+) ")
  message(FATAL_ERROR "no sidechips line in:\n${a}")
endif()
if(NOT CMAKE_MATCH_1 EQUAL 5)
  message(FATAL_ERROR "the chevron clicks did not reach the Sources chip (chip=${CMAKE_MATCH_1}):\n${a}")
endif()
if(NOT a MATCHES "sidelib draws=[0-9]+ rows=([0-9]+) items=([0-9]+) ")
  message(FATAL_ERROR "no sidelib line in:\n${a}")
endif()
set(rows ${CMAKE_MATCH_1})
set(items ${CMAKE_MATCH_2})
if(NOT items EQUAL nsrc)
  message(FATAL_ERROR "600 ms after the Sources click the sidebar holds ${items} items, expected the ${nsrc} sources: the finished read was not taken until a later event:\n${a}")
endif()
if(rows LESS 1)
  message(FATAL_ERROR "the Sources list holds ${items} items but the last drawn sidebar frame drew ${rows} rows:\n${a}")
endif()
message(STATUS "dui-sources-first-paint ok (rows=${rows} items=${items})")
