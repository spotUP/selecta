# dui-tracker (DUI-P4-12): the desktop Tracker page, through the real shell and the scripted --input feeder.
#   -DSELECTA -DWORK -DGOLDEN -DGENMOD (tools/gen_testmod)
# Fixture: gen_testmod --format mk, a plain ProTracker module. This script parses the module file itself (order list at
# 952, patterns at 1084, four bytes a cell, sample lengths in the header) and never trusts the engine for the oracle.
# 1. Pattern tab: at each SEEK time the dumped playing position (order, row) names a cell row of the module file; the dumped
#    `trcell` fields of that row equal the fields computed here from the file. The page drew (sentinel `tracker draws`).
# 2. Samples tab: the dump lists the module's 31 sample slots; clicking the first non-empty sample sends exactly one verb
#    and the engine plays one sample (stat sample_plays 1, sample_frames > 0). An idle page plays none.
# 3. Clicking a channel header sends one MUTE verb and sets the mute mask.
# 4. A golden pins the Pattern tab frame at the last SEEK time.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(MOD "${WORK}/mk.mod")
execute_process(COMMAND "${GENMOD}" --format mk "${MOD}" RESULT_VARIABLE grc ERROR_VARIABLE gerr)
if(NOT grc EQUAL 0)
  message(FATAL_ERROR "gen_testmod failed (${grc}): ${gerr}")
endif()
file(READ "${MOD}" hex HEX)

function(byte_at outvar off)
  math(EXPR p "${off} * 2")
  string(SUBSTRING "${hex}" ${p} 2 h)
  math(EXPR v "0x${h}")
  set(${outvar} "${v}" PARENT_SCOPE)
endfunction()

# The tracker note name of a ProTracker period (856 = C-1 .. 113 = B-3), "..." for no note.
set(periods 856 808 762 720 678 640 604 570 538 508 480 453 428 404 381 360 339 320 302 285 269 254 240 226 214 202 190 180 170 160 151 143 135 127 120 113)
set(names "C-" "C\#" "D-" "D\#" "E-" "F-" "F\#" "G-" "G\#" "A-" "A\#" "B-")
function(note_name outvar period)
  if(period EQUAL 0)
    set(${outvar} "..." PARENT_SCOPE)
    return()
  endif()
  # The nearest scale period (the generator doubles some periods to reach the octave above the table).
  set(idx 0)
  set(best 100000)
  set(i 0)
  foreach(pp ${periods})
    math(EXPR dd "${pp} - ${period}")
    if(dd LESS 0)
      math(EXPR dd "0 - ${dd}")
    endif()
    if(dd LESS best)
      set(best ${dd})
      set(idx ${i})
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
  # The pattern scale of the engine is libopenmpt's: period 856 is C-4, 428 is C-5 (plugins/replayers/nuade/adapter.c).
  math(EXPR semi "${idx} % 12")
  math(EXPR oct "${idx} / 12 + 4")
  list(GET names ${semi} nm)
  set(${outvar} "${nm}${oct}" PARENT_SCOPE)
endfunction()

# cell_text(<out> <order> <row> <channel>) is "<note> <ins> <vol> <fx>" as the module file says.
function(cell_text outvar order row ch)
  math(EXPR off "952 + ${order}")
  byte_at(pat ${off})
  math(EXPR off "1084 + ${pat} * 1024 + (${row} * 4 + ${ch}) * 4")
  byte_at(b0 ${off})
  math(EXPR o1 "${off} + 1")
  byte_at(b1 ${o1})
  math(EXPR o2 "${off} + 2")
  byte_at(b2 ${o2})
  math(EXPR o3 "${off} + 3")
  byte_at(b3 ${o3})
  math(EXPR period "(${b0} & 15) * 256 + ${b1}")
  math(EXPR ins "(${b0} & 240) | (${b2} >> 4)")
  math(EXPR fxn "${b2} & 15")
  note_name(nn ${period})
  if(ins EQUAL 0)
    set(it "..")
  else()
    math(EXPR ins16 "${ins}" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${ins16}" 2 -1 ih)
    string(LENGTH "${ih}" l)
    if(l EQUAL 1)
      set(ih "0${ih}")
    endif()
    string(TOUPPER "${ih}" it)
  endif()
  if(fxn EQUAL 0 AND b3 EQUAL 0)
    set(ft "...")
  else()
    math(EXPR f16 "${fxn}" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${f16}" 2 -1 fh)
    math(EXPR p16 "${b3} + 256" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${p16}" 3 -1 ph)
    string(TOUPPER "${fh}${ph}" ft)
  endif()
  set(${outvar} "${nn} ${it} .. ${ft}" PARENT_SCOPE)
endfunction()

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()

# tr_run(<tag> <seek ms> <input script> [extra args...]) runs the tracker page; sets <tag>_out and the sentinel fields.
function(tr_run tag seek input)
  file(WRITE "${WORK}/${tag}.txt" "${input}")
  file(REMOVE_RECURSE "${WORK}/cfg" "${WORK}/${tag}.db")
  set(args --db "${WORK}/${tag}.db" --ui desktop --backend mem --view tracker --canvas 1280x800 --clock fixed --stats
    --exec "OPEN ${MOD}")
  if(seek GREATER 0)
    list(APPEND args --exec "SEEK ${seek}")
  endif()
  dui_run(o ${args} ${ARGN} --input "${WORK}/${tag}.txt")
  if(NOT "${o}" MATCHES "(^|\n)(tracker draws [^\n]*)")
    message(FATAL_ERROR "no tracker sentinel in:\n${o}")
  endif()
  set(tline "${CMAKE_MATCH_2}")
  foreach(k draws tab order row rows channels muted samples plays frames cmds shown bar fit moves)
    if(NOT "${tline}" MATCHES "[ ]${k} ([0-9]+)")
      message(FATAL_ERROR "no '${k}' in the tracker line:\n${o}")
    endif()
    set(${tag}_${k} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  endforeach()
  set(${tag}_out "${o}" PARENT_SCOPE)
  dui_stat(h "${o}" desktop canvas_hash)
  set(${tag}_hash "${h}" PARENT_SCOPE)
endfunction()

function(centre_of outvar dump key idx)
  if(NOT "${dump}" MATCHES "\n${key} ${idx} (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no ${key} ${idx} geometry in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

# 1. the playing row at three song times
set(seen_rows "")
set(real_notes 0)
foreach(seek 1000 3000 7000)
  tr_run(p${seek} ${seek} "wait 300\n")
  if(p${seek}_draws LESS 1)
    message(FATAL_ERROR "the Tracker page did not draw at ${seek} ms")
  endif()
  expect_eq("channels at ${seek} ms" "${p${seek}_channels}" 4)
  expect_eq("playing row shown in the pattern window at ${seek} ms" "${p${seek}_shown}" 1)
  if(p${seek}_rows LESS 8)
    message(FATAL_ERROR "the pattern tab drew only ${p${seek}_rows} rows at ${seek} ms")
  endif()
  list(APPEND seen_rows "${p${seek}_order}:${p${seek}_row}")
  foreach(ch RANGE 0 3)
    cell_text(want ${p${seek}_order} ${p${seek}_row} ${ch})
    if(NOT "${p${seek}_out}" MATCHES "\ntrcell ${ch} ([^\n]*)\n")
      message(FATAL_ERROR "no trcell ${ch} at ${seek} ms in:\n${p${seek}_out}")
    endif()
    expect_eq("channel ${ch} at order ${p${seek}_order} row ${p${seek}_row} (${seek} ms)" "${CMAKE_MATCH_1}" "${want}")
    if(NOT want MATCHES "^\\.\\.\\.")
      math(EXPR real_notes "${real_notes} + 1")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES seen_rows)
list(LENGTH seen_rows nseen)
if(nseen LESS 3)
  message(FATAL_ERROR "the playing row did not advance across the seeks: ${seen_rows}")
endif()
if(real_notes LESS 1)
  message(FATAL_ERROR "no checked cell carried a note, the oracle compares nothing")
endif()
# 1b. the row rolls while the song plays, with no SEEK (I282): the position comes from the replayer's own
#     RP_POSITION, sampled by the engine every tick, not from the seek path. The mem backend plays the song to its
#     end, so the sentinel counts the pattern frames that drew a new order:row; a frozen position draws none.
#     selecta-test.mod plays through nuade (a voice replayer, the path that froze); the generated MOD goes to openmpt.
set(gen_mod "${MOD}")
set(MOD "${SONGS}/selecta-test.mod")
tr_run(roll 0 "wait 1\n" --exec PLAY --ticks 300)
set(MOD "${gen_mod}")
if(NOT "${roll_out}" MATCHES "replayer=nuade")
  message(FATAL_ERROR "the roll run did not play through nuade:\n${roll_out}")
endif()
if(roll_moves LESS 32)
  message(FATAL_ERROR "the playing row moved ${roll_moves} times over the song, want at least 32:\n${roll_out}")
endif()
# 1c. the playing-row bar holds the middle slot while the pattern scrolls past it (I283), also at row 0
#     where the old window clamp put it in the top slot.
math(EXPR mid "${p1000_fit} / 2")
expect_eq("the bar slot at row ${p1000_row}" "${p1000_bar}" "${mid}")
tr_run(top 0 "wait 1\n")
math(EXPR mid "${top_fit} / 2")
expect_eq("the bar slot at order 0 row 0" "${top_bar}" "${mid}")
expect_eq("an idle page plays samples" "${p1000_plays}" 0)
expect_eq("an idle page sends verbs" "${p1000_cmds}" 0)

# 2. click-to-play on the Samples tab: the first sample with data
set(first 0)
foreach(n RANGE 1 31)
  math(EXPR so "20 + (${n} - 1) * 30 + 22")
  byte_at(hi ${so})
  math(EXPR so1 "${so} + 1")
  byte_at(lo ${so1})
  math(EXPR words "${hi} * 256 + ${lo}")
  if(words GREATER 1 AND first EQUAL 0)
    set(first ${n})
  endif()
endforeach()
if(first EQUAL 0)
  message(FATAL_ERROR "the fixture has no sample with data")
endif()
centre_of(tab_samples "${p1000_out}" trtab 1)
tr_run(s0 0 "wait 100\nclick ${tab_samples}\nwait 100\n")
expect_eq("tab after clicking Samples" "${s0_tab}" 1)
expect_eq("sample slots listed" "${s0_samples}" 31)
expect_eq("samples played before any click" "${s0_plays}" 0)
centre_of(row_sample "${s0_out}" trsample ${first})
tr_run(s1 0 "wait 100\nclick ${tab_samples}\nwait 100\nclick ${row_sample}\nwait 300\n")
expect_eq("verbs sent by one sample click" "${s1_cmds}" 1)
expect_eq("samples played by one sample click" "${s1_plays}" 1)
if(s1_frames LESS 1)
  message(FATAL_ERROR "the sample click rendered no frames (sample_frames ${s1_frames})")
endif()

# 3. mute from the channel header
centre_of(chan2 "${p1000_out}" trchan 1)
tr_run(m1 1000 "wait 200\nclick ${chan2}\nwait 200\n")
expect_eq("verbs sent by one channel click" "${m1_cmds}" 1)
expect_eq("mute mask after clicking Channel 2" "${m1_muted}" 2)

# 4. golden
set(gfile "${GOLDEN}/desktop/tracker-rgba32-1280x800@1.hash")
if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
  file(WRITE "${gfile}" "${p7000_hash}\n")
endif()
if(NOT EXISTS "${gfile}")
  message(FATAL_ERROR "missing golden ${gfile} (hash ${p7000_hash}); create it with SELECTA_GOLDEN_UPDATE=1")
endif()
file(STRINGS "${gfile}" want LIMIT_COUNT 1)
if(NOT p7000_hash STREQUAL want)
  message(FATAL_ERROR "tracker hash ${p7000_hash} differs from golden ${want} (${gfile})")
endif()
