# dui-source-drill (I790 part 3): a source page opens its drill, not its whole song list (design doc 2026-10-22 section 9b "Source page
# drill"), through the real desktop UI entry. -DSELECTA -DWORK
# Seed: source "hvsc" with 4000 songs in three formats and 1000 artists, so one format holds 334 artists, more than SEL_DRILL_WINDOW.
# The dump prints `drill page= rows= skip= path=[] window= built= crumbs= first=[] row0=x,y,w,h row1=x,y,w,h crumbN=x,y,w,h`;
# built is the engine's drill_rows sentinel (rows the drill queries emitted), page 1 is the root, 2 a group level.
# 1. A click on the source row opens the root level: page=1, 4 rows (Formats, Platforms, Artists, New), no song rows, the drill ran.
# 2. A click on the first row descends to the formats (page=2, 3 rows, 2 crumbs); a click on the first format lists its artists, held to
#    the window (rows == window), and the rows built so far stay under three windows while the source holds 4000 songs.
# 3. A click on the first crumb (the source name) goes back up to the root level.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-source-drill needs the sqlite3 command line tool to seed the library")
endif()
set(db "${WORK}/lib.db")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x1600)
dui_run(init ${common})
string(CONCAT seed
  "DROP TRIGGER IF EXISTS songs_ai; "
  "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 4000) "
  "INSERT INTO songs(key, source, path, name, artist, album, format, added) "
  "SELECT 'hvsc:' || i, 'hvsc', '/h/' || i || '.mod', 'Song ' || i, 'Artist ' || (i % 1000), '', "
  "CASE i % 3 WHEN 0 THEN 'Protracker' WHEN 1 THEN 'Fasttracker 2' ELSE 'Impulsetracker' END, 1 FROM n")
# I911: a fourth format whose five songs have no artist (artist NULL): it has the fewest files, so it is the last format row.
string(CONCAT seed "${seed}; "
  "INSERT INTO songs(key, source, path, name, artist, album, format, added) "
  "SELECT 'hvsc:n' || i, 'hvsc', '/h/n' || i || '.chr', 'Noartist ' || i, NULL, '', 'Chrome', 1 FROM (SELECT 1 AS i UNION SELECT 2 UNION SELECT 3 UNION SELECT 4 UNION SELECT 5)")
# I1235: a second source whose format list (300 formats) is longer than SEL_DRILL_WINDOW, like Modland (339 formats in the real library).
string(CONCAT seed "${seed}; "
  "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 300) "
  "INSERT INTO songs(key, source, path, name, artist, album, format, added) "
  "SELECT 'modland:' || i, 'modland', '/m/' || i || '.x', 'M ' || i, 'Artist ' || i, '', 'Zfmt' || char(97 + (i - 1) / 26) || char(97 + (i - 1) % 26), 1 FROM n")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" "${seed}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "seeding the drill source failed: ${err}")
endif()

# Opening a source touches Recents and reorders the sidebar, so every run starts from the seeded database the row positions came from.
file(COPY_FILE "${db}" "${WORK}/base.db")
function(fresh)
  file(COPY_FILE "${WORK}/base.db" "${db}")
endfunction()
function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()
function(drill_field out dump field)
  if(NOT "${dump}" MATCHES "\ndrill ([^\n]* )?${field}=([^ \n]*)")
    message(FATAL_ERROR "no drill line with ${field} in:\n${dump}")
  endif()
  set(${out} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()
function(drill_center out dump name)
  if(NOT "${dump}" MATCHES "\ndrill [^\n]* ${name}=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)")
    message(FATAL_ERROR "no ${name} rectangle on the drill line in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(side_row out dump name)
  if(NOT "${dump}" MATCHES "sidelib_row [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) pinned=[01] open=[01] kind=7 ${name}\n")
    message(FATAL_ERROR "no sidebar row of kind 7 '${name}' in:\n${dump}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${out} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

# The 1000 seeded artists flood Your Library, so the Sources chip (five steps of the right chevron) narrows the list to the source rows.
file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(idle ${common} --input "${WORK}/idle.txt")
if(NOT "${idle}" MATCHES "sidechev L [0-9]+ [0-9]+ [0-9]+ [0-9]+ R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no sidechev in:\n${idle}")
endif()
math(EXPR rx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR ry "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(chip "")
foreach(k RANGE 1 5)
  string(APPEND chip "click ${rx} ${ry}\nwait 300\n")
endforeach()
file(WRITE "${WORK}/chip.txt" "${chip}")
fresh()
dui_run(chipped ${common} --input "${WORK}/chip.txt")
side_row(src_xy "${chipped}" "HVSC")

# 1. The root level.
file(WRITE "${WORK}/root.txt" "${chip}click ${src_xy}\nwait 100\n")
fresh()
dui_run(root ${common} --input "${WORK}/root.txt")
drill_field(pg "${root}" page)
expect_eq("the source page opens the root drill level" "${pg}" "1")
drill_field(rows "${root}" rows)
expect_eq("root rows (Formats, Platforms, Artists, New)" "${rows}" "4")
drill_field(first "${root}" first)
expect_eq("first root row" "${first}" "[Formats]")
drill_field(built "${root}" built)
if(built LESS 1)
  message(FATAL_ERROR "the drill never ran for the source page (built=${built})")
endif()
if(NOT "${root}" MATCHES "collection kind=source [^\n]* shown=0 of=0")
  message(FATAL_ERROR "the source page built song rows at its first level:\n${root}")
endif()
drill_center(row0 "${root}" row0)

# 2. Descend twice: formats, then the artists of the first format.
file(WRITE "${WORK}/fmt.txt" "${chip}click ${src_xy}\nwait 100\nclick ${row0}\nwait 100\n")
fresh()
dui_run(fmt ${common} --input "${WORK}/fmt.txt")
drill_field(pg "${fmt}" page)
expect_eq("the formats level is a group page" "${pg}" "2")
drill_field(rows "${fmt}" rows)
expect_eq("formats rows (three tracker formats and Chrome)" "${rows}" "4")
drill_field(cr "${fmt}" crumbs)
expect_eq("crumbs at the formats level (source, Formats)" "${cr}" "2")
drill_center(crumb0 "${fmt}" crumb0)
# I1235: the formats are A-Z (Chrome, Fasttracker 2, Impulsetracker, Protracker), not by file count; the last row is the 1333 song Protracker
# with its 334 artists, three row pitches below the first.
if(NOT "${fmt}" MATCHES "\ndrill [^\n]* first=\\[Chrome\\] ")
  message(FATAL_ERROR "the formats level is not A-Z (I1235: Chrome first):\n${fmt}")
endif()
drill_center(fmt_row1 "${fmt}" row1)
string(REPLACE " " ";" r0 "${row0}")
string(REPLACE " " ";" r1 "${fmt_row1}")
list(GET r0 0 x0)
list(GET r0 1 y0)
list(GET r1 1 y1)
math(EXPR y3 "${y0} + 3 * (${y1} - ${y0})")

file(WRITE "${WORK}/art.txt" "${chip}click ${src_xy}\nwait 100\nclick ${row0}\nwait 100\nclick ${x0} ${y3}\nwait 100\n")
fresh()
dui_run(art ${common} --input "${WORK}/art.txt")
drill_field(pg "${art}" page)
expect_eq("the artists of a format are a group page" "${pg}" "2")
drill_field(rows "${art}" rows)
drill_field(win "${art}" window)
expect_eq("artist rows held to the window" "${rows}" "${win}")
drill_field(cr "${art}" crumbs)
expect_eq("crumbs at the artists level (source, Formats, format)" "${cr}" "3")
drill_field(built "${art}" built)
math(EXPR cap "3 * ${win}")
if(built GREATER cap)
  message(FATAL_ERROR "the drill built ${built} rows for three levels of a 4000 song source, over ${cap}")
endif()
if(built LESS ${win})
  message(FATAL_ERROR "the artists level never counted its rows in the drill sentinel (built=${built})")
endif()

# 3. A crumb goes back up.
file(WRITE "${WORK}/up.txt" "${chip}click ${src_xy}\nwait 100\nclick ${row0}\nwait 100\nclick ${crumb0}\nwait 100\n")
fresh()
dui_run(up ${common} --input "${WORK}/up.txt")
drill_field(pg "${up}" page)
expect_eq("the source crumb returns to the root level" "${pg}" "1")

# 4. I911: the format whose songs have no artist (Chrome, now the first row) lists its one group row, labelled, not an empty page.
file(WRITE "${WORK}/noart.txt" "${chip}click ${src_xy}\nwait 100\nclick ${row0}\nwait 100\nclick ${row0}\nwait 100\n")
fresh()
dui_run(noart ${common} --input "${WORK}/noart.txt")
drill_field(pg "${noart}" page)
expect_eq("the artists of the no-artist format are a group page" "${pg}" "2")
drill_field(rows "${noart}" rows)
expect_eq("the no-artist format lists its group row (I911: it listed 0)" "${rows}" "1")
if(NOT "${noart}" MATCHES "\ndrill [^\n]* first=\\[Unknown artist\\] ")
  message(FATAL_ERROR "the group of songs with no artist is not labelled Unknown artist:\n${noart}")
endif()

# 5. I1235: the find field narrows the formats level. Typing "tracker" leaves three of the four formats, "pro" leaves Protracker only; the
# filter sentinel proves drl_filter ran for each change, and clearing the text brings all four back.
if(NOT "${fmt}" MATCHES "collection kind=source [^\n]* find=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)")
  message(FATAL_ERROR "no find rectangle on the formats page:\n${fmt}")
endif()
math(EXPR fx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR fy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
if(${CMAKE_MATCH_3} EQUAL 0)
  message(FATAL_ERROR "the find field has no size on the formats page (I1235: it only showed on song pages)")
endif()
drill_field(filters0 "${fmt}" filters)
set(open_fmt "${chip}click ${src_xy}\nwait 100\nclick ${row0}\nwait 100\nclick ${fx} ${fy}\nwait 100\n")
file(WRITE "${WORK}/f1.txt" "${open_fmt}key t\nkey r\nkey a\nkey c\nkey k\nkey e\nkey r\nwait 100\n")
fresh()
dui_run(f1 ${common} --input "${WORK}/f1.txt")
drill_field(shown "${f1}" shown)
expect_eq("formats left after typing tracker" "${shown}" "3")
drill_field(filters1 "${f1}" filters)
if(NOT filters1 GREATER filters0)
  message(FATAL_ERROR "typing in the find field never ran drl_filter (filters ${filters0} -> ${filters1})")
endif()
drill_field(rows "${f1}" rows)
expect_eq("the level itself keeps all four formats" "${rows}" "4")
file(WRITE "${WORK}/f2.txt" "${open_fmt}key p\nkey r\nkey o\nwait 100\n")
fresh()
dui_run(f2 ${common} --input "${WORK}/f2.txt")
drill_field(shown "${f2}" shown)
expect_eq("formats left after typing pro" "${shown}" "1")
if(NOT "${f2}" MATCHES "\ndrill [^\n]* first=\\[Protracker\\] ")
  message(FATAL_ERROR "the one format left is not Protracker:\n${f2}")
endif()
file(WRITE "${WORK}/f3.txt" "${open_fmt}key p\nkey r\nkey o\nkey backspace\nkey backspace\nkey backspace\nwait 100\n")
fresh()
dui_run(f3 ${common} --input "${WORK}/f3.txt")
drill_field(shown "${f3}" shown)
expect_eq("all formats back after clearing the field" "${shown}" "4")

# 6. I1235: a format list longer than the window filters over the WHOLE list. Modland-like source: 300 formats, 200 in the first window,
# names Zfmtaa..Zfmtln A-Z, so the 14 names Zfmtla.. sit past the first window; typing "fmtl" must find all 14, which the loaded window never held.
side_row(ml_xy "${chipped}" "Modland")
file(WRITE "${WORK}/m0.txt" "${chip}click ${ml_xy}\nwait 100\nclick ${row0}\nwait 100\n")
fresh()
dui_run(m0 ${common} --input "${WORK}/m0.txt")
drill_field(rows "${m0}" rows)
drill_field(win "${m0}" window)
expect_eq("the long format list is held to the window" "${rows}" "${win}")
if(NOT "${m0}" MATCHES "collection kind=source [^\n]* find=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)")
  message(FATAL_ERROR "no find rectangle on a windowed format list:\n${m0}")
endif()
if(${CMAKE_MATCH_3} EQUAL 0)
  message(FATAL_ERROR "no find field on a windowed format list:\n${m0}")
endif()
math(EXPR mx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR my "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
file(WRITE "${WORK}/m1.txt" "${chip}click ${ml_xy}\nwait 100\nclick ${row0}\nwait 100\nclick ${mx} ${my}\nwait 100\nkey f\nkey m\nkey t\nkey l\nwait 300\n")
fresh()
dui_run(m1 ${common} --input "${WORK}/m1.txt")
drill_field(rows "${m1}" rows)
expect_eq("formats found past the first window (fmtl)" "${rows}" "14")
drill_field(shown "${m1}" shown)
expect_eq("formats shown past the first window (fmtl)" "${shown}" "14")
