# dui-playlist-page (I633): a saved playlist opens as a page of its songs, through the real desktop UI entry.
#   -DSELECTA -DSONGS -DWORK
#   Violated invariant: a playlist the user opens (sidebar Your Library row, or a playlist row of the Playlists tree) shows its
#   songs. The sidebar row led to the list of playlists and the tree row did nothing visible.
#   A first run makes a playlist "alpha" from the queue (a.mod) and adds b.mod. The dump prints `plpage id= name=[] songs= rows= draws=` and one
#   `plsong <i> x y w h file= title=` per drawn row.
# 1. A click on the sidebar row opens the page: 2 songs, in playlist order, drawn (draws > 0, rows 2).
# 2. Remove from Playlist (the menu item after the shared five) on row 0 leaves 1 song, b.mod.
# 3. A click on a playlist row of the Playlists tree opens the same page; Escape returns to the tree.
# 4-7. (see the cases below.) 8. I652d: Add Folder on the empty page adds every module of a nested folder in path order.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(n a b)
  file(COPY_FILE "${SONGS}/selecta-test.mod" "${WORK}/${n}.mod")
endforeach()
set(db "${WORK}/lib.db")

function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()

function(pp_centre outvar out re)
  if(NOT "${out}" MATCHES "${re} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no '${re}' in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()

function(pp_page tag out songs)
  if(NOT "${out}" MATCHES "plpage id=([0-9]+) name=\\[alpha\\] songs=([0-9]+) rows=([0-9]+) draws=([0-9]+)")
    message(FATAL_ERROR "no plpage line for alpha in:\n${out}")
  endif()
  expect_eq("${tag} songs" "${CMAKE_MATCH_2}" "${songs}")
  expect_eq("${tag} rows drawn" "${CMAKE_MATCH_3}" "${songs}")
  if(CMAKE_MATCH_4 LESS 1)
    message(FATAL_ERROR "${tag}: the playlist page never drew:\n${out}")
  endif()
endfunction()

dui_run(seed --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}"
  --exec "QUEUE_ADD ${WORK}/a.mod" --exec "PLAYLIST_CREATE alpha"
  --exec "PLAYLIST_ADD_SONG 1 ${WORK}/b.mod")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}" --canvas 1280x800)

file(WRITE "${WORK}/idle.txt" "wait 100\n")
dui_run(i0 ${common} --input "${WORK}/idle.txt")
pp_centre(side "${i0}" "sidelib_row 3")

# 1. Sidebar row click: the page lists both songs in playlist order.
file(WRITE "${WORK}/open.txt" "click ${side}\nwait 100\n")
dui_run(o1 ${common} --input "${WORK}/open.txt")
pp_page(open "${o1}" 2)
if(NOT "${o1}" MATCHES "plsong 0 [0-9]+ [0-9]+ [0-9]+ [0-9]+ file=a.mod [^\n]*\nplsong 1 [0-9]+ [0-9]+ [0-9]+ [0-9]+ file=b.mod ")
  message(FATAL_ERROR "the page rows are not a.mod then b.mod in:\n${o1}")
endif()

# 2. Right-click row 0, pick the sixth menu item (Remove from Playlist).
pp_centre(row0 "${o1}" "plsong 0")
string(REGEX MATCH "^[0-9]+" rx "${row0}")
string(REGEX MATCH "[0-9]+$" ry "${row0}")
math(EXPR ix "${rx} + 10")
math(EXPR iy "${ry} + 5 * 24 + 12")
file(WRITE "${WORK}/remove.txt" "click ${side}\nwait 50\nmove ${rx} ${ry}\nrclick ${rx} ${ry}\nclick ${ix} ${iy}\nwait 100\n")
dui_run(o2 ${common} --input "${WORK}/remove.txt")
pp_page(removed "${o2}" 1)
if(NOT "${o2}" MATCHES "plsong 0 [0-9]+ [0-9]+ [0-9]+ [0-9]+ file=b.mod ")
  message(FATAL_ERROR "the remaining song is not b.mod in:\n${o2}")
endif()
# The removal reached the library: a later run reads one song.
dui_run(o3 ${common} --input "${WORK}/open.txt")
pp_page(persisted "${o3}" 1)

# 3. The Playlists tree: a playlist row click opens the page, Escape goes back to the tree.
set(tree --ui desktop --backend mem --view playlists --clock fixed --stats --db "${db}" --canvas 1280x800)
dui_run(t0 ${tree} --input "${WORK}/idle.txt")
pp_centre(prow "${t0}" "plslot 0")
file(WRITE "${WORK}/tree.txt" "click ${prow}\nwait 100\n")
dui_run(t1 ${tree} --input "${WORK}/tree.txt")
pp_page(tree "${t1}" 1)
file(WRITE "${WORK}/back.txt" "click ${prow}\nwait 50\nkey escape\nwait 100\n")
dui_run(t2 ${tree} --input "${WORK}/back.txt")
if("${t2}" MATCHES "plpage ")
  message(FATAL_ERROR "Escape did not leave the playlist page:\n${t2}")
endif()

# 4. I647: the open page's More button opens Rename and Delete. Delete asks for a confirm, then the playlist is gone
# and the Playlists list shows. (The list toolbar has no Delete: a click on a row opens it.)
file(WRITE "${WORK}/more0.txt" "click ${side}\nwait 100\n")
dui_run(m0 ${common} --input "${WORK}/more0.txt")
if(NOT "${m0}" MATCHES "plmore ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no plmore geometry (the More button) in:\n${m0}")
endif()
math(EXPR mx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR my "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
# the menu opens under the button: its left edge, one button height below the top; item 1 (Delete) is 24 px further
math(EXPR dx "${CMAKE_MATCH_1} + 10")
math(EXPR dy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} + 24 + 12")
set(more "${mx} ${my}")
file(WRITE "${WORK}/more1.txt" "click ${side}\nwait 100\nclick ${more}\nwait 50\nclick ${dx} ${dy}\nwait 100\n")
dui_run(m1 ${common} --input "${WORK}/more1.txt")
if(NOT "${m1}" MATCHES "dlgconfirm ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "More > Delete did not open the confirm in:\n${m1}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
file(WRITE "${WORK}/more2.txt" "click ${side}\nwait 100\nclick ${more}\nwait 50\nclick ${dx} ${dy}\nwait 100\nclick ${cx} ${cy}\nwait 100\n")
dui_run(m2 ${common} --input "${WORK}/more2.txt")
if("${m2}" MATCHES "plpage ")
  message(FATAL_ERROR "the playlist page is still open after a confirmed Delete:\n${m2}")
endif()
dui_run(m3 ${tree} --input "${WORK}/idle.txt")
if("${m3}" MATCHES "plrow ")
  message(FATAL_ERROR "the deleted playlist is still in the library:\n${m3}")
endif()

# 5. I652a: the empty playlist page searches the library and adds a result. The fixture library has songs; PLAYLIST_CREATE makes
# an empty playlist "gamma". Click the sidebar row, click the search field, type "format:mod" (the same debounced LIBRARY_SEARCH the Search
# page sends: the library_screen searches sentinel grows), click Add on the first result: the playlist then has 1 song.
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "the I652a case needs the sqlite3 command line tool to load the fixture library")
endif()
set(fdb "${WORK}/find.db")
dui_run(f_init --db "${fdb}" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "PLAYLIST_CREATE gamma")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${fdb}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE frc ERROR_VARIABLE ferr)
if(NOT frc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${ferr}")
endif()
set(fcommon --ui desktop --backend mem --view home --clock fixed --stats --db "${fdb}" --canvas 1280x800)
dui_run(f0 ${fcommon} --input "${WORK}/idle.txt")
pp_centre(fside "${f0}" "sidelib_row 3")
file(WRITE "${WORK}/find1.txt" "click ${fside}\nwait 100\n")
dui_run(f1 ${fcommon} --input "${WORK}/find1.txt")
if(NOT "${f1}" MATCHES "plpage id=[0-9]+ name=\\[gamma\\] songs=0 ")
  message(FATAL_ERROR "the empty playlist page did not open in:\n${f1}")
endif()
pp_centre(ffield "${f1}" "plfind field")
file(WRITE "${WORK}/find2.txt" "click ${fside}\nwait 100\nclick ${ffield}\nkey f\nkey o\nkey r\nkey m\nkey a\nkey t\nkey :\nkey m\nkey o\nkey d\nwait 600\n")
dui_run(f2 ${fcommon} --input "${WORK}/find2.txt")
if(NOT "${f2}" MATCHES "plfind field [0-9 ]+ results=([1-9][0-9]*) adds=0 searches=([1-9][0-9]*)")
  message(FATAL_ERROR "typing in the playlist search gave no results or no library search in:\n${f2}")
endif()
pp_centre(fadd "${f2}" "plfindadd 0")
file(WRITE "${WORK}/find3.txt" "click ${fside}\nwait 100\nclick ${ffield}\nkey f\nkey o\nkey r\nkey m\nkey a\nkey t\nkey :\nkey m\nkey o\nkey d\nwait 600\nexec VIEW_SOURCE search\nwait 300\nclick ${fadd}\nwait 300\n")
dui_run(f3 ${fcommon} --input "${WORK}/find3.txt")
if(NOT "${f3}" MATCHES "plpage id=[0-9]+ name=\\[gamma\\] songs=1 ")
  message(FATAL_ERROR "Add did not put the first result into the playlist in:\n${f3}")
endif()
dui_run(f4 ${fcommon} --input "${WORK}/find1.txt")
if(NOT "${f4}" MATCHES "plpage id=[0-9]+ name=\\[gamma\\] songs=1 ")
  message(FATAL_ERROR "the added song did not reach the library in:\n${f4}")
endif()

# 6. I652b: the empty playlist page's Add from Library button opens the Library page in add mode for this playlist. The dump prints
# `plfindbtn 0 x y w h` (the button) and, in add mode, `libadd id= name=[] adds= sent=`, `libaddback x y w h` and one `libaddrow i x y w h key=` per Add control.
# Click the button: add mode names gamma and draws Add controls; click Add on a row: the playlist then has 1 song after Back.
# The earlier cases filled gamma, so this case builds a fresh database with an empty gamma.
set(adb "${WORK}/add.db")
dui_run(a_init --db "${adb}" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "PLAYLIST_CREATE gamma")
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${adb}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE arc ERROR_VARIABLE aerr)
if(NOT arc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${aerr}")
endif()
set(acommon --ui desktop --backend mem --view home --clock fixed --stats --db "${adb}" --canvas 1280x800)
dui_run(a1 ${acommon} --input "${WORK}/find1.txt")
pp_centre(fbtn "${a1}" "plfindbtn 0")
file(WRITE "${WORK}/lib1.txt" "click ${fside}\nwait 100\nclick ${fbtn}\nwait 300\n")
dui_run(l1 ${acommon} --input "${WORK}/lib1.txt")
if(NOT "${l1}" MATCHES "libadd id=([0-9]+) name=\\[gamma\\] adds=0 ")
  message(FATAL_ERROR "the Add from Library button did not open the Library in add mode for gamma in:\n${l1}")
endif()
# Add mode lists song rows with an Add control in the History mode (tab 4).
pp_centre(ftab "${l1}" "tab 4")
file(WRITE "${WORK}/lib2.txt" "click ${fside}\nwait 100\nclick ${fbtn}\nwait 300\nclick ${ftab}\nwait 400\n")
dui_run(l2 ${acommon} --input "${WORK}/lib2.txt")
if(NOT "${l2}" MATCHES "libadd id=[0-9]+ name=\\[gamma\\] adds=([1-9][0-9]*) sent=0")
  message(FATAL_ERROR "no Add controls on the library song rows in:\n${l2}")
endif()
pp_centre(frow "${l2}" "libaddrow 0")
pp_centre(fback "${l2}" "libaddback")
file(WRITE "${WORK}/lib3.txt" "click ${fside}\nwait 100\nclick ${fbtn}\nwait 300\nclick ${ftab}\nwait 400\nclick ${frow}\nwait 300\n")
dui_run(l3 ${acommon} --input "${WORK}/lib3.txt")
if(NOT "${l3}" MATCHES "libadd id=[0-9]+ name=\\[gamma\\] adds=[0-9]+ sent=1" OR NOT "${l3}" MATCHES "songs_opened=0")
  message(FATAL_ERROR "Add on a library row did not send PLAYLIST_ADD_SONG (or played the row) in:\n${l3}")
endif()
file(WRITE "${WORK}/lib4.txt" "click ${fside}\nwait 100\nclick ${fbtn}\nwait 300\nclick ${ftab}\nwait 400\nclick ${frow}\nwait 300\nclick ${fback}\nwait 300\n")
dui_run(l4 ${acommon} --input "${WORK}/lib4.txt")
if(NOT "${l4}" MATCHES "plpage id=[0-9]+ name=\\[gamma\\] songs=1 " OR "${l4}" MATCHES "libadd ")
  message(FATAL_ERROR "Back to gamma did not return to the playlist with 1 song in:\n${l4}")
endif()

# 7. I652c: the empty playlist page's Import playlist file button. --dialog-answer stands in for the native file dialog's answer
# (a path to an .m3u). The dump prints `plfindbtn 1 x y w h` (the button) and `plimport sent= runs= added= missing=` (sent: lines the UI sent;
# runs: engine PLAYLIST_IMPORT runs, the sentinel). The list names a.mod, a missing file and b.mod (relative to the list): the playlist then has
# 2 songs in file order, the engine counted 1 missing, and the UI reports them.
set(idb "${WORK}/imp.db")
dui_run(i_init --db "${idb}" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "PLAYLIST_CREATE gamma")
file(WRITE "${WORK}/list.m3u" "#EXTM3U\n${WORK}/a.mod\n${WORK}/missing.mod\nb.mod\n")
set(icommon --ui desktop --backend mem --view home --clock fixed --stats --db "${idb}" --canvas 1280x800)
dui_run(i1 ${icommon} --input "${WORK}/find1.txt")
if(NOT "${i1}" MATCHES "plimport sent=0 runs=0 added=0 missing=0")
  message(FATAL_ERROR "the import counters are not zero before the click in:\n${i1}")
endif()
pp_centre(ibtn "${i1}" "plfindbtn 1")
file(WRITE "${WORK}/imp1.txt" "click ${fside}\nwait 100\nclick ${ibtn}\nwait 300\n")
dui_run(i2 ${icommon} --dialog-answer "${WORK}/list.m3u" --input "${WORK}/imp1.txt")
if(NOT "${i2}" MATCHES "plimport sent=1 runs=1 added=2 missing=1")
  message(FATAL_ERROR "the import sentinel did not count 2 added 1 missing in:\n${i2}")
endif()
if(NOT "${i2}" MATCHES "plpage id=[0-9]+ name=\\[gamma\\] songs=2 ")
  message(FATAL_ERROR "Import playlist file did not give gamma 2 songs in:\n${i2}")
endif()
dui_run(i3 ${icommon} --input "${WORK}/find1.txt")
if(NOT "${i3}" MATCHES "plpage id=[0-9]+ name=\\[gamma\\] songs=2 ")
  message(FATAL_ERROR "the imported songs did not reach the library in:\n${i3}")
endif()

# 8. I652d: the empty playlist page's Add Folder button. --dialog-answer stands in for the native folder dialog's answer. The dump prints
# `plfindbtn 2 x y w h` (the button) and `pladdfolder sent= runs= added=` (runs: engine PLAYLIST_ADD_FOLDER runs, the sentinel). The folder
# holds three real modules in nested subfolders plus a text file; the playlist then has 3 songs in path order (m/b, sub/deep/a, z).
set(fdb "${WORK}/addf.db")
set(ftree "${WORK}/addf_tree")
file(MAKE_DIRECTORY "${ftree}/sub/deep" "${ftree}/m")
execute_process(COMMAND "${GENMOD}" "${ftree}/z.mod" RESULT_VARIABLE rc1)
execute_process(COMMAND "${GENMOD}" --short "${ftree}/sub/deep/a.mod" RESULT_VARIABLE rc2)
execute_process(COMMAND "${GENMOD}" --loop "${ftree}/m/b.mod" RESULT_VARIABLE rc3)
file(WRITE "${ftree}/sub/readme.txt" "not a module")
if(NOT rc1 EQUAL 0 OR NOT rc2 EQUAL 0 OR NOT rc3 EQUAL 0)
  message(FATAL_ERROR "gen_testmod failed for the Add Folder tree")
endif()
dui_run(f_init --db "${fdb}" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "PLAYLIST_CREATE delta")
set(fcommon --ui desktop --backend mem --view home --clock fixed --stats --db "${fdb}" --canvas 1280x800)
dui_run(f1 ${fcommon} --input "${WORK}/find1.txt")
if(NOT "${f1}" MATCHES "pladdfolder sent=0 runs=0 added=0")
  message(FATAL_ERROR "the Add Folder counters are not zero before the click in:\n${f1}")
endif()
pp_centre(abtn "${f1}" "plfindbtn 2")
if(NOT "${f1}" MATCHES "plfindbtn 2 [0-9]+ [0-9]+ [0-9]+ [0-9]+ label=Add Folder")
  message(FATAL_ERROR "slot 2 is not labelled Add Folder in:\n${f1}")
endif()
file(WRITE "${WORK}/addf1.txt" "click ${fside}\nwait 100\nclick ${abtn}\nwait 1500\n")
dui_run(f2 ${fcommon} --dialog-answer "${ftree}" --input "${WORK}/addf1.txt")
if(NOT "${f2}" MATCHES "pladdfolder sent=1 runs=1 added=3")
  message(FATAL_ERROR "the Add Folder sentinel did not count 3 added in:\n${f2}")
endif()
if(NOT "${f2}" MATCHES "plpage id=[0-9]+ name=\\[delta\\] songs=3 ")
  message(FATAL_ERROR "Add Folder did not give delta 3 songs in:\n${f2}")
endif()
string(REGEX MATCHALL "plsong [0-9]+ [^\n]*file=[^ \n]*" f2rows "${f2}")
list(LENGTH f2rows f2n)
expect_eq("Add Folder drawn rows" "${f2n}" "3")
list(GET f2rows 0 r0)
list(GET f2rows 1 r1)
list(GET f2rows 2 r2)
if(NOT "${r0}" MATCHES "file=b.mod$" OR NOT "${r1}" MATCHES "file=a.mod$" OR NOT "${r2}" MATCHES "file=z.mod$")
  message(FATAL_ERROR "Add Folder songs are not in path order:\n${r0}\n${r1}\n${r2}")
endif()

# 9. I652e: a folder that cannot be read ends in an error toast, not "0 songs added". The same empty playlist, --dialog-answer a missing path.
dui_run(g_init --db "${WORK}/addf_bad.db" --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats
  --exec "PLAYLIST_CREATE echo")
set(gcommon --ui desktop --backend mem --view home --clock fixed --stats --db "${WORK}/addf_bad.db" --canvas 1280x800)
dui_run(g1 ${gcommon} --input "${WORK}/find1.txt")
pp_centre(gbtn "${g1}" "plfindbtn 2")
file(WRITE "${WORK}/addf_bad.txt" "click ${fside}\nwait 100\nclick ${gbtn}\nwait 1500\n")
dui_run(g2 ${gcommon} --dialog-answer "${WORK}/no_such_folder" --input "${WORK}/addf_bad.txt")
if(NOT "${g2}" MATCHES "toast_text Could not read that folder or file")
  message(FATAL_ERROR "a missing folder did not raise the error toast in:\n${g2}")
endif()
if("${g2}" MATCHES "songs added")
  message(FATAL_ERROR "a failed Add Folder still toasted a count in:\n${g2}")
endif()
