# dui-aga-budget (DUI-P6-4): the INDEX8 colour budget, through the real binary. -DSELECTA -DWORK -DGOLDEN
#   Budget layout: entries 0-31 UI, 32-63 generated art, 64-127 tile row, 128-191 panel, 192-255 cover flow.
# 1. The 11 views at --canvas 640x512 --format index8 hash to tests/golden/desktop/<view>-index8-640x512@1.hash
#    (update only with SELECTA_GOLDEN_UPDATE=1) and every region stays within 32 / 32 / 64 x 3 distinct indices
#    (stats palette_colours_ui|art|tile|panel|flow).
# 2. Sentinel: the home view over the fixture library (covers for three albums) runs the median-cut quantiser
#    (stat quant_calls > 0) and the tile region then uses more than one palette entry; a view without artwork leaves
#    quant_calls at 0 (the stat is the code's own counter, not a constant).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

set(views testcard text widgets home search library playlists queue nowplaying songs songinfo)
list(LENGTH views view_n)
if(NOT view_n EQUAL 11)
  message(FATAL_ERROR "the budget set is 11 views, found ${view_n}")
endif()
set(limits ui 32 art 32 tile 64 panel 64 flow 64)
set(index8 --ui desktop --backend mem --canvas 640x512 --format index8 --clock fixed --stats)

function(check_budget out label)
  foreach(region ui art tile panel flow)
    list(FIND limits ${region} at)
    math(EXPR at "${at} + 1")
    list(GET limits ${at} limit)
    dui_stat(n "${out}" desktop palette_colours_${region})
    if(n GREATER limit)
      message(FATAL_ERROR "${label}: region ${region} uses ${n} palette entries, budget ${limit}")
    endif()
  endforeach()
endfunction()

foreach(view IN LISTS views)
  dui_run(o ${index8} --view ${view})
  check_budget("${o}" "${view}")
  dui_stat(hash "${o}" desktop canvas_hash)
  dui_stat(quant "${o}" desktop quant_calls)
  if(NOT quant EQUAL 0)
    message(FATAL_ERROR "${view}: no artwork is loaded, yet the quantiser ran ${quant} times")
  endif()
  set(gfile "${GOLDEN}/desktop/${view}-index8-640x512@1.hash")
  if("$ENV{SELECTA_GOLDEN_UPDATE}" STREQUAL "1")
    file(WRITE "${gfile}" "${hash}\n")
  endif()
  if(NOT EXISTS "${gfile}")
    message(FATAL_ERROR "missing golden ${gfile} (hash ${hash}); create it with SELECTA_GOLDEN_UPDATE=1")
  endif()
  file(STRINGS "${gfile}" want LIMIT_COUNT 1)
  if(NOT hash STREQUAL want)
    message(FATAL_ERROR "${view}: index8 hash ${hash} differs from golden ${want} (${gfile})")
  endif()
endforeach()

# Sentinel: artwork on screen runs the quantiser.
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-aga-budget needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" ${index8} --view home)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
file(STRINGS "${HERE}/fixture_library.sql" song_lines REGEX "^INSERT INTO songs")
set(execs "")
set(queued 0)
foreach(line IN LISTS song_lines)
  if(line MATCHES "VALUES\\([0-9]+, '[^']*', 'local', '([^']+)'" AND queued LESS 4)
    list(APPEND execs --exec "QUEUE_ADD \"${CMAKE_MATCH_1}\"")
    math(EXPR queued "${queued} + 1")
  endif()
endforeach()
dui_run(art --db "${db}" ${index8} --view home ${execs})
dui_run(art2 --db "${db}" ${index8} --view home ${execs})
foreach(run art art2)
  check_budget("${${run}}" "artwork ${run}")
endforeach()
dui_stat(q1 "${art}" desktop quant_calls)
dui_stat(q2 "${art2}" desktop quant_calls)
dui_stat(tile2 "${art2}" desktop palette_colours_tile)
if(NOT q1 GREATER 0 AND NOT q2 GREATER 0)
  message(FATAL_ERROR "artwork on screen but the quantiser never ran (quant_calls ${q1}, ${q2})")
endif()
if(tile2 LESS 2)
  message(FATAL_ERROR "the tile region uses ${tile2} palette entries after quantising three covers")
endif()
