# dui-library-scroll (I541, I542): the Library Sources list at the AGA screen size (640x256 canvas, ydiv 2, resized to 640x512)
# scrolls WITHOUT a mouse wheel, and one click on a source switch flips only that source.
# Entry point: the desktop UI's --input script (click, drag, key lines) through desk_route_input and desk_key. No wheel line is used.
# Sentinels: "libbar ... draws N" (the scrollbar painter ran) and "q16" (the list offset). The first visible source is q16 / 48 rows.
#   A: the Sources tab has more rows than fit, so a scrollbar is shown, at offset 0.
#   B: a drag in the bar track, C: a click in the track below the handle, D: Page Down, E: Down: each moves the first visible source.
#   F: a click at the centre of one switch changes exactly one source's enabled flag (I542).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
find_program(SQLITE3 sqlite3)
if(NOT SQLITE3)
  message(FATAL_ERROR "dui-library-scroll needs the sqlite3 command line tool to load the fixture library")
endif()
set(db "${WORK}/library.db")
dui_run(init --db "${db}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
execute_process(COMMAND "${SQLITE3}" -cmd "PRAGMA trusted_schema=ON" "${db}" INPUT_FILE "${HERE}/fixture_library.sql"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "loading the fixture failed: ${err}")
endif()
set(ENV{SELECTA_SOCKET} "/tmp/selecta-dui-library-scroll.sock")
# The Sources tab is the sixth tab; its centre at 640x512 (canvas rows are half the layout rows).
function(scenario tag lines)
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/${tag}.txt" "click 581 64\nwait 300\n${lines}wait 300\n")
  dui_run(${tag} --db "${db}" --ui desktop --backend mem --view library --canvas 640x256 --ydiv 2
    --zoom fit --clock fixed --stats --resize 640x512 --input "${WORK}/${tag}.txt")
  set(${tag} "${${tag}}" PARENT_SCOPE)
endfunction()
function(first_row tag out)
  if(NOT ${tag} MATCHES "mode Sources\n")
    message(FATAL_ERROR "${tag}: the Sources tab did not open:\n${${tag}}")
  endif()
  if(NOT ${tag} MATCHES "libbar [0-9]+ [0-9]+ [0-9]+ [0-9]+ handle [0-9]+ [0-9]+ [0-9]+ [0-9]+ q16 (-?[0-9]+) draws ([0-9]+)")
    message(FATAL_ERROR "${tag}: no Library scrollbar although the Sources list is longer than the screen:\n${${tag}}")
  endif()
  if(NOT CMAKE_MATCH_2 GREATER 0)
    message(FATAL_ERROR "${tag}: the scrollbar painter did not run")
  endif()
  math(EXPR r "${CMAKE_MATCH_1} / 65536 / 48")
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

scenario(a "")
first_row(a row_a)
if(NOT row_a EQUAL 0)
  message(FATAL_ERROR "A: the list must start at the first source, got row ${row_a}")
endif()

# I548 (d): the Sources tab (the last tab) ends inside the page margin: its right edge is at most the main region's right edge
# (640) less the panel inset (4) and the page margin (24). Before the fix lib_tab_pad measured against the region, not the panel.
if(NOT a MATCHES "\ntab 5 (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)\n")
  message(FATAL_ERROR "A: no tab 5 line:\n${a}")
endif()
math(EXPR tab_end "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3}")
if(tab_end GREATER 612)
  message(FATAL_ERROR "I548 d: the Sources tab ends at ${tab_end}, past the page margin (612)")
endif()
# I548 (f): every source row's kind and count columns are at least as wide as their measured text and end left of the Sync
# button, so the status reads "Remote" / "N songs" whole. Line: sourcecols i kind_x kind_w kind_need count_x count_w count_need.
string(REGEX MATCHALL "sourcecols [0-9]+ [-0-9 ]+\n" cols "${a}")
list(LENGTH cols n_cols)
if(n_cols LESS 9)
  message(FATAL_ERROR "I548 f: ${n_cols} sourcecols lines, expected one per source (9):\n${a}")
endif()
foreach(c ${cols})
  string(REGEX MATCH "sourcecols ([0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)" _c "${c}")
  set(row ${CMAKE_MATCH_1})
  if(CMAKE_MATCH_3 LESS CMAKE_MATCH_4 OR CMAKE_MATCH_6 LESS CMAKE_MATCH_7)
    message(FATAL_ERROR "I548 f: row ${row} columns too narrow for the text (kind ${CMAKE_MATCH_3}<${CMAKE_MATCH_4} or count ${CMAKE_MATCH_6}<${CMAKE_MATCH_7})")
  endif()
  math(EXPR count_end "${CMAKE_MATCH_5} + ${CMAKE_MATCH_6}")
  if(NOT a MATCHES "sourcesync ${row} (-?[0-9]+) " OR count_end GREATER CMAKE_MATCH_1)
    message(FATAL_ERROR "I548 f: row ${row} count column ends at ${count_end}, under the Sync button")
  endif()
endforeach()
# I551: every source name is at least as wide as its measured text, so no built-in name draws with an ellipsis ("Mo..."). Line:
# sourcename i name_x name_w name_need.
string(REGEX MATCHALL "sourcename [0-9]+ [-0-9 ]+\n" names "${a}")
list(LENGTH names n_names)
if(n_names LESS 9)
  message(FATAL_ERROR "I551: ${n_names} sourcename lines, expected one per source (9):\n${a}")
endif()
foreach(nm ${names})
  string(REGEX MATCH "sourcename ([0-9]+) (-?[0-9]+) (-?[0-9]+) (-?[0-9]+)" _n "${nm}")
  if(CMAKE_MATCH_3 LESS CMAKE_MATCH_4)
    message(FATAL_ERROR "I551: row ${CMAKE_MATCH_1} name column ${CMAKE_MATCH_3} is narrower than the name text ${CMAKE_MATCH_4}")
  endif()
endforeach()
string(REGEX MATCH "libbar ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) handle ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)" _b "${a}")
set(tx ${CMAKE_MATCH_1})
set(ty ${CMAKE_MATCH_2})
set(tw ${CMAKE_MATCH_3})
set(th ${CMAKE_MATCH_4})
set(hh ${CMAKE_MATCH_8})
math(EXPR cx "${tx} + ${tw} / 2")
math(EXPR below "(${ty} + ${th} - 4) / 2")   # canvas row inside the track, under the handle
math(EXPR top "(${ty} + 4) / 2")
math(EXPR bottom "(${ty} + ${th} - 4) / 2")
if(a MATCHES "libbar [^\n]*handle [0-9]+ ([0-9]+)")
  math(EXPR hbot "(${CMAKE_MATCH_1} + ${hh}) / 2")
  if(below LESS hbot OR below EQUAL hbot)
    message(FATAL_ERROR "A: the track below the handle is empty, the handle covers the whole track:\n${a}")
  endif()
endif()

scenario(b "drag ${cx} ${top} ${cx} ${bottom}\n")
first_row(b row_b)
scenario(c "click ${cx} ${below}\n")
first_row(c row_c)
scenario(d "key pagedown\n")
first_row(d row_d)
scenario(e "key down\n")
first_row(e row_e)
foreach(t b c d e)
  if(NOT row_${t} GREATER 0)
    message(FATAL_ERROR "${t}: the first visible source is still row ${row_${t}}; this input must scroll the list without a wheel:\n${${t}}")
  endif()
endforeach()
if(NOT row_b GREATER row_c OR NOT row_c GREATER row_e)
  message(FATAL_ERROR "drag to the track end (${row_b}) must go beyond one page (${row_c}), which goes beyond one row (${row_e})")
endif()

# F (I542): a click at the centre of the second switch changes exactly one source's enabled flag.
if(NOT a MATCHES "sourcetoggle 1 ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
  message(FATAL_ERROR "no switch rect for source 1:\n${a}")
endif()
math(EXPR sx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR sy "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2) / 2")
scenario(f "click ${sx} ${sy}\n")
string(REGEX MATCHALL "source [0-9]+ [a-z]+\\|[a-z]+\\|[^|\n]*\\|([01])\\|" on_a "${a}")
string(REGEX MATCHALL "source [0-9]+ [a-z]+\\|[a-z]+\\|[^|\n]*\\|([01])\\|" on_f "${f}")
list(LENGTH on_a n_a)
set(changed 0)
foreach(i RANGE 0 ${n_a})
  if(i LESS n_a)
    list(GET on_a ${i} la)
    list(GET on_f ${i} lf)
    if(NOT la STREQUAL lf)
      math(EXPR changed "${changed} + 1")
    endif()
  endif()
endforeach()
if(NOT changed EQUAL 1)
  message(FATAL_ERROR "F: one click on a switch changed ${changed} sources, expected 1:\n${a}\n${f}")
endif()

# I548 (e): an empty library shows the one-line hint under the tab row (the shared empty state)
if(NOT a MATCHES "libempty \n")
  message(FATAL_ERROR "I548 e: the fixture library must show no empty hint:\n${a}")
endif()
set(edb "${WORK}/empty.db")
dui_run(einit --db "${edb}" --ui desktop --backend mem --view home --canvas 900x600 --clock fixed --stats)
file(REMOVE_RECURSE "${WORK}/cfg")
dui_run(e --db "${edb}" --ui desktop --backend mem --view library --canvas 640x256 --ydiv 2 --zoom fit --clock fixed --stats
  --resize 640x512)
if(NOT e MATCHES "libempty Your library is empty. Choose Add Folder to scan your music.\n")
  message(FATAL_ERROR "I548 e: an empty library shows no hint:\n${e}")
endif()

# I548 (e): the Tree, Columns, Files and History pages of an empty library show the same hint (tabs 1..4; x is a canvas column, y
# is halved because canvas rows are half the layout rows).
foreach(m 1 2 3 4)
  if(NOT e MATCHES "tab ${m} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)\n")
    message(FATAL_ERROR "I548 e: no tab ${m} in the dump:\n${e}")
  endif()
  math(EXPR mx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR my "(${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2) / 2")
  file(REMOVE_RECURSE "${WORK}/cfg")
  file(WRITE "${WORK}/em${m}.txt" "click ${mx} ${my}\nwait 300\n")
  dui_run(em${m} --db "${edb}" --ui desktop --backend mem --view library --canvas 640x256 --ydiv 2 --zoom fit --clock fixed --stats
    --resize 640x512 --input "${WORK}/em${m}.txt")
  if(NOT em${m} MATCHES "mode (Tree|Columns|Files|History)\n")
    message(FATAL_ERROR "I548 e: tab ${m} did not open:\n${em${m}}")
  endif()
  set(mode "${CMAKE_MATCH_1}")
  if(m EQUAL 3 AND em${m} MATCHES "vrow 0 ") # Files lists the folders of the browse source, so the page is not blank and shows no hint
    continue()
  endif()
  if(NOT em${m} MATCHES "libempty Your library is empty. Choose Add Folder to scan your music.\n")
    message(FATAL_ERROR "I548 e: the ${mode} page of an empty library shows no hint:\n${em${m}}")
  endif()
endforeach()

# I552: the Songs page with nothing to list shows a hint under its Title and Format headers (rig 3 showed the headers alone);
# (rig 3 state: the Songs page lists the queue, which is empty).file(REMOVE_RECURSE "${WORK}/cfg")
dui_run(sg --db "${edb}" --ui desktop --backend mem --view songs --canvas 640x256 --ydiv 2 --zoom fit --clock fixed --stats
  --resize 640x512)
if(NOT sg MATCHES "libempty No songs to list yet. Add songs from the Library page.\n")
  message(FATAL_ERROR "I552: the Songs page of an empty library shows no hint:\n${sg}")
endif()
