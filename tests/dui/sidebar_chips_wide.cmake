# dui-sidebar-chips-wide (I1208, I1221): the expanded Your Library sidebar shows the chip row (wrapped, all six in view), not the single label.
#   -DSELECTA -DSONGS -DWORK
# Johan 2026-11-09: "i still only see one fullwidth chip when its expanded". Entry point: a click on the Expand Library toggle and on
# the chevrons / chips through the real desktop UI. Lives apart from dui-sidebar-library, whose section 8 (I655) fails before it.
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
configure_file("${SONGS}/selecta-test.mod" "${WORK}/one.mod" COPYONLY)
set(db "${WORK}/lib.db")
function(expect_eq what got want)
  if(NOT "${got}" STREQUAL "${want}")
    message(FATAL_ERROR "${what}: got '${got}', expected '${want}'")
  endif()
endfunction()
function(sc_parse tag out)
  if(NOT "${out}" MATCHES "sidechips chip=([0-9]+) filters=([0-9]+) scrolls=([0-9]+) single=([0-9]+)")
    message(FATAL_ERROR "no sidechips line in:\n${out}")
  endif()
  set(${tag}_chip "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${tag}_filters "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${tag}_scrolls "${CMAKE_MATCH_3}" PARENT_SCOPE)
  set(${tag}_single "${CMAKE_MATCH_4}" PARENT_SCOPE)
endfunction()
function(sc_centre outvar out idx)
  if(NOT "${out}" MATCHES "sidechip ${idx} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidechip ${idx} in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(sc_chev outvar out which)
  if(NOT "${out}" MATCHES "sidechev L ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) R ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidechev in:\n${out}")
  endif()
  if(which STREQUAL "L")
    math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
    math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  else()
    math(EXPR cx "${CMAKE_MATCH_5} + ${CMAKE_MATCH_7} / 2")
    math(EXPR cy "${CMAKE_MATCH_6} + ${CMAKE_MATCH_8} / 2")
  endif()
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(hdr_centre outvar out which)
  if(NOT "${out}" MATCHES "sidehdr ${which} plus_clicks=[0-9]+ wide_clicks=[0-9]+ wide=[0-9]+ sidebar_w=[0-9]+ rect (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidehdr ${which} line in:\n${out}")
  endif()
  if(CMAKE_MATCH_3 EQUAL 0)
    message(FATAL_ERROR "sidehdr ${which} has an empty rect in:\n${out}")
  endif()
  math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
  math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
  set(${outvar} "${cx} ${cy}" PARENT_SCOPE)
endfunction()
function(hdr_field outvar out which field)
  if(NOT "${out}" MATCHES "sidehdr ${which} [^\n]*${field}=([0-9]+)")
    message(FATAL_ERROR "no ${field} in sidehdr ${which} of:\n${out}")
  endif()
  set(${outvar} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

dui_run(seed --ui desktop --backend mem --view home --canvas 1280x800 --clock fixed --stats --db "${db}"
  --exec "QUEUE_ADD ${WORK}/one.mod" --exec "PLAYLIST_CREATE alpha" --exec "PLAYLIST_CREATE beta" --exec "PLAYLIST_CREATE gamma")
file(WRITE "${WORK}/idle.txt" "wait 100\n")
set(common --ui desktop --backend mem --view home --clock fixed --stats --db "${db}")
dui_run(h0 ${common} --canvas 1280x800 --input "${WORK}/idle.txt")
hdr_centre(wide_c "${h0}" wide)
file(WRITE "${WORK}/wide1.txt" "click ${wide_c}\nwait 100\n")
dui_run(h2 ${common} --canvas 1280x800 --input "${WORK}/wide1.txt")

# 10b. I1221 supersedes the I1208 chevron scrolling on the desktop tier: the expanded sidebar shows the chip row, never the single label,
# and the chips that do not fit one row wrap onto the next rows. Invariant: all six chips are drawn (non-empty rect), no chevron
# scrolls the row (scrolls stays 0), and a click on a chip takes the filter. The single label is the narrow sidebar's and the bitmap
# tier's (10, 10c).
sc_parse(k6 "${h2}")
expect_eq("the expanded sidebar shows the chip row, not the single label" "${k6_single}" "0")
foreach(i RANGE 0 5)
  if(NOT "${h2}" MATCHES "sidechip ${i} ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)")
    message(FATAL_ERROR "no sidechip ${i} in:\n${h2}")
  endif()
  if(CMAKE_MATCH_3 EQUAL 0)
    message(FATAL_ERROR "chip ${i} is not in view on the expanded sidebar:\n${h2}")
  endif()
endforeach()
sc_centre(wchip "${h2}" 1)
file(WRITE "${WORK}/wchip_pick.txt" "click ${wide_c}\nwait 100\nclick ${wchip}\nwait 100\n")
dui_run(k10 ${common} --canvas 1280x800 --input "${WORK}/wchip_pick.txt")
sc_parse(k10 "${k10}")
expect_eq("a chip of the wrapped row takes the filter" "${k10_chip}" "2")
expect_eq("no chevron scrolled the row" "${k10_scrolls}" "0")
