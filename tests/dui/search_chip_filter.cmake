# dui-search-chip-filter (I1224): a source chip clicked on the Search page FILTERS the All-sources result already shown down to that
# source; it sends no new query and the list is not rebuilt. The selected chip clicked again lifts the filter. One reachability test
# through the real shell (mem backend, scripted --input, recorded fixtures): -DSELECTA -DWORK -DNETWORK=<net fixture work dir>
#  A. a query typed with All sources: `online_filter filtered=0 queries=Q0` (Q0 = the query count), several From sections;
#  B. + a click on the Modules.pl chip: filtered=1, queries == Q0 (sentinel: no query went out), scope=modulespl, exactly one
#     search_section (From Modules.pl) and every `searchrow` key is a modulespl: key;
#  C. + a second click on the same chip: filtered=0, queries still Q0, the other From sections are back.
# hvsc is not in the net fixture; Modules.pl stands in for it (same chip path).
get_filename_component(HERE "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${HERE}/dui_run.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${NETWORK}/port" port)
string(STRIP "${port}" port)
set(fx "http://127.0.0.1:${port}")
set(ENV{SELECTA_NET_ALLOW} "127.0.0.1")
set(ENV{SELECTA_NET_MAP} "www.modules.pl=${fx},radio.modules.pl=${fx},fixture.test=${fx},ia.search.test=${fx},rb.search.test=${fx},cc.search.test=${fx},jam.search.test=${fx}")
set(ENV{SELECTA_ARCHIVEORG_BASE} "http://ia.search.test")
set(ENV{SELECTA_RADIO_BROWSER} "http://rb.search.test")
set(ENV{SELECTA_CCMIXTER_BASE} "http://cc.search.test")
set(ENV{SELECTA_JAMENDO_API} "http://jam.search.test")
set(ENV{SELECTA_JAMENDO_CLIENT_ID} "searchid1")
set(ENV{SELECTA_MODULESPL_SITE} "http://www.modules.pl")
unset(ENV{SELECTA_MIRROR})
set(ENV{SELECTA_MIRRORS_MODULESPL} "http://www.modules.pl/modules/")
set(ENV{SELECTA_CACHE_DIR} "${WORK}/cache")

set(typed "wait 300\nkey c\nkey h\nkey i\nkey p\nkey enter\n")
foreach(i RANGE 1 40)
  string(APPEND typed "wait 300\n")
endforeach()

function(cf_run outvar extra)
  file(REMOVE "${WORK}/library.db")
  file(WRITE "${WORK}/in.txt" "${typed}${extra}")
  dui_run(o --db "${WORK}/library.db" --ui desktop --backend mem --view search --canvas 1280x2400 --clock fixed --stats --input "${WORK}/in.txt")
  set(${outvar} "${o}" PARENT_SCOPE)
endfunction()

cf_run(a "")
if(NOT "${a}" MATCHES "online_filter filtered=0 queries=([0-9]+)\n")
  message(FATAL_ERROR "A: no online_filter line:\n${a}")
endif()
set(q0 ${CMAKE_MATCH_1})
string(REGEX MATCHALL "search_section [0-9]+ rows=" secs_a "${a}")
list(LENGTH secs_a na)
if(q0 LESS 1 OR na LESS 2)
  message(FATAL_ERROR "A: expected a query and several From sections (queries=${q0} sections=${na}):\n${a}")
endif()
if(NOT "${a}" MATCHES "online_chip [0-9]+ (-?[0-9]+) (-?[0-9]+) ([0-9]+) ([0-9]+) scope=modulespl\n")
  message(FATAL_ERROR "A: no Modules.pl chip:\n${a}")
endif()
math(EXPR cx "${CMAKE_MATCH_1} + ${CMAKE_MATCH_3} / 2")
math(EXPR cy "${CMAKE_MATCH_2} + ${CMAKE_MATCH_4} / 2")
set(click "move ${cx} ${cy}\nclick ${cx} ${cy}\nwait 100\nwait 100\n")

cf_run(b "${click}")
if(NOT "${b}" MATCHES "online_filter filtered=1 queries=([0-9]+)\n" OR NOT CMAKE_MATCH_1 EQUAL q0)
  message(FATAL_ERROR "B: the chip click must filter (filtered=1) without a new query (queries=${q0}):\n${b}")
endif()
if(NOT "${b}" MATCHES "online scope=modulespl ")
  message(FATAL_ERROR "B: the Modules.pl chip must be the selected one:\n${b}")
endif()
string(REGEX MATCHALL "search_section [0-9]+ rows=[0-9]+ [^\n]*" secs_b "${b}")
list(LENGTH secs_b nb)
if(NOT nb EQUAL 1 OR NOT "${secs_b}" MATCHES "From Modules.pl")
  message(FATAL_ERROR "B: only the From Modules.pl section may remain, got ${secs_b}:\n${b}")
endif()
string(REGEX MATCHALL "searchrow [0-9]+ [^\n]*key=[^\n]*" rows_b "${b}")
list(LENGTH rows_b rb)
if(rb LESS 1)
  message(FATAL_ERROR "B: no result rows are shown:\n${b}")
endif()
foreach(r IN LISTS rows_b)
  if(NOT "${r}" MATCHES "key=modulespl:")
    message(FATAL_ERROR "B: a shown row is not a modulespl: row: ${r}")
  endif()
endforeach()

cf_run(c "${click}${click}")
if(NOT "${c}" MATCHES "online_filter filtered=0 queries=([0-9]+)\n" OR NOT CMAKE_MATCH_1 EQUAL q0)
  message(FATAL_ERROR "C: the second click must lift the filter without a new query:\n${c}")
endif()
string(REGEX MATCHALL "search_section [0-9]+ rows=" secs_c "${c}")
list(LENGTH secs_c nc)
if(nc LESS 2)
  message(FATAL_ERROR "C: the other From sections must be back (sections=${nc}):\n${c}")
endif()
