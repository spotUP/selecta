+			|| recs.back().id != 1 || recs.back().tag != SKMTagEOF || recs.back().length != 0)
+			return false;
+
+		std::array<bool, 256> instrumentIDs{};
+		for(const auto &rec : recs)
+		{
+			if(rec.tag == SKMTagEOF || rec.length == 0)
+				continue;
+			// Record IDs vary by layout; tag 1 identifies instruments.
+			if(rec.tag != 1 || rec.length < 2)
+				return false;
+			const uint8 recordIndex = std::to_integer<uint8>(insSpan[rec.dataOffset]);
+			if(instrumentIDs[recordIndex])
+				return false;
+			instrumentIDs[recordIndex] = true;
+			const INSTRUMENTINDEX instrIndex = static_cast<INSTRUMENTINDEX>(recordIndex) + 1;
+			if(instrIndex >= MAX_INSTRUMENTS)
+				continue;
+
+			std::size_t nameEnd;
+			const std::size_t recordEnd = rec.dataOffset + rec.length;
+			const std::string instrName = ReadSKMCString(insSpan, rec.dataOffset + 1, recordEnd, nameEnd);
+			if(nameEnd == recordEnd && insSpan[recordEnd - 1] != std::byte{0})
+				return false;
+			const std::size_t nameEndRel = nameEnd - rec.dataOffset;
+
+			SAMPLEINDEX sampleIdx = 0;
+			std::array<SAMPLEINDEX, 256> localSamples{};
+			std::array<bool, 256> localSlotsSeen{};
+			std::optional<std::array<uint8, 96>> keymap;
+			std::optional<uint16> instrumentFadeOut;
+			std::optional<float> mixerVolume, mixerBalance;
+			std::optional<SKMEnvelopeInfo> volumeEnvelope, panningEnvelope;
+			if(nameEndRel < rec.length)
+			{
+				auto listStart = LocateSKMSampleList(insSpan, rec.dataOffset, rec.length, nameEndRel, versionRaw);
+				if(listStart)
+				{
+					// Fadeout is known only for the canonical 928-byte prefix.
+					if(versionRaw == 7600 && *listStart - nameEndRel == 928)
+					{
+						instrumentFadeOut = PeekU16(insSpan, rec.dataOffset + nameEndRel + 640);
+					}
+					// The mixer strip is anchored before the sample list. Boolean
+					// fields reject incompatible older two-band-EQ layouts.
+					if(versionRaw == 7600 && *listStart >= 281)
+					{
+						const std::size_t mixer = rec.dataOffset + *listStart;
+						const std::array<std::size_t, 9> flags = {
+							281, 136, 35, 34, 33, 32, 31, 22, 13,
+						};
+						const bool saneMixer = std::all_of(flags.begin(), flags.end(), [&](std::size_t back) {
+							return insSpan[mixer - back] == std::byte{0} || insSpan[mixer - back] == std::byte{1};
+						});
+						const float volume = PeekFloat32LE(insSpan, mixer - 279);
+						const float balance = PeekFloat32LE(insSpan, mixer - 275);
+						if(saneMixer && std::isfinite(volume) && volume >= 0.0f)
+							mixerVolume = volume;
+						if(saneMixer && std::isfinite(balance) && balance >= -0.5f && balance <= 0.5f)
+							mixerBalance = balance;
+					}
+					if(modland_skm_hook) mixerBalance = 0.0f;  // modland
+					std::vector<SKMChunk> sub;
+					std::size_t subConsumed = 0;
+					const std::size_t subLength = rec.length - *listStart;
+					if(!ReadSKMChunkList(insSpan, rec.dataOffset + *listStart, subLength, sub, subConsumed)
+						|| subConsumed != subLength || sub.empty()
+						|| sub.back().id != 1 || sub.back().tag != SKMTagEOF || sub.back().length != 0)
+						return false;
+
+					// Later 0.76-family keymaps use 96 framed six-byte entries.
+					if(versionRaw == 7600 && *listStart >= nameEndRel && *listStart - nameEndRel >= 96u * 6u)
+					{
+						std::array<uint8, 96> candidate{};
+						bool validKeymap = true;
+						for(std::size_t note = 0; note < candidate.size(); note++)
+						{
+							const std::size_t entry = rec.dataOffset + nameEndRel + note * 6u;
+							if(insSpan[entry] != std::byte{1} || insSpan[entry + 1] != std::byte{1}
+								|| insSpan[entry + 3] != std::byte{0} || insSpan[entry + 4] != std::byte{0x7F}
+								|| insSpan[entry + 5] != std::byte{0})
+							{
