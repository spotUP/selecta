+namespace
+{
+
+// Container: flat/nested id/tag/length chunk stream.
+// The same header frames top-level sections and instrument sub-chunks.
+
+constexpr uint16 SKMTagHeader = 0xFFFE;
+constexpr uint16 SKMTagEOF = 0xFFFF;
+
+struct SKMChunkHeader
+{
+	uint16le id;      // 0x0001 = binary section, 0x0003 = record/text section (not otherwise used below)
+	uint16le tag;      // 0xFFFE = header, 1..6 = section index, 0xFFFF = EOF
+	uint32le length;
+
+	uint32 GetLength() const { return length; }
+};
+
+MPT_BINARY_STRUCT(SKMChunkHeader, 8)
+
+// Chunk offsets refer to the shared raw-byte buffer.
+struct SKMChunk
+{
+	std::size_t offset = 0;      // header offset
+	uint16 id = 0;
+	uint16 tag = 0;
+	uint32 length = 0;
+	std::size_t dataOffset = 0;  // payload offset
+};
+
+uint16 PeekU16(mpt::span<const std::byte> b, std::size_t off)
+{
+	return static_cast<uint16>(std::to_integer<uint8>(b[off])) | (static_cast<uint16>(std::to_integer<uint8>(b[off + 1])) << 8);
+}
+
+uint32 PeekU32(mpt::span<const std::byte> b, std::size_t off)
+{
+	return static_cast<uint32>(std::to_integer<uint8>(b[off])) | (static_cast<uint32>(std::to_integer<uint8>(b[off + 1])) << 8)
+		| (static_cast<uint32>(std::to_integer<uint8>(b[off + 2])) << 16) | (static_cast<uint32>(std::to_integer<uint8>(b[off + 3])) << 24);
+}
+
+float PeekFloat32LE(mpt::span<const std::byte> b, std::size_t off)
+{
+	return static_cast<float>(IEEE754binary32LE{b[off], b[off + 1], b[off + 2], b[off + 3]});
+}
+
+uint32 SKMBasePreAmp(CHANNELINDEX channels)
+{
+	// Cancel Original mix mode's channel-count attenuation; Skale 0.71+
+	// keeps the same level when empty channels are added.
+	static constexpr uint8 attenuation[16] = {
+		0x60, 0x60, 0x60, 0x70, 0x80, 0x88, 0x90, 0x98,
+		0xA0, 0xA4, 0xA8, 0xAC, 0xB0, 0xB4, 0xB8, 0xBC,
+	};
+	const CHANNELINDEX clamped = std::clamp(channels, CHANNELINDEX{1}, CHANNELINDEX{31});
+	return mpt::saturate_round<uint32>(208.0f * attenuation[clamped / 2u] / 136.0f);
+}
+
+// Walk one chunk level. `consumedOut` allows callers to require exact closure.
+bool ReadSKMChunkList(mpt::span<const std::byte> buf, std::size_t base, std::size_t len,
+	std::vector<SKMChunk> &out, std::size_t &consumedOut)
+{
+	if(base > buf.size() || len > buf.size() - base)
+		return false;
+	std::size_t off = 0;
+	while(off <= len && len - off >= 8)
+	{
+		uint16 id = PeekU16(buf, base + off);
+		uint16 tag = PeekU16(buf, base + off + 2);
+		uint32 length = PeekU32(buf, base + off + 4);
+		std::size_t body = off + 8;
+		if(length > len - body)
+		{
+			consumedOut = off;
+			return false;
+		}
+		SKMChunk c;
+		c.offset = base + off;
+		c.id = id;
+		c.tag = tag;
+		c.length = length;
+		c.dataOffset = base + body;
+		out.push_back(c);
+		off = body + length;
+		if(tag == SKMTagEOF)
+			break;
+	}
+	consumedOut = off;
+	return true;
+}
+
+std::string ReadSKMCString(mpt::span<const std::byte> buf, std::size_t off, std::size_t end, std::size_t &next)
+{
+	std::size_t p = off;
+	while(p < end && buf[p] != std::byte{0})
+		p++;
+	std::string s;
+	s.reserve(p - off);
+	for(std::size_t i = off; i < p; i++)
+		s.push_back(static_cast<char>(std::to_integer<uint8>(buf[i])));
+	// A missing terminator leaves next at end for the caller to reject.
+	next = (p < end) ? p + 1 : end;
+	return s;
+}
+
+// Sample sub-chunks contain a C string followed by a 27-byte header and audio.
+// Loop positions are absolute sample-frame offsets.
+
+constexpr std::size_t SKMSampleHeaderLen = 27;
+
+// A valid embedded sample consumes its record exactly, including a 3-byte tail.
+std::optional<bool> SKMSampleSubchunkSizeExact(mpt::span<const std::byte> buf, std::size_t base, std::size_t len)
+{
+	if(base > buf.size() || len > buf.size() - base || len < 2)
+		return std::nullopt;
+	std::size_t p = 1;
+	while(p < len && buf[base + p] != std::byte{0})
+		p++;
+	if(p >= len)
+		return std::nullopt;
+	std::size_t n2 = p + 1;
+	if(len < SKMSampleHeaderLen || n2 > len - SKMSampleHeaderLen || len - n2 - SKMSampleHeaderLen < 3)
+		return std::nullopt;
+	uint32 audioDataLength = PeekU32(buf, base + n2 + 18);
+	return audioDataLength == len - n2 - SKMSampleHeaderLen - 3;
+}
+
+struct SKMSampleInfo
+{
+	std::string name;
+	uint8 volume = 0, panning = 0;
+	int8 finetune = 0, relativeNote = 0;
+	uint32 loopStart = 0, loopEnd = 0;
+	uint8 loopType = 0;
+	uint16 formatRaw = 0;
+	uint32 audioDataLength = 0, sampleValueCount = 0;
+	uint8 channels = 1;
+	std::size_t audioDataOffset = 0;  // absolute, within the shared buffer
+	bool headerValid = false;
+};
+
+SKMSampleInfo ParseSKMSampleSubchunk(mpt::span<const std::byte> buf, std::size_t base, std::size_t len)
+{
+	SKMSampleInfo si;
+	if(base > buf.size() || len > buf.size() - base || len < 2)
+		return si;
+	std::size_t p = 1;
+	while(p < len && buf[base + p] != std::byte{0})
+		p++;
+	std::size_t n2 = p + 1;
+	std::size_t dummy;
+	si.name = ReadSKMCString(buf, base + 1, base + len, dummy);
+	if(len < SKMSampleHeaderLen || n2 > len - SKMSampleHeaderLen)
+		return si;
+	std::size_t h = base + n2;
+	si.volume = std::to_integer<uint8>(buf[h]);
+	si.panning = std::to_integer<uint8>(buf[h + 1]);
+	si.finetune = static_cast<int8>(std::to_integer<uint8>(buf[h + 2]));
+	si.relativeNote = static_cast<int8>(std::to_integer<uint8>(buf[h + 3]));
+	si.loopStart = PeekU32(buf, h + 5);
+	si.loopEnd = PeekU32(buf, h + 9);
+	si.loopType = std::to_integer<uint8>(buf[h + 13]);
+	si.formatRaw = PeekU16(buf, h + 14);
+	si.audioDataLength = PeekU32(buf, h + 18);
+	si.sampleValueCount = PeekU32(buf, h + 22);
+	si.channels = std::to_integer<uint8>(buf[h + 26]);
+	si.audioDataOffset = h + SKMSampleHeaderLen;
+	si.headerValid = true;
+	return si;
+}
+
+struct SKMEnvelopeInfo
+{
+	uint8 type = 0;
+	bool enabled = false, sustain = false, loop = false;
+	uint8 sustainPoint = 0, loopStart = 0, loopEnd = 0;
+	std::vector<EnvelopeNode> points;
+};
+
+std::optional<SKMEnvelopeInfo> ParseSKMEnvelope(mpt::span<const std::byte> buf, std::size_t base, std::size_t len)
+{
+	// Main step-A envelopes use row 0, type 1=volume / 2=panning. The same
+	// id=3/tag=2 record family also holds the B-H preset grid, so row/type and
+	// the self-describing point count are required to distinguish them.
+	if(base > buf.size() || len > buf.size() - base || len < 10)
+		return std::nullopt;
+	const uint8 row = std::to_integer<uint8>(buf[base]);
+	const uint8 type = std::to_integer<uint8>(buf[base + 1]);
+	const uint8 enabled = std::to_integer<uint8>(buf[base + 2]);
+	const uint8 numPoints = std::to_integer<uint8>(buf[base + 3]);
+	const std::size_t coreLength = 9u + 4u * numPoints;
+	if(row != 0 || (type != 1 && type != 2) || enabled > 1
+		|| numPoints > 12 || (len != coreLength && len != coreLength + 1u))
+		return std::nullopt;
+
+	SKMEnvelopeInfo env;
+	env.type = type;
+	env.enabled = enabled != 0;
+	env.points.reserve(numPoints);
+	uint16 previousTick = 0;
+	for(uint8 i = 0; i < numPoints; i++)
+	{
+		const uint16 tick = PeekU16(buf, base + 4u + 4u * i);
+		const uint16 value = PeekU16(buf, base + 6u + 4u * i);
+		if(value > ENVELOPE_MAX || (i != 0 && tick < previousTick))
+			return std::nullopt;
+		env.points.emplace_back(tick, static_cast<uint8>(value));
+		previousTick = tick;
+	}
+
+	const std::size_t tail = base + 4u + 4u * numPoints;
+	const uint8 sustain = std::to_integer<uint8>(buf[tail]);
+	const uint8 loop = std::to_integer<uint8>(buf[tail + 2]);
+	if(sustain > 1 || loop > 1 || (len == coreLength + 1u && buf[tail + 5] != std::byte{0}))
+		return std::nullopt;
+	env.sustain = sustain != 0;
+	env.sustainPoint = std::to_integer<uint8>(buf[tail + 1]);
+	env.loop = loop != 0;
+	env.loopStart = std::to_integer<uint8>(buf[tail + 3]);
+	env.loopEnd = std::to_integer<uint8>(buf[tail + 4]);
+	if((env.sustain && env.sustainPoint >= numPoints)
+		|| (env.loop && (env.loopStart >= numPoints || env.loopEnd >= numPoints || env.loopStart > env.loopEnd)))
+		return std::nullopt;
+	return env;
+}
+
+void ApplySKMEnvelope(const SKMEnvelopeInfo &src, InstrumentEnvelope &dst)
+{
+	dst.assign(src.points.begin(), src.points.end());
+	dst.dwFlags.set(ENV_ENABLED, src.enabled && !dst.empty());
+	dst.dwFlags.set(ENV_SUSTAIN, src.sustain && !dst.empty());
+	dst.dwFlags.set(ENV_LOOP, src.loop && !dst.empty());
+	dst.nSustainStart = dst.nSustainEnd = src.sustainPoint;
+	dst.nLoopStart = src.loopStart;
+	dst.nLoopEnd = src.loopEnd;
+}
+
+// Locate the nested sample list by validating its framing and sample sizes.
+// The prefix is fixed before 0.76 but has several 0.76 layouts. A missing
+// list is valid for sample-less instrument or text records.
+std::optional<std::size_t> LocateSKMSampleList(mpt::span<const std::byte> buf, std::size_t recBase, std::size_t recLen,
+	std::size_t start, uint32 versionRaw)
+{
+	if(recBase > buf.size() || recLen > buf.size() - recBase || recLen < 8 || start > recLen)
+		return std::nullopt;
+
+	auto validateCandidate = [&](std::size_t off) -> bool
+	{
+		if(off > recLen - 8)
+			return false;
+		uint16 id = PeekU16(buf, recBase + off);
+		uint16 tag = PeekU16(buf, recBase + off + 2);
+		if(!(id == 1 || id == 3))
+			return false;
+		if(!(tag == 1 || tag == 2 || tag == SKMTagEOF))
+			return false;
+		uint32 length = PeekU32(buf, recBase + off + 4);
+		if(length > recLen - off - 8)
+			return false;
+		std::vector<SKMChunk> sub;
+		std::size_t consumed = 0;
+		bool clean = ReadSKMChunkList(buf, recBase + off, recLen - off, sub, consumed);
+		if(!clean || consumed != recLen - off || sub.empty()
+			|| sub.back().id != 1 || sub.back().tag != SKMTagEOF || sub.back().length != 0)
+			return false;
+		for(const auto &s : sub)
+		{
+			if(s.id == 1 && s.tag == 1)
+			{
+				auto exact = SKMSampleSubchunkSizeExact(buf, s.dataOffset, s.length);
+				if(exact && !*exact)
+					return false;
+			}
+		}
+		return true;
+	};
+
+	// Known layouts use a small finite set of prefix sizes.
+	if(versionRaw == 7000 || versionRaw == 7100 || versionRaw == 7500)
+	{
+		if(529 > recLen - start)
+			return std::nullopt;
+		const std::size_t candidate = start + 529;
+		return validateCandidate(candidate) ? std::optional<std::size_t>{candidate} : std::nullopt;
+	}
+	if(versionRaw == 7600)
+	{
+		static constexpr std::size_t gaps[] = {928, 1056, 1052, 1048, 784, 716, 544, 412};
+		for(const auto gap : gaps)
+		{
+			if(gap > recLen - start)
+				continue;
+			const std::size_t candidate = start + gap;
+			if(validateCandidate(candidate))
+				return candidate;
+		}
+		return std::nullopt;
+	}
+
+	// Unknown versions: try every prefix size the known layouts use instead of
+	// scanning. An open-ended scan would validate a fresh chunk list at every
+	// offset, making a single crafted instrument record quadratic to parse.
+	static constexpr std::size_t knownGaps[] = {1056, 1052, 1048, 928, 784, 716, 544, 529, 412};
+	for(const auto gap : knownGaps)
+	{
+		if(gap > recLen - start)
+			continue;
+		const std::size_t candidate = start + gap;
+		if(validateCandidate(candidate))
+			return candidate;
+	}
+	return std::nullopt;
+}
+
+// Section 2: order list + channel-major pattern/track/row grammar.
+
+constexpr uint32 SKMPatternSig = 0x00010001;  // bytes 01 00 01 00, read as LE u32
+constexpr uint16 SKMTrackSepMarker = 0x0101;  // bytes 01 01
+
+// 0x81 is Note Off. 0x80 is provisionally mapped to Note Cut.
+constexpr uint8 SKMNoteOff = 0x81;
+constexpr uint8 SKMNoteCut = 0x80;
+
+// Keep decoding separate from conversion to soundlib commands.
+struct SKMCell
+{
+	bool hasNote = false, hasInstrument = false, hasVolume = false, hasEffect = false;
+	uint8 note = 0, instrument = 0, volume0 = 0, volume1 = 0, effectCmd = 0, effectParam = 0;
+};
+
+// Decode one track into absolute rows. The first two bytes are the last and
+// first stored row; unencoded rows remain empty.
+bool SKMDecodeTrackEvents(mpt::span<const std::byte> data, std::size_t offset, std::size_t length,
+	ROWINDEX numRows, std::vector<std::optional<SKMCell>> &rowsOut)
+{
+	if(length < 2)
+		return false;
+	const uint8 lastRow = std::to_integer<uint8>(data[offset]);
+	uint8 reserved = std::to_integer<uint8>(data[offset + 1]);
+	std::size_t pos = offset + 2;
+	std::size_t end = offset + length;
+	ROWINDEX row = reserved;
+	while(pos < end)
+	{
+		if(row >= numRows)
+			return false;
+		uint8 b = std::to_integer<uint8>(data[pos++]);
+		if(b == 0x80)
+		{
+			row++;
+			continue;
+		}
+		SKMCell cell;
+		if(b & 0x80)
+		{
+			// COMPRESSED row: low 5 bits select fields, ascending bit order.
+			if(b & (1 << 0))
+			{
+				if(pos + 1 > end) return false;
+				cell.hasEffect = true;
+				cell.effectCmd = std::to_integer<uint8>(data[pos++]);
+			}
+			if(b & (1 << 1))
+			{
+				if(pos + 1 > end) return false;
+				cell.hasNote = true;
+				cell.note = std::to_integer<uint8>(data[pos++]);
+			}
+			if(b & (1 << 2))
+			{
+				if(pos + 1 > end) return false;
+				cell.hasInstrument = true;
+				cell.instrument = std::to_integer<uint8>(data[pos++]);
+			}
+			if(b & (1 << 3))
+			{
+				if(pos + 2 > end) return false;
+				cell.hasVolume = true;
+				cell.volume0 = std::to_integer<uint8>(data[pos]);
+				cell.volume1 = std::to_integer<uint8>(data[pos + 1]);
+				pos += 2;
+			}
+			if(b & (1 << 4))
+			{
+				if(pos + 1 > end) return false;
+				cell.effectParam = std::to_integer<uint8>(data[pos++]);
+			}
+		} else
+		{
+			// Literal rows store effect, note, instrument, volume, and parameter.
+			if(pos + 5 > end) return false;
+			cell.hasEffect = true;
+			cell.effectCmd = b;
+			cell.hasNote = true;
+			cell.note = std::to_integer<uint8>(data[pos]);
+			cell.hasInstrument = true;
+			cell.instrument = std::to_integer<uint8>(data[pos + 1]);
+			cell.hasVolume = true;
+			cell.volume0 = std::to_integer<uint8>(data[pos + 2]);
+			cell.volume1 = std::to_integer<uint8>(data[pos + 3]);
+			cell.effectParam = std::to_integer<uint8>(data[pos + 4]);
+			pos += 5;
+		}
+		if(row < numRows)
+			rowsOut[row] = cell;
+		row++;
+	}
+	return row > reserved && row - 1 == lastRow;
+}
+
+// Convert SKM's zero-based notes and instruments to soundlib's one-based
+// representation. Effects 0x00..0x0F follow MOD/XM numbering; Set Volume
+// uses twice the XM parameter. Native effects 0x10..0x13 remain unmapped.
+void SKMApplyCellToModCommand(const SKMCell &cell, ModCommand &m)
+{
+	if(cell.hasNote)
+	{
+		if(cell.note == SKMNoteOff)
+			m.note = NOTE_KEYOFF;
+		else if(cell.note == SKMNoteCut)
+			m.note = NOTE_NOTECUT;  // provisional interpretation
+		else if(cell.note <= 95)
+			m.note = static_cast<ModCommand::NOTE>(cell.note + 13);
+	}
+
+	if(cell.hasInstrument && cell.instrument != 0)
+		m.instr = cell.instrument;
+
+	// A zero high byte denotes plain 0..128 volume. A high byte of 0x80 is
+	// displayed as no volume; its low byte is opaque.
+	if(cell.hasVolume && cell.volume1 == 0 && cell.volume0 <= 0x80)
+	{
+		// SKM's 0..128 scale maps to soundlib's 0..64 scale.
+		m.volcmd = VOLCMD_VOLUME;
+		m.vol = cell.volume0 / 2;
+	}
+
+	if(cell.hasEffect || cell.effectParam != 0)
+	{
+		// Deliberately skip Skale-native 0x10..0x13 and any unknown extended
+		// command until a faithful mapping is established.
+		if(cell.effectCmd > 15)
+			return;
+		uint8 param = cell.effectParam;
+		if(cell.effectCmd == 12)
+		{
+			// Set Volume stores twice the XM parameter. Every observed value is
+			// even; round instead of dropping the command should an odd one
+			// appear, so an unseen file degrades by a half step rather than
+			// losing the volume change entirely.
+			param = static_cast<uint8>((param + 1u) / 2u);
+		}
+		if(cell.effectCmd != 0 || param != 0)
+			CSoundFile::ConvertModCommand(m, cell.effectCmd, param);
+	}
+}
+
