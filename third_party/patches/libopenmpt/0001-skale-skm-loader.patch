+
+CSoundFile::ProbeResult CSoundFile::ProbeFileHeaderSKM(MemoryFileReader file, const uint64 *pfilesize)
+{
+	SKMChunkHeader hdr;
+	if(!file.ReadStruct(hdr))
+		return ProbeWantMoreData;
+	if(hdr.id != 1 || hdr.tag != SKMTagHeader || hdr.GetLength() < 9)
+		return ProbeFailure;
+	if(!file.CanRead(5))
+		return ProbeWantMoreData;
+	char magic[5];
+	file.ReadArray(magic);
+	if(std::memcmp(magic, "ALIM3", 5) != 0)
+		return ProbeFailure;
+	MPT_UNREFERENCED_PARAMETER(pfilesize);
+	return ProbeSuccess;
+}
+
+
+bool CSoundFile::ReadSKM(FileReader &file, ModLoadingFlags loadFlags)
+{
+	file.Rewind();
+
+	SKMChunkHeader hdr;
+	if(!file.ReadStruct(hdr) || hdr.id != 1 || hdr.tag != SKMTagHeader || hdr.GetLength() < 9)
+		return false;
+	FileReader headerChunk = file.ReadChunk(hdr.GetLength());
+	char magic[5];
+	if(!headerChunk.ReadArray(magic) || std::memcmp(magic, "ALIM3", 5) != 0)
+		return false;
+	const uint32 versionRaw = headerChunk.ReadUint32LE();  // version * 10000, e.g. 7600 = Skale 0.76
+
+	if(loadFlags == onlyVerifyHeader)
+		return true;
+
+	// Collect the supported sections in one linear top-level pass.
+	FileReader songTextChunk, patternsChunk, instrumentsChunk, globalChunk;
+	std::array<bool, 7> seenSection{};
+	bool sawEOF = false;
+	for(;;)
+	{
+		SKMChunkHeader ch;
+		if(!file.CanRead(sizeof(SKMChunkHeader)) || !file.ReadStruct(ch))
+			return false;
+		if(!file.CanRead(ch.GetLength()))
+			return false;
+		FileReader chunk = file.ReadChunk(ch.GetLength());
+		// Section 5 permits either observed binary ID; other IDs are fixed.
+		if((ch.tag == 1 && ch.id != 3)
+			|| ((ch.tag == 2 || ch.tag == 3 || ch.tag == 4 || ch.tag == 6) && ch.id != 1)
+			|| (ch.tag == 5 && ch.id != 1 && ch.id != 2))
+			return false;
+		if(ch.tag >= 1 && ch.tag <= 6)
+		{
+			if(seenSection[ch.tag])
+				return false;
+			seenSection[ch.tag] = true;
+		}
+		switch(ch.tag)
+		{
+		case 1: songTextChunk = chunk; break;
+		case 2: patternsChunk = chunk; break;
+		case 3: instrumentsChunk = chunk; break;
+		case 5: globalChunk = chunk; break;
+		default: break;
+		}
+		if(ch.tag == SKMTagEOF)
+		{
+			if(ch.id != 1 || ch.GetLength() != 0)
+				return false;
+			sawEOF = true;
+			break;
+		}
+	}
+	if(!sawEOF || !file.EndOfFile())
+		return false;
+
+	if(!patternsChunk.IsValid() || !patternsChunk.CanRead(259))
+		return false;
+
+	// Use one raw section-2 view so all offsets share the same origin.
+	FileReader::PinnedView patView = patternsChunk.GetPinnedView(patternsChunk.GetLength());
+	mpt::span<const std::byte> patSpan = patView.span();
+
+	// Section 2 header: channel count, order list, length, restart position.
+	const CHANNELINDEX numChannels = std::to_integer<uint8>(patSpan[0]);
+	if(numChannels < 1 || numChannels > MAX_BASECHANNELS)
+		return false;
+	std::array<uint8, 256> orderRegion{};
+	for(std::size_t i = 0; i < 256; i++)
+		orderRegion[i] = std::to_integer<uint8>(patSpan[1 + i]);
+	const uint8 songLength = std::to_integer<uint8>(patSpan[257]);
+	const uint8 repeatPattern = std::to_integer<uint8>(patSpan[258]);
+	if(songLength == 0)
+		return false;
+	const std::size_t orderUsed = std::min<std::size_t>(songLength, orderRegion.size());
+
+	// SKM shares XM tuning, effect, envelope, and sample semantics, so the
+	// module is loaded as MOD_TYPE_XM and identified as SKM through m_modFormat
+	// alone. This is what recent soundlib formats do (SymMOD, DSym, FTM, RTM,
+	// ETX all take no MODTYPE bit of their own), and it needs no Snd_defs.h
+	// change.
+	//
+	// It also matters for more than packaging: GetModSpecifications() switches
+	// on the exact type, so a composite value falls through to ModSpecs::mod,
+	// which declares no instruments, no envelopes, 64-row patterns, and 31
+	// samples. MOD_TYPE_XM selects ModSpecs::xmEx, which actually describes
+	// what this loader produces.
+	InitializeGlobals(MOD_TYPE_XM, numChannels);
+	// Original mixing with preamp 208 matches controlled Skale renders.
+	m_nMixLevels = MixLevels::Original;
+	// Skale 0.70 retains Original mode's channel attenuation; 0.71+ does not.
+	const uint32 skmBasePreAmp = versionRaw == 7000 ? 208u : SKMBasePreAmp(numChannels);
+	m_nSamplePreAmp = skmBasePreAmp;
+	// Skale omits the final point when a ping-pong loop reverses.
+	m_playBehaviour.set(kITPingPongMode);
+	m_modFormat.formatName = UL_("Skale Tracker Module");
+	m_modFormat.type = UL_("skm");
+	// Skale is a Win32 tracker and stores plain 8-bit text.
+	m_modFormat.charset = mpt::Charset::Windows1252;
+	// The stamped value is the format version, not the application version:
+	// Skale 0.77 through 0.81 all still write 7600.
+	m_modFormat.madeWithTracker = MPT_UFORMAT("Skale Tracker (format v0.{})")((versionRaw % 10000u) / 100u);
+	m_SongFlags.set(SONG_IMPORTED);
+	// Skale uses linear periods and preserves all finetune bits, unlike FT2.
+	m_SongFlags.set(SONG_LINEARSLIDES);
+	m_playBehaviour.reset(kFT2FinetunePrecision);
+
+	// Section 1: title, message, initial tempo.
+	if(songTextChunk.IsValid() && songTextChunk.GetLength() >= 18)
+	{
+		// Title C string, optional NUL separator, message, a 10-byte zero footer,
+		// then the fixed 8-byte trailer. The footer is fixed-width in files Skale
+		// itself writes, but this parses the message by trimming trailing NULs
+		// back from the trailer rather than reserving the footer: a file whose
+		// run is shorter is malformed song text, not a reason to fail the whole
+		// module, and reserving a fixed count would truncate its message.
+		const std::size_t chunkLen = songTextChunk.GetLength();
+		const std::size_t trailerOffset = chunkLen - 8;
+		const FileReader::PinnedView textView = songTextChunk.GetPinnedView(chunkLen);
+		const mpt::span<const std::byte> text = textView.span();
+		if(std::to_integer<uint8>(text[trailerOffset + 2]) != numChannels
+			|| text[trailerOffset + 3] != std::byte{0}
+			|| PeekU32(text, trailerOffset + 4) != versionRaw)
+			return false;
+
+		std::size_t titleEnd = 0;
+		const std::string title = ReadSKMCString(text, 0, trailerOffset, titleEnd);
+		if(titleEnd == trailerOffset && (trailerOffset == 0 || text[trailerOffset - 1] != std::byte{0}))
+			return false;
+		m_songName = title;
+
+		// Tolerate a missing separator between the title and message.
+		std::size_t pos = titleEnd;
+		if(pos < trailerOffset && text[pos] == std::byte{0})
+			pos++;
+		// Trim the trailing NUL padding rather than assuming its length.
+		std::size_t messageEnd = trailerOffset;
+		while(messageEnd > pos && text[messageEnd - 1] == std::byte{0})
+			messageEnd--;
+		if(pos < messageEnd)
+		{
+			songTextChunk.Seek(pos);
+			m_songMessage.Read(songTextChunk, messageEnd - pos, SongMessage::leAutodetect);
+		}
+
+		const uint8 initialBpm = std::to_integer<uint8>(text[trailerOffset]);
+		const uint8 initialSpeed = std::to_integer<uint8>(text[trailerOffset + 1]);
+		if(initialSpeed > 0)
+			Order().SetDefaultSpeed(std::min<uint8>(initialSpeed, 31));
+		if(initialBpm > 0)
+			Order().SetDefaultTempoInt(std::max<uint8>(initialBpm, 32));
+	}
+
+	// Section 2 body: patterns.
+	// Validate framing even without allocation; record IDs sanitize the order list.
+	std::array<bool, 256> patternIDs{};
+	{
+		std::size_t off = 0x103;
+		// Reused across every track; tracks are decoded one at a time.
+		std::vector<std::optional<SKMCell>> rows;
+		for(;;)
+		{
+			if(off > patSpan.size())
+				return false;
+			const std::size_t bytesLeft = patSpan.size() - off;
+			if(bytesLeft == 8)
+			{
+				if(PeekU16(patSpan, off) != 1 || PeekU16(patSpan, off + 2) != SKMTagEOF || PeekU32(patSpan, off + 4) != 0)
+					return false;
+				break;
+			}
+			if(bytesLeft < 17)
+				return false;
+			if(PeekU32(patSpan, off) != SKMPatternSig)
+				return false;
+			const uint16 packedSize = PeekU16(patSpan, off + 4);
+			if(packedSize < 9)
+				return false;
+			if(off > patSpan.size() - 4 || packedSize > patSpan.size() - off - 4)
+				return false;
+			const std::size_t dataEnd = off + 4 + packedSize;
+			if(patSpan.size() - dataEnd < 4)
+				return false;
+			if(patSpan[dataEnd] != std::byte{0x01} || patSpan[dataEnd + 1] != std::byte{0xFF}
+				|| patSpan[dataEnd + 2] != std::byte{0x00} || patSpan[dataEnd + 3] != std::byte{0x00})
+				return false;
+			const PATTERNINDEX patIndex = std::to_integer<uint8>(patSpan[off + 8]);
+			if(patternIDs[patIndex])
+				return false;
+			patternIDs[patIndex] = true;
+			const uint8 rowsRaw = std::to_integer<uint8>(patSpan[off + 9]);
+			const ROWINDEX numRows = rowsRaw ? rowsRaw : 256;  // zero encodes the 256-row limit
+
+			const bool storePattern = (loadFlags & loadPatternData)
+				&& patIndex < MAX_PATTERNS && Patterns.Insert(patIndex, numRows);
+			// Tracks are channel-major and separated by 01 01.
+			std::size_t toff = off + 13;
+			const std::size_t tend = dataEnd;
+			CHANNELINDEX expectedChannel = 0;
+			while(toff < tend)
+			{
+				if(tend - toff < 2)
+					return false;
+				const uint16 ln = PeekU16(patSpan, toff);
+				toff += 2;
+				if(ln < 3 || ln > tend - toff)
+					return false;
+				const CHANNELINDEX channel = std::to_integer<uint8>(patSpan[toff]);
+				if(channel != expectedChannel || channel >= numChannels)
+					return false;
+				const std::size_t eventsOffset = toff + 1;
+				const std::size_t eventsLength = ln - 1;
+				rows.assign(numRows, std::nullopt);
+				if(!SKMDecodeTrackEvents(patSpan, eventsOffset, eventsLength, numRows, rows))
+					return false;
+
+				if(storePattern)
+				{
+					for(ROWINDEX row = 0; row < numRows; row++)
+					{
+						if(rows[row])
+							SKMApplyCellToModCommand(*rows[row], *Patterns[patIndex].GetpModCommand(row, channel));
+					}
+				}
+
+				toff += ln;
+				expectedChannel++;
+				if(toff == tend)
+					break;
+				if(tend - toff < 2 || PeekU16(patSpan, toff) != SKMTrackSepMarker)
+					return false;
+				toff += 2;
+			}
+			if(toff != tend || expectedChannel != numChannels)
+				return false;
+
+			off = dataEnd + 4;  // include the 01 ff 00 00 trailer
+		}
+	}
+
+	Order().resize(static_cast<ORDERINDEX>(orderUsed));
+	for(std::size_t i = 0; i < orderUsed; i++)
+	{
+		const PATTERNINDEX pat = orderRegion[i];
+		// Missing pattern IDs play as 64 empty rows rather than being skipped.
+		bool patternAvailable = pat < MAX_PATTERNS;
+		if(patternAvailable && !patternIDs[pat] && (loadFlags & loadPatternData))
+		{
+			patternAvailable = Patterns.Insert(pat, 0x40);
+			patternIDs[pat] = patternAvailable;
+		}
+		Order()[i] = patternAvailable ? pat : PATTERNINDEX_SKIP;
+	}
+	if(repeatPattern < Order().size())
+		Order().SetRestartPos(repeatPattern);
+
+	// Section 3: instruments and samples. Some 0.76 instruments with
+	// 716/784-byte prefixes use an unknown keymap and fall back to sample 1.
+	// Instrument, envelope, keymap, and sample metadata are always parsed:
+	// libopenmpt scans modules for names and counts with sample loading off.
+	// Only the audio payload itself is gated.
+	if(instrumentsChunk.IsValid())
+	{
+		const bool loadAudio = (loadFlags & loadSampleData) != 0;
+		FileReader::PinnedView insView = instrumentsChunk.GetPinnedView(instrumentsChunk.GetLength());
+		mpt::span<const std::byte> insSpan = insView.span();
+		std::vector<SKMChunk> recs;
+		std::vector<std::pair<INSTRUMENTINDEX, float>> mixerInstrumentGains;
+		std::array<std::optional<float>, MAX_INSTRUMENTS> mixerBalances{};
+		std::size_t consumed = 0;
+		if(!ReadSKMChunkList(insSpan, 0, insSpan.size(), recs, consumed)
