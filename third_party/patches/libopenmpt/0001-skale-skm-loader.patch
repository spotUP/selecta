+						// local sample-slot byte per note.
+						std::array<uint8, 96> candidate{};
+						for(std::size_t note = 0; note < candidate.size(); note++)
+							candidate[note] = std::to_integer<uint8>(insSpan[rec.dataOffset + nameEndRel + note]);
+						keymap = candidate;
+					}
+					for(const auto &sc : sub)
+					{
+						if((sc.id != 2 && sc.id != 3) || sc.tag != 2)
+							continue;
+						const auto env = ParseSKMEnvelope(insSpan, sc.dataOffset, sc.length);
+						if(!env)
+							continue;
+						if(env->type == 1)
+							volumeEnvelope = env;
+						else
+							panningEnvelope = env;
+					}
+					for(const auto &sc : sub)
+					{
+						if(sc.id != 1 || sc.tag != 1)
+							continue;
+						if(sc.length == 0)
+							continue;
+						const uint8 localSlot = std::to_integer<uint8>(insSpan[sc.dataOffset]);
+						if(localSlotsSeen[localSlot])
+							return false;
+						localSlotsSeen[localSlot] = true;
+						// Empty slots share the same framing; only size-exact audio plays.
+						const auto sizeExact = SKMSampleSubchunkSizeExact(insSpan, sc.dataOffset, sc.length);
+						if(!sizeExact || !*sizeExact)
+							continue;
+						if(!CanAddMoreSamples())
+							break;
+						SKMSampleInfo si = ParseSKMSampleSubchunk(insSpan, sc.dataOffset, sc.length);
+						if(!si.headerValid || (si.formatRaw != 2 && si.formatRaw != 3 && si.formatRaw != 4)
+							|| si.audioDataOffset > instrumentsChunk.GetLength()
+							|| si.audioDataLength > instrumentsChunk.GetLength() - si.audioDataOffset)
+							continue;
+
+						const SAMPLEINDEX newSampleIdx = ++m_nSamples;
+						ModSample &mptSmp = Samples[newSampleIdx];
+						bool decoded = false;
+						if(si.formatRaw == 4)
+						{
+							// Embedded Ogg uses a length-prefixed, self-contained stream.
+							// Its frame count is only known once decoded, so a
+							// metadata-only load keeps the slot but leaves it empty.
+							if(!loadAudio)
+							{
+								mptSmp.Initialize(MOD_TYPE_XM);
+								decoded = true;
+							} else if(si.audioDataLength >= 10)
+							{
+								const uint32 streamLength = PeekU32(insSpan, si.audioDataOffset);
+								const std::size_t streamOffset = si.audioDataOffset + 4;
+								// Skale pads every stream with a fixed 01 00 FF FF after the
+								// real Ogg EOS, counted inside the inner length. All four bytes
+								// must be excluded, not just the trailing FF FF: leaving 01 00
+								// in place makes stb_vorbis consume nothing while reporting
+								// need-more-data, which spins a length-driven read loop forever
+								// once the audio is already fully decoded. The padding carries
+								// no audio, so dropping it is lossless.
+								if(streamLength <= si.audioDataLength - 4 && streamLength >= 8
+									&& insSpan[streamOffset] == std::byte{'O'} && insSpan[streamOffset + 1] == std::byte{'g'}
+									&& insSpan[streamOffset + 2] == std::byte{'g'} && insSpan[streamOffset + 3] == std::byte{'S'}
+									&& insSpan[streamOffset + streamLength - 4] == std::byte{0x01}
+									&& insSpan[streamOffset + streamLength - 3] == std::byte{0x00}
+									&& insSpan[streamOffset + streamLength - 2] == std::byte{0xFF}
+									&& insSpan[streamOffset + streamLength - 1] == std::byte{0xFF})
+								{
+									FileReader oggChunk = instrumentsChunk;
+									oggChunk.Seek(streamOffset);
+									oggChunk = oggChunk.ReadChunk(streamLength - 4);
+									decoded = ReadVorbisSample(newSampleIdx, oggChunk);
+								}
+							}
+						} else
+						{
+							const uint32 sampleFrames = (si.channels == 1 || si.channels == 2)
+								? si.sampleValueCount / si.channels : 0;
+							if((si.channels != 1 && si.channels != 2) || si.sampleValueCount == 0
+								|| (si.sampleValueCount % si.channels) != 0 || sampleFrames > MAX_SAMPLE_LENGTH)
+							{
+								m_nSamples--;
+								continue;
+							}
+							const uint32 bytesPerValue = si.formatRaw == 2 ? 2u : 1u;
+							const uint64 requiredAudioBytes = static_cast<uint64>(si.sampleValueCount) * bytesPerValue;
+							if(requiredAudioBytes > si.audioDataLength)
+							{
+								m_nSamples--;
+								continue;
+							}
+							mptSmp.Initialize(MOD_TYPE_XM);
+							mptSmp.nLength = sampleFrames;
+							if(loadAudio)
+							{
+								FileReader audioChunk = instrumentsChunk;
+								audioChunk.Seek(si.audioDataOffset);
+								audioChunk = audioChunk.ReadChunk(mpt::saturate_cast<std::size_t>(requiredAudioBytes));
+								SampleIO(
+									si.formatRaw == 2 ? SampleIO::_16bit : SampleIO::_8bit,
+									si.channels > 1 ? SampleIO::stereoInterleaved : SampleIO::mono,
+									SampleIO::littleEndian,
+									// Raw PCM8 and PCM16 are signed.
+									SampleIO::signedPCM)
+									.ReadSample(mptSmp, audioChunk);
+							}
+							decoded = true;
+						}
+
+						if(!decoded)
+						{
+							mptSmp.FreeSample();
+							mptSmp.Initialize(MOD_TYPE_XM);
+							m_nSamples--;
+							continue;
+						}
+
+						// Apply metadata after decoding; ReadVorbisSample reinitializes the sample.
+						m_szNames[newSampleIdx] = si.name;
+						mptSmp.filename = si.name;
+						// Convert Skale's soft pan followed by linear BAL into soundlib's
+						// linear pan plus attenuation.
+						const float samplePan = si.panning;
+						float left = std::min(1.0f, (256.0f - samplePan) / 128.0f);
+						float right = std::min(1.0f, samplePan / 128.0f);
+						const float balance = mixerBalance.value_or(0.0f);
+						left *= 1.0f - 2.0f * balance;
+						right *= 1.0f + 2.0f * balance;
+						const float panGain = (left + right) * 0.5f;
+						const float linearPan = (left + right) > 0.0f ? 256.0f * right / (left + right) : 128.0f;
+						// Keep panning attenuation multiplicative so event volume cannot erase it.
+						mptSmp.nVolume = std::min<uint16>(si.volume * 2u, 256u);
+						mptSmp.nGlobalVol = mpt::saturate_round<uint16>(64.0f * panGain);
+						mptSmp.nPan = mpt::saturate_round<uint16>(linearPan);
+						mptSmp.uFlags.set(CHN_PANNING);
+						mptSmp.nFineTune = si.finetune;
+						mptSmp.RelativeTone = si.relativeNote;
+						if((si.loopType == 1 || si.loopType == 2)
+							&& si.loopEnd > si.loopStart && si.loopEnd <= mptSmp.nLength)
+						{
+							mptSmp.nLoopStart = si.loopStart;
+							mptSmp.nLoopEnd = si.loopEnd;
+							mptSmp.uFlags.set(CHN_LOOP);
+							if(si.loopType == 2)
+								mptSmp.uFlags.set(CHN_PINGPONGLOOP);
+						}
+
+						localSamples[localSlot] = newSampleIdx;
+						if(sampleIdx == 0)
+							sampleIdx = newSampleIdx;
+					}
+				}
+			}
+
+			// Preserve sparse zero-based record IDs as one-based instruments.
+			ModInstrument *instr = AllocateInstrument(instrIndex, keymap ? 0 : sampleIdx);
+			if(instr != nullptr)
+			{
+				instr->name = instrName;
+				mixerInstrumentGains.emplace_back(instrIndex, modland_skm_hook ? modland_skm_gain[recordIndex] : mixerVolume.value_or(1.0f));  // modland
+				mixerBalances[instrIndex] = mixerBalance;
+				if(volumeEnvelope)
+					ApplySKMEnvelope(*volumeEnvelope, instr->VolEnv);
+				if(panningEnvelope)
+					ApplySKMEnvelope(*panningEnvelope, instr->PanEnv);
+				if(instrumentFadeOut)
+					instr->nFadeOut = std::min<uint16>(*instrumentFadeOut, 32767);
+				if(keymap)
+				{
+					for(std::size_t note = 0; note < keymap->size(); note++)
+						instr->Keyboard[note + 12] = localSamples[(*keymap)[note]];
+				}
+			}
+		}
+
+		// Move above-unity strip gain into the format preamp, preserving relative
+		// instrument gains within soundlib's unity-limited fields.
+		float maxMixerGain = 1.0f;
+		for(const auto &[instrument, gain] : mixerInstrumentGains)
+			maxMixerGain = std::max(maxMixerGain, gain);
+		const float basePreAmp = static_cast<float>(skmBasePreAmp);
+		const float preAmpScale = std::min(maxMixerGain, static_cast<float>(MAX_PREAMP) / basePreAmp);
+		m_nSamplePreAmp = mpt::saturate_round<uint32>(basePreAmp * preAmpScale);
+		for(const auto &[instrument, gain] : mixerInstrumentGains)
+		{
+			if(ModInstrument *instr = Instruments[instrument])
+				instr->nGlobalVol = mpt::saturate_round<uint16>(std::clamp(64.0f * gain / preAmpScale, 0.0f, 64.0f));
+		}
+
+		// Command 8 applies soft pan before mixer BAL. Track the active instrument
+		// so effect-only rows use its BAL and preserve the resulting attenuation.
+		//
+		// Limitation: the conversion is baked into shared pattern data, so the
+		// active instrument is only tracked within a pattern. A pattern entered
+		// with an instrument still held from an earlier order entry falls back to
+		// BAL 0, and a pattern played twice under different instruments can only
+		// carry one answer. Reproducing Skale exactly would need per-channel
+		// state at playback time rather than a load-time rewrite.
+		for(PATTERNINDEX pat = 0; pat < Patterns.Size(); pat++)
+		{
+			if(!Patterns.IsValidPat(pat))
+				continue;
+			std::vector<INSTRUMENTINDEX> currentInstrument(GetNumChannels(), 0);
+			for(ROWINDEX row = 0; row < Patterns[pat].GetNumRows(); row++)
+			{
+				for(CHANNELINDEX channel = 0; channel < GetNumChannels(); channel++)
+				{
+					ModCommand &m = *Patterns[pat].GetpModCommand(row, channel);
+					if(m.instr != 0)
+						currentInstrument[channel] = m.instr;
+					if(m.command != CMD_PANNING8)
+						continue;
+					// Unknown volume families may conflict with this conversion.
+					if(m.volcmd != VOLCMD_NONE && m.volcmd != VOLCMD_VOLUME)
+						continue;
+					const INSTRUMENTINDEX instrument = currentInstrument[channel];
+					const float balance = instrument < mixerBalances.size() ? mixerBalances[instrument].value_or(0.0f) : 0.0f;
+					float left = std::min(1.0f, (256.0f - m.param) / 128.0f);
+					float right = std::min(1.0f, m.param / 128.0f);
+					left *= 1.0f - 2.0f * balance;
+					right *= 1.0f + 2.0f * balance;
+					const float panGain = (left + right) * 0.5f;
+					const float linearPan = (left + right) > 0.0f ? 256.0f * right / (left + right) : 128.0f;
+					m.param = mpt::saturate_round<ModCommand::PARAM>(std::min(linearPan, 255.0f));
+					if(m.volcmd == VOLCMD_VOLUME)
+						m.vol = mpt::saturate_round<ModCommand::VOL>(m.vol * panGain);
+					else if(m.volcmd == VOLCMD_NONE)
+					{
+						// Store pan and persistent attenuation in separate command columns.
+						m.volcmd = VOLCMD_PANNING;
+						m.vol = mpt::saturate_round<ModCommand::VOL>(linearPan / 4.0f);
+						m.command = CMD_CHANNELVOLUME;
+						m.param = mpt::saturate_round<ModCommand::PARAM>(64.0f * panGain);
+					}
+				}
+			}
+		}
+	}
+
+	// Section 5: master volume only.
+	// SUB1-4 bus routing and the FX-bus send matrix have no direct equivalent
+	// in soundlib's shared module graph and are not attempted here.
+	if(globalChunk.IsValid() && globalChunk.CanRead(4))
+	{
+		globalChunk.Seek(0);
+		const float masterVolume = globalChunk.ReadFloatLE();
+		if(std::isfinite(masterVolume))
+		{
+			const float saneMasterVolume = std::clamp(masterVolume, 0.0f, 2.0f);
+			if(saneMasterVolume <= 1.0f)
+			{
+				m_nDefaultGlobalVolume = mpt::saturate_round<uint32>(saneMasterVolume * MAX_GLOBAL_VOLUME);
+			} else
+			{
+				// Preserve above-unity master gain in the format preamp.
+				m_nDefaultGlobalVolume = MAX_GLOBAL_VOLUME;
+				m_nSamplePreAmp = mpt::saturate_round<uint32>(std::min(m_nSamplePreAmp * saneMasterVolume, static_cast<float>(MAX_PREAMP)));
+			}
+		}
+	}
+
+	return true;
+}
+
+OPENMPT_NAMESPACE_END
