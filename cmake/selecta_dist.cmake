# I1137: stage and check the Selecta Amiga distribution drawer (the archive the Installer script dist/amiga/Install-Selecta installs).
#   cmake -DMODE=stage    -DDEST=<Selecta dir> -DBIN_DIR=<dir holding selecta and library-template.db> -DROOT=<repo> -P selecta_dist.cmake
#   cmake -DMODE=check    -DDEST=<Selecta dir> -P selecta_dist.cmake
#   cmake -DMODE=selftest -DWORK=<scratch dir> -DROOT=<repo> -P selecta_dist.cmake   (host: stage with stand-in binaries, then check)
# library-template.db lies beside the program because PROGDIR:library.db is the database (sel_default_db_path) and sel_library_open
# looks for the template in the directory of the database path.
# I427e2: Players/ (the on-demand LoadSeg replayer modules, sel_<name>) lies beside the program too: loader_seg.c loads
# PROGDIR:Players/sel_<name>, and the archive holds one program, so one Players/ drawer is the only copy. It is staged
# from <BIN_DIR>/Players, which sel_amiga_players_beside (cmake/selecta_registry.cmake) fills on every build of the app.
set(SELECTA_DIST_REL Selecta library-template.db Install-Selecta rexx/selecta-next.rexx rexx/selecta-status.rexx rexx/selecta-volume.rexx)

function(selecta_check)
  set(missing 0)
  foreach(f ${SELECTA_DIST_REL})
    if(NOT EXISTS "${DEST}/${f}")
      message(SEND_ERROR "[ERROR] selecta-dist-layout: missing ${f}")
      math(EXPR missing "${missing}+1")
    endif()
  endforeach()
  file(GLOB players "${DEST}/Players/sel_*")
  list(LENGTH players nplayers)
  if(nplayers EQUAL 0)
    message(SEND_ERROR "[ERROR] selecta-dist-layout: no player module (Players/sel_*) under ${DEST}")
    math(EXPR missing "${missing}+1")
  endif()
  list(LENGTH SELECTA_DIST_REL n)
  if(missing GREATER 0)
    message(FATAL_ERROR "[ERROR] selecta-dist-layout: ${missing} of ${n} paths missing under ${DEST}")
  endif()
  message(STATUS "[OK] selecta-dist-layout: ${n} paths and ${nplayers} player modules present under ${DEST}")
endfunction()

function(selecta_stage)
  file(REMOVE_RECURSE "${DEST}")
  file(MAKE_DIRECTORY "${DEST}/rexx" "${DEST}/Players")
  file(COPY_FILE "${BIN_DIR}/selecta" "${DEST}/Selecta")
  file(COPY "${BIN_DIR}/library-template.db" DESTINATION "${DEST}")
  file(GLOB players "${BIN_DIR}/Players/sel_*")
  if(players)
    file(COPY ${players} DESTINATION "${DEST}/Players")
  endif()
  file(GLOB rexx "${ROOT}/dist/amiga/rexx/*.rexx")
  file(COPY ${rexx} DESTINATION "${DEST}/rexx")
  file(COPY "${ROOT}/dist/amiga/Install-Selecta" DESTINATION "${DEST}")
endfunction()

if(MODE STREQUAL "stage")
  selecta_stage()
  selecta_check()
elseif(MODE STREQUAL "check")
  selecta_check()
elseif(MODE STREQUAL "selftest")
  file(REMOVE_RECURSE "${WORK}")
  file(MAKE_DIRECTORY "${WORK}/bin")
  file(WRITE "${WORK}/bin/selecta" "stand-in program\n")
  file(WRITE "${WORK}/bin/library-template.db" "stand-in template\n")
  file(WRITE "${WORK}/bin/Players/sel_standin" "stand-in player module\n")
  set(BIN_DIR "${WORK}/bin")
  set(DEST "${WORK}/Selecta")
  selecta_stage()
  selecta_check()
else()
  message(FATAL_ERROR "[ERROR] selecta_dist.cmake: MODE must be stage, check or selftest")
endif()
