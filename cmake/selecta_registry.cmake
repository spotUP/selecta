# Generates the static plugin list from every sel_add_plugin call and
# builds selecta_registry (design doc section 10). Include after
# add_subdirectory(plugins) so the SEL_PLUGINS property is complete.

function(sel_make_registry target list_file_name)
  set(_sel_plugins ${ARGN})

  set(_sel_list "/* Generated by cmake/selecta_registry.cmake. Do not edit. */\n")
  string(APPEND _sel_list "#include <selecta/plugin.h>\n\n")
  foreach(_p IN LISTS _sel_plugins)
    string(APPEND _sel_list "const sel_tag* sel_plugin_entry_${_p}(uint32_t host_api);\n")
  endforeach()
  string(APPEND _sel_list "\nextern const sel_plugin_entry_fn sel_registry_entries[];\n")
  string(APPEND _sel_list "extern const uint32_t sel_registry_entry_count;\n\n")
  string(APPEND _sel_list "const sel_plugin_entry_fn sel_registry_entries[] = {\n")
  foreach(_p IN LISTS _sel_plugins)
    string(APPEND _sel_list "    sel_plugin_entry_${_p},\n")
  endforeach()
  string(APPEND _sel_list "    NULL\n};\n\n")
  list(LENGTH _sel_plugins _sel_n)
  string(APPEND _sel_list "const uint32_t sel_registry_entry_count = ${_sel_n}u;\n")

  set(_sel_list_file "${PROJECT_BINARY_DIR}/generated/${list_file_name}")
  file(CONFIGURE OUTPUT "${_sel_list_file}" CONTENT "${_sel_list}" @ONLY)

  add_library(${target} STATIC
    "${PROJECT_SOURCE_DIR}/src/engine/registry.c"
    "${_sel_list_file}")
  target_link_libraries(${target} PUBLIC selecta_core)
  foreach(_p IN LISTS _sel_plugins)
    target_link_libraries(${target} PUBLIC sel_plugin_${_p})
  endforeach()
endfunction()

get_property(_sel_all_plugins GLOBAL PROPERTY SEL_PLUGINS)
get_property(_sel_gui_only GLOBAL PROPERTY SEL_GUI_ONLY_PLUGINS)
sel_make_registry(selecta_registry registry_list.c ${_sel_all_plugins})

# The 68k selecta-cli carries no GUI plugin (I583): the baked icons and Inter fonts alone are 3.4 MB, and the
# CLI's SQLite heap does not fit in the 8 MiB baseline next to them. Host builds keep one registry.
set(_sel_cli_plugins ${_sel_all_plugins})
if(SEL_AMIGA)
  list(REMOVE_ITEM _sel_cli_plugins ${_sel_gui_only})
endif()
sel_make_registry(selecta_registry_cli registry_list_cli.c ${_sel_cli_plugins})
