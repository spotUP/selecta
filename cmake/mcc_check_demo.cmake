# I685k (design 2026-11-06-mui-mcc-package.md section 10 gate item 1): UP-Demo is built against the release headers only.
# Run as: cmake -DINCLUDES=<list> -DLIBS=<list> -DSOURCE=<demo.c> -DRELEASE_INC=<dir> -DSOURCE_ROOT=<repo> -DBINARY_ROOT=<build dir> -P mcc_check_demo.cmake
# INCLUDES / LIBS are the include directories and link libraries of target up_demo (the Amiga part of the package CMakeLists
# asserts the real target has exactly these). Fails when an include directory lies in the repository outside the build tree (the
# release headers are staged in the build tree; AmigaOS and MUI headers come from the toolchain), when sel_mcc_static (or any Selecta target) is linked, or when the source includes a Selecta header by name.
foreach(v INCLUDES LIBS SOURCE RELEASE_INC SOURCE_ROOT BINARY_ROOT)
  if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
    message(FATAL_ERROR "mcc-demo-headers-only: ${v} is not defined")
  endif()
endforeach()
set(bad 0)
foreach(d ${INCLUDES})
  string(FIND "${d}/" "${BINARY_ROOT}/" in_build)
  string(FIND "${d}/" "${SOURCE_ROOT}/" in_repo)
  if(in_repo EQUAL 0 AND NOT in_build EQUAL 0)
    message(SEND_ERROR "demo include directory ${d} is a Selecta include path")
    set(bad 1)
  endif()
endforeach()
foreach(l ${LIBS})
  if(l MATCHES "^(sel_|selecta_|mui_map)")
    message(SEND_ERROR "demo links ${l}")
    set(bad 1)
  endif()
endforeach()
file(STRINGS "${SOURCE}" lines REGEX "^[ \t]*#[ \t]*include")
foreach(line ${lines})
  if(line MATCHES "selecta/|\"|mui_aa|map/|sel_mcc")
    message(SEND_ERROR "demo source includes a package-internal header: ${line}")
    set(bad 1)
  endif()
endforeach()
if(bad)
  message(FATAL_ERROR "mcc-demo-headers-only FAILED")
endif()
message(STATUS "mcc-demo-headers-only OK")
