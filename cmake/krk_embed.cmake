# Krakatoa shaders (I1052): compiles shaders/krk_smoke.comp once per pass (-DKRK_PASS_<NAME>) to SPIR-V with
# glslangValidator, cross-compiles it to MSL 2.1 with spirv-cross, and writes every MSL source as a NUL-terminated
# unsigned char array krk_msl_<pass> into one generated header. Run with cmake -P:
#   -DGLSLANG=<glslangValidator> -DSPVCROSS=<spirv-cross> -DSRC=<krk_smoke.comp> -DWORK=<dir> -DOUT=<header>
foreach(v GLSLANG SPVCROSS SRC WORK OUT)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "krk_embed: ${v} not set")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
set(body "/* Generated by cmake/krk_embed.cmake from ${SRC}. Do not edit. */\n#pragma once\n")
foreach(pass advect curl force div jacobi grad march final)
  string(TOUPPER "${pass}" up)
  execute_process(
    COMMAND "${GLSLANG}" -V -S comp "-DKRK_PASS_${up}" "${SRC}" -o "${WORK}/${pass}.spv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "krk_embed: glslang ${pass} failed:\n${out}${err}")
  endif()
  execute_process(
    COMMAND "${SPVCROSS}" --msl --msl-version 20100 --msl-decoration-binding "${WORK}/${pass}.spv"
      --output "${WORK}/${pass}.msl"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "krk_embed: spirv-cross ${pass} failed:\n${out}${err}")
  endif()
  file(READ "${WORK}/${pass}.msl" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "static const unsigned char krk_msl_${pass}[] = {${hex}0x00};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
