# Amiga LoadSeg module imports (I1378a; design thoughts/shared/research/2026-11-13-amiga-plugins-on-demand.md, Design 1).
# Reads the append-only list cmake/amiga_seg_imports.txt and generates, at configure time:
#   generated/sel_seg_imports.c       host side: const void* const sel_seg_imports[] (one address per line, in list
#                                     order) and sel_seg_imports_n. Linked into every Amiga executable that has the
#                                     seg loader (cmake/selecta_registry.cmake); it also forces each symbol into the image.
#   generated/seg_thunks/<sym>.c      module side: one m68k thunk per symbol, `_sym: movel _sel_seg_imp,a0;
#                                     movel a0@(N*4),a0; jmp a0@`. _sel_seg_imp is the SELP v2 header slot (seg_crt.c)
#                                     the loader fills before init. Args stay on the stack, so any cdecl signature works.
# The thunks form the static library sel_seg_thunks, one archive member per symbol: a module link pulls only the thunks
# for symbols it leaves undefined, and a symbol the module defines privately never clashes with its thunk.
# SEL_SEG_IMPORT_COUNT is the list length; a module records it in its header and the loader rejects a module whose
# count exceeds the host's (a module built from a newer list than the host).
set(_sel_imp_list "${PROJECT_SOURCE_DIR}/cmake/amiga_seg_imports.txt")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_sel_imp_list}")
file(STRINGS "${_sel_imp_list}" _sel_imp_lines)
set(_sel_imp_syms "")
foreach(_l IN LISTS _sel_imp_lines)
  string(STRIP "${_l}" _l)
  if(_l STREQUAL "" OR _l MATCHES "^#")
    continue()
  endif()
  if(NOT _l MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "cmake/amiga_seg_imports.txt: '${_l}' is not a C symbol name")
  endif()
  if(_l IN_LIST _sel_imp_syms)
    message(FATAL_ERROR "cmake/amiga_seg_imports.txt: '${_l}' is listed twice")
  endif()
  list(APPEND _sel_imp_syms "${_l}")
endforeach()
list(LENGTH _sel_imp_syms SEL_SEG_IMPORT_COUNT)

set(_sel_imp_gen "${PROJECT_BINARY_DIR}/generated")
set(_sel_imp_decl "")
set(_sel_imp_rows "")
set(_sel_imp_thunks "")
set(_i 0)
foreach(_s IN LISTS _sel_imp_syms)
  # The host table only takes addresses, so every symbol is declared as a char object whatever its real type.
  string(APPEND _sel_imp_decl "extern char ${_s};\n")
  string(APPEND _sel_imp_rows "    &${_s},\n")
  math(EXPR _off "${_i} * 4")
  set(_t "${_sel_imp_gen}/seg_thunks/${_s}.c")
  file(CONFIGURE OUTPUT "${_t}" CONTENT "/* Generated by cmake/amiga_seg_imports.cmake from cmake/amiga_seg_imports.txt. Do not edit. */
__asm__(\"\\t.text\\n\\t.even\\n\\t.globl\\t_${_s}\\n_${_s}:\\n\\tmovel\\t_sel_seg_imp,a0\\n\\tmovel\\ta0@(${_off}),a0\\n\\tjmp\\ta0@\\n\");
" @ONLY)
  list(APPEND _sel_imp_thunks "${_t}")
  math(EXPR _i "${_i} + 1")
endforeach()
if(SEL_SEG_IMPORT_COUNT EQUAL 0)
  set(_sel_imp_rows "    0,\n") # C forbids an empty initializer; the count stays 0
endif()
set(SEL_SEG_IMPORTS_C "${_sel_imp_gen}/sel_seg_imports.c")
file(CONFIGURE OUTPUT "${SEL_SEG_IMPORTS_C}" CONTENT "/* Generated by cmake/amiga_seg_imports.cmake from cmake/amiga_seg_imports.txt. Do not edit. */
#include <stdint.h>

${_sel_imp_decl}
extern const void* const sel_seg_imports[];
extern const uint32_t sel_seg_imports_n;

const void* const sel_seg_imports[] = {
${_sel_imp_rows}};
const uint32_t sel_seg_imports_n = ${SEL_SEG_IMPORT_COUNT}u;
" @ONLY)
if(_sel_imp_thunks)
  add_library(sel_seg_thunks STATIC ${_sel_imp_thunks})
endif()
