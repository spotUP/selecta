# SDK isolation include check (RULES.md rule 3, I228). Run as
#   cmake -DPLUGIN=<name> -DOWN_DIR=<dir> -DSOURCES=<a|b> -DTHIRD_PARTY=<a|b>
#         -DSDK_DIR=<include/selecta> -DSHARED_DIR=<plugins/shared> -P sel_check_includes.cmake
# The compile check (sel_sdkcheck_*) cannot see a quoted include such as "../stream/x.h": the compiler resolves it
# against the including file's directory before any -I path. This script resolves every quoted include the same way
# and fails when the resolved file is outside what a plugin may see:
#   a plugin file:   its own directory, include/selecta, plugins/shared, its declared THIRD_PARTY_INCLUDES
#   a shared file:   plugins/shared, include/selecta, the declared THIRD_PARTY_INCLUDES
# Plugin and shared files are followed through their includes; SDK and third-party files are not scanned.
# A "|" separates list items (a ";" would not survive the command line).

string(REPLACE "|" ";" SOURCES "${SOURCES}")
string(REPLACE "|" ";" THIRD_PARTY "${THIRD_PARTY}")
get_filename_component(SDK_DIR "${SDK_DIR}" REALPATH)
get_filename_component(SHARED_DIR "${SHARED_DIR}" REALPATH)
get_filename_component(OWN_DIR "${OWN_DIR}" REALPATH)
set(roots "${SDK_DIR}/.." "${SHARED_DIR}")
set(tp_real "")
foreach(t IN LISTS THIRD_PARTY)
  get_filename_component(t "${t}" REALPATH)
  list(APPEND tp_real "${t}")
  list(APPEND roots "${t}")
endforeach()

function(sel_under path dir out)
  string(FIND "${path}" "${dir}/" pos)
  if(pos EQUAL 0)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

set(queue "")
foreach(s IN LISTS SOURCES)
  get_filename_component(s "${s}" REALPATH)
  list(APPEND queue "${s}")
endforeach()
set(seen "")
set(bad "")
while(queue)
  list(POP_FRONT queue file)
  if(file IN_LIST seen OR NOT EXISTS "${file}")
    continue()
  endif()
  list(APPEND seen "${file}")
  get_filename_component(dir "${file}" DIRECTORY)
  sel_under("${file}" "${SHARED_DIR}" in_shared)
  file(STRINGS "${file}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]")
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "include[ \t]*([\"<])([^\">]+)[\">]")
      continue()
    endif()
    set(quote "${CMAKE_MATCH_1}")
    set(inc "${CMAKE_MATCH_2}")
    set(resolved "")
    if(quote STREQUAL "\"")
      get_filename_component(cand "${dir}/${inc}" REALPATH)
      if(EXISTS "${cand}" AND NOT IS_DIRECTORY "${cand}")
        set(resolved "${cand}")
      endif()
    endif()
    if(NOT resolved)
      # Found through an include root (or a system header): fine, unless the spelling climbs out with "..".
      if(inc MATCHES "(^|/)\\.\\.(/|$)")
        string(APPEND bad "  ${file}: #include ${quote}${inc}${quote} climbs out of the include path\n")
        continue()
      endif()
      foreach(r IN LISTS roots)
        if(EXISTS "${r}/${inc}")
          get_filename_component(resolved "${r}/${inc}" REALPATH)
          break()
        endif()
      endforeach()
      if(NOT resolved)
        continue()
      endif()
    endif()
    set(ok FALSE)
    sel_under("${resolved}" "${SDK_DIR}" u)
    if(u)
      set(ok TRUE)
    endif()
    sel_under("${resolved}" "${SHARED_DIR}" u)
    if(u)
      set(ok TRUE)
    endif()
    if(NOT in_shared)
      sel_under("${resolved}" "${OWN_DIR}" u)
      if(u)
        set(ok TRUE)
      endif()
    endif()
    foreach(t IN LISTS tp_real)
      sel_under("${resolved}" "${t}" u)
      if(u)
        set(ok TRUE)
      endif()
    endforeach()
    if(NOT ok)
      string(APPEND bad "  ${file}: #include ${quote}${inc}${quote} resolves to ${resolved}, outside the plugin directory, include/selecta and plugins/shared\n")
    else()
      sel_under("${resolved}" "${SDK_DIR}" is_sdk)
      set(is_tp FALSE)
      foreach(t IN LISTS tp_real)
        sel_under("${resolved}" "${t}" u)
        if(u)
          set(is_tp TRUE)
        endif()
      endforeach()
      if(NOT is_sdk AND NOT is_tp)
        list(APPEND queue "${resolved}")
      endif()
    endif()
  endforeach()
endwhile()

if(bad)
  message(FATAL_ERROR "[ERROR] plugin ${PLUGIN} breaks SDK isolation:\n${bad}")
endif()
message(STATUS "[OK] plugin ${PLUGIN}: includes stay inside its directory, include/selecta and plugins/shared")
