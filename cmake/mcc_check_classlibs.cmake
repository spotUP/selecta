# I685i (design 2026-11-06-mui-mcc-package.md section 3.2): the eleven UP-*.mcc libraries and sel_mcc_static compile the same
# class sources. Run as: cmake -DLIB_SOURCES=<list> -DSTATIC_SOURCES=<list> -DLIB_COUNT=<n> -P mcc_check_classlibs.cmake
# LIB_SOURCES: the class source of each library, one entry per library. STATIC_SOURCES: the class sources of sel_mcc_static.
if(NOT DEFINED LIB_SOURCES OR "${LIB_SOURCES}" STREQUAL "")
  message(FATAL_ERROR "mcc-classlibs-source: no class library list (MCC_CLASS_LIB_SOURCES is not defined)")
endif()
set(lib_unique ${LIB_SOURCES})
list(REMOVE_DUPLICATES lib_unique)
set(static_classes "")
foreach(s ${STATIC_SOURCES})
  if(s MATCHES "^src/class/.*\\.c$")
    list(APPEND static_classes "${s}")
  endif()
endforeach()
set(bad 0)
foreach(s ${static_classes})
  if(NOT s IN_LIST lib_unique)
    message(SEND_ERROR "class source ${s} is in sel_mcc_static but in no .mcc library")
    set(bad 1)
  endif()
endforeach()
foreach(s ${lib_unique})
  if(NOT s IN_LIST static_classes)
    message(SEND_ERROR "class source ${s} is in a .mcc library but not in sel_mcc_static")
    set(bad 1)
  endif()
endforeach()
if("${static_classes}" STREQUAL "")
  message(SEND_ERROR "no class sources in STATIC_SOURCES")
  set(bad 1)
endif()
list(LENGTH LIB_SOURCES n)
if(NOT n EQUAL 11)
  message(SEND_ERROR "expected 11 class libraries, found ${n}")
  set(bad 1)
endif()
if(bad)
  message(FATAL_ERROR "mcc-classlibs-source FAILED")
endif()
message(STATUS "mcc-classlibs-source OK: ${n} libraries from the class sources of sel_mcc_static")
