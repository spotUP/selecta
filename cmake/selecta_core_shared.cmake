# I427f (design D6): fold the static closure of selecta_core into the shared selecta_core (SELECTA_PLUGIN_LINK=MODULE).
# Every static library selecta_core links, directly or through PUBLIC dependencies, goes in whole (all objects, not only the
# ones the core references) and its symbols are exported, so a module or test that links such a library by name again finds
# every symbol already defined by the shared core and pulls no private copy from the archive. Runs deferred: the targets live
# in subdirectories added after src/.
if(NOT SELECTA_PLUGIN_LINK STREQUAL "MODULE")
  return()
endif()

function(sel_core_static_closure out)
  set(todo selecta_core)
  set(seen "")
  set(found "")
  while(todo)
    list(POP_FRONT todo t)
    if(t IN_LIST seen)
      continue()
    endif()
    list(APPEND seen ${t})
    get_target_property(deps ${t} INTERFACE_LINK_LIBRARIES)
    if(deps)
      foreach(d IN LISTS deps)
        if(TARGET ${d})
          get_target_property(k ${d} TYPE)
          if(k STREQUAL "STATIC_LIBRARY")
            list(APPEND found ${d})
          endif()
          list(APPEND todo ${d})
        endif()
      endforeach()
    endif()
  endwhile()
  list(REMOVE_DUPLICATES found)
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(sel_core_fold)
  get_target_property(_core_type selecta_core TYPE)
  if(NOT _core_type STREQUAL "SHARED_LIBRARY")
    return()
  endif()
  sel_core_static_closure(closure)
  foreach(lib IN LISTS closure)
    if(APPLE)
      target_link_options(selecta_core PRIVATE "LINKER:-force_load,$<TARGET_FILE:${lib}>")
    else()
      target_link_options(selecta_core PRIVATE "LINKER:--whole-archive,$<TARGET_FILE:${lib}>,--no-whole-archive")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY SEL_CORE_FOLDED_LIBS "${closure}")
endfunction()
cmake_language(DEFER CALL sel_core_fold)
