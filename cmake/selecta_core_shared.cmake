# I427f (design D6): fold the static closure of selecta_core into the shared selecta_core (SELECTA_PLUGIN_LINK=MODULE).
# Every static library selecta_core links, directly or through PUBLIC dependencies, goes in whole (all objects, not only the
# ones the core references) and its symbols are exported, so a module or test that links such a library by name again finds
# every symbol already defined by the shared core and pulls no private copy from the archive. Runs deferred: the targets live
# in subdirectories added after src/.
if(NOT SELECTA_PLUGIN_LINK STREQUAL "MODULE")
  return()
endif()

function(sel_core_static_closure out)
  set(todo selecta_core)
  set(seen "")
  set(found "")
  while(todo)
    list(POP_FRONT todo t)
    if(t IN_LIST seen)
      continue()
    endif()
    list(APPEND seen ${t})
    get_target_property(deps ${t} INTERFACE_LINK_LIBRARIES)
    if(deps)
      foreach(d IN LISTS deps)
        if(TARGET ${d})
          get_target_property(k ${d} TYPE)
          if(k STREQUAL "STATIC_LIBRARY")
            list(APPEND found ${d})
          endif()
          list(APPEND todo ${d})
        endif()
      endforeach()
    endif()
  endwhile()
  list(REMOVE_DUPLICATES found)
  set(${out} "${found}" PARENT_SCOPE)
  set(${out}_seen "${seen}" PARENT_SCOPE)
endfunction()

# I1090: every buildsystem target in the project, all directories.
function(sel_core_all_targets dir out)
  get_property(t DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
  get_property(subs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
  foreach(s IN LISTS subs)
    sel_core_all_targets(${s} st)
    list(APPEND t ${st})
  endforeach()
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# I1090: ld takes the first definition on the link line, so a consumer naming a folded archive before selecta_core pulled a
# private copy of its objects (globals and registries split from the shared core). Every consumer outside the core's own
# closure now names selecta_core in place of each folded archive, so link order no longer matters: the dylib always comes
# first and the archives only follow it through selecta_core's own interface.
function(sel_core_redirect closure skip)
  sel_core_all_targets(${CMAKE_SOURCE_DIR} all)
  foreach(t IN LISTS all)
    if(t IN_LIST skip)
      continue()
    endif()
    foreach(prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(libs ${t} ${prop})
      if(NOT libs)
        continue()
      endif()
      set(new "")
      set(changed FALSE)
      foreach(l IN LISTS libs)
        set(r "${l}")
        foreach(f IN LISTS closure)
          if(l STREQUAL f)
            set(r selecta_core)
          elseif(l STREQUAL "$<LINK_ONLY:${f}>")
            set(r "$<LINK_ONLY:selecta_core>")
          endif()
        endforeach()
        if(NOT r STREQUAL l)
          set(changed TRUE)
        endif()
        list(APPEND new "${r}")
      endforeach()
      if(changed)
        list(REMOVE_DUPLICATES new)
        set_property(TARGET ${t} PROPERTY ${prop} "${new}")
      endif()
    endforeach()
  endforeach()
endfunction()

function(sel_core_fold)
  get_target_property(_core_type selecta_core TYPE)
  if(NOT _core_type STREQUAL "SHARED_LIBRARY")
    return()
  endif()
  sel_core_static_closure(closure)
  foreach(lib IN LISTS closure)
    if(APPLE)
      target_link_options(selecta_core PRIVATE "LINKER:-force_load,$<TARGET_FILE:${lib}>")
    else()
      target_link_options(selecta_core PRIVATE "LINKER:--whole-archive,$<TARGET_FILE:${lib}>,--no-whole-archive")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY SEL_CORE_FOLDED_LIBS "${closure}")
  sel_core_redirect("${closure}" "selecta_core;${closure_seen}")
endfunction()
cmake_language(DEFER CALL sel_core_fold)
