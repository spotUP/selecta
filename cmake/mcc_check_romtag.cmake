# I685p: post-build check on every UP- MUI library (up-mcc.library, UP-<Class>.mcc, UP-MCC.mcp, UP-Spike.mcc).
# Reads the AmigaOS hunk file BINARY, finds the Resident (RTC_MATCHWORD 0x4afc followed by a pointer to itself) in the first
# (code) hunk and fails unless rt_Flags has RTF_AUTOINIT, rt_Type is NT_LIBRARY and rt_Version equals VERSION.
# Why: exec's ramlib refuses OpenLibrary(name, n) for a disk library whose Resident version is below n. libnix libinit.o has
# rt_Version 0, so OpenLibrary("up-mcc.library", 1) in every class init failed and all eleven classes returned NULL from
# MUI_NewObject on the rig.
# Usage: cmake -DBINARY=<file> -DVERSION=<n> -P mcc_check_romtag.cmake
if(NOT BINARY OR NOT VERSION)
  message(FATAL_ERROR "mcc_check_romtag: BINARY and VERSION are required")
endif()
file(READ "${BINARY}" hex HEX)
string(LENGTH "${hex}" hexlen)
macro(_long off out)
  math(EXPR _c "(${off}) * 2")
  string(SUBSTRING "${hex}" ${_c} 8 _h)
  math(EXPR ${out} "0x${_h}")
endmacro()
_long(0 magic)
if(NOT magic EQUAL 1011) # HUNK_HEADER 0x3f3
  message(FATAL_ERROR "${BINARY}: not an AmigaOS hunk file")
endif()
_long(4 names)
if(NOT names EQUAL 0)
  message(FATAL_ERROR "${BINARY}: resident library names in the hunk header are not supported")
endif()
_long(8 count)
_long(12 first)
_long(16 last)
math(EXPR nsizes "${last} - ${first} + 1")
math(EXPR pos "20 + 4 * ${nsizes}")
_long(${pos} htype)
math(EXPR htype "${htype} & 0x3fffffff")
if(NOT htype EQUAL 1001) # HUNK_CODE 0x3e9
  message(FATAL_ERROR "${BINARY}: first hunk is not HUNK_CODE (${htype})")
endif()
math(EXPR pos "${pos} + 4")
_long(${pos} codelongs)
math(EXPR code "${pos} + 4")
math(EXPR codebytes "${codelongs} * 4")
math(EXPR codehexend "(${code} + ${codebytes}) * 2")
if(codehexend GREATER hexlen)
  message(FATAL_ERROR "${BINARY}: code hunk runs past the end of the file")
endif()
math(EXPR codehex "${code} * 2")
math(EXPR codehexlen "${codebytes} * 2")
string(SUBSTRING "${hex}" ${codehex} ${codehexlen} text)
# The self pointer is relocated against the code hunk, so in the file it holds the Resident's offset in the hunk.
set(found -1)
set(start 0)
while(found EQUAL -1)
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "4afc" rel)
  if(rel EQUAL -1)
    break()
  endif()
  math(EXPR at "${start} + ${rel}")
  math(EXPR start "${at} + 4")
  math(EXPR odd "${at} % 4")
  if(NOT odd EQUAL 0)
    continue()
  endif()
  math(EXPR off "${at} / 2")
  math(EXPR ptrhex "${at} + 4")
  string(SUBSTRING "${text}" ${ptrhex} 8 ph)
  string(LENGTH "${ph}" phlen)
  if(NOT phlen EQUAL 8)
    break()
  endif()
  math(EXPR ptr "0x${ph}")
  if(ptr EQUAL off)
    set(found ${off})
  endif()
endwhile()
if(found EQUAL -1)
  message(FATAL_ERROR "${BINARY}: no Resident (0x4afc + self pointer) in the code hunk")
endif()
math(EXPR fh "(${found} + 10) * 2")
string(SUBSTRING "${text}" ${fh} 8 fvt)
string(SUBSTRING "${fvt}" 0 2 rt_flags)
string(SUBSTRING "${fvt}" 2 2 rt_version)
string(SUBSTRING "${fvt}" 4 2 rt_type)
math(EXPR rt_flags "0x${rt_flags}")
math(EXPR rt_version "0x${rt_version}")
math(EXPR rt_type "0x${rt_type}")
math(EXPR autoinit "${rt_flags} & 0x80")
get_filename_component(_name "${BINARY}" NAME)
if(NOT autoinit EQUAL 128 OR NOT rt_type EQUAL 9 OR NOT rt_version EQUAL VERSION)
  message(FATAL_ERROR "${_name}: Resident at +${found} has flags ${rt_flags} type ${rt_type} version ${rt_version}; "
    "want RTF_AUTOINIT, NT_LIBRARY (9) and version ${VERSION} (ramlib refuses OpenLibrary(name, ${VERSION}) below it)")
endif()
message(STATUS "${_name}: Resident at +${found}, version ${rt_version}, NT_LIBRARY, RTF_AUTOINIT")
