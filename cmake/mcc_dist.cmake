# I685l (design 2026-11-06-mui-mcc-package.md section 9): stage and check the UP-MCC distribution tree.
#   cmake -DMODE=stage    -DDEST=<UP-MCC dir> -DBIN_DIR=<built products> -DSFD_INC=<sfdc headers> -DROOT=<repo> -DCLASS_NAMES=<list> -P mcc_dist.cmake
#   cmake -DMODE=check    -DDEST=<UP-MCC dir> -DCLASS_NAMES=<list> [-DHAS_INTER_LICENSE=1] -P mcc_dist.cmake
#   cmake -DMODE=selftest -DWORK=<scratch dir> -DROOT=<repo> -DCLASS_NAMES=<list> -P mcc_dist.cmake   (host: stage with empty stand-ins
#         for the built products, then check; proves the staging rules and the file list without the Amiga toolchain)
# BIN_DIR holds UP-<Class>.mcc, UP-MCC.mcp, up-mcc.library and UP-Demo. SFD_INC holds proto/ inline/ clib/ pragmas/ of up-mcc.library.
set(MCC_ROOT "${ROOT}/plugins/shared/mcc")
set(SFD_HEADER_FILES proto/up_mcc.h inline/up_mcc.h clib/up_mcc_protos.h pragmas/up_mcc_pragmas.h)

function(mcc_expected out)
  set(l Libs/mui/UP-MCC.mcp Libs/up-mcc.library Fonts/Inter-Regular.ttf Themes/Dark.theme Themes/Light.theme
    Include/mcc/up.h Include/mcc/up_lib.h Include/selecta/uimodel/tokens.h
    Docs/LICENSE Docs/LICENSE.Lucide Docs/LICENSE.Inter Docs/up-mcc.library.doc Demo/UP-Demo Demo/updemo.c Install-UP-MCC README)
  foreach(c ${CLASS_NAMES})
    list(APPEND l "Libs/mui/UP-${c}.mcc" "Docs/UP-${c}.mcc.doc")
  endforeach()
  foreach(h ${SFD_HEADER_FILES})
    list(APPEND l "Include/${h}")
  endforeach()
  set(${out} "${l}" PARENT_SCOPE)
endfunction()

function(mcc_check)
  mcc_expected(files)
  set(missing 0)
  foreach(f ${files})
    if(NOT EXISTS "${DEST}/${f}")
      message(SEND_ERROR "[ERROR] mcc-dist-layout: missing ${f}")
      math(EXPR missing "${missing}+1")
    endif()
  endforeach()
  list(LENGTH files n)
  if(missing GREATER 0)
    message(FATAL_ERROR "[ERROR] mcc-dist-layout: ${missing} of ${n} paths missing under ${DEST}")
  endif()
  message(STATUS "[OK] mcc-dist-layout: ${n} paths present under ${DEST}")
endfunction()

function(mcc_stage)
  file(REMOVE_RECURSE "${DEST}")
  file(MAKE_DIRECTORY "${DEST}/Libs/mui" "${DEST}/Fonts" "${DEST}/Themes" "${DEST}/Include/mcc" "${DEST}/Include/selecta/uimodel"
    "${DEST}/Docs" "${DEST}/Demo")
  foreach(c ${CLASS_NAMES})
    file(COPY "${BIN_DIR}/UP-${c}.mcc" DESTINATION "${DEST}/Libs/mui")
  endforeach()
  file(COPY "${BIN_DIR}/UP-MCC.mcp" DESTINATION "${DEST}/Libs/mui")
  file(COPY "${BIN_DIR}/up-mcc.library" DESTINATION "${DEST}/Libs")
  file(COPY "${BIN_DIR}/UP-Demo" DESTINATION "${DEST}/Demo")
  file(COPY "${MCC_ROOT}/demo/updemo.c" DESTINATION "${DEST}/Demo")
  file(COPY "${ROOT}/third_party/fonts/Inter-Regular.ttf" DESTINATION "${DEST}/Fonts")
  file(GLOB themes "${MCC_ROOT}/dist/themes/*.theme")
  file(COPY ${themes} DESTINATION "${DEST}/Themes")
  file(COPY "${MCC_ROOT}/include/mcc/up.h" "${MCC_ROOT}/include/mcc/up_lib.h" DESTINATION "${DEST}/Include/mcc")
  file(COPY "${ROOT}/include/selecta/uimodel/tokens.h" DESTINATION "${DEST}/Include/selecta/uimodel")
  foreach(h ${SFD_HEADER_FILES})
    get_filename_component(d "${h}" DIRECTORY)
    file(COPY "${SFD_INC}/${h}" DESTINATION "${DEST}/Include/${d}")
  endforeach()
  file(COPY "${MCC_ROOT}/dist/Install-UP-MCC" "${MCC_ROOT}/dist/README" DESTINATION "${DEST}")
  file(COPY_FILE "${ROOT}/LICENSE" "${DEST}/Docs/LICENSE")
  file(COPY_FILE "${ROOT}/third_party/lucide/LICENSE" "${DEST}/Docs/LICENSE.Lucide")
  file(COPY_FILE "${ROOT}/third_party/fonts/LICENSE-OFL.txt" "${DEST}/Docs/LICENSE.Inter")
  find_program(PYTHON3 NAMES python3 python REQUIRED)
  execute_process(COMMAND "${PYTHON3}" -I "${ROOT}/tools/mcc_autodoc.py" extract "${DEST}/Docs" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "[ERROR] mcc_autodoc.py extract failed: ${out}")
  endif()
endfunction()

if(MODE STREQUAL "stage")
  mcc_stage()
  mcc_check()
elseif(MODE STREQUAL "check")
  mcc_check()
elseif(MODE STREQUAL "selftest")
  file(REMOVE_RECURSE "${WORK}")
  set(BIN_DIR "${WORK}/bin")
  set(SFD_INC "${WORK}/sfd")
  set(DEST "${WORK}/UP-MCC")
  file(MAKE_DIRECTORY "${BIN_DIR}")
  foreach(f UP-MCC.mcp up-mcc.library UP-Demo)
    file(WRITE "${BIN_DIR}/${f}" "stand-in\n")
  endforeach()
  foreach(c ${CLASS_NAMES})
    file(WRITE "${BIN_DIR}/UP-${c}.mcc" "stand-in\n")
  endforeach()
  foreach(h ${SFD_HEADER_FILES})
    file(WRITE "${SFD_INC}/${h}" "/* stand-in */\n")
  endforeach()
  mcc_stage()
  mcc_check()
else()
  message(FATAL_ERROR "mcc_dist.cmake: MODE must be stage, check or selftest")
endif()
