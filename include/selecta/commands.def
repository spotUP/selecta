/* Command table: SEL_CMD(id, args, area). Design doc section 3, first set plus
 * the protocol additions. Generates sel_cmd_id, the text codec tables,
 * COMMANDS reflection and the ratchet of unimplemented verbs.
 *
 * args is the argument signature: one letter per argument.
 *   s  string (quoted on the wire when it holds a space or a quote)
 *   i  signed 32-bit; a leading + or - is kept as the relative flag
 *   u  unsigned 32-bit
 *   t  tag list, {NAME=value,...} on the wire, names from tags.def
 *   ?  the previous argument is optional (only at the end)
 *   *  the previous argument repeats to the end of the line
 * area is the section the verb sits in (the comment headings below): transport,
 * queue, playlists, view, protocol. COMMANDS reports it as `area=<name>`; the
 * command palette and the help overlay group by it.
 * The wire form is one line: VERB arg arg ... (design doc section 8). */

/* transport */
SEL_CMD(OPEN, "s", "transport")
SEL_CMD(PLAY, "", "transport")
SEL_CMD(PAUSE, "", "transport")
SEL_CMD(PAUSE_PLAYBACK, "s", "transport")
SEL_CMD(STOP, "", "transport")
SEL_CMD(NEXT, "", "transport")
SEL_CMD(PREV, "", "transport")
SEL_CMD(NEXT_ALBUM, "", "transport")
SEL_CMD(PREV_ALBUM, "", "transport")
SEL_CMD(SUBSONG, "u", "transport")
SEL_CMD(SEEK, "s", "transport")
SEL_CMD(VOLUME, "i", "transport")
SEL_CMD(MUTE, "us", "transport")
SEL_CMD(SOLO, "u", "transport")
SEL_CMD(PITCH, "i", "transport")
SEL_CMD(TEMPO, "i", "transport")
SEL_CMD(REPEAT, "s", "transport")
SEL_CMD(OUTPUT, "s", "transport")
SEL_CMD(OPTION, "ss", "transport")
SEL_CMD(SLEEP_TIMER, "u", "transport")
SEL_CMD(ALARM, "s", "transport")

/* queue */
SEL_CMD(QUEUE_ADD, "s", "queue")
SEL_CMD(QUEUE_ADD_QUERY, "s", "queue")
SEL_CMD(QUEUE_REMOVE, "u", "queue")
SEL_CMD(QUEUE_CLEAR, "", "queue")
SEL_CMD(QUEUE_PLAY_NEXT, "s", "queue")
SEL_CMD(QUEUE_MOVE, "uu", "queue")
SEL_CMD(QUEUE_SWAP, "uu", "queue")
SEL_CMD(QUEUE_SHUFFLE, "s?", "queue")
SEL_CMD(QUEUE_CHANGES, "u", "queue")
SEL_CMD(SNAPSHOT_QUEUE, "uu?", "queue")
SEL_CMD(PLAY_QUERY, "s", "queue")
SEL_CMD(RESHUFFLE, "", "queue")
SEL_CMD(SHUFFLE, "ss?", "queue")
SEL_CMD(SCOPE, "s", "queue")
SEL_CMD(UNDO, "", "queue")
SEL_CMD(REDO, "", "queue")

/* playlists and library */
SEL_CMD(PLAYLIST_LOAD, "ss?", "playlists")
SEL_CMD(PLAYLIST_SAVE, "s", "playlists")
SEL_CMD(SAMPLE_LIST, "", "playlists")
SEL_CMD(SAMPLE_EXPORT, "us", "playlists")
SEL_CMD(PLAYLIST_PUBLISH, "s", "playlists")
SEL_CMD(LIBRARY_BROWSE, "s", "playlists")
SEL_CMD(LIBRARY_SEARCH, "s", "playlists")
SEL_CMD(LIBRARY_FETCH, "s", "playlists")
SEL_CMD(LIBRARY_SCAN, "s", "playlists")
SEL_CMD(RATE, "u", "playlists")
SEL_CMD(VOTE, "s?", "playlists")
SEL_CMD(CUE_SET, "u", "playlists")
SEL_CMD(CUE_GOTO, "u", "playlists")
SEL_CMD(STICKER_SET, "sss", "playlists")
SEL_CMD(STICKER_GET, "ss", "playlists")
SEL_CMD(STICKER_DEL, "ss", "playlists")
SEL_CMD(STICKER_LIST, "s", "playlists")
SEL_CMD(PREF_GET, "s", "playlists")
SEL_CMD(PREF_SET, "ss", "playlists")

/* view model and shell */
SEL_CMD(VIEW_STYLE, "s", "view")
SEL_CMD(VIEW_SHOW, "s", "view")
SEL_CMD(VIEW_CURSOR, "s", "view")
SEL_CMD(VIEW_ACTIVATE, "", "view")
SEL_CMD(VIEW_WINDOW, "u", "view")
SEL_CMD(VIEW_GROUP, "s", "view")
SEL_CMD(VIEW_EXPAND, "u", "view")
SEL_CMD(VIEW_COLLAPSE, "u", "view")
SEL_CMD(VIEW_DRILL, "us", "view")
SEL_CMD(UI_SWITCH, "s", "view")

/* mixer stages: LED filter on|off|toggle, stereo width 0..100 (+n and -n are relative) */
SEL_CMD(FILTER_LED, "s", "view")
SEL_CMD(MIX_STEREO_WIDTH, "i", "view")

/* dsp (palette area: view, the only settings-like group) */
SEL_CMD(DSP, "ss", "view")

/* protocol */
SEL_CMD(BEGIN, "", "protocol")
SEL_CMD(END, "", "protocol")
SEL_CMD(COMMANDS, "", "protocol")
SEL_CMD(EVENTS, "", "protocol")
SEL_CMD(TAGTYPES, "", "protocol")
SEL_CMD(IDLE, "s*", "protocol")
SEL_CMD(AUTH, "s", "protocol")
SEL_CMD(DEVICE_LIST, "", "protocol")
SEL_CMD(DEVICE_TRANSFER, "u", "protocol")
SEL_CMD(DEVICE_FOLLOW, "u?", "protocol")
