/* Command table: SEL_CMD(id, args, area, argnames, label). Design doc section 3, first set plus
 * the protocol additions. Generates sel_cmd_id, the text codec tables,
 * COMMANDS reflection and the ratchet of unimplemented verbs.
 *
 * args is the argument signature: one letter per argument.
 *   s  string (quoted on the wire when it holds a space or a quote)
 *   i  signed 32-bit; a leading + or - is kept as the relative flag
 *   u  unsigned 32-bit
 *   t  tag list, {NAME=value,...} on the wire, names from tags.def
 *   ?  the previous argument is optional (only at the end)
 *   *  the previous argument repeats to the end of the line
 * area is the section the verb sits in (the comment headings below): transport,
 * queue, playlists, view, protocol. COMMANDS reports it as `area=<name>`; the
 * command palette and the help overlay group by it.
 * argnames is the argument names for COMMANDS: space separated, lower case with underscores, one per signature
 * letter (? and * are not letters). An optional argument is written [name], a repeating one name...
 * label is the verb's name for people (menus, palette, ARexx help): full English words, no abbreviations.
 * The build checks that every row has both and that the name count matches the signature.
 * The wire form is one line: VERB arg arg ... (design doc section 8). */

/* transport */
SEL_CMD(OPEN, "s", "transport", "path", "Open")
SEL_CMD(PLAY, "", "transport", "", "Play")
SEL_CMD(PAUSE, "", "transport", "", "Pause")
SEL_CMD(PAUSE_PLAYBACK, "s", "transport", "mode", "Pause Playback")
SEL_CMD(STOP, "", "transport", "", "Stop")
SEL_CMD(NEXT, "", "transport", "", "Next Song")
SEL_CMD(PREV, "", "transport", "", "Previous Song")
SEL_CMD(NEXT_ALBUM, "", "transport", "", "Next Album")
SEL_CMD(PREV_ALBUM, "", "transport", "", "Previous Album")
SEL_CMD(SUBSONG, "u", "transport", "number", "Select Subsong")
SEL_CMD(SEEK, "s", "transport", "position", "Seek")
SEL_CMD(VOLUME, "i", "transport", "level", "Volume")
SEL_CMD(MUTE, "us", "transport", "channel mode", "Mute Channel")
SEL_CMD(SOLO, "u", "transport", "channel", "Solo Channel")
SEL_CMD(PITCH, "i", "transport", "amount", "Pitch")
SEL_CMD(TEMPO, "i", "transport", "amount", "Tempo")
SEL_CMD(REPEAT, "s", "transport", "mode", "Repeat")
SEL_CMD(OUTPUT, "s", "transport", "name", "Select Output")
SEL_CMD(OPTION, "ss", "transport", "name value", "Set Option")
SEL_CMD(SLEEP_TIMER, "u", "transport", "minutes", "Sleep Timer")
SEL_CMD(ALARM, "s", "transport", "time", "Alarm")

