/* Preferences (plan M1.2, "Decisions: prefs"). One row per pref:
 *   SEL_PREF(id, key, default, kind)
 * kind is SEL_PREF_PLAIN (any text) or SEL_PREF_FORMAT (must parse as a title
 * format, see src/engine/format.h). The engine reads and writes them through
 * the PREF_GET and PREF_SET verbs and keeps them in prefs.conf. Appending a
 * row is the only change a new pref needs. */
SEL_PREF(VIEW_TITLE_FORMAT,  "view.title_format",  "[%author% - ]%title%[  Votes %votes%]",    SEL_PREF_FORMAT)
SEL_PREF(VIEW_COLUMNS,       "view.columns",       "title,format,duration",                       SEL_PREF_PLAIN)
SEL_PREF(VIEW_STATUS_FORMAT, "view.status_format", "%state% %elapsed% / %duration%  %title%",     SEL_PREF_FORMAT)
SEL_PREF(UI_HISTORY_SIZE,    "ui.history_size",    "100",                                         SEL_PREF_PLAIN)
/* desktop UI layout: full, window (compact window) or mini (title and transport only); MODE= sets it at start */
SEL_PREF(UI_DESKTOP_MODE,    "ui.desktop.mode",    "full",                                        SEL_PREF_PLAIN)
SEL_PREF(UI_DESKTOP_VIZ,     "ui.desktop.viz",     "viz_scope",                                   SEL_PREF_PLAIN)
/* desktop UI zoom (I458, I565): fit, 75, 100, 125 or 150; empty = the backend default (100 on SDL, fit on rtg and aga); --zoom overrides */
SEL_PREF(UI_DESKTOP_ZOOM,    "ui.desktop.zoom",    "",                                            SEL_PREF_PLAIN)
/* Fill Screen (Overscan), AGA backend only (I566): 0 = the standard 640x256 (640x200 NTSC) screen with a black border,
 * 1 = the screen fills the area of the Overscan preferences editor (OSCAN_STANDARD, as Workbench does), so its size is whatever the
 * user set there; untuned preferences (640x256 PAL, 640x200 NTSC) open the normal screen. Read when the screen opens, so a change applies at the next start */
SEL_PREF(UI_DESKTOP_OVERSCAN, "ui.desktop.overscan", "0",                                     SEL_PREF_PLAIN)
/* desktop UI animations: 1 turns every tween off; 0 is the default because SDL does not report the OS setting */
SEL_PREF(UI_DESKTOP_REDUCE_MOTION, "ui.desktop.reduce_motion", "0",                               SEL_PREF_PLAIN)
/* crossfeed: auto (on when the output reports headphones), on, off */
SEL_PREF(DSP_CROSSFEED,      "dsp.crossfeed",      "auto",                                        SEL_PREF_PLAIN)
/* Start options (one parser for ToolTypes and CLI, src/engine/options.c; keys OUTPUT, PRI, BUFFER, LED). */
SEL_PREF(OUTPUT_ID,          "output.id",          "",                                            SEL_PREF_PLAIN)
/* audio task priority; 30 is the default of the interrupt design (plan M2 D-M2-1) */
SEL_PREF(AUDIO_PRIORITY,     "audio.priority",     "30",                                          SEL_PREF_PLAIN)
/* output buffer in frames; 0: scaled from the machine */
SEL_PREF(OUTPUT_BUFFER,      "output.buffer",      "0",                                           SEL_PREF_PLAIN)
/* Amiga LED (power) filter: on, off */
SEL_PREF(OUTPUT_LED,         "output.led",         "off",                                         SEL_PREF_PLAIN)
/* per-replayer options, "plugin.key=value,..."; a replayer reads its declared SEL_RP_CONFIG keys at open (D-M2-8) */
SEL_PREF(RP_CONFIG,          "rp.config",          "",                                            SEL_PREF_PLAIN)
/* stereo width percent, 0 (mono) to 100 (unchanged); the LED filter is output.led */
SEL_PREF(MIX_STEREO_WIDTH,   "mix.stereo_width",   "100",                                         SEL_PREF_PLAIN)
/* loudness normalisation (I189, D-M3-9): track = apply the stored per-song gain, then the -1 dBFS limiter;
 * auto = track, and the adaptive leveler for songs without a gain (I190); off = untouched samples, no limiter */
SEL_PREF(MIX_LOUDNESS,       "mix.loudness",       "track",                                       SEL_PREF_PLAIN)
/* Prefetch and smart downloads (I168, I169, F34). library.prefetch: fetch the next remote queue entry while a song
 * plays. library.metered: the connection is metered, so neither prefetch nor smart downloads run. library.smart_downloads:
 * fetch songs of the smart playlist and the most played history in the background, behind the foreground fetch and
 * the prefetch, within the cache budget (off by default on the Amiga, where a transfer blocks the single task).
 * library.smart_playlist: name of the saved view that is the smart playlist ("" = history only). library.smart_top:
 * how many songs one planning round fetches at most (0 = none, capped at 8). */
SEL_PREF(LIBRARY_PREFETCH,   "library.prefetch",   "on",                                          SEL_PREF_PLAIN)
SEL_PREF(LIBRARY_METERED,    "library.metered",    "off",                                         SEL_PREF_PLAIN)
#ifdef __amigaos__
SEL_PREF(LIBRARY_SMART,      "library.smart_downloads", "off",                                    SEL_PREF_PLAIN)
#else
SEL_PREF(LIBRARY_SMART,      "library.smart_downloads", "on",                                     SEL_PREF_PLAIN)
#endif
/* HippoPlayer vote service (I174): this install's random 128-bit device token (32 hex digits), made on the first VOTE */
SEL_PREF(LIBRARY_VOTE_TOKEN, "library.vote_token", "",                                            SEL_PREF_PLAIN)
/* DEViLBOX lyrics (I193): "on" asks the endpoint for a song without a .lrc file and without a song message. On by
 * default (Johan's call): the request carries the md5 of the file; "off" keeps every song hash on the machine. */
SEL_PREF(LIBRARY_LYRICS,     "library.lyrics_online", "on",                                       SEL_PREF_PLAIN)
/* Sources page (I265): comma separated ids of the sources switched off. A source in the list is skipped by search, browse
 * and radio; SOURCES reports SRC_ENABLED=0 for it. Empty: every registered source is on. */
SEL_PREF(LIBRARY_SOURCES_OFF, "library.sources_off", "",                                       SEL_PREF_PLAIN)
/* Sync on launch (I527): a remote source never synced, or not for this many days, is offered on the Library page (0: never
 * offer). library.sync_notice_at is the unix time Not now was pressed; the offer returns once that is as old as the limit. */
SEL_PREF(LIBRARY_SYNC_STALE_DAYS, "library.sync_stale_days", "30",                              SEL_PREF_PLAIN)
SEL_PREF(LIBRARY_SYNC_NOTICE_AT,  "library.sync_notice_at",  "0",                               SEL_PREF_PLAIN)
/* I582: per-source snooze of the offer. Comma separated "id:days" (days since the unix epoch the banner's Sync button was
 * pressed with that source unticked). The engine counts a source's offer from the later of this and library.sync_notice_at.
 * Whole days keep up to eight remote sources inside the 128 character pref limit. */
SEL_PREF(LIBRARY_SYNC_SNOOZED,    "library.sync_snoozed",    "",                                SEL_PREF_PLAIN)
SEL_PREF(LIBRARY_SMART_VIEW, "library.smart_playlist", "smart",                                   SEL_PREF_PLAIN)
SEL_PREF(LIBRARY_SMART_TOP,  "library.smart_top",  "3",                                           SEL_PREF_PLAIN)
#ifndef __amigaos__
/* last.fm scrobbler (I177, I177b; plugins/integrations/lastfm): API key, shared secret and the session key that
 * `selecta-cli lastfm login` stores. Empty: the plugin falls back to SELECTA_LASTFM_* in the environment. */
SEL_PREF(SCROBBLE_LASTFM_KEY,     "scrobble.lastfm_key",     "",                                  SEL_PREF_PLAIN)
SEL_PREF(SCROBBLE_LASTFM_SECRET,  "scrobble.lastfm_secret",  "",                                  SEL_PREF_PLAIN)
SEL_PREF(SCROBBLE_LASTFM_SESSION, "scrobble.lastfm_session", "",                                  SEL_PREF_PLAIN)
#endif
/* Search source of the search field (MUI-P8-8): Library, Web or Demozoo (src/uimodel/sources.c). */
SEL_PREF(SEARCH_SOURCE,           "search.source",           "Library",                           SEL_PREF_PLAIN)
/* MUI state kept on close (MUI-P8-11, src/uimodel/panels.c): window geometry "x,y,w,h", the open panes bit mask and the
 * browse view. Empty: the MUI defaults. The visualiser is ui.desktop.viz, shared with the desktop UI. */
SEL_PREF(UI_MUI_GEOMETRY,         "ui.mui.geometry",         "",                                  SEL_PREF_PLAIN)
SEL_PREF(UI_MUI_PANES,            "ui.mui.panes",            "",                                  SEL_PREF_PLAIN)
SEL_PREF(UI_MUI_BROWSE_VIEW,      "ui.mui.browse_view",      "",                                  SEL_PREF_PLAIN)
/* Amiga runtime settings (MUI-P8-14): Commodities hotkeys 1 on / 0 off, the main task priority (-5 to 5, clamped by
 * sel_uim_priority_clamp; audio.priority is the audio task's) and the HippoPlayer-style group file path. Stored only: the
 * engine does not act on them yet (I643, M4-P12-12). */
SEL_PREF(AMIGA_HOTKEYS,           "amiga.hotkeys",           "1",                                 SEL_PREF_PLAIN)
SEL_PREF(AMIGA_TASK_PRIORITY,     "amiga.task_priority",     "0",                                 SEL_PREF_PLAIN)
SEL_PREF(AMIGA_GROUP_FILE,        "amiga.group_file",        "",                                  SEL_PREF_PLAIN)
