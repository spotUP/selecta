SEL_TAG(UI, STAT_ICON_RESAMPLED,    0x50D6, INT)
SEL_TAG(UI, STAT_ATLAS_MS,          0x50D7, INT)
SEL_TAG(UI, STAT_ATLAS_BAKED_HITS,  0x50D8, INT)
/* I469: Home shelf album tiles drawn with a library cover. */
SEL_TAG(UI, STAT_SHELF_ALBUM_ART_DRAWS, 0x50D9, INT)
/* I244: tooltip-bound controls on screen: the transport buttons shown plus the visualizer switch segments and the heart. */
SEL_TAG(UI, STAT_TOOLTIP_TARGETS, 0x50DA, INT)
/* Amiga MUI UI (plan 2026-10-25-amiga-mui.md MUI-P1-5): windows opened; only the mui plugin lists it. */
SEL_TAG(UI, STAT_OPEN_MUI,        0x50DB, INT)
/* I526: text lookups served by the bitmap fonts mini4, mini6, mini8 and by the Inter headline sizes 18 and 24. */
SEL_TAG(UI, STAT_BITMAP_HITS_MINI4,   0x50DC, INT)
SEL_TAG(UI, STAT_BITMAP_HITS_MINI6,   0x50DD, INT)
SEL_TAG(UI, STAT_BITMAP_HITS_MINI8,   0x50DE, INT)
SEL_TAG(UI, STAT_HEADLINE_HITS_18,    0x50DF, INT)
SEL_TAG(UI, STAT_HEADLINE_HITS_24,    0x50E0, INT)

/* LIBRARY_RESULT: the listed path and the number of entries in it. */
SEL_TAG(SRC, PATH,             0x7000, STR)
SEL_TAG(SRC, COUNT,            0x7001, INT)
/* Library rows and source capabilities (plan 2026-10-25-m3-library.md Phase 4, I157; design doc 9.1). */
SEL_TAG(SRC, KEY,              0x7002, STR)
SEL_TAG(SRC, NAME,             0x7003, STR)
SEL_TAG(SRC, FORMAT,           0x7004, STR)
SEL_TAG(SRC, ARTIST,           0x7005, STR)
SEL_TAG(SRC, DURATION,         0x7006, INT)
SEL_TAG(SRC, RATING,           0x7007, INT)
SEL_TAG(SRC, GENRE,            0x7008, STR)
SEL_TAG(SRC, ROW_KIND,         0x7009, INT)
SEL_TAG(SRC, HAS_LISTS,        0x7010, INT)
SEL_TAG(SRC, HOSTED_BY,        0x7011, STR)
SEL_TAG(SRC, HAS_MD5,          0x7012, INT)
SEL_TAG(SRC, TRANSPORTS,       0x7013, INT)
SEL_TAG(SRC, FTS,              0x7014, INT)
/* SOURCES rows: "local" or "remote" (where the songs live), and 1 when the source is registered and usable. */
SEL_TAG(SRC, KIND,             0x7015, STR)
SEL_TAG(SRC, ENABLED,          0x7016, INT)
/* A source plugin's hooks list carries its sel_source descriptor (source.h) under this tag (I517 phase 3). */
SEL_TAG(SRC, DESCRIPTOR,       0x7017, PTR)
/* SOURCES rows (I527): SYNCED is the unix time of the last successful LIBRARY_SYNC of the source (0: never); DUE is 1 when
 * the desktop should offer a sync on launch (sel_source_sync_due: a remote, enabled source never synced or stale). */
SEL_TAG(SRC, SYNCED,           0x7018, INT)
SEL_TAG(SRC, DUE,              0x7019, INT)
/* SOURCES rows (I582): unix time (whole days) the user snoozed this source's sync offer with the banner's Sync button while the
 * row was unticked (library.sync_snoozed); 0 none. The desktop writes the pref back from these, so it never reads prefs. */
SEL_TAG(SRC, SNOOZED,          0x701a, INT)

/* META STR values come from the song file. The host stores and draws UTF-8: a value that is valid UTF-8 is kept,
 * anything else is read as ISO-8859-1 (Amiga module text) and converted where it enters the host (I444,
 * src/library/meta_utf8.h). Replayers pass the file's bytes through unchanged. */
SEL_TAG(META, TITLE,           0x8000, STR)
SEL_TAG(META, AUTHOR,          0x8001, STR)
SEL_TAG(META, FORMAT,          0x8002, STR)
SEL_TAG(META, CHANNELS,        0x8003, INT)
SEL_TAG(META, PATTERNS,        0x8004, INT)
SEL_TAG(META, INSTRUMENTS,     0x8005, INT)
SEL_TAG(META, SAMPLES,         0x8006, INT)
SEL_TAG(META, SUBSONGS,        0x8007, INT)
SEL_TAG(META, DURATION_MS,     0x8008, INT)
SEL_TAG(META, MESSAGE,         0x8009, STR)
SEL_TAG(META, SIZE,            0x800A, INT)
SEL_TAG(META, YEAR,            0x800B, INT)
SEL_TAG(META, RELEASE,         0x800C, STR)
SEL_TAG(META, SID_MODEL,       0x800D, INT)
SEL_TAG(META, STIL,            0x800E, STR)

/* Machine probe (design doc section 12). CPU and TIER values are the
 * sel_cpu and sel_tier enums in machine.h; RAM sizes are bytes; speeds are
 * integer loop counts per second (see machine.h); GFX, AUDIO, NET and DISK
 * are strings, "unknown" until their probes exist. */
SEL_TAG(MACHINE, CPU,          0x9000, INT)
SEL_TAG(MACHINE, CPU_SPEED,    0x9001, INT)
SEL_TAG(MACHINE, FPU,          0x9002, INT)
SEL_TAG(MACHINE, FPU_SPEED,    0x9003, INT)
SEL_TAG(MACHINE, FAST_RAM,     0x9004, INT)
SEL_TAG(MACHINE, CHIP_RAM,     0x9005, INT)
SEL_TAG(MACHINE, GFX,          0x9006, STR)
SEL_TAG(MACHINE, AUDIO,        0x9007, STR)
SEL_TAG(MACHINE, NET,          0x9008, STR)
SEL_TAG(MACHINE, DISK,         0x9009, STR)
SEL_TAG(MACHINE, TIER,         0x900A, INT)

SEL_TAG(HOSTQ, API_VERSION,    0xA000, INT)
SEL_TAG(HOSTQ, LOCAL_TIME,     0xA001, INT) /* milliseconds since local midnight */

/* Mixer configuration. The resampler values (none, linear, cubic, sinc)
 * are enum constants in the mixer header, not tags. */
SEL_TAG(MIX, RESAMPLE,         0xB000, INT)

/* Integration plugins (Now Playing, MPRIS; include/selecta/integration.h). */
SEL_TAG(INT, NAME,             0xC000, STR)
SEL_TAG(INT, OPEN,             0xC001, PTR)
SEL_TAG(INT, ON_EVENT,         0xC002, PTR)
SEL_TAG(INT, POLL,             0xC003, PTR)
SEL_TAG(INT, CLOSE,            0xC004, PTR)
SEL_TAG(INT, LOGIN,            0xC005, PTR)

/* Sync statistics (I517; include/selecta/source.h). A source's `sync` fills a tag list with the counters of the run;
 * the engine reads the generic ones and passes the whole list through sel_engine_sync_info. Source-private counters
 * use SEL_TAG_USER tags. */
SEL_TAG(SYNC, LISTING_ROWS,    0xD000, INT)
SEL_TAG(SYNC, SKIPPED_ROWS,    0xD001, INT)
SEL_TAG(SYNC, NEW_THIS_WEEK,   0xD002, INT)
SEL_TAG(SYNC, NET_REQUESTS,    0xD003, INT)
SEL_TAG(SYNC, NET_BYTES,       0xD004, INT) /* listing bytes downloaded */
SEL_TAG(SYNC, CHANGELOGS,      0xD005, INT)
SEL_TAG(SYNC, CL_ADDED,        0xD006, INT)
SEL_TAG(SYNC, CL_REMOVED,      0xD007, INT)
SEL_TAG(SYNC, CL_MOVED,        0xD008, INT)
SEL_TAG(SYNC, CL_UPDATED,      0xD009, INT)
SEL_TAG(SYNC, ZIP_BYTES,       0xD00A, INT)
SEL_TAG(SYNC, UNPACK_PEAK_HEAP, 0xD00B, INT)
SEL_TAG(SYNC, CHANGELOGS_FETCHED, 0xD00C, INT)
SEL_TAG(SYNC, CHANGELOGS_MISSING, 0xD00D, INT)
SEL_TAG(SYNC, SONGLENGTHS,     0xD00E, INT)
SEL_TAG(SYNC, STIL_ENTRIES,    0xD00F, INT)
SEL_TAG(SYNC, SUBTUNES,        0xD010, INT)
SEL_TAG(SYNC, SONGLENGTHS_BYTES, 0xD011, INT)
SEL_TAG(SYNC, STIL_BYTES,      0xD012, INT)
SEL_TAG(SYNC, LISTING_DERIVED, 0xD013, INT)
SEL_TAG(SYNC, LISTS,           0xD014, INT)
SEL_TAG(SYNC, PRG_FILES,       0xD015, INT)
SEL_TAG(SYNC, PRG_ENTRIES,     0xD016, INT)
SEL_TAG(SYNC, PRG_DIVIDERS,    0xD017, INT)
SEL_TAG(SYNC, PRG_STEALTH,     0xD018, INT)
SEL_TAG(SYNC, PRG_SUBSONGS,    0xD019, INT)
