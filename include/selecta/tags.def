/* Tag table: SEL_TAG(namespace, name, value, type). One row per tag; this
 * file generates the enum in tags.h, the name and type table in
 * src/core/tag.c, the TAGTYPES reflection and the tag lint.
 *
 * Namespace blocks (design doc section 10), reserved, never renumbered:
 *   PLUGIN  0x0100  descriptor tags returned by sel_plugin_entry
 *   RP      0x1000  replayer            (M0b)
 *   OUT     0x2000  output
 *   DSP     0x3000  dsp                 (M1)
 *   VIZ     0x4000  visualizer          (M1)
 *   UI      0x5000  ui                  (M1.1)
 *   CONV    0x6000  converter           (M3)
 *   SRC     0x7000  source              (M1)
 *   META    0x8000  metadata values
 *   MACHINE 0x9000  machine probe       (M0b)
 *   HOSTQ   0xA000  host queries
 *   MIX     0xB000  mixer configuration (M0b)
 *   INT     0xC000  integration plugins (M1.2)
 * Control tags 0 END, 1 MORE, 2 SKIP and the SEL_TAG_USER bit 0x80000000
 * live in tags.h. Types: INT (value is a number), STR (value is a
 * const char*), PTR (value is a function or object pointer), LIST (value
 * is a const sel_tag*). */

SEL_TAG(PLUGIN, KIND,          0x0100, INT)
SEL_TAG(PLUGIN, ID,            0x0101, STR)
SEL_TAG(PLUGIN, VERSION,       0x0102, INT)
SEL_TAG(PLUGIN, TAGS,          0x0103, LIST)

SEL_TAG(RP, NAME,              0x1000, STR)
SEL_TAG(RP, VERSION,           0x1001, INT)
SEL_TAG(RP, KIND,              0x1002, INT)
SEL_TAG(RP, EXTENSIONS,        0x1003, STR)
SEL_TAG(RP, FORMATS,           0x1004, STR)
SEL_TAG(RP, MAX_VOICES,        0x1005, INT)
SEL_TAG(RP, NEEDS_CHIPMEM,     0x1006, INT)
SEL_TAG(RP, PROBE,             0x1007, PTR)
SEL_TAG(RP, OPEN,              0x1008, PTR)
SEL_TAG(RP, CLOSE,             0x1009, PTR)
SEL_TAG(RP, START,             0x100A, PTR)
SEL_TAG(RP, TICK,              0x100B, PTR)
SEL_TAG(RP, METADATA,          0x100C, PTR)
SEL_TAG(RP, FLAGS,             0x100D, INT)
SEL_TAG(RP, RENDER,            0x100E, PTR)
SEL_TAG(RP, SEEK,              0x100F, PTR)
SEL_TAG(RP, POSITION,          0x1010, PTR)
SEL_TAG(RP, TRACKER_INFO,      0x1011, PTR)
SEL_TAG(RP, TRACKER_CELLS,     0x1012, PTR)
SEL_TAG(RP, MUTE,              0x1013, PTR)
SEL_TAG(RP, SET_SPEED,         0x1014, PTR)
SEL_TAG(RP, SAMPLE_GET,        0x1015, PTR)
/* Declared needs (M2, design doc section 14): the registry machine filter hides a plugin whose
 * needs the probed machine cannot meet; among plugins claiming the same format the highest
 * PRIORITY wins. MIN_CPU: 68000, 68010, 68020, ... as plain numbers; NEEDS_FLOAT: 1 = needs an
 * FPU; MEMORY: bytes of chip plus fast RAM; PRIORITY: signed, default 0; CONFIG: per-replayer
 * option list. */
SEL_TAG(RP, MIN_CPU,           0x1016, INT)
SEL_TAG(RP, NEEDS_FLOAT,       0x1017, INT)
SEL_TAG(RP, MEMORY,            0x1018, INT)
SEL_TAG(RP, PRIORITY,          0x1019, INT)
SEL_TAG(RP, CONFIG,            0x101A, LIST)
/* Companion file rules (library cache, I166): ';'-separated `pattern>companion` over the base name,
 * '*' standing for the rest of the name. `mdat.*>smpl.*` fetches smpl.<name> with mdat.<name>. */
SEL_TAG(RP, COMPANIONS,        0x101B, STR)
/* STREAMING: 1 = the replayer can open from a growing byte stream (sel_song_source.stream, I195b) instead of the
 * whole file; it then plays an http(s) URL while the download runs. Others get the whole file. */
SEL_TAG(RP, STREAMING,         0x101C, INT)
/* HW kind (I219): the replayer drives the sound hardware itself (Paula, CIA timer), so the engine hands the output
 * over to it. HW_PAUSE stops and resumes the replayer's own clock (sel_rp_hw_pause_fn); HW_RELEASE gives the
 * hardware back before another song takes it (sel_rp_hw_release_fn). Both optional; RP_CLOSE always releases. */
SEL_TAG(RP, HW_PAUSE,          0x101D, PTR)
SEL_TAG(RP, HW_RELEASE,        0x101E, PTR)
/* HW_POLL (I219b): optional, HW kind. Called once per engine render chunk while the song plays; returns SEL_TICK_*
 * flags (sel_rp_hw_poll_fn), 0 when nothing happened. LOOPED and ENDED take the same end policy as a tick's flags. */
SEL_TAG(RP, HW_POLL,           0x101F, PTR)

SEL_TAG(OUT, NAME,             0x2000, STR)
SEL_TAG(OUT, SINK,             0x2001, INT)
SEL_TAG(OUT, RATES,            0x2002, STR)
SEL_TAG(OUT, CHANNELS,         0x2003, INT)
SEL_TAG(OUT, LATENCY_MS,       0x2004, INT)
SEL_TAG(OUT, OPEN,             0x2005, PTR)
SEL_TAG(OUT, CLOSE,            0x2006, PTR)
SEL_TAG(OUT, SET_SOURCE,       0x2007, PTR)
SEL_TAG(OUT, VOICES,           0x2008, PTR)
SEL_TAG(OUT, PUMP,             0x2009, PTR)
SEL_TAG(OUT, STATS,            0x200A, PTR)
SEL_TAG(OUT, STAT_FRAMES,      0x200B, INT)
SEL_TAG(OUT, DIRECT_VOLUME,    0x200C, INT)
SEL_TAG(OUT, HEADPHONES,       0x200D, INT)
SEL_TAG(OUT, STAT_CALLBACKS,   0x200E, INT)
SEL_TAG(OUT, MEM_CHIP,         0x200F, INT) /* bytes of chip RAM the output needs */
SEL_TAG(OUT, VOICE_BACKEND,    0x2010, PTR) /* const sel_voices* (*)(void* state): the open output's voice sink */
SEL_TAG(OUT, STAT_REG_WRITES,  0x2011, INT) /* shadow outputs: AUDx register writes logged */
SEL_TAG(OUT, STAT_LOG_DIGEST,  0x2012, STR) /* shadow outputs: SHA-256 of the register log, lowercase hex */
SEL_TAG(OUT, VOICE_MAX,        0x2013, INT) /* voice outputs: most voices the backend plays; a replayer with more goes through the mixer */
SEL_TAG(OUT, PAULA_HW,         0x2014, INT) /* the output drives the real Paula: LED and width stages are bypassed */

SEL_TAG(OUT, STAT_P14_FRAMES,  0x2015, INT) /* paula14 outputs: frames split into the chip buffers */
SEL_TAG(OUT, STAT_P14_MAX_ERR, 0x2016, INT) /* paula14 outputs: worst split error over every s16 input, 14-bit LSB */
SEL_TAG(OUT, STAT_P14_HASH,    0x2017, STR) /* paula14 outputs: FNV-1a of the split channel bytes, 8 lowercase hex digits */
SEL_TAG(OUT, STAT_P14_BUFS,    0x2018, INT) /* paula14 outputs: chip buffer swaps */
/* CLOCKLESS: 1 = the sink has no clock of its own; the caller paces it and OUT_PUMP pulls on the caller's thread,
 * which therefore is not marked as the audio thread (I64, I216). Absent = the output plays from its own clock. */
SEL_TAG(OUT, CLOCKLESS,        0x2019, INT)

/* DSP plugin rows (design doc section 5, include/selecta/dsp.h). */
SEL_TAG(DSP, NAME,             0x3000, STR)
SEL_TAG(DSP, OPEN,             0x3001, PTR)
SEL_TAG(DSP, PROCESS,          0x3002, PTR)
SEL_TAG(DSP, CLOSE,            0x3003, PTR)
SEL_TAG(DSP, PARAM,            0x3004, PTR)

/* Visualizer plugin rows (design doc section 8). The built-in text UI panels
 * read the snapshot frame (sel_state.viz) directly and need none of these. */
SEL_TAG(VIZ, NAME,             0x4000, STR)
SEL_TAG(VIZ, OPEN,             0x4001, PTR)
SEL_TAG(VIZ, FRAME,            0x4002, PTR)
SEL_TAG(VIZ, CLOSE,            0x4003, PTR)

SEL_TAG(UI, NAME,              0x5000, STR)
SEL_TAG(UI, OPEN,              0x5001, PTR)
SEL_TAG(UI, ON_EVENT,          0x5002, PTR)
SEL_TAG(UI, WAIT,              0x5003, PTR)
SEL_TAG(UI, CLOSE,             0x5004, PTR)
SEL_TAG(UI, VIEW_STYLES,       0x5005, INT)
SEL_TAG(UI, NEEDS_RTG,         0x5006, INT)
SEL_TAG(UI, HOTKEYS,           0x5007, PTR)
SEL_TAG(UI, STATS,             0x5008, PTR)
/* VIEW_CHANGED / VIEW_ROWS: where the view window stands. */
SEL_TAG(UI, ROW_COUNT,         0x5009, INT)
SEL_TAG(UI, CURSOR,            0x500A, INT)
SEL_TAG(UI, WINDOW_START,      0x500B, INT)
SEL_TAG(UI, WINDOW_ROWS,       0x500C, INT)
SEL_TAG(UI, STAT_FLUSHES,      0x500D, INT)
SEL_TAG(UI, STAT_KEYS,         0x500E, INT)
/* T28 sentinels: command lines run, palette openings, entries in the binding table. */
SEL_TAG(UI, STAT_CMDLINE_RUNS, 0x500F, INT)
SEL_TAG(UI, STAT_PALETTE_OPENS, 0x5010, INT)
SEL_TAG(UI, STAT_BINDINGS,     0x5011, INT)
/* T39 sentinels: viz panel frames drawn, scope voice reads, pattern rows drawn. */
SEL_TAG(UI, STAT_VIZ_FRAMES,   0x5012, INT)
SEL_TAG(UI, STAT_SCOPE_READS,  0x5013, INT)
SEL_TAG(UI, STAT_PATTERN_ROWS, 0x5014, INT)
SEL_TAG(UI, STAT_DOT_ROWS,     0x5015, INT)
SEL_TAG(UI, STAT_PHASE_POINTS, 0x5016, INT)
SEL_TAG(UI, STAT_FRAMES,       0x5017, INT)
SEL_TAG(UI, STAT_HASH,         0x5018, INT)
/* T98 sentinels: library screen openings and library searches run from it. */
SEL_TAG(UI, STAT_LIBRARY_OPENS, 0x5019, INT)
SEL_TAG(UI, STAT_LIBRARY_SEARCHES, 0x501A, INT)
/* I179 sentinel: openings of the playlist folder tree screen. */
SEL_TAG(UI, STAT_FOLDER_OPENS, 0x501B, INT)
/* I185 sentinel: catalogue rows the module info panel drew in the latest frame. */
SEL_TAG(UI, STAT_META_PANEL_ROWS, 0x501C, INT)
/* Desktop UI sentinels (plan 2026-10-24-desktop-ui.md section 4.1): widgets drawn in total (one per dirty region per
 * frame), sel_uim_update calls, and the regions the latest changing update touched (SEL_UIM_DIRTY_* bits). */
SEL_TAG(UI, STAT_WIDGET_DRAWS, 0x501D, INT)
SEL_TAG(UI, STAT_UIM_UPDATES,  0x501E, INT)
SEL_TAG(UI, STAT_UIM_DIRTY,    0x501F, INT)
/* The frame layout id (SEL_UIM_LAYOUT_*) the desktop UI draws with. */
SEL_TAG(UI, STAT_UIM_LAYOUT,   0x5020, INT)
/* Effects governor sentinels (DUI-P1-9): tweens started and blur or shadow primitives run by the desktop UI. */
SEL_TAG(UI, STAT_TWEENS,       0x5021, INT)
SEL_TAG(UI, STAT_EFFECT_PRIMS, 0x5022, INT)
/* Rasterizer sentinels (DUI-P2-1, DUI-P2-2): pixels the latest present repainted, pixels over all presents, the
 * canvas hash and the drawing primitives run. */
SEL_TAG(UI, STAT_DIRTY_PIXELS, 0x5023, INT)
SEL_TAG(UI, STAT_DIRTY_TOTAL,  0x5024, INT)
SEL_TAG(UI, STAT_CANVAS_HASH,  0x5025, INT)
SEL_TAG(UI, STAT_DRAW_PRIMS,   0x5026, INT)
/* Text sentinels (DUI-P2-3): code points the glyph atlas lacked (the missing glyph box was drawn) and non-blank glyphs
 * blitted. */
/* Tiles opened by a scripted --input click (DUI-P2-6). */
SEL_TAG(UI, STAT_VIEW_OPENS,   0x5027, INT)
SEL_TAG(UI, STAT_MISSING_GLYPHS, 0x5028, INT)
SEL_TAG(UI, STAT_GLYPHS_DRAWN,   0x5029, INT)
/* Covers decoded by the artwork worker (DUI-P2-4): thumb rows already in the library are not decoded again. */
SEL_TAG(UI, STAT_ART_DECODES,    0x502A, INT)
/* FNV-1a of the first home tile square, to compare generated artwork per format (DUI-P2-5). */
SEL_TAG(UI, STAT_ART_TILE_HASH,  0x502B, INT)
/* sdl backend (DUI-P2-7): hash of the frame read back from the renderer, pixels uploaded to the texture, presents. */
SEL_TAG(UI, STAT_PRESENT_HASH,   0x502C, INT)
SEL_TAG(UI, STAT_UPLOAD_PIXELS,  0x502D, INT)
SEL_TAG(UI, STAT_PRESENTS,       0x502E, INT)

/* LIBRARY_RESULT: the listed path and the number of entries in it. */
SEL_TAG(SRC, PATH,             0x7000, STR)
SEL_TAG(SRC, COUNT,            0x7001, INT)
/* Library rows and source capabilities (plan 2026-10-25-m3-library.md Phase 4, I157; design doc 9.1). */
